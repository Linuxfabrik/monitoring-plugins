# Dependencies of the compiled Windows plugins. Generates the
# `requirements.txt` next to this file (the Nuitka build host runs
# Python 3.13; see BUILD.md). Kept apart from the Linux lockfiles
# because Windows needs one package they do not, and because the
# Dependabot `pip` watch at `/lockfiles/py313-windows` is then
# independent from theirs.
#
# To regenerate, from the root of the repository:
#   python3.13 -m venv .venv-py313
#   source .venv-py313/bin/activate
#   python -m pip install 'pip<25.1' pip-tools
#   python -m piptools compile --generate-hashes \
#       --strip-extras --allow-unsafe \
#       --output-file=lockfiles/py313-windows/requirements.txt \
#       lockfiles/py313-windows/requirements.in

linuxfabrik-lib

# Needed on Windows only:
sspilib
