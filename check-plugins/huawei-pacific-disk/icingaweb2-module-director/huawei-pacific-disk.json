    "Datafield": {
        "1": {
            "varname": "huawei_pacific_disk_always_ok",
            "caption": "Huawei Pacific Disk: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "50afcddf-f9db-45ac-8801-c85b98283d24"
        },
        "2": {
            "varname": "huawei_pacific_disk_brief",
            "caption": "Huawei Pacific Disk: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on. Worth setting on a cluster with many disks.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "670be592-c978-49aa-8b7f-0ec5218b8665"
        },
        "3": {
            "varname": "huawei_pacific_disk_cache_expire",
            "caption": "Huawei Pacific Disk: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "abfcb6fa-87ec-467d-a47c-f1c3836f8d70"
        },
        "4": {
            "varname": "huawei_pacific_disk_critical",
            "caption": "Huawei Pacific Disk: Critical",
            "description": "CRIT threshold for the remaining life of a disk, as a Nagios range in days.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e42128fc-24c7-428d-9fa0-22fd625348e1"
        },
        "5": {
            "varname": "huawei_pacific_disk_ignore",
            "caption": "Huawei Pacific Disk: Ignore",
            "description": "Skip disks. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the node name, the disk pool, the serial number and the slot, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3774013a-8e33-44d1-ad31-aa6b62756399"
        },
        "6": {
            "varname": "huawei_pacific_disk_insecure",
            "caption": "Huawei Pacific Disk: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "97e6802d-aba0-40f4-913a-e2a704408de1"
        },
        "7": {
            "varname": "huawei_pacific_disk_lengthy",
            "caption": "Huawei Pacific Disk: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "995366a9-e1f4-479f-b9a3-b9fcb298b8f5"
        },
        "8": {
            "varname": "huawei_pacific_disk_no_insecure",
            "caption": "Huawei Pacific Disk: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f4d3d729-924e-4af9-9535-0b7639ef6982"
        },
        "9": {
            "varname": "huawei_pacific_disk_match",
            "caption": "Huawei Pacific Disk: Match",
            "description": "Limit to disks. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the node name, the disk pool, the serial number and the slot, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4c8aed2b-1148-4e57-a079-ff03e20ac399"
        },
        "10": {
            "varname": "huawei_pacific_disk_no_match_severity",
            "caption": "Huawei Pacific Disk: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_disk_no_match_severity_list"
            },
            "uuid": "6347c448-d132-49e9-9895-2fea3cf7ef7c"
        },
        "11": {
            "varname": "huawei_pacific_disk_no_perfdata",
            "caption": "Huawei Pacific Disk: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "b86decd7-db32-4145-8241-586459c01c00"
        },
        "12": {
            "varname": "huawei_pacific_disk_no_proxy",
            "caption": "Huawei Pacific Disk: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2e762867-d137-4369-8202-c868aa8a7d84"
        },
        "13": {
            "varname": "huawei_pacific_disk_password",
            "caption": "Huawei Pacific Disk: Password",
            "description": "Huawei OceanStor Pacific API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "f89f1d88-b23d-4ad7-a321-a6a462853f21"
        },
        "14": {
            "varname": "huawei_pacific_disk_password_file",
            "caption": "Huawei Pacific Disk: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "06a3bdb3-7b62-40e9-b4bf-7f1fff72b1b5"
        },
        "15": {
            "varname": "huawei_pacific_disk_scope",
            "caption": "Huawei Pacific Disk: Scope",
            "description": "Huawei OceanStor Pacific API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7678a592-35c4-49f0-9d00-2f43935f12f5"
        },
        "16": {
            "varname": "huawei_pacific_disk_timeout",
            "caption": "Huawei Pacific Disk: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0ce23f3d-78b9-41f4-bdd6-e23f708c288e"
        },
        "17": {
            "varname": "huawei_pacific_disk_url",
            "caption": "Huawei Pacific Disk: URL",
            "description": "Huawei OceanStor Pacific API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "17a8fcb9-3615-45d5-b87e-4c628f95c56d"
        },
        "18": {
            "varname": "huawei_pacific_disk_username",
            "caption": "Huawei Pacific Disk: Username",
            "description": "Huawei OceanStor Pacific API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "82794211-d63e-45ba-b2e0-c40109243d87"
        },
        "19": {
            "varname": "huawei_pacific_disk_warning",
            "caption": "Huawei Pacific Disk: Warning",
            "description": "WARN threshold for the remaining life of a disk, as a Nagios range in days.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "858ecbbc-c106-468a-8cd4-87c46465738b"
        },
        "20": {
            "varname": "huawei_pacific_disk_verbose",
            "caption": "Huawei Pacific Disk: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c8ca9354-7f75-4aa6-9391-27cda2dbe935"
        }
    }
}
