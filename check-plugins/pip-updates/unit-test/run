import tempfile

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        # captured with `python3 -m pip list --outdated --format=json` on Rocky 9 without
        # python3-pip (exit code 1, empty stdout)
        'id': 'unknown-pip-not-installed',
        'test': ',stderr/python3-without-pip,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['pip is not installed for `python3`'],
        'assert-not-in': ['No module named pip'],
    },
    {
        'id': 'unknown-malformed-json',
        'test': 'stdout/malformed-json,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Failed to parse JSON.'],
    },
    {
        # pip 25.0.1 on openSUSE Leap 16.0, which only has itself to report and says
        # so on stderr
        'id': 'ok-pip-names-its-own-update',
        'test': 'stdout/pip-outdated,stderr/pip25-new-release-notice,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'pip says `[notice] A new release of pip is available: 25.0.1 -> 26.2.1`',
            '1 outdated package.',
        ],
    },
    {
        'id': 'warn-eighteen-outdated-packages',
        'test': 'stdout/eighteen-outdated-packages,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '18 outdated packages [WARNING]. Executed command: `python3 -m pip list --outdated`',
