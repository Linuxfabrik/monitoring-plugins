        },
        "3": {
            "varname": "huawei_dorado_enclosure_critical_temperature",
            "caption": "Huawei Dorado Enclosure: Critical Temperature",
            "description": "CRIT threshold in degrees Celsius. Off by default, because a healthy operating temperature depends on the enclosure model and on where the array stands. Example: `--critical-temperature=50`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "efe1ca8a-4e4a-4aa6-852a-c69c869e9715"
        },
        "4": {
            "varname": "huawei_dorado_enclosure_device_id",
            "caption": "Huawei Dorado Enclosure: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "89c717b1-7d66-4448-8e88-bf134ea29f46"
        },
        "5": {
            "varname": "huawei_dorado_enclosure_ignore",
            "caption": "Huawei Dorado Enclosure: Ignore",
            "description": "Skip enclosures. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, `NAME`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "12f17758-924f-4b4d-9d33-42dd2c9069cf"
        },
        "6": {
            "varname": "huawei_dorado_enclosure_insecure",
            "caption": "Huawei Dorado Enclosure: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "33075533-3c86-47ad-9979-2bdf6acc872f"
        },
        "7": {
            "varname": "huawei_dorado_enclosure_lengthy",
            "caption": "Huawei Dorado Enclosure: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2664d02f-9a6d-4e69-92e6-a89ed918800f"
        },
        "8": {
            "varname": "huawei_dorado_enclosure_match",
            "caption": "Huawei Dorado Enclosure: Match",
            "description": "Limit to enclosures. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, `NAME`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4763654c-4514-42fc-97ad-6124bd902efa"
        },
        "9": {
            "varname": "huawei_dorado_enclosure_no_insecure",
            "caption": "Huawei Dorado Enclosure: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "89200a9d-5db3-417a-a83e-add5f255a67c"
        },
        "10": {
            "varname": "huawei_dorado_enclosure_no_match_severity",
            "caption": "Huawei Dorado Enclosure: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_enclosure_no_match_severity_list"
            },
            "uuid": "00f2b3ce-23d3-4476-b910-9376b547f415"
        },
        "11": {
            "varname": "huawei_dorado_enclosure_no_perfdata",
            "caption": "Huawei Dorado Enclosure: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "550b64d4-8c21-4f0b-8fd0-324830bca16c"
        },
        "12": {
            "varname": "huawei_dorado_enclosure_no_proxy",
            "caption": "Huawei Dorado Enclosure: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fcf3f2d5-2e77-41bf-8c7d-ef53a0f1dc2e"
        },
        "13": {
            "varname": "huawei_dorado_enclosure_password",
            "caption": "Huawei Dorado Enclosure: Password",
            "description": "Huawei OceanStor Dorado API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "48e73c5f-978d-43b0-b188-f7a9a43be0e1"
        },
        "14": {
            "varname": "huawei_dorado_enclosure_password_file",
            "caption": "Huawei Dorado Enclosure: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "4c48fdf7-886f-4572-9b3d-08a7bd09a273"
        },
        "15": {
            "varname": "huawei_dorado_enclosure_proxy",
            "caption": "Huawei Dorado Enclosure: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "02e8b67f-58e7-4f4a-97fe-b15771bf6b76"
        },
        "16": {
            "varname": "huawei_dorado_enclosure_scope",
            "caption": "Huawei Dorado Enclosure: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9f170a17-dfe1-4395-9695-287572b6e7c4"
        },
        "17": {
            "varname": "huawei_dorado_enclosure_timeout",
            "caption": "Huawei Dorado Enclosure: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2ad9709d-5e2c-4e8f-ac0b-cbff94cc1cce"
        },
        "18": {
            "varname": "huawei_dorado_enclosure_url",
            "caption": "Huawei Dorado Enclosure: URL",
            "description": "Huawei OceanStor Dorado API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "106b6026-4202-477d-8215-83232748e953"
        },
        "19": {
            "varname": "huawei_dorado_enclosure_username",
            "caption": "Huawei Dorado Enclosure: Username",
            "description": "Huawei OceanStor Dorado API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6edd6eb7-c0fb-4b5b-9377-9a46ed5f22d2"
        },
        "20": {
            "varname": "huawei_dorado_enclosure_verbose",
            "caption": "Huawei Dorado Enclosure: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f0fce27f-cc67-4e25-b487-606b874c8a27"
        },
        "21": {
            "varname": "huawei_dorado_enclosure_warning_temperature",
            "caption": "Huawei Dorado Enclosure: Warning Temperature",
            "description": "WARN threshold in degrees Celsius. Off by default, because a healthy operating temperature depends on the enclosure model and on where the array stands. Example: `--warning-temperature=40`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "462ad3a1-bad5-42b7-88a5-7800e5b687e9"
