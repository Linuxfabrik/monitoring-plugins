import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'ok-enclosures-healthy',
        'test': 'stdout/enclosures-healthy,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'UUID   ! Location ! Name   ! Model                                 '
            '! SerialNumber         ! Logic                                '
            '! MacAddress        ! Switch ! Temp ! Health     ! Running     ! State',
            '-------+----------+--------+---------------------------------------'
            '+----------------------+--------------------------------------'
            '+-------------------+--------+------+------------+-------------+------',
            '206:0  ! 0.1      ! CTE0   ! Unknown                               '
            '! 210235843910E6000009 ! Controller Enclosure                 '
            '! 30:d1:7e:b4:f7:61 ! Off    ! 30   ! Normal (1) ! Online (27) ! [OK] ',
            '206:0  ! --       ! CTE0   ! 4 U 4-controller controller enclosure '
            '! 0815                 ! Controller Enclosure                 '
            '! f4:b7:8d:f4:fe:ff ! Off    ! 22   ! Normal (1) ! Online (27) ! [OK] ',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the inventory ones out.
        'id': 'ok-enclosures-healthy-core-columns',
        'test': 'stdout/enclosures-healthy,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'UUID   ! Location ! Name   ! Temp ! Health     ! Running     ! State',
            '206:0  ! 0.1      ! CTE0   ! 30   ! Normal (1) ! Online (27) ! [OK] ',
        ],
        'assert-not-in': ['MacAddress', 'SerialNumber'],
    },
    {
        # Real-shape enclosures (V700R001C10SPH128, Dorado 6000 V6), one controller
        # and two disk enclosures reporting 22, 21 and 25 C. The temperature
        # threshold that fired has to show up on the Temp value and in the row's
        # State, not only in the overall state above a table of [OK] rows.
        'id': 'warn-enclosure-temperature-marks-row',
        'test': 'stdout/enclosures-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --warning-temperature=24 --critical-temperature=40',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings.',
            '206:0  ! CTE0   ! 22           ! Normal (1) ! Online (27) ! [OK]',
            '206:73 ! DAE050 ! 25 [WARNING] ! Normal (1) ! Online (27) ! [WARNING]',
        ],
    },
    {
        'id': 'crit-enclosure-temperature-marks-row',
        'test': 'stdout/enclosures-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --critical-temperature=24',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            '206:73 ! DAE050 ! 25 [CRITICAL] ! Normal (1) ! Online (27) ! [CRITICAL]',
        ],
    },
    {
        # Without temperature thresholds the same enclosures are fine.
        'id': 'ok-enclosure-temperature-no-thresholds',
        'test': 'stdout/enclosures-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            '206:73 ! DAE050 ! 25   ! Normal (1) ! Online (27) ! [OK]',
        ],
    },
    {
        # The performance data carries the temperature with its thresholds, never a
        # status code: the state already reports those.
        'id': 'warn-enclosure-perfdata-without-status-codes',
        'test': 'stdout/enclosures-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --warning-temperature=24',
        'assert-retc': STATE_WARN,
        'assert-in': [
            "'206_0_temperature'=22;24;;0 ",
            "'206_73_temperature'=25;24;;0",
        ],
        'assert-not-in': ['_health_status', '_running_status', '_switch_status'],
    },
    {
        # An appliance always has enclosures. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-enclosures',
        'test': 'stdout/no-enclosures,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no enclosures.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-enclosure'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
