    "Datafield": {
        "1": {
            "varname": "librenms_validate_always_ok",
            "caption": "LibreNMS Validate: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "cc445926-0d93-48d6-ab12-5973c9149ed9"
        },
        "2": {
            "varname": "librenms_validate_brief",
            "caption": "LibreNMS Validate: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "51491318-d230-4753-8b64-39c40eea2fe2"
        },
        "3": {
            "varname": "librenms_validate_fail_severity",
            "caption": "LibreNMS Validate: Fail Severity",
            "description": "State to report for an item the monitored system itself marks as failed. A failed item means the installation is broken in a way that stops it from working correctly, which is worth acting on but rarely worth waking somebody up for.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "librenms_validate_fail_severity_list"
            },
            "uuid": "e5c05780-0d5d-4b4e-b477-fee57f2b0fe3"
        },
        "4": {
            "varname": "librenms_validate_group",
            "caption": "LibreNMS Validate: Group",
            "description": "Validation group to check. Can be specified multiple times. The groups distributedpoller, mail, rrdcheck are left out of a default run and each costs an additional run of the validation when it is asked for. \"distributedpoller\" is the exception: where distributed polling is enabled, a default run already covers it. Two of them have side effects: \"mail\" sends a real test message to the configured alerting address on every check run, and \"rrdcheck\" reads every RRD file, which takes minutes on a grown installation. If not specified, everything the default run reports is checked. Example: `--group=database --group=poller`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "array",
                "datalist": "librenms_validate_group_list"
            },
            "uuid": "23176cf9-4862-45fc-93e4-aadfd1400278"
        },
        "5": {
            "varname": "librenms_validate_ignore",
            "caption": "LibreNMS Validate: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d3f82952-eacd-484c-9619-62717cf5dd73"
        },
        "6": {
            "varname": "librenms_validate_lengthy",
            "caption": "LibreNMS Validate: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "eda2e140-56bb-4db8-b591-63accb79be01"
        },
        "7": {
            "varname": "librenms_validate_match",
            "caption": "LibreNMS Validate: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ede91f0e-7aef-44dd-b6b8-ef7991e06511"
        },
        "8": {
            "varname": "librenms_validate_no_match_severity",
            "caption": "LibreNMS Validate: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "librenms_validate_no_match_severity_list"
            },
            "uuid": "738f7b9b-526b-4eac-975a-70819fbc0e84"
        },
        "9": {
            "varname": "librenms_validate_no_perfdata",
            "caption": "LibreNMS Validate: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6e6f1135-316f-4044-a959-3473a037fba5"
        },
        "10": {
            "varname": "librenms_validate_path",
            "caption": "LibreNMS Validate: Path",
            "description": "Local path to the installation.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fc507321-ad4f-43fe-92e7-cd86fb8becb8"
        },
        "11": {
            "varname": "librenms_validate_php_path",
            "caption": "LibreNMS Validate: PHP Path",
            "description": "Local path to your PHP binary. Has to be the binary the sudo rule names, because that rule lists the permitted command with its exact arguments.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5f5f137c-7f34-4023-8982-0364dfb5877e"
        },
        "12": {
            "varname": "librenms_validate_timeout",
            "caption": "LibreNMS Validate: Timeout",
            "description": "Seconds to wait for a single run of the validation to finish.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5a2f986f-6a1e-4da6-837e-1cee0775e623"
        },
        "13": {
            "varname": "librenms_validate_user",
            "caption": "LibreNMS Validate: User",
            "description": "System user to run the validation as. LibreNMS refuses to validate itself as root and reports a failure when any other user runs it, so this has to name the user that owns the installation. Requires the right to `sudo -u <user>` (root has this by default).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "162d820c-af74-4c68-9f2f-3b3ce1a71e33"
        }
    }
}
