import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# Every fixture in stdout/ was captured from a real `validate.php` run, escape sequences
# included: the container ones from a LibreNMS Docker instance, git-install-* from a
# production installation deployed from git.
#
# A check run consists of the default run plus one run per requested optional group, so
# the fixtures follow the same split: `--test=stdout/all-ok` feeds the default run, and
# `stdout/all-ok-distributedpoller` the run that `--group=distributedpoller` triggers.
#
# The rest are synthetic, because they capture a state an installation only reaches while
# it is broken or has not shipped yet: default-run-unlisted-group is a captured default
# run with a group appended that no LibreNMS release currently reports, which is how a
# future validation group would arrive; unrecognised-status and
# unrecognised-status-unpadded do the same for a status LibreNMS does not print today,
# once in each of the two shapes its own padding produces; composer-not-run, config-* and
# install-dir-not-set reproduce the aborts validate.php prints before it reaches its first
# validation group; empty-output is the run that printed nothing at all.

TESTS = [
    # A healthy installation with one real finding. The exit code of validate.php is 1
    # here, but the check never reads it.
    {
        'id': 'warn-single-failure',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '1 failure found.',
            'Checked 17 validations in 13 groups.',
            'rrdcached',
        ],
    },
    # A group that finds nothing prints its marker and no result, which is the normal
    # case. Counting groups from the results alone would report 4 instead of 13.
    {
        'id': 'warn-counts-groups-without-results',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ['in 13 groups'],
    },
    # Same fixture, escalated and defused through --fail-severity.
    {
        'id': 'crit-failure-escalated',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--fail-severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'rrdcached.*\[CRITICAL\]',
    },
    {
        'id': 'ok-failure-downgraded',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--fail-severity=ok',
        'assert-retc': STATE_OK,
    },
    # --brief drops the rows that are within expectations, but neither the counts in the
    # summary nor the state change.
    {
        'id': 'warn-brief-hides-ok-rows',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--brief',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 failure found.', 'Checked 17 validations'],
        'assert-not-in': ['Database Connected'],
    },
    # An accepted finding is filtered out, which takes the whole check back to OK.
    {
        'id': 'ok-ignore-regex-drops-the-finding',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--ignore-regex=rrdcached',
        'assert-retc': STATE_OK,
        'assert-in': ['No failures found. No warnings found.'],
        'assert-not-in': ['rrdcached'],
    },
    # Every group reported OK and nothing else.
    {
        'id': 'ok-nothing-to-report',
        'test': 'stdout/all-ok,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['No failures found. No warnings found.'],
    },
    # Warnings, failures, informational results, a suggested fix and a message that
    # continues on the next line, all in one run.
    {
        'id': 'warn-full-run-with-every-status',
        'test': 'stdout/default-run-two-failures,,1',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '4 failures and 2 warnings found.',
            'You have no devices.',
        ],
    },
    # A message too long for one line continues indented by a single space and belongs to
    # the result above it.
    {
        'id': 'warn-continuation-line-joins-the-message',
        'test': 'stdout/default-run-two-failures,,1',
        'params': '--lengthy',
        'assert-retc': STATE_WARN,
        'assert-regex': r'Time between this server and the mysql database is off Mysql time',
    },
    # A group LibreNMS leaves out of a default run is only reported when it is asked for,
    # and it is only run then, which is why its findings live in their own fixture.
    {
        'id': 'ok-optional-group-not-requested',
        'test': 'stdout/all-ok,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-not-in': ['distributed_poller'],
    },
    {
        'id': 'warn-optional-group-requested',
        'test': 'stdout/all-ok,,0',
        'params': '--group=distributedpoller',
        'assert-retc': STATE_WARN,
        'assert-in': ['You have not enabled distributed_poller'],
    },
    # Both runs happen, and their results and groups end up in one report.
    {
        'id': 'warn-optional-group-merges-with-default-run',
        'test': 'stdout/all-ok,,0',
        'params': '--group=disk --group=distributedpoller',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'You have not enabled distributed_poller',
            'in 2 groups',
        ],
    },
    # A message longer than the column is cut in the middle by default, so the table still
    # fits a terminal, and --lengthy prints it whole.
    {
        'id': 'warn-long-message-is-shortened',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '/run/rrdcached.sock does not appe...rrdcached connectivity test failed'
        ],
    },
    {
        'id': 'warn-lengthy-keeps-the-whole-message',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--lengthy',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '/run/rrdcached.sock does not appear to exist, rrdcached connectivity test '
            'failed',
        ],
    },
    # --lengthy adds the command LibreNMS suggests for the finding.
    {
        'id': 'warn-lengthy-shows-the-suggested-fix',
        'test': 'stdout/all-ok,,0',
        'params': '--group=distributedpoller --lengthy',
        'assert-retc': STATE_WARN,
        'assert-in': ['lnms config:set distributed_poller true'],
    },
    {
        'id': 'warn-default-hides-the-suggested-fix',
        'test': 'stdout/all-ok,,0',
        'params': '--group=distributedpoller',
        'assert-retc': STATE_WARN,
        'assert-not-in': ['lnms config:set distributed_poller true'],
    },
    # Everything a default run reports is checked, including a group the check does not
    # know by name, so a group a later LibreNMS adds cannot fall out of the report.
    {
        'id': 'warn-unlisted-group-of-a-default-run-still-alerts',
        'test': 'stdout/default-run-unlisted-group,,1',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '1 failure found.',
            'Custom MIB directory is not writable',
        ],
    },
    # Naming a group restricts the report to it, whether the group is known or not.
    {
        'id': 'ok-unlisted-group-filtered-out',
        'test': 'stdout/default-run-unlisted-group,,1',
        'params': '--group=disk',
        'assert-retc': STATE_OK,
        'assert-not-in': ['Custom MIB directory is not writable'],
    },
    # The detail list of a result explains the finding and belongs to its message, not to
    # the fix column.
    {
        'id': 'warn-detail-list-joins-the-message',
        'test': 'stdout/database-unreachable-with-list,,1',
        'params': '--lengthy --brief',
        'assert-retc': STATE_WARN,
        'assert-regex': r'Unable to connect to database.*SQLSTATE\[HY000\]',
    },
    # A group whose progress output pushes its status onto a later line still parses.
    {
        'id': 'ok-progress-output-does-not-confuse-the-parser',
        'test': 'stdout/all-ok,,0',
        'params': '--group=rrdcheck',
        'assert-retc': STATE_OK,
        'assert-not-in': ['Scanning', 'Status:'],
    },
    # That status line is indented like the continuation of a message, and it arrives
    # after the last result of the group before it. It must not extend that result, and
    # the checks every run repeats before it reaches its group are one validation, not
    # one per run.
    {
        'id': 'ok-second-run-neither-duplicates-nor-extends-a-result',
        'test': 'stdout/all-ok,,0',
        'params': '--group=dependencies --group=rrdcheck',
        'assert-retc': STATE_OK,
        'assert-in': ['Checked 1 validation in 2 groups.'],
        'assert-not-in': ['required OK'],
    },
    # validate.php refuses to run as root. Its exit code is the same 1 a run that found a
    # problem returns, so only the output tells the two apart.
    {
        'id': 'unknown-refused-as-root',
        'test': 'stdout/run-as-root,,1',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['--user'],
    },
    # The other bootstrap failure: validate.php gives up before it can load anything,
    # which is not the same as an installation that validated cleanly.
    {
        'id': 'unknown-composer-missing',
        'test': 'stdout/composer-not-run,,1',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['composer_wrapper.php install --no-dev'],
    },
    # The configuration file aborts the validation the same way, and validate.php prints
    # the abort in the shape of an ordinary finding. Without that being recognised, an
    # installation that cannot start at all would arrive as a single failed validation.
    {
        'id': 'unknown-config-does-not-parse',
        'test': 'stdout/config-syntax-error,,1',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['php -l config.php'],
    },
    {
        'id': 'unknown-config-without-opening-tag',
        'test': 'stdout/config-missing-php-open-tag,,1',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['<?php'],
    },
    {
        'id': 'unknown-config-with-closing-tag',
        'test': 'stdout/config-trailing-php-close-tag,,1',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['?>'],
    },
    # This one aborts after the header and the dependency pre-check have already printed,
    # so the abort has to win over the two results standing above it.
    {
        'id': 'unknown-install-dir-not-configured',
        'test': 'stdout/install-dir-not-set,,1',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['install_dir'],
        'assert-not-in': ['Dependencies up-to-date.'],
    },
    # A run that printed nothing at all cannot be reported on, and an empty report is not
    # a clean one.
    {
        'id': 'unknown-no-validation-ran',
        'test': 'stdout/empty-output,,0',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['LibreNMS ran no validation at all.'],
    },
    # Running as a user that is neither root nor the LibreNMS user is a finding, not an
    # abort: LibreNMS reports it through its own `user` group.
    {
        'id': 'warn-wrong-user-is-a-finding',
        'test': 'stdout/run-as-wrong-user,,1',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ["You need to run this script as 'librenms' or root"],
    },
    # An unknown group leaves validate.php with nothing to do, and it exits 0 doing it.
    # A group that is legitimately absent on a host looks the same, which is why this
    # stays quiet unless --no-match-severity says otherwise.
    {
        'id': 'ok-no-group-matched',
        'test': 'stdout/unknown-group,,0',
        'params': '--group=database',
        'assert-retc': STATE_OK,
        'assert-in': ['Nothing checked.'],
    },
    {
        'id': 'unknown-no-group-matched-severity-raised',
        'test': 'stdout/unknown-group,,0',
        'params': '--group=database --no-match-severity=unknown',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Nothing checked.'],
    },
    # LibreNMS prints four statuses today and falls back to a placeholder for anything
    # else, so a status a later release adds arrives as a shape the check has never seen.
    # It has to reach the report rather than be dropped as an unparsable line.
    {
        'id': 'unknown-status-the-check-does-not-know',
        'test': 'stdout/unrecognised-status,,0',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Schema migration scheduled', 'Checked 2 validations'],
    },
    # The same status without the padding LibreNMS puts between it and the message. It
    # measures that padding before it colorizes the status, so a name of six characters or
    # more fills the column on its own and the message follows right behind it.
    {
        'id': 'unknown-status-without-padding',
        'test': 'stdout/unrecognised-status-unpadded,,0',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Schema migration scheduled', 'Checked 2 validations'],
    },
    # A value that would reach the command line as an option instead of as the path or
    # the account it is meant to be is refused before anything runs.
    {
        'id': 'unknown-path-looks-like-an-option',
        'test': 'stdout/all-ok,,0',
        'params': '--path=-x',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['--path'],
    },
    {
        'id': 'unknown-php-path-looks-like-an-option',
        'test': 'stdout/all-ok,,0',
        'params': '--php-path=-x',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['--php-path'],
    },
    {
        'id': 'unknown-user-looks-like-an-option',
        'test': 'stdout/all-ok,,0',
        'params': '--user=-x',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['--user'],
    },
    # A pattern that is not a valid regex is a parameter error, not a finding.
    {
        'id': 'unknown-invalid-ignore-regex',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--ignore-regex=[',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Unable to compile regex.'],
    },
    # Performance data covers every result, including the ones --brief hides.
    {
        'id': 'warn-perfdata-is-complete-under-brief',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--brief',
        'assert-retc': STATE_WARN,
        'assert-in': [
            "'fail_count'=1;;;0",
            "'ok_count'=16;;;0",
            "'validation_count'=17;;;0",
        ],
    },
    {
        'id': 'warn-no-perfdata-drops-the-metrics-only',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--no-perfdata',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 failure found.'],
        'assert-not-in': ['validation_count'],
    },
    {
        'id': 'ok-always-ok-masks-the-finding',
        'test': 'stdout/git-install-rrdcached-missing,,1',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['1 failure found.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../librenms-validate'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
