import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        'id': 'crit-controller-health-critical',
        'test': 'stdout/controller-health-critical,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            'UUID   ! Location ! Model              ! Role      ! Master ! CPU (%) '
            '! Mem (%) ! Volt ! Temp ! Health     ! Running',
            '-------+----------+--------------------+-----------+--------+---------+'
            '---------+------+------+------------+--------',
            # The board voltage reads as tenths of a volt, and a board without a
            # temperature sensor prints the appliance's own placeholder.
            '207:0A ! CTE0.A   ! Unknown            ! Primary   ! -      ! 3       '
            '! 75      ! 12.0 ! --   ! [CRITICAL] ! [OK]   ',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the inventory ones out.
        'id': 'crit-controller-health-critical-core-columns',
        'test': 'stdout/controller-health-critical,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'UUID   ! Location ! Master ! CPU (%) ! Mem (%) ! Temp ! Health     ! Running',
            '207:0A ! CTE0.A   ! -      ! 3       ! 75      ! --   ! [CRITICAL] ! [OK]   ',
        ],
        'assert-not-in': ['Volt'],
    },
    {
        # A controller board without a temperature sensor answers with -1. Read as a
        # reading it sits below the implicit lower bound of every Nagios range, so a
        # plain --critical-temperature=55 used to report CRITICAL on a healthy board.
        'id': 'ok-controller-without-temperature-sensor',
        'test': 'stdout/controller-without-temperature-sensor,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin '
        '--warning-temperature=45 --critical-temperature=55',
        'assert-retc': STATE_OK,
        'assert-not-in': ['_temperature='],
    },
    {
        # A firmware that reports only the mandatory fields used to end the check in a
        # traceback. The state still has to be reported, and the columns the appliance
        # said nothing about print as the placeholder it uses itself.
        'id': 'ok-controller-without-optional-fields',
        'test': 'stdout/controller-without-optional-fields,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin '
        '--lengthy',
        'assert-retc': STATE_OK,
        'assert-in': ['207:0E ! CTE0.E   ! Unknown ! Unknown ! -      ! --      ! --'],
        'assert-not-in': ['Unknown column'],
    },
    {
        # An appliance always has controllers. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-controllers',
        'test': 'stdout/no-controllers,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no controllers.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-controller'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
