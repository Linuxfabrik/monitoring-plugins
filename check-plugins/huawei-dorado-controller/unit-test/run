import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'crit-controller-health-critical',
        'test': 'stdout/controller-health-critical,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            'UUID   ! Location ! Model              ! Role      ! Master ! CPU (%) '
            '! Mem (%) ! Volt ! Health     ! Running',
            '-------+----------+--------------------+-----------+--------+---------+'
            '---------+------+------------+--------',
            # The board voltage reads as tenths of a volt. No board in this listing
            # has a temperature sensor, so that column is left out entirely.
            '207:0A ! CTE0.A   ! Unknown            ! Primary   ! -      ! 3       '
            '! 75      ! 12.0 ! Faulty (2) ! Online (27) ! [CRITICAL]',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the inventory ones out.
        'id': 'crit-controller-health-critical-core-columns',
        'test': 'stdout/controller-health-critical,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'UUID   ! Location ! Master ! CPU (%) ! Mem (%) ! Health     ! Running',
            '207:0A ! CTE0.A   ! -      ! 3       ! 75      ! Faulty (2) ! Online (27) ! [CRITICAL]',
        ],
        'assert-not-in': ['Volt'],
    },
    {
        # A controller board without a temperature sensor answers with -1. Read as a
        # reading it sits below the implicit lower bound of every Nagios range, so a
        # plain --critical-temperature=55 used to report CRITICAL on a healthy board.
        'id': 'ok-controller-without-temperature-sensor',
        'test': 'stdout/controller-without-temperature-sensor,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin '
        '--warning-temperature=45 --critical-temperature=55',
        'assert-retc': STATE_OK,
        'assert-not-in': ['_temperature='],
    },
    {
        # A firmware that reports only the mandatory fields used to end the check in a
        # traceback. The state still has to be reported, and the columns the appliance
        # said nothing about print as the placeholder it uses itself.
        'id': 'ok-controller-without-optional-fields',
        'test': 'stdout/controller-without-optional-fields,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin '
        '--lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            '207:0E ! CTE0.E   ! Unknown ! Unknown ! Normal (1) ! Online (27) ! [OK]'
        ],
        'assert-not-in': ['Unknown column'],
    },
    {
        # Real controllers (V700R001C10SPH128, Dorado 6000 V6) at 75 to 83% memory,
        # which is normal operation for them. The memory thresholds are off by
        # default, so this reads as healthy.
        'id': 'ok-controller-memory-usage-defaults',
        'test': 'stdout/controllers-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            '207:0B ! CTE0.B   ! -      ! 40      ! 83      ! Normal (1) '
            '! Online (27) ! [OK]',
        ],
    },
    {
        # `--warning` and `--critical` cover the CPU usage only. At 32 to 40% CPU
        # none of these boards crosses them, and the memory at 75 to 83% is no
        # longer compared against them.
        'id': 'ok-controller-cpu-thresholds-leave-memory-alone',
        'test': 'stdout/controllers-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --warning=70 --critical=80',
        'assert-retc': STATE_OK,
        'assert-regex': r"207_0B_memory_usage'=83%;;;0;100 ",
    },
    {
        'id': 'warn-controller-cpu-usage-marks-row',
        'test': 'stdout/controllers-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --warning=38',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '207:0A ! CTE0.A   ! x      ! 36           ! 78      ! Normal (1) '
            '! Online (27) ! [OK]',
            '207:0B ! CTE0.B   ! -      ! 40 [WARNING] ! 83      ! Normal (1) '
            '! Online (27) ! [WARNING]',
        ],
    },
    {
        # The memory threshold that fired has to show up on the value that crossed
        # it and in the row's State, not only in the overall state above a table of
        # [OK] rows. The performance data carries the memory thresholds.
        'id': 'warn-controller-memory-usage-marks-row',
        'test': 'stdout/controllers-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --warning-mem=80 --critical-mem=90',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings.',
            '207:0A ! CTE0.A   ! x      ! 36      ! 78           ! Normal (1) '
            '! Online (27) ! [OK]',
            '207:0B ! CTE0.B   ! -      ! 40      ! 83 [WARNING] ! Normal (1) '
            '! Online (27) ! [WARNING]',
        ],
        'assert-regex': r"207_0B_memory_usage'=83%;80;90;0;100 ",
    },
    {
        'id': 'crit-controller-memory-usage-marks-row',
        'test': 'stdout/controllers-v700,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --critical-mem=80 --lengthy',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            '207:0B ! CTE0.B   ! 2U2C PALM control board ! Secondary ! -      ! 40      '
            '! 83 [CRITICAL] ! 12.0 ! Normal (1) ! Online (27) ! [CRITICAL]',
        ],
    },
    {
        # The same listing with one board given a temperature reading of 48 C (the
        # real boards report -1, no sensor).
        'id': 'warn-controller-temperature-marks-row',
        'test': 'stdout/controllers-v700-one-temperature-sensor,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --warning-temperature=45',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '207:0A ! CTE0.A   ! x      ! 36      ! 78      ! --           '
            '! Normal (1) ! Online (27) ! [OK]',
            '207:1B ! CTE1.B   ! -      ! 36      ! 80      ! 48 [WARNING] '
            '! Normal (1) ! Online (27) ! [WARNING]',
        ],
    },
    {
        # The performance data carries what can be trended and alerted on per board,
        # never a status code: the state already reports those.
        'id': 'ok-controller-perfdata-without-status-codes',
        'test': 'stdout/controllers-v700-one-temperature-sensor,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            "'207_1B_cpu_usage'=36%;;;0;100 ",
            "'207_1B_memory_usage'=80%;;;0;100 ",
            "'207_1B_temperature'=48;;;0 ",
            "'207_1B_voltage'=12.0;;;0",
        ],
        'assert-not-in': [
            '_dirty_data_rate',
            '_health_status',
            '_light_status',
            '_running_status',
        ],
    },
    {
        # An appliance always has controllers. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-controllers',
        'test': 'stdout/no-controllers,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no controllers.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-controller'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
