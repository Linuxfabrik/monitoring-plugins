import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_UNKNOWN

TESTS = [
    {
        'id': 'crit-controller-health-critical',
        'test': 'stdout/controller-health-critical,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            'UUID   ! Location ! Model              ! Role      ! Master ! CPU (%) '
            '! Mem (%) ! Volt ! Health     ! Running',
            '-------+----------+--------------------+-----------+--------+---------+'
            '---------+------+------------+--------',
            '207:0A ! CTE0.A   ! Unknown            ! Primary   ! -      ! 3       '
            '! 75      ! 120  ! [CRITICAL] ! [OK]   ',
        ],
    },
    {
        # An appliance always has controllers. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-controllers',
        'test': 'stdout/no-controllers,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no controllers.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-controller'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
