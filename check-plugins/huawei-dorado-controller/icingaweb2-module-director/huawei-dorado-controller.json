    "Datafield": {
        "1": {
            "varname": "huawei_dorado_controller_always_ok",
            "caption": "Huawei Dorado Controller: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "44f888bb-e416-4d0c-9ea7-ba8e7bd48edd"
        },
        "2": {
            "varname": "huawei_dorado_controller_cache_expire",
            "caption": "Huawei Dorado Controller: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "cfd07836-a460-4f17-a8e7-48ef941dacf0"
        },
        "3": {
            "varname": "huawei_dorado_controller_critical",
            "caption": "Huawei Dorado Controller: Critical",
            "description": "CRIT threshold for CPU and memory usage, as a Nagios range in percent. Off by default, because a controller under load is doing its job; set it once you know what your array normally sits at. Example: `--critical=90`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "dbde77d8-e0bc-472c-9f81-83e286a640a7"
        },
        "4": {
            "varname": "huawei_dorado_controller_critical_temperature",
            "caption": "Huawei Dorado Controller: Critical Temperature",
            "description": "CRIT threshold in degrees Celsius. Off by default, because a healthy operating temperature depends on the controller model and on where the array stands. Example: `--critical-temperature=55`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "82911e5d-6771-40d6-823e-12897ad97442"
        },
        "5": {
            "varname": "huawei_dorado_controller_device_id",
            "caption": "Huawei Dorado Controller: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2c0a38c7-7571-4d6b-8e50-cd79eaa90069"
        },
        "6": {
            "varname": "huawei_dorado_controller_ignore",
            "caption": "Huawei Dorado Controller: Ignore",
            "description": "Skip controllers. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a8efd221-7eb6-4b78-8eb9-338d6bc8d7e9"
        },
        "7": {
            "varname": "huawei_dorado_controller_insecure",
            "caption": "Huawei Dorado Controller: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "05439d02-6158-453e-bcde-4c4d479efa08"
        },
        "8": {
            "varname": "huawei_dorado_controller_lengthy",
            "caption": "Huawei Dorado Controller: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "33723556-29aa-4cd4-9228-9d366e9ac279"
        },
        "9": {
            "varname": "huawei_dorado_controller_match",
            "caption": "Huawei Dorado Controller: Match",
            "description": "Limit to controllers. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0ed2a991-b61c-420c-9ff4-4d8d97a41d64"
        },
        "10": {
            "varname": "huawei_dorado_controller_no_insecure",
            "caption": "Huawei Dorado Controller: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3727f6b2-4e3b-4800-8aad-efcfad73a50b"
        },
        "11": {
            "varname": "huawei_dorado_controller_no_match_severity",
            "caption": "Huawei Dorado Controller: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_controller_no_match_severity_list"
            },
            "uuid": "b4b3c9a3-6edc-41d3-a2e0-80f6fe505ac2"
        },
        "12": {
            "varname": "huawei_dorado_controller_no_perfdata",
            "caption": "Huawei Dorado Controller: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "068bab9b-f4b2-499a-85e9-447a88178d26"
        },
        "13": {
            "varname": "huawei_dorado_controller_no_proxy",
            "caption": "Huawei Dorado Controller: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "81be51d1-4f06-4858-8965-694cd5f424d7"
        },
        "14": {
            "varname": "huawei_dorado_controller_password",
            "caption": "Huawei Dorado Controller: Password",
            "description": "Huawei OceanStor Dorado API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "aa19a792-1fdb-4d35-adf3-9d68622567af"
        },
        "15": {
            "varname": "huawei_dorado_controller_password_file",
            "caption": "Huawei Dorado Controller: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "1d926adb-cd4e-4457-b8b0-c1f0c14d2f0f"
        },
        "16": {
            "varname": "huawei_dorado_controller_performance",
            "caption": "Huawei Dorado Controller: Performance?",
            "description": "Additionally report the I/O counters of every controller. Costs one API request per object, so a large appliance may need a higher --timeout.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5b2654ea-fed5-43d4-ade6-4debfd64b905"
        },
        "17": {
            "varname": "huawei_dorado_controller_proxy",
            "caption": "Huawei Dorado Controller: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c5a2465a-bec8-4d20-9ad3-20674b42c383"
        },
        "18": {
            "varname": "huawei_dorado_controller_scope",
            "caption": "Huawei Dorado Controller: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4cef57e0-d4b1-4cea-8154-47ac75270ad9"
        },
        "19": {
            "varname": "huawei_dorado_controller_timeout",
            "caption": "Huawei Dorado Controller: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "db35fea6-a368-4870-ad39-1095a61382db"
        },
        "20": {
            "varname": "huawei_dorado_controller_url",
            "caption": "Huawei Dorado Controller: URL",
            "description": "Huawei OceanStor Dorado API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c8f2bb6e-7065-4423-b6b8-df8c94b7e0dc"
        },
        "21": {
            "varname": "huawei_dorado_controller_username",
            "caption": "Huawei Dorado Controller: Username",
            "description": "Huawei OceanStor Dorado API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8a2f9d9d-e405-4f53-a6b5-33e81573eebe"
        },
        "22": {
            "varname": "huawei_dorado_controller_verbose",
            "caption": "Huawei Dorado Controller: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "80a4f249-565d-4aae-acb8-59e6c5fe46f9"
        },
        "23": {
            "varname": "huawei_dorado_controller_warning",
            "caption": "Huawei Dorado Controller: Warning",
            "description": "WARN threshold for CPU and memory usage, as a Nagios range in percent. Off by default, because a controller under load is doing its job; set it once you know what your array normally sits at. Example: `--warning=80`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "eecfb901-aefb-47bd-b9d6-470a9b15fafd"
        },
        "24": {
            "varname": "huawei_dorado_controller_warning_temperature",
            "caption": "Huawei Dorado Controller: Warning Temperature",
            "description": "WARN threshold in degrees Celsius. Off by default, because a healthy operating temperature depends on the controller model and on where the array stands. Example: `--warning-temperature=45`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
