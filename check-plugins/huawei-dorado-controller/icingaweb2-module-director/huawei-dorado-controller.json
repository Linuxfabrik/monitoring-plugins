        "5": {
            "varname": "huawei_dorado_controller_device_id",
            "caption": "Huawei Dorado Controller: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2c0a38c7-7571-4d6b-8e50-cd79eaa90069"
        },
        "6": {
            "varname": "huawei_dorado_controller_ignore",
            "caption": "Huawei Dorado Controller: Ignore",
            "description": "Skip controllers. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a8efd221-7eb6-4b78-8eb9-338d6bc8d7e9"
        },
        "7": {
            "varname": "huawei_dorado_controller_insecure",
            "caption": "Huawei Dorado Controller: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "05439d02-6158-453e-bcde-4c4d479efa08"
        },
        "8": {
            "varname": "huawei_dorado_controller_no_insecure",
            "caption": "Huawei Dorado Controller: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3727f6b2-4e3b-4800-8aad-efcfad73a50b"
        },
        "9": {
            "varname": "huawei_dorado_controller_match",
            "caption": "Huawei Dorado Controller: Match",
            "description": "Filter by controllers. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0ed2a991-b61c-420c-9ff4-4d8d97a41d64"
        },
        "10": {
            "varname": "huawei_dorado_controller_no_match_severity",
            "caption": "Huawei Dorado Controller: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_controller_no_match_severity_list"
            },
            "uuid": "b4b3c9a3-6edc-41d3-a2e0-80f6fe505ac2"
        },
        "11": {
            "varname": "huawei_dorado_controller_no_perfdata",
            "caption": "Huawei Dorado Controller: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "068bab9b-f4b2-499a-85e9-447a88178d26"
        },
        "12": {
