            "max_check_attempts": 5,
            "notes": "Checks the health and running status of all controllers on a Huawei OceanStor Dorado storage system via the REST API (/controller endpoint). Alerts when any controller reports a non-normal health or running state, and optionally when its CPU, memory or temperature exceeds the configured thresholds. Supports extended reporting via --lengthy, and reporting the I/O and cache counters via --performance.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/huawei-dorado-controller/",
            "object_name": "tpl-service-huawei-dorado-controller",
            "object_type": "template",
            "retry_interval": 30,
            "service_set": null,
            "template_choice": null,
            "use_agent": false,
            "use_var_overrides": null,
            "vars": {
                "criticality": "A",
                "huawei_dorado_controller_always_ok": false,
                "huawei_dorado_controller_cache_expire": 15,
                "huawei_dorado_controller_critical": "",
                "huawei_dorado_controller_critical_temperature": "",
                "huawei_dorado_controller_device_id": "",
                "huawei_dorado_controller_ignore": [],
                "huawei_dorado_controller_insecure": true,
                "huawei_dorado_controller_lengthy": false,
                "huawei_dorado_controller_match": [],
                "huawei_dorado_controller_no_match_severity": "ok",
                "huawei_dorado_controller_no_perfdata": false,
                "huawei_dorado_controller_no_proxy": false,
                "huawei_dorado_controller_performance": false,
                "huawei_dorado_controller_scope": "0",
                "huawei_dorado_controller_timeout": 3,
