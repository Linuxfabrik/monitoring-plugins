            "caption": "Nfs Mounts: Error Severity",
            "description": "State to report for a mount that answers with an error other than a stale file handle, for example the I/O error a `soft` mount reports once it has given up on its server.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "nfs_mounts_error_severity_list"
