class TestCheck(unittest.TestCase):
    pass


def _run(params):
    result = subprocess.run(
        [PLUGIN, *params],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode, result.stdout + result.stderr


def _check_case(test, case):
    returncode, combined = _run(case['params'])
    test.assertEqual(
        returncode,
        case['assert-retc'],
        f'expected retc {case["assert-retc"]}, got {returncode}.\nOutput: {combined}',
    )
    for needle in case.get('assert-in', []):
        test.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
    for needle in case.get('assert-not-in', []):
        test.assertNotIn(
            needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
        )


lib.lftest.attach_each(TestCheck, CASES, _check_case, id_func=lambda it: it['id'])


class TestArrivalRate(unittest.TestCase):
    """A burst of denied requests alerts, the same burst an hour ago does not.

    The log is written here rather than taken from `fixtures/`, because a
    timestamp stored in the repository sits inside the rate window on the day it
    was captured and outside it on every day after. It goes below `unit-test/`,
    which is where the plugin allows itself to read outside /var/log.
    """

    def setUp(self):
        self.scratch_dir = tempfile.mkdtemp(prefix='burst-', dir=HERE)

    def tearDown(self):
        shutil.rmtree(self.scratch_dir, ignore_errors=True)

    def _write_denials(self, count, minutes_ago, peers=1):
        """Write `count` denied requests, spread evenly over `peers` clients."""
        path = os.path.join(self.scratch_dir, 'error_log')
        first = datetime.datetime.now() - datetime.timedelta(minutes=minutes_ago)
        with open(path, 'w', encoding='utf-8') as handle:
            for index in range(count):
                logged_at = first + datetime.timedelta(seconds=index)
                handle.write(
                    DENIAL_LINE.format(
                        timestamp=logged_at.strftime(APACHE_TIMESTAMP_FORMAT),
                        peer=f'198.51.100.{7 + index % peers}',
                    )
                    + '\n'
                )
        return path

    def test_burst_within_the_window_warns(self):
        path = self._write_denials(count=20, minutes_ago=5)
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn('20 client denials from 198.51.100.7 in the last 10m', combined)
        self.assertIn('walking the site', combined)

    def test_burst_within_the_window_crits_above_the_threshold(self):
        path = self._write_denials(count=20, minutes_ago=5)
        returncode, combined = _run(
            [f'--server-log={path}', '--client-denials-critical=10']
        )
        self.assertEqual(returncode, STATE_CRIT, combined)

    def test_the_same_burst_spread_over_many_clients_is_quiet(self):
        # Twenty denials, but no client got past two of them. That is the open
        # network going past, and what an intrusion prevention system answers
        # long before this check would have anything to say.
        path = self._write_denials(count=20, minutes_ago=5, peers=10)
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_OK, combined)
        self.assertIn('2 client denials from 198.51.100.', combined)
        self.assertIn('(20 in total from 10 addresses)', combined)

    def test_the_total_is_what_no_per_source_judges(self):
        path = self._write_denials(count=20, minutes_ago=5, peers=10)
        returncode, combined = _run([f'--server-log={path}', '--no-per-source'])
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn('20 client denials in the last 10m', combined)

    def test_the_same_burst_an_hour_ago_is_quiet(self):
        path = self._write_denials(count=20, minutes_ago=60)
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_OK, combined)
        self.assertIn('0 client denials in the last 10m', combined)
        self.assertIn('(20 in the window read)', combined)

    def test_a_wider_window_sees_the_older_burst(self):
        path = self._write_denials(count=20, minutes_ago=60)
        returncode, combined = _run([f'--server-log={path}', '--lookback=7200'])
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn('20 client denials from 198.51.100.7 in the last 2h', combined)


class TestConfigParsing(unittest.TestCase):
    """The configuration reader, against the trees the distributions install."""

    def test_redhat_resolves_against_serverroot(self):
        # The server's log first, then the one its TLS virtual host writes.
        root = config_root('rhel')
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(root),
            (
                f'{root}/etc/httpd/logs/error_log',
                [f'{root}/etc/httpd/logs/ssl_error_log'],
            ),
        )

    def test_serverroot_still_applies_inside_an_included_file(self):
        # `ErrorLog logs/...` in a drop-in file means the server's log directory,
        # not one below the drop-in directory: ServerRoot is what it resolves
        # against, wherever the directive that uses it stands.
        root = config_root('rhel-vhosts')
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(root),
            (
                f'{root}/etc/httpd/logs/error_log',
                [f'{root}/etc/httpd/logs/www.example.com-error.log'],
            ),
        )

    def test_debian_follows_the_symlink_a_site_is_enabled_with(self):
        # sites-enabled holds symlinks into sites-available, and the log
        # directory is a variable rather than a path.
        root = config_root('debian-vhosts')
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(root),
            (
                f'{root}/var/log/apache2/error.log',
                [f'{root}/var/log/apache2/www.example.com-error.log'],
            ),
        )

    def test_debian_resolves_the_envvars_variable(self):
        root = config_root('debian')
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(root),
            (f'{root}/var/log/apache2/error.log', []),
        )

    def test_an_unset_shell_variable_expands_to_nothing(self):
        # `$SUFFIX` is a plain shell variable the envvars file sets in a
        # conditional this check does not evaluate, and it is empty on an
        # ordinary host.
        env = apache_httpd_logfile.get_env_vars(config_root('debian'))
        self.assertEqual(env['APACHE_LOG_DIR'], '/var/log/apache2')

    def test_a_virtual_host_errorlog_is_not_the_server_log(self):
        # Without an ErrorLog outside the virtual hosts there is no server log,
        # and a host's own is never read instead of it: the caller probes for the
        # path Apache was compiled with and reads the site's log next to it.
        root = config_root('vhost-only')
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(root),
            (None, [f'{root}/etc/httpd/logs/ssl_error_log']),
        )

    def test_a_site_is_still_read_where_the_server_logs_to_syslog(self):
        # The marker for the server's own log, and the sites next to it: the one
        # is not a reason to drop the other.
        root = config_root('syslog-vhosts')
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(root),
            (
                apache_httpd_logfile.SYSLOG_TARGET,
                [f'{root}/etc/httpd/logs/www.example.com-error.log'],
            ),
        )

    def test_syslog_and_a_pipe_are_reported_rather_than_opened(self):
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(config_root('syslog')),
            (apache_httpd_logfile.SYSLOG_TARGET, []),
        )
        self.assertEqual(
            apache_httpd_logfile.get_configured_log_files(config_root('piped')),
            (apache_httpd_logfile.PIPE_TARGET, []),
        )

    def test_a_commented_out_directive_does_not_count(self):
        found = apache_httpd_logfile.parse_config(
            '# ErrorLog "logs/commented_out"\nErrorLog "logs/error_log"\n'
        )
        self.assertEqual(found, [('errorlog', 'logs/error_log', False)])

    def test_the_directives_come_back_in_the_order_the_file_states_them(self):
        # In document order, and each with whether it stood inside a virtual
        # host, because the caller resolves an include where it stands and keeps
        # the last value the way Apache does.
        found = apache_httpd_logfile.parse_config(
            'ServerRoot "/etc/httpd"\n'
            'ErrorLog "logs/error_log"\n'
            'IncludeOptional conf.d/*.conf\n'
            '<VirtualHost _default_:443>\n'
            '    ErrorLog logs/ssl_error_log\n'
            '</VirtualHost>\n'
            'ErrorLog "logs/later_wins"\n'
        )
        self.assertEqual(
            found,
            [
                ('serverroot', '/etc/httpd', False),
                ('errorlog', 'logs/error_log', False),
                ('includeoptional', 'conf.d/*.conf', False),
                ('errorlog', 'logs/ssl_error_log', True),
                ('errorlog', 'logs/later_wins', False),
            ],
        )

    def test_a_variable_nothing_defines_gives_up(self):
        self.assertIsNone(apache_httpd_logfile.expand('${NOWHERE}/error.log', {}))


class TestLineReading(unittest.TestCase):
    """The two things every line is measured against: its level and its time."""

    def test_the_level_is_found_wherever_the_format_puts_it(self):
        for line, level in (
            (
                '[Fri Aug 28 17:11:44.101220 2026] [core:notice] [pid 1] AH1: x',
                'notice',
            ),
            ('[core:error] [pid 1] AH1: x', 'error'),
            # Apache writes no module name where the message reached it without
            # one, which is what the standard error of a CGI script and what
            # `mod_security` logs both look like.
            ('[Fri Aug 28 17:11:44.101220 2026] [:error] [pid 3790] x', 'error'),
            # journalctl prefixes every line with its own timestamp and the unit
            ('2026-08-28T17:16:18+0000 host httpd[20]: [ssl:warn] AH1: x', 'warn'),
            # `ErrorLogFormat` without `%m` leaves the module out
            ('[Fri Aug 28 17:11:44.101220 2026] [emerg] [pid 1] AH1: x', 'emerg'),
        ):
            match = apache_httpd_logfile.LEVEL_REGEX.search(line)
            self.assertIsNotNone(match, line)
            self.assertEqual(match.group(1), level, line)

    def test_the_transport_timestamp_is_read_where_apache_wrote_none(self):
        # A server logging through syslog leaves its own timestamp out, so what
        # is left is journalctl's. Reading that one is the library's job; this
        # only makes sure the check asks it to.
        line = (
            '2026-08-28T17:16:18+0200 host httpd[20]: [ssl:error] [pid 20]'
            ' AH02032: Hostname a provided via SNI'
        )
        self.assertIsNone(apache_httpd_logfile.parse_timestamp(line))
        # Compared against the same moment converted to whatever the local clock
        # is, so the test says the same thing in every timezone.
        expected = (
            datetime.datetime(
                2026,
                8,
                28,
                17,
                16,
                18,
                tzinfo=datetime.timezone(datetime.timedelta(hours=2)),
            )
            .astimezone()
            .replace(tzinfo=None)
        )
        self.assertEqual(
            lib.logsource.timestamp(
                line, parse_line=apache_httpd_logfile.parse_timestamp
            ),
            expected,
        )

    def test_a_startup_line_carries_neither_level_nor_timestamp(self):
        line = (
            "AH00558: httpd: Could not reliably determine the server's fully"
            ' qualified domain name'
        )
        self.assertIsNone(apache_httpd_logfile.LEVEL_REGEX.search(line))
        self.assertIsNone(apache_httpd_logfile.parse_timestamp(line))
        self.assertIsNotNone(apache_httpd_logfile.CODE_REGEX.search(line))

    def test_the_timestamp_is_read_with_and_without_a_padded_day(self):
        self.assertEqual(
            apache_httpd_logfile.parse_timestamp(
                '[Fri Aug 28 17:11:44.101220 2026] [core:notice] AH1: x'
            ),
            datetime.datetime(2026, 8, 28, 17, 11, 44),
        )
        self.assertEqual(
            apache_httpd_logfile.parse_timestamp(
                '[Sat Aug  8 07:01:02.000001 2026] [core:notice] AH1: x'
            ),
            datetime.datetime(2026, 8, 8, 7, 1, 2),
        )

    def test_levels_map_to_the_states_the_parameters_ask_for(self):
        states = apache_httpd_logfile.get_level_states('crit', 'error')
        self.assertEqual(states['emerg'], STATE_CRIT)
        self.assertEqual(states['crit'], STATE_CRIT)
        self.assertEqual(states['error'], STATE_WARN)
        self.assertEqual(states['warn'], STATE_OK)
        states = apache_httpd_logfile.get_level_states('none', 'none')
        self.assertEqual(set(states.values()), {STATE_OK})


class TestSourceAddress(unittest.TestCase):
    """Which client a request-scoped line is counted under."""

    def test_the_port_comes_off_and_the_address_does_not(self):
        for field, expected in (
            ('198.51.100.7:58204', '198.51.100.7'),
            # An IPv6 address has a colon between every group, so cutting at the
            # last one unasked would turn one client into two.
            ('2001:db8::80da:af6b:8b2c', '2001:db8::80da:af6b:8b2c'),
            ('[2001:db8::80da:af6b:8b2c]:51548', '2001:db8::80da:af6b:8b2c'),
            ('::ffff:198.51.100.7:58204', '198.51.100.7'),
        ):
            line = (
                f'[Fri Aug 28 17:11:44.101220 2026] [authz_core:error]'
                f' [pid 2338:tid 2392] [client {field}] AH01630: client denied'
            )
            self.assertEqual(apache_httpd_logfile.get_source(line), expected, field)

    def test_a_line_about_the_server_has_no_client(self):
        line = (
            '[Fri Aug 28 17:11:47.108528 2026] [mpm_event:error] [pid 1835]'
            ' AH00484: server reached MaxRequestWorkers setting'
        )
        self.assertIsNone(apache_httpd_logfile.get_source(line))


class TestPathConfinement(unittest.TestCase):
    """A `--server-log` that resolves outside /var/log (here a scratch file in
    the temp directory) is refused, so a plugin running under sudo cannot be
    turned into an arbitrary file read (GHSA-f54c-p5vg-mr5c)."""

    def setUp(self):
        self.scratch_dir = tempfile.mkdtemp(prefix='apache-httpd-logfile-confine-')
        self.scratch_file = os.path.join(self.scratch_dir, 'error_log')
        with open(self.scratch_file, 'w', encoding='utf-8') as handle:
            handle.write(
                '[Fri Aug 28 17:11:44.101220 2026] [core:notice] [pid 1:tid 1]'
                ' AH00094: secret\n'
            )

    def tearDown(self):
        shutil.rmtree(self.scratch_dir, ignore_errors=True)

    def test_server_log_outside_allowed_roots_is_refused(self):
        returncode, combined = _run([f'--server-log={self.scratch_file}'])
        self.assertEqual(returncode, STATE_UNKNOWN, combined)
        self.assertIn('Refusing to read', combined)
        self.assertNotIn('secret', combined)


if __name__ == '__main__':
    unittest.main()
