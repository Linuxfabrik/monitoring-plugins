"""Unit tests for the apache-httpd-logfile check plugin.

Every fixture under `fixtures/` was written by a real Apache (2.4.62 on Rocky 9,
2.4.37 on Rocky 8 and 2.4.68 on Debian 12, driven into the situation the file is
named after), and the trees under `config/` mirror what the RHEL and the Debian
family install, down to the `logs` symlink of the former and the envvars file of
the latter. That keeps the tests honest about the log format instead of
confirming the plugin's own reading of it.

The two tests about arrival rates write their own log, because a fixture with a
fixed timestamp would be inside the rate window on the day it was taken and
outside it forever after.

Reading a systemd unit or a container log is left to the library and is not
covered here; the journal fixture is a file holding what `journalctl` printed.
"""

import datetime
import importlib.machinery
import importlib.util
import os
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.lftest
import lib.logsource
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN = os.path.join(HERE, '..', 'apache-httpd-logfile')


def _load_plugin_module():
    """Import the hyphen-named plugin as a Python module for direct function
    unit tests."""
    loader = importlib.machinery.SourceFileLoader('apache_httpd_logfile', PLUGIN)
    spec = importlib.util.spec_from_loader('apache_httpd_logfile', loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


apache_httpd_logfile = _load_plugin_module()


def fixture(name):
    return os.path.join(HERE, 'fixtures', name)


def config_root(name):
    return os.path.join(HERE, 'config', name)


# One denial as Apache writes it, with the timestamp left open so a test can
# place the line inside or outside the rate window.
DENIAL_LINE = (
    '[{timestamp}] [authz_core:error] [pid 2338:tid 2392]'
    ' [client {peer}:58204] AH01630: client denied by server'
    ' configuration: /var/www/html/.htaccess'
)
APACHE_TIMESTAMP_FORMAT = '%a %b %d %H:%M:%S.%f %Y'


