    '[{timestamp}] [authz_core:error] [pid 2338:tid 2392]'
    ' [client 198.51.100.7:58204] AH01630: client denied by server'
    ' configuration: /var/www/html/.htaccess'
)
APACHE_TIMESTAMP_FORMAT = '%a %b %d %H:%M:%S.%f %Y'


