    "ServiceTemplate": {
        "tpl-service-apache-httpd-logfile": {
            "action_url": null,
            "apply_for": null,
            "assign_filter": null,
            "check_command": "cmd-check-apache-httpd-logfile",
            "check_interval": 300,
