                "apache_httpd_logfile_icinga_callback": false,
                "apache_httpd_logfile_ignore": [],
                "apache_httpd_logfile_insecure": true,
                "apache_httpd_logfile_lookback": 600,
                "apache_httpd_logfile_match": [],
                "apache_httpd_logfile_no_match_severity": "ok",
                "apache_httpd_logfile_no_perfdata": false,
                "apache_httpd_logfile_no_proxy": false,
                "apache_httpd_logfile_per_source": true,
                "apache_httpd_logfile_proxy_failures_critical": 100,
                "apache_httpd_logfile_proxy_failures_warning": 10,
                "apache_httpd_logfile_request_errors_critical": 60,
                "apache_httpd_logfile_request_errors_warning": 6,
                "apache_httpd_logfile_server_log": [],
                "apache_httpd_logfile_timeout": 8,
                "apache_httpd_logfile_warning_level": "error"
            },
            "volatile": null,
            "zone": null,
            "uuid": "66ca7abe-acd8-468b-b039-9033813da4ee"
        }
