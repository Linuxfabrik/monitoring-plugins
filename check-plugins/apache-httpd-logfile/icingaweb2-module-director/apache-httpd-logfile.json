            "caption": "Apache httpd Logfile: Client Denials Critical",
            "description": "Number of denied requests within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--client-denials-critical=200`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
