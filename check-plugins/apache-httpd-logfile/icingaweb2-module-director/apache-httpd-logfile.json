            "varname": "apache_httpd_logfile_auth_failures_critical",
            "caption": "Apache httpd Logfile: Auth Failures Critical",
            "description": "Number of authentication failures within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--auth-failures-critical=200`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
