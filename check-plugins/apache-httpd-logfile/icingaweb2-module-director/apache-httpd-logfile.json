        "5": {
            "varname": "apache_httpd_logfile_client_denials_warning",
            "caption": "Apache httpd Logfile: Client Denials Warning",
            "description": "Number of denied requests within `--lookback` that returns WARNING. 0 turns the threshold off. Example: `--client-denials-warning=50`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fa2d45df-2d4e-4b6d-a624-7f3480ae32e0"
        },
        "6": {
            "varname": "apache_httpd_logfile_critical_level",
            "caption": "Apache httpd Logfile: Critical Level",
            "description": "Least severe Apache log level that returns CRITICAL. Each level includes everything more severe than itself, so `error` covers `crit`, `alert` and `emerg` as well. Case-sensitive. `none` lets no level return CRITICAL, which leaves the events this check names as the only way to reach it. Example: `--critical-level=error`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "apache_httpd_logfile_critical_level_list"
            },
            "uuid": "4e90b78e-ff90-4205-afc0-3c45bf77b584"
        },
        "7": {
            "varname": "apache_httpd_logfile_icinga_callback",
            "caption": "Apache httpd Logfile: Icinga Callback?",
            "description": "Ask the monitoring server whether the service running this check is acknowledged. Where it is, what this run reports is remembered as already handled, so it no longer raises an alert on the following runs. Requires `--icinga-url`, `--icinga-username`, `--icinga-password` and `--icinga-service-name`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "71703e18-c787-489c-bb82-d391d1953986"
        },
        "8": {
            "varname": "apache_httpd_logfile_icinga_password",
            "caption": "Apache httpd Logfile: Icinga Password",
            "description": "Monitoring server API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "ee466d54-215f-4c5e-8729-f57f0dc365ff"
        },
