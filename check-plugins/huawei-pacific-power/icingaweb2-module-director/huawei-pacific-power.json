    "Datafield": {
        "1": {
            "varname": "huawei_pacific_power_always_ok",
            "caption": "Huawei Pacific Power: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ba00bacb-8bb7-4e2e-b680-1b0806de5343"
        },
        "2": {
            "varname": "huawei_pacific_power_cache_expire",
            "caption": "Huawei Pacific Power: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "794ce7c5-bc70-4dd8-912e-a3db73cf30ed"
        },
        "3": {
            "varname": "huawei_pacific_power_ignore",
            "caption": "Huawei Pacific Power: Ignore",
            "description": "Skip power supplies. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `frame_sn`, `name`, `node`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e263c0c8-4d1b-4d36-9136-29f5030c45f6"
        },
        "4": {
            "varname": "huawei_pacific_power_insecure",
            "caption": "Huawei Pacific Power: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1a168409-22da-4b64-a07e-e19787a03ac7"
        },
        "5": {
            "varname": "huawei_pacific_power_lengthy",
            "caption": "Huawei Pacific Power: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7c5d922f-2d1c-4792-89ff-06b255d65d8c"
        },
        "6": {
            "varname": "huawei_pacific_power_match",
            "caption": "Huawei Pacific Power: Match",
            "description": "Limit to power supplies. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `frame_sn`, `name`, `node`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1caccbbb-342f-48d9-8c83-0c0ce5a7ee89"
        },
        "7": {
            "varname": "huawei_pacific_power_no_insecure",
            "caption": "Huawei Pacific Power: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "bfe952ab-4bc9-43ea-bca2-0a88651fff25"
        },
        "8": {
            "varname": "huawei_pacific_power_no_match_severity",
            "caption": "Huawei Pacific Power: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_power_no_match_severity_list"
            },
            "uuid": "63cffee8-6f48-44a3-ac68-076f4a28b21f"
        },
        "9": {
            "varname": "huawei_pacific_power_no_perfdata",
            "caption": "Huawei Pacific Power: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "044728f3-8eaa-4cdd-a015-4f6f479ca887"
        },
        "10": {
            "varname": "huawei_pacific_power_no_proxy",
            "caption": "Huawei Pacific Power: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "18f6beb1-3877-4951-ad0c-d445912cd156"
        },
        "11": {
            "varname": "huawei_pacific_power_password",
            "caption": "Huawei Pacific Power: Password",
            "description": "Huawei OceanStor Pacific API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "de82e5c6-d317-4d2f-a042-94bd472dbe3a"
        },
        "12": {
            "varname": "huawei_pacific_power_password_file",
            "caption": "Huawei Pacific Power: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "a733f8d8-f8d9-4fab-87de-1ada06cd01eb"
        },
        "13": {
            "varname": "huawei_pacific_power_proxy",
            "caption": "Huawei Pacific Power: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2547513d-1815-469d-8d06-6e85b4b7c3bb"
        },
        "14": {
            "varname": "huawei_pacific_power_scope",
            "caption": "Huawei Pacific Power: Scope",
            "description": "Huawei OceanStor Pacific API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "826c2481-a765-4d4d-8e6c-9d99987dbfc7"
        },
        "15": {
            "varname": "huawei_pacific_power_timeout",
            "caption": "Huawei Pacific Power: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "251d465e-757a-4d40-9db0-6ea7a29bb9dc"
        },
        "16": {
            "varname": "huawei_pacific_power_url",
            "caption": "Huawei Pacific Power: URL",
            "description": "Huawei OceanStor Pacific API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "50c6462e-3b0b-4733-b0ca-bcdc3295c55c"
        },
        "17": {
            "varname": "huawei_pacific_power_username",
            "caption": "Huawei Pacific Power: Username",
            "description": "Huawei OceanStor Pacific API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d8811e96-6ff7-4faf-be14-66992a21b511"
        },
        "18": {
            "varname": "huawei_pacific_power_verbose",
            "caption": "Huawei Pacific Power: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "90540127-c1d2-46a8-a01e-fd7cbe41120c"
        }
