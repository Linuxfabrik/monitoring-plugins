import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        'id': 'ok-power-supplies-healthy',
        'test': 'stdout/power-supplies-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.', 'PSU0', 'normal'],
    },
    {
        # A faulty power supply has stopped doing its job, so it has to reach
        # CRITICAL.
        'id': 'crit-power-supply-faulty',
        'test': 'stdout/power-supplies-one-faulty,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'fault.*\[CRITICAL\]',
    },
    {
        # An appliance always has power supplies. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-power-supplies',
        'test': 'stdout/no-power-supplies,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no power supplies.'],
    },
    {
        # Every chassis of a cluster numbers its power supplies from zero, so "PSU0"
        # says nothing on its own. The node name identifies the chassis for the
        # operator who has to walk up to it; `--lengthy` adds the chassis serial.
        'id': 'crit-node-name-instead-of-chassis-serial',
        'test': 'stdout/power-supplies-multi-chassis,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': ['Node   ! Name ! Status ! State', 'node02 ! PSU1 ! fault'],
        'assert-not-in': ['Chassis SN           !'],
    },
    {
        'id': 'crit-lengthy-adds-the-chassis-serial',
        'test': 'stdout/power-supplies-multi-chassis,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --lengthy',
        'assert-retc': STATE_CRIT,
        'assert-in': ['Node   ! Chassis SN           ! Name', '2102355GLC10N9100002'],
    },
    {
        # The chassis serial keeps the performance data of two identically named
        # power supplies apart.
        'id': 'crit-names-repeat-per-chassis',
        'test': 'stdout/power-supplies-multi-chassis,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            "'2102355GLC10N9100001_PSU0_status'=0",
            "'2102355GLC10N9100002_PSU0_status'=0",
            "'2102355GLC10N9100002_PSU1_status'=1",
        ],
    },
    {
        # The node name is worth filtering on: it is what an operator knows a chassis by.
        'id': 'ok-match-filters-by-node-name',
        'test': 'stdout/power-supplies-multi-chassis,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        " --match='node01'",
        'assert-retc': STATE_OK,
        'assert-in': ['node01'],
        'assert-not-in': ['node02'],
    },
    {
        # The filter selects a subset; what it drops must not be checked either.
        'id': 'ok-match-filters-powers',
        'test': 'stdout/power-supplies-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        " --match='PSU0'",
        'assert-retc': STATE_OK,
        'assert-in': ['PSU0'],
        'assert-not-in': ['PSU1'],
    },
    {
        'id': 'crit-no-match-severity',
        'test': 'stdout/power-supplies-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        " --match='nonexistent' --no-match-severity=crit",
        'assert-retc': STATE_CRIT,
        'assert-in': ['No power supplies matched `nonexistent`.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-pacific-power'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
