import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_WARN

# Fixtures are the verbatim output of the commands the check runs, in the C locale it
# runs them in. A check with failed units also asks `systemctl show` for the reason
# (`<base>-show`) and journalctl for the log of each unit (`<base>-journal-<unit>`);
# without such a fixture, the unit goes without a reason or without log lines.
# `ten-failed-el10*` comes from a ubi10-init container (systemd 257) with ten units
# that fail in different ways. `one-failed-openipmi-show` is made up: a Result value
# that systemd does not know today.

TESTS = [
    {
        'id': 'ok-no-failed-units',
        'test': 'stdout/no-failed-units,,0',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok.',
    },
    {
        'id': 'warn-one-failed-openipmi',
        'test': 'stdout/one-failed-openipmi,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 failed unit: openipmi.service'],
    },
    {
        'id': 'warn-two-failed-openipmi-smartd',
        'test': 'stdout/two-failed-openipmi-smartd,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['2 failed units: openipmi.service, smartd.service'],
    },
    {
        'id': 'warn-two-failed-ignore-openipmi',
        'test': 'stdout/two-failed-openipmi-smartd,,0',
        'params': '--ignore=openipmi.service',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 failed unit: smartd.service'],
    },
    {
        'id': 'ok-two-failed-ignore-both',
        'test': 'stdout/two-failed-openipmi-smartd,,0',
        'params': '--ignore=openipmi.service --ignore=smartd.service',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok.',
    },
    {
        'id': 'ok-two-failed-ignore-both-plus-fantasy',
        'test': 'stdout/two-failed-openipmi-smartd,,0',
        'params': '--ignore=openipmi.service --ignore=smartd.service --ignore=fantasy.mount',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok.',
    },
    {
        'id': 'warn-one-failed-chronyd',
        'test': 'stdout/one-failed-chronyd,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 failed unit: chronyd.service'],
    },
    {
        # systemctl names a unit in its escaped form; --ignore takes either form
        'id': 'warn-one-failed-escaped-swap',
        'test': 'stdout/one-failed-escaped-swap,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [r'1 failed unit: dev-disk-by\x2duuid-0a1b2c3d.swap'],
    },
    {
        'id': 'ok-one-failed-escaped-swap-ignore-escaped',
        'test': 'stdout/one-failed-escaped-swap,,0',
        # single quotes, so shlex keeps the backslash
        'params': r"'--ignore=dev-disk-by\x2duuid-*'",
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok.',
    },
    {
        'id': 'ok-one-failed-escaped-swap-ignore-readable',
        'test': 'stdout/one-failed-escaped-swap,,0',
        'params': '--ignore=dev-disk-by-uuid-*',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok.',
    },
    {
        'id': 'warn-three-failed-tomcat-varnish',
        'test': 'stdout/three-failed-tomcat-varnish,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '3 failed units: tomcat8.service, varnish.service, varnishlog.service',
        ],
        'assert-regex': (
            r'tomcat8.service    ! not-found ! failed ! failed ! tomcat8.service'
        ),
    },
    {
        'id': 'warn-ten-failed-el10-say-why',
        'test': 'stdout/ten-failed-el10,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '10 failed units: mnt-x.mount (exited with an error), ',
            't-exit.service (exited with status 3), ',
            't-noexec.service (exited with status 203/EXEC), ',
            't-notify.service (timed out), ',
            't-nouser.service (exited with status 217/USER), ',
            't-pre.service (exited with an error), ',
            't-segv.service (dumped core on SIGSEGV), ',
            't-signal.service (killed by SIGKILL), ',
            't-timeout.service (timed out)',
        ],
    },
    {
        'id': 'warn-ten-failed-el10-show-the-log',
        'test': 'stdout/ten-failed-el10,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'Last log lines of t-exit.service:\n'
            'starting\n'
            'Error: config file /etc/foo.conf not found\n',
            'Last log lines of t-noexec.service:\n'
            "t-noexec.service: Unable to locate executable '/nonexistent/binary'",
        ],
        'assert-not-in': ['Last log lines of mnt-x.mount'],
    },
    {
        # the last lines are only a hint, so the command follows them for all units
        'id': 'warn-ten-failed-el10-hint-names-every-unit',
        'test': 'stdout/ten-failed-el10,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'No such file or directory\n\n'
            'Show the log with `sudo journalctl --boot=0 --unit=mnt-x.mount '
            '--unit=t-exit.service --unit=t-limit.service --unit=t-noexec.service '
            '--unit=t-notify.service --unit=t-nouser.service --unit=t-pre.service '
            '--unit=t-segv.service --unit=t-signal.service --unit=t-timeout.service`',
        ],
    },
    {
        'id': 'warn-unknown-result-is-shown-as-is',
        'test': 'stdout/one-failed-openipmi,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            "1 failed unit: openipmi.service (failed with result 'frobnicate')",
        ],
    },
    {
        # no log lines: the journal is not readable, or the unit wrote nothing
        'id': 'warn-without-log-points-to-journalctl',
        'test': 'stdout/one-failed-openipmi,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'Show the log with `sudo journalctl --boot=0 --unit=openipmi.service`',
        ],
    },
    {
        # quoted, so the shell keeps the backslash of the escaped name
        'id': 'warn-escaped-unit-is-quoted-in-the-journalctl-hint',
        'test': 'stdout/one-failed-escaped-swap,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            r"`sudo journalctl --boot=0 '--unit=dev-disk-by\x2duuid-0a1b2c3d.swap'`",
        ],
    },
]


class TestCheck(unittest.TestCase):
    check = '../systemd-units-failed'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
