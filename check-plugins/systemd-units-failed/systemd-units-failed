import argparse
import fnmatch
import re
import sys

import lib.args
import lib.base
import lib.human
import lib.lftest
import lib.shell
import lib.systemd
import lib.time
import lib.txt
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026111102'

DESCRIPTION = """Checks for failed systemd units. Alerts when any unit is in a failed state, and
says why each unit failed, for example the exit status or the signal that killed it.
With read access to the systemd journal, also shows the last log lines of each failed
unit. Specific units can be excluded from the check via --ignore with glob patterns.
When no unit is currently failed, reports the most recent system unit-failed event
from the current boot's journal so operators see at a glance how long the host has
been clean since the last reboot."""

JOURNAL_TIMEOUT = 5  # seconds

# Log lines shown per failed unit, and the number of failed units whose log is read.
# Every unit costs one journalctl call, so a host with many failed units does not
# hold up the check.
LOG_LINES = 3
LOG_UNITS = 5
# A program may write a whole document into one log line.
LOG_LINE_LENGTH = 200


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--ignore',
        help='Unit name to exclude from the check. '
        'Supports glob patterns according to https://docs.python.org/3/library/fnmatch.html. '
        'Case-sensitive. '
        'Can be specified multiple times. '
        'Example: `--ignore=dhcpd.service`.',
        dest='IGNORE',
        default=None,
        action='append',
    )

    parser.add_argument(
        '--no-perfdata',
        help=lib.args.help('--no-perfdata'),
        dest='NO_PERFDATA',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--test',
        help=lib.args.help('--test'),
        dest='TEST',
        type=lib.args.csv,
    )

    args, _ = parser.parse_known_args()
    return args


def _unescape_systemd_name(name):
    """Replace systemd's `\\xNN` hex escapes with the original character so
    unit names are human-readable. A run of escapes is decoded as a whole, as a
    character outside ASCII spans several bytes (`\\xc3\\xa4` is "ä").
    """
    return re.sub(
        r'(?:\\x[0-9a-fA-F]{2})+',
        lambda m: bytes.fromhex(m.group(0).replace('\\x', '')).decode(
            'utf-8', errors='replace'
        ),
        name,
    )


def _is_ignored(name, ignores):
    """Tell whether the unit `name` matches one of the `ignores` glob patterns.

    systemctl and the journal both name a unit in its escaped form
    (`dev-disk-by\\x2duuid-...`), while an admin may well write the readable one, so
    either form matches, in the list of failed units and in the last-failed hint alike.
    """
    names = {name, _unescape_systemd_name(name)}
    return any(
        fnmatch.fnmatchcase(candidate, ignore)
        for candidate in names
        for ignore in ignores
    )


_LAST_FAILED_LINE = re.compile(
    r'^(\d+(?:\.\d+)?)\s+\S+\s+systemd\[\d+\]:\s+(.+?):\s+'
    r"Failed with result\s+'([^']+)'"
)


def get_last_failed_unit(ignores):
    """Return (unit_name, epoch_seconds, reason) of the most recent
    system-scope unit-failed event recorded in the journal of the
    current boot, or (None, None, None) if journalctl is unavailable,
    returns nothing, or its output cannot be parsed. Restricted to
    PID 1 entries so user-session unit failures do not leak into the
    system-scope check. Units matching one of the `ignores` glob patterns
    (--ignore) are skipped, like in the check itself.

    Filters by message text rather than CODE_FUNC or MESSAGE_ID because
    the structured fields are not consistently set on every systemd
    version (RHEL 9 / Rocky 9 hosts at systemd 252 are missing them on
    most of the unit-failed entries). The hardcoded English string is
    safe: systemd's `unit_log_failure()` writes this format string
    verbatim into the journal, regardless of the system locale.

    Scopes to the current boot via `--boot=0` so the scan stays fast
    regardless of journal size, and so 'last failed since reboot' is
    what the admin sees - which is more actionable than 'last failed
    ever in the retained journal'. Reads short-unix output
    (epoch.microseconds prefix) and parses the last matching line
    client-side, because RHEL 9 / Rocky 9 (systemd 252) misorder
    `--grep` against `--lines=1` and produce no JSON output for some
    `--output=json --grep ...` combinations.
    """
    cmd = [
        'journalctl',
        '--no-pager',
        '--output=short-unix',
        '--boot=0',
        '_PID=1',
        '--grep=Failed with result',
    ]
    # The hint is a courtesy: a journal that takes long to search must not hold up the
    # check, so a timeout simply drops the hint.
    success, result = lib.shell.shell_exec(cmd, timeout=JOURNAL_TIMEOUT)
    if not success:
        return None, None, None
    stdout, _stderr, retc = result
    if retc != 0 or not stdout:
        return None, None, None
    for line in reversed(stdout.splitlines()):
        match = _LAST_FAILED_LINE.match(line)
        if match and not _is_ignored(match.group(2), ignores):
            break
    else:
        return None, None, None
    timestamp_str, unit, reason = match.groups()
    try:
        epoch = float(timestamp_str)
    except ValueError:
        return None, None, None
    unit = _unescape_systemd_name(unit)
    message = f"Failed with result '{reason}'"
    return unit, epoch, message


def get_log_lines(units, test):
    """Return a dict of unit name to the last LOG_LINES lines the unit's own processes
    wrote to the journal in the current boot, for the first LOG_UNITS units. Every
    unit costs one journalctl call, so all calls together get JOURNAL_TIMEOUT seconds.
    """
    units = units[:LOG_UNITS]
    if test is None:
        return lib.systemd.get_log_lines(
            units, lines=LOG_LINES, line_length=LOG_LINE_LENGTH, timeout=JOURNAL_TIMEOUT
        )
    logs = {}
    for unit in units:
        lines = lib.systemd.log_lines(
            load_fixture(f'{test[0]}-journal-{unit}'), LOG_LINES, LOG_LINE_LENGTH
        )
        if lines:
            logs[unit] = lines
    return logs


def get_reasons(units, test):
    """Return a dict of unit name to the reason it failed. On any error, the units go
    without a reason instead of failing the check.
    """
    if test is None:
        return lib.systemd.get_failure_reasons(units)
    return lib.systemd.failure_reasons(units, load_fixture(f'{test[0]}-show'))


def load_fixture(path):
    """Return the content of the fixture `path` below `unit-test/`, or '' if there is
    none. lib.lftest.test() hands back the value itself for a missing file.
    """
    stdout, _stderr, _retc = lib.lftest.test([path])
    return '' if stdout == path else stdout


def main():
    """The main function. This is where the magic happens."""

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)

    # set default values for append parameters that were not specified
    if args.IGNORE is None:
        args.IGNORE = []

    # fetch data
    if args.TEST is None:
        # get the values the normal way
        stdout, _stderr, retc = lib.base.coe(
            lib.shell.shell_exec(
                ['systemctl', '--state=failed', '--no-pager', '--no-legend']
            )
        )
    else:
        # do not call the command, put in test data
        stdout, _stderr, retc = lib.lftest.test(args.TEST)

    if retc != 0:
        lib.base.cu('systemctl was unable to return any data.')

    # init some vars
    msg = 'Everything is ok.'
    table = ''
    state = STATE_OK
    count = 0

    # analyze data
    failed_units = stdout.splitlines()
    if len(failed_units) > 0:
        table_data = []
        offset = 0
        for line in failed_units:
            if line.startswith('*'):
                offset = 1
            unit = line.split()
            if _is_ignored(unit[0 + offset], args.IGNORE):
                continue
            count += 1
            table_data.append(
                {
                    'unit': unit[0 + offset],
                    'load': unit[1 + offset],
                    'active': unit[2 + offset],
                    'sub': unit[3 + offset],
                    'description': ' '.join(unit[4 + offset :]),
                }
            )
        if count > 0:
            state = STATE_WARN
            units = [row['unit'] for row in table_data]
            reasons = get_reasons(units, args.TEST)
            unit_names = ', '.join(
                f'{unit} ({reasons[unit]})' if reasons.get(unit) else unit
                for unit in units
            )
            msg = f'{count} failed {lib.txt.pluralize("unit", count)}: {unit_names}'
            table = lib.base.get_table(
                table_data,
                ['unit', 'load', 'active', 'sub', 'description'],
                ['unit', 'load', 'active', 'sub', 'description'],
            )
            logs = get_log_lines(units, args.TEST)
            for unit, lines in logs.items():
                log = '\n'.join(lines)
                table += f'\nLast log lines of {unit}:\n{log}\n'
            # always, since the last lines are only a first hint and cover at
            # most LOG_UNITS units; no period after the command, so it can be copied
            # as is
            command = lib.systemd.journalctl_command(units)
            table += f'\nShow the log with `sudo {command}`\n'

    # When the system is currently clean, surface the most recent unit-failed
    # journal event so the admin sees how long the host has been quiet.
    # Skipped in --test mode because the journal is host-state, not fixture data.
    if state == STATE_OK and args.TEST is None:
        unit, epoch, message = get_last_failed_unit(args.IGNORE)
        if unit and epoch:
            delta = max(0, lib.time.now() - epoch)
            ago = lib.human.seconds2human(delta)
            ts = lib.time.epoch2iso(epoch)
            # message ends with '.' from systemd; drop it so the suffix reads cleanly
            message = message.rstrip('.') if message else ''
            msg = (
                f'Everything is ok. Last failed: `{unit}`'
                + (f' with message "{message}"' if message else '')
                + f' at {ts} ({ago} ago)'
            )

    # build the message
    perfdata = lib.base.get_perfdata(
        'systemd-units-failed',
        count,
        warn=1,
        _min=0,
    )

    # over and out
    lib.base.oao(
        f'{msg}\n\n{table}',
        state,
        perfdata,
        always_ok=args.ALWAYS_OK,
        no_perfdata=args.NO_PERFDATA,
    )


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
