__version__ = '2026111101'

DESCRIPTION = """Checks for failed systemd units. Alerts when any unit is in a failed state, and
says why each unit failed, for example the exit status or the signal that killed it.
With read access to the systemd journal, also shows the last log lines of each failed
unit. Specific units can be excluded from the check via --ignore with glob patterns.
When no unit
is currently failed, reports the most recent system unit-failed event from the current
boot's journal so operators see at a glance how long the host has been clean since the
last reboot."""

JOURNAL_TIMEOUT = 5  # seconds

# Log lines shown per failed unit, and the number of failed units whose log is read.
# Every unit costs one journalctl call, so a host with many failed units does not
# hold up the check.
LOG_LINES = 3
LOG_UNITS = 5
# A program may write a whole document into one log line.
LOG_LINE_LENGTH = 200

# How systemd's `Result` property reads in the output, complete for every unit type
# (`*_result_table` in src/core/{automount,mount,path,scope,service,socket,swap,
# timer}.c, verified against systemd 257). `success` is left out, since a unit with
# that result has not failed for a reason of its own (a unit that is not found, for
# example). `exit-code`, `signal` and `core-dump` are refined with the exit status or
# the signal of the main process where systemd knows them.
RESULT_REASONS = {
    'core-dump': 'dumped core',
    'exec-condition': 'its ExecCondition= failed',
    'exit-code': 'exited with an error',
    'mount-start-limit-hit': 'its mount unit was started too often',
    'oom-kill': 'killed by the OOM killer',
    'protocol': 'did not follow the start-up protocol of its type',
    'resources': 'a system operation failed while starting or stopping it',
    'service-start-limit-hit': 'its service was started too often',
    'signal': 'killed by a signal',
    'start-limit-hit': 'started too often',
    'timeout': 'timed out',
    'trigger-limit-hit': 'triggered too often',
    'unit-start-limit-hit': 'the unit it triggers was started too often',
    'unmounted': 'its automount point was unmounted',
    'watchdog': 'missed its watchdog',
}

# The exit statuses systemd sets itself when it cannot start a process, from
# src/shared/exit-status.h (verified against systemd 257). 223 and 234 are reserved
# and have no name. The LSB (1 to 7) and BSD (64 to 78) names that systemctl also
# prints are left out on purpose: a program chooses those statuses itself, mostly
# without following either convention, so `3/NOTIMPLEMENTED` would mislead.
SYSTEMD_EXIT_STATUSES = {
    200: 'CHDIR',
    201: 'NICE',
    202: 'FDS',
    203: 'EXEC',
    204: 'MEMORY',
    205: 'LIMITS',
    206: 'OOM_ADJUST',
    207: 'SIGNAL_MASK',
    208: 'STDIN',
    209: 'STDOUT',
    210: 'CHROOT',
    211: 'IOPRIO',
    212: 'TIMERSLACK',
    213: 'SECUREBITS',
    214: 'SETSCHEDULER',
    215: 'CPUAFFINITY',
    216: 'GROUP',
    217: 'USER',
    218: 'CAPABILITIES',
    219: 'CGROUP',
    220: 'SETSID',
    221: 'CONFIRM',
    222: 'STDERR',
    224: 'PAM',
    225: 'NETWORK',
    226: 'NAMESPACE',
    227: 'NO_NEW_PRIVILEGES',
    228: 'SECCOMP',
    229: 'SELINUX_CONTEXT',
    230: 'PERSONALITY',
    231: 'APPARMOR',
    232: 'ADDRESS_FAMILIES',
    233: 'RUNTIME_DIRECTORY',
    235: 'CHOWN',
    236: 'SMACK_PROCESS_LABEL',
    237: 'KEYRING',
    238: 'STATE_DIRECTORY',
    239: 'CACHE_DIRECTORY',
    240: 'LOGS_DIRECTORY',
    241: 'CONFIGURATION_DIRECTORY',
    242: 'NUMA_POLICY',
    243: 'CREDENTIALS',
    244: 'BPF',
    245: 'KSM',
    246: 'MEMORY_THP',
    255: 'EXCEPTION',
}

# `ExecMainCode` is the si_code of the main process: CLD_EXITED, CLD_KILLED or
# CLD_DUMPED. 0 means the main process never ran, for example because an
# ExecStartPre= command failed, and a unit that is not a service has no main process.
CLD_EXITED = 1
CLD_KILLED = 2
CLD_DUMPED = 3


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--ignore',
        help='Unit name to exclude from the check. '
        'Supports glob patterns according to https://docs.python.org/3/library/fnmatch.html. '
        'Case-sensitive. '
        'Can be specified multiple times. '
        'Example: `--ignore=dhcpd.service`.',
        dest='IGNORE',
        default=None,
        action='append',
    )

    parser.add_argument(
        '--no-perfdata',
        help=lib.args.help('--no-perfdata'),
        dest='NO_PERFDATA',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--test',
        help=lib.args.help('--test'),
        dest='TEST',
        type=lib.args.csv,
    )

    args, _ = parser.parse_known_args()
    return args


def _unescape_systemd_name(name):
    """Replace systemd's `\\xNN` hex escapes with the original character so
    unit names are human-readable. A run of escapes is decoded as a whole, as a
    character outside ASCII spans several bytes (`\\xc3\\xa4` is "ä").
    """
    return re.sub(
        r'(?:\\x[0-9a-fA-F]{2})+',
        lambda m: bytes.fromhex(m.group(0).replace('\\x', '')).decode(
            'utf-8', errors='replace'
        ),
        name,
    )


def _is_ignored(name, ignores):
    """Tell whether the unit `name` matches one of the `ignores` glob patterns.

    systemctl and the journal both name a unit in its escaped form
    (`dev-disk-by\\x2duuid-...`), while an admin may well write the readable one, so
    either form matches, in the list of failed units and in the last-failed hint alike.
    """
    names = {name, _unescape_systemd_name(name)}
    return any(
        fnmatch.fnmatchcase(candidate, ignore)
        for candidate in names
        for ignore in ignores
    )


_LAST_FAILED_LINE = re.compile(
    r'^(\d+(?:\.\d+)?)\s+\S+\s+systemd\[\d+\]:\s+(.+?):\s+'
    r"Failed with result\s+'([^']+)'"
)


def get_last_failed_unit(ignores):
    """Return (unit_name, epoch_seconds, reason) of the most recent
    system-scope unit-failed event recorded in the journal of the
    current boot, or (None, None, None) if journalctl is unavailable,
    returns nothing, or its output cannot be parsed. Restricted to
    PID 1 entries so user-session unit failures do not leak into the
    system-scope check. Units matching one of the `ignores` glob patterns
    (--ignore) are skipped, like in the check itself.

    Filters by message text rather than CODE_FUNC or MESSAGE_ID because
    the structured fields are not consistently set on every systemd
    version (RHEL 9 / Rocky 9 hosts at systemd 252 are missing them on
    most of the unit-failed entries). The hardcoded English string is
    safe: systemd's `unit_log_failure()` writes this format string
    verbatim into the journal, regardless of the system locale.

    Scopes to the current boot via `--boot=0` so the scan stays fast
    regardless of journal size, and so 'last failed since reboot' is
    what the admin sees - which is more actionable than 'last failed
    ever in the retained journal'. Reads short-unix output
    (epoch.microseconds prefix) and parses the last matching line
    client-side, because RHEL 9 / Rocky 9 (systemd 252) misorder
    `--grep` against `--lines=1` and produce no JSON output for some
    `--output=json --grep ...` combinations.
    """
    cmd = [
        'journalctl',
        '--no-pager',
        '--output=short-unix',
        '--boot=0',
        '_PID=1',
        '--grep=Failed with result',
    ]
    # The hint is a courtesy: a journal that takes long to search must not hold up the
    # check, so a timeout simply drops the hint.
    success, result = lib.shell.shell_exec(cmd, timeout=JOURNAL_TIMEOUT)
    if not success:
        return None, None, None
    stdout, _stderr, retc = result
    if retc != 0 or not stdout:
        return None, None, None
    for line in reversed(stdout.splitlines()):
        match = _LAST_FAILED_LINE.match(line)
        if match and not _is_ignored(match.group(2), ignores):
            break
    else:
        return None, None, None
    timestamp_str, unit, reason = match.groups()
    try:
        epoch = float(timestamp_str)
    except ValueError:
        return None, None, None
    unit = _unescape_systemd_name(unit)
    message = f"Failed with result '{reason}'"
    return unit, epoch, message


def _signal_name(number):
    """Return the name of signal `number` (`SIGKILL`), or `signal 9` if Python does
    not know it.
    """
    try:
        return signal.Signals(number).name
    except ValueError:
        return f'signal {number}'


def get_log_lines(units, test):
    """Return a dict of unit name to the last LOG_LINES lines that the unit's own
    processes wrote to the journal in the current boot, for the first LOG_UNITS units.
    The messages of systemd about the unit stay out, since the reason already says
    what they say.

    Reading the system journal needs root, sudo or the `systemd-journal` group.
    Without them, journalctl ends with an error or shows only the account's own
    journal; either way, no lines come back and the unit is left out. All calls
    together get JOURNAL_TIMEOUT seconds.
    """
    logs = {}
    deadline = time.monotonic() + JOURNAL_TIMEOUT
    for unit in units[:LOG_UNITS]:
        if test is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            success, result = lib.shell.shell_exec(
                [
                    'journalctl',
                    '--no-pager',
                    '--boot=0',
                    '--output=cat',
                    f'--lines={LOG_LINES}',
                    f'_SYSTEMD_UNIT={unit}',
                ],
                timeout=remaining,
            )
            if not success:
                break
            stdout, _stderr, retc = result
            if retc != 0:
                # not allowed to read a single journal file, the next unit fares
                # no better
                break
        else:
            stdout = load_fixture(f'{test[0]}-journal-{unit}')
        lines = [
            lib.txt.shorten(line.rstrip(), LOG_LINE_LENGTH)
            for line in stdout.splitlines()
            if line.strip()
        ]
        if lines:
            logs[unit] = lines[-LOG_LINES:]
    return logs


def get_reason(props):
    """Tell in a few words why a unit failed, from its `Result`, `ExecMainCode` and
    `ExecMainStatus` properties (`systemctl show`). Returns '' if systemd gives no
    reason, which is the case for a unit that is not found.
    """
    result = props.get('Result', '')
    if not result or result == 'success':
        return ''
    try:
        code = int(props.get('ExecMainCode', 0))
        status = int(props.get('ExecMainStatus', 0))
    except ValueError:
        code, status = 0, 0
    if result == 'exit-code' and code == CLD_EXITED and status:
        name = SYSTEMD_EXIT_STATUSES.get(status)
        return f'exited with status {status}' + (f'/{name}' if name else '')
    if result == 'signal' and code == CLD_KILLED and status:
        return f'killed by {_signal_name(status)}'
    if result == 'core-dump' and code == CLD_DUMPED and status:
        return f'dumped core on {_signal_name(status)}'
    # a result that a later systemd adds still says something
    return RESULT_REASONS.get(result, f"failed with result '{result}'")


def get_reasons(units, test):
    """Return a dict of unit name to reason, from one `systemctl show` call for all
    `units`. Reading the properties needs no privileges. On any error, the units go
    without a reason instead of failing the check.
    """
    cmd = [
        'systemctl',
        'show',
        '--property=Result,ExecMainCode,ExecMainStatus',
        '--',
        *units,
    ]
    if test is None:
        success, result = lib.shell.shell_exec(cmd)
        if not success:
            return {}
        stdout, _stderr, retc = result
        if retc != 0:
            return {}
    else:
        stdout = load_fixture(f'{test[0]}-show')
    blocks = parse_show(stdout)
    if len(blocks) != len(units):
        return {}
    return {unit: get_reason(props) for unit, props in zip(units, blocks)}


def load_fixture(path):
    """Return the content of the fixture `path` below `unit-test/`, or '' if there is
    none. lib.lftest.test() hands back the value itself for a missing file.
    """
    stdout, _stderr, _retc = lib.lftest.test([path])
    return '' if stdout == path else stdout


def parse_show(stdout):
    """Split the output of `systemctl show <unit> <unit> ...` into one dict of
    properties per unit. systemctl prints one block per unit, in the order of the
    arguments, separated by an empty line, and leaves out the ExecMain properties for
    a unit that is not a service.
    """
    blocks = []
    for block in stdout.strip().split('\n\n'):
        props = {}
        for line in block.splitlines():
            key, sep, value = line.partition('=')
            if sep:
                props[key] = value
        blocks.append(props)
    return blocks


def main():
    """The main function. This is where the magic happens."""

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)

    # set default values for append parameters that were not specified
    if args.IGNORE is None:
        args.IGNORE = []

    # fetch data
    if args.TEST is None:
        # get the values the normal way
        stdout, _stderr, retc = lib.base.coe(
            lib.shell.shell_exec(
                ['systemctl', '--state=failed', '--no-pager', '--no-legend']
            )
        )
    else:
        # do not call the command, put in test data
        stdout, _stderr, retc = lib.lftest.test(args.TEST)

    if retc != 0:
        lib.base.cu('systemctl was unable to return any data.')

    # init some vars
    msg = 'Everything is ok.'
    table = ''
    state = STATE_OK
    count = 0

    # analyze data
    failed_units = stdout.splitlines()
    if len(failed_units) > 0:
        table_data = []
        offset = 0
        for line in failed_units:
            if line.startswith('*'):
                offset = 1
            unit = line.split()
            if _is_ignored(unit[0 + offset], args.IGNORE):
                continue
            count += 1
            table_data.append(
                {
                    'unit': unit[0 + offset],
                    'load': unit[1 + offset],
                    'active': unit[2 + offset],
                    'sub': unit[3 + offset],
                    'description': ' '.join(unit[4 + offset :]),
                }
            )
        if count > 0:
            state = STATE_WARN
            units = [row['unit'] for row in table_data]
            reasons = get_reasons(units, args.TEST)
            unit_names = ', '.join(
                f'{unit} ({reasons[unit]})' if reasons.get(unit) else unit
                for unit in units
            )
            msg = f'{count} failed {lib.txt.pluralize("unit", count)}: {unit_names}'
            table = lib.base.get_table(
                table_data,
                ['unit', 'load', 'active', 'sub', 'description'],
                ['unit', 'load', 'active', 'sub', 'description'],
            )
            logs = get_log_lines(units, args.TEST)
            for unit, lines in logs.items():
                log = '\n'.join(lines)
                table += f'\nLast log lines of {unit}:\n{log}\n'
            # always, since the last lines are only a first hint and cover at
            # most LOG_UNITS units; quoted, since an escaped unit name contains a
            # backslash; no period after the command, so it can be copied as is
            unit_args = ' '.join(shlex.quote(f'--unit={unit}') for unit in units)
            table += f'\nShow the log with `sudo journalctl --boot=0 {unit_args}`\n'

    # When the system is currently clean, surface the most recent unit-failed
    # journal event so the admin sees how long the host has been quiet.
    # Skipped in --test mode because the journal is host-state, not fixture data.
    if state == STATE_OK and args.TEST is None:
        unit, epoch, message = get_last_failed_unit(args.IGNORE)
        if unit and epoch:
            delta = max(0, lib.time.now() - epoch)
            ago = lib.human.seconds2human(delta)
            ts = lib.time.epoch2iso(epoch)
            # message ends with '.' from systemd; drop it so the suffix reads cleanly
            message = message.rstrip('.') if message else ''
            msg = (
                f'Everything is ok. Last failed: `{unit}`'
                + (f' with message "{message}"' if message else '')
                + f' at {ts} ({ago} ago)'
            )

    # build the message
    perfdata = lib.base.get_perfdata(
        'systemd-units-failed',
        count,
        warn=1,
        _min=0,
    )

    # over and out
    lib.base.oao(
        f'{msg}\n\n{table}',
        state,
        perfdata,
        always_ok=args.ALWAYS_OK,
        no_perfdata=args.NO_PERFDATA,
    )


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
