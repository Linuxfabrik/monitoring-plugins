# The OpenStack client libraries pull in `requests`, which prints a
# RequestsDependencyWarning when the urllib3 or chardet it finds is not the
# combination it was built against. Printed before anything else, that warning
# becomes the first line of the check output, which is the line a monitoring
# server reads as the result.
warnings.filterwarnings('ignore')

# Those libraries also log to stderr through loggers of their own, for instance
# when identity version discovery on the auth URL does not answer. A plugin
# reports through its stdout line and its exit code, so that noise is turned off
# rather than left to confuse whoever runs the check by hand.
logging.getLogger('keystoneauth').setLevel(logging.CRITICAL)
logging.getLogger('novaclient').setLevel(logging.CRITICAL)

