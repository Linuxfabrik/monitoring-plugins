    "Datafield": {
        "1": {
            "varname": "openstack_nova_list_always_ok",
            "caption": "Openstack Nova List: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "a47efdcb-cc96-487c-a1ef-fa8de770d19b"
        },
        "2": {
            "varname": "openstack_nova_list_brief",
            "caption": "Openstack Nova List: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8cdc0dac-f96a-4bc0-9744-1b8c55e6b962"
        },
        "3": {
            "varname": "openstack_nova_list_cache_expire",
            "caption": "Openstack Nova List: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ce87f435-a564-454c-b07e-431e13f48c0d"
        },
        "4": {
            "varname": "openstack_nova_list_ignore",
            "caption": "Openstack Nova List: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the instance name.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "82b262f9-2c78-45d4-9c3c-34cef8df66b9"
        },
        "5": {
            "varname": "openstack_nova_list_ignore_host",
            "caption": "Openstack Nova List: Ignore Host",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the compute host the instance runs on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "36905a5f-2bc0-436a-967d-669a79dbbf9f"
        },
        "6": {
            "varname": "openstack_nova_list_ignore_vm_state",
            "caption": "Openstack Nova List: Ignore VM State",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the VM state, which is the lower-case stable state the server status is derived from, for example `active` or `stopped`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2d8bd219-8b0d-4c39-8615-36d0b9fa9c80"
        },
        "7": {
            "varname": "openstack_nova_list_ignore_zone",
            "caption": "Openstack Nova List: Ignore Zone",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the availability zone of the instance.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "90d90705-8170-422c-9e97-21cc50b1a78d"
        },
        "8": {
            "varname": "openstack_nova_list_insecure",
            "caption": "Openstack Nova List: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "09644f99-ded7-4bfd-aade-18570790aa19"
        },
        "9": {
            "varname": "openstack_nova_list_lengthy",
            "caption": "Openstack Nova List: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "872b091a-c789-412a-ae25-438d86f0c747"
        },
        "10": {
            "varname": "openstack_nova_list_match",
            "caption": "Openstack Nova List: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the instance name.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3b0b9ae6-0801-49c4-8d1f-0eba8c7aee26"
        },
        "11": {
            "varname": "openstack_nova_list_match_host",
            "caption": "Openstack Nova List: Match Host",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the compute host the instance runs on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a702a8a3-3647-49a1-8408-72b2419c2ab3"
        },
        "12": {
            "varname": "openstack_nova_list_match_vm_state",
            "caption": "Openstack Nova List: Match VM State",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the VM state, which is the lower-case stable state the server status is derived from, for example `active` or `stopped`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "22bc87f9-8c68-42c7-b67e-86f218ba32d9"
        },
        "13": {
            "varname": "openstack_nova_list_match_zone",
            "caption": "Openstack Nova List: Match Zone",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the availability zone of the instance.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "62e5bbc3-8b92-44fe-ba2b-3dbd95f84a87"
        },
        "14": {
            "varname": "openstack_nova_list_no_match_severity",
            "caption": "Openstack Nova List: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "openstack_nova_list_no_match_severity_list"
            },
            "uuid": "9dd11aae-240b-415e-a263-3af11fd5f7dc"
        },
        "15": {
            "varname": "openstack_nova_list_no_perfdata",
            "caption": "Openstack Nova List: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "da136279-3f68-41eb-a5aa-f5cc0bb39416"
        },
        "16": {
            "varname": "openstack_nova_list_no_proxy",
            "caption": "Openstack Nova List: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5c79ecb6-e711-4a23-b8d4-f8e63184e36a"
        },
        "17": {
            "varname": "openstack_nova_list_proxy",
            "caption": "Openstack Nova List: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ec0c1f13-e543-4e7a-a096-e6d42236ad2b"
        },
        "18": {
            "varname": "openstack_nova_list_rc_file",
            "caption": "Openstack Nova List: Rc File",
            "description": "Path to a rc file containing OpenStack connection parameters like OS_USERNAME (instead of specifying them on the command line). Example: `--rc-file=/var/spool/icinga2/.openstack.cnf`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3f888410-5f40-4878-8e55-0855238ac7cc"
        },
        "19": {
            "varname": "openstack_nova_list_severity",
            "caption": "Openstack Nova List: Severity",
            "description": "State to report for instances in a given Nova status, as `STATUS,STATE`. STATUS is a Nova server status such as `SHUTOFF`, case-insensitive. STATE is one of `ok`, `warn`, `crit` or `unknown`. Overrides the built-in state for that status only, every other status keeps its default. Can be specified multiple times. Example: `--severity=SHUTOFF,warn --severity=BUILD,ok`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bf8ebf27-b82c-4218-84ae-a6c3f1c05c28"
        },
        "20": {
            "varname": "openstack_nova_list_timeout",
            "caption": "Openstack Nova List: Timeout",
            "description": "Network timeout in seconds. Applies to the whole run, not to a single request.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "56c38e3c-c405-4b78-8a79-231e0cd95954"
        }
    }
}
