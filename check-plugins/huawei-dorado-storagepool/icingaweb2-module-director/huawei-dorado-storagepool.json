        },
        "4": {
            "varname": "huawei_dorado_storagepool_device_id",
            "caption": "Huawei Dorado Storagepool: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b96c98a7-2f73-4d2c-84c0-ceb628ab6fae"
        },
        "5": {
            "varname": "huawei_dorado_storagepool_ignore",
            "caption": "Huawei Dorado Storagepool: Ignore",
            "description": "Skip storage pools. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the pool identifier, the pool name and the name of its disk domain, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9e4ad12e-a967-4d08-a724-ab7a898c801d"
        },
        "6": {
            "varname": "huawei_dorado_storagepool_insecure",
            "caption": "Huawei Dorado Storagepool: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4b03f7bf-ca2f-4dd8-ad4f-e5f85217dafd"
        },
        "7": {
            "varname": "huawei_dorado_storagepool_match",
            "caption": "Huawei Dorado Storagepool: Match",
            "description": "Filter by storage pools. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the pool identifier, the pool name and the name of its disk domain, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "edc45071-c629-42d7-a3bc-4f5032271ab2"
        },
        "8": {
            "varname": "huawei_dorado_storagepool_no_insecure",
            "caption": "Huawei Dorado Storagepool: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "27dcabdd-90ec-49ca-86ac-4bd79f96b25a"
        },
        "9": {
            "varname": "huawei_dorado_storagepool_no_match_severity",
            "caption": "Huawei Dorado Storagepool: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_storagepool_no_match_severity_list"
            },
            "uuid": "78d8d48a-3a16-4779-af28-e209c38d0c4b"
        },
        "10": {
            "varname": "huawei_dorado_storagepool_no_perfdata",
            "caption": "Huawei Dorado Storagepool: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d81da56c-a931-4b14-b854-189f0caf45a8"
        },
        "11": {
            "varname": "huawei_dorado_storagepool_no_proxy",
            "caption": "Huawei Dorado Storagepool: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "da63fd39-3951-4feb-818c-1f22fcb2489a"
        },
        "12": {
            "varname": "huawei_dorado_storagepool_performance",
            "caption": "Huawei Dorado Storagepool: Performance?",
            "description": "Additionally report the I/O counters of every storage pool. Costs one API request per object, so a large appliance may need a higher --timeout.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6a3968e4-48a3-41a2-9baa-e0b815556f70"
        },
        "13": {
            "varname": "huawei_dorado_storagepool_password",
            "caption": "Huawei Dorado Storagepool: Password",
            "description": "Huawei OceanStor Dorado API password. Password.",
