            "max_check_attempts": 5,
            "notes": "Checks the health, running status and capacity usage of all storage pools on a Huawei OceanStor Dorado storage system via the REST API (/storagepool endpoint). Alerts when a pool reports a non-normal state, when its used capacity reaches the warning or critical threshold, and when it reaches the threshold the storage administrator configured on the appliance itself. Supports reporting the I/O counters via --performance.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/huawei-dorado-storagepool/",
            "object_name": "tpl-service-huawei-dorado-storagepool",
            "object_type": "template",
            "retry_interval": 30,
            "service_set": null,
            "template_choice": null,
            "use_agent": false,
            "use_var_overrides": null,
            "vars": {
                "criticality": "A",
                "huawei_dorado_storagepool_always_ok": false,
                "huawei_dorado_storagepool_cache_expire": 15,
                "huawei_dorado_storagepool_critical": "90",
                "huawei_dorado_storagepool_critical_overprovisioning": "",
                "huawei_dorado_storagepool_device_id": "",
                "huawei_dorado_storagepool_device_threshold_severity": "warn",
                "huawei_dorado_storagepool_ignore": [],
                "huawei_dorado_storagepool_insecure": true,
                "huawei_dorado_storagepool_match": [],
                "huawei_dorado_storagepool_no_match_severity": "ok",
                "huawei_dorado_storagepool_no_perfdata": false,
                "huawei_dorado_storagepool_no_proxy": false,
                "huawei_dorado_storagepool_performance": false,
                "huawei_dorado_storagepool_scope": "0",
                "huawei_dorado_storagepool_timeout": 3,
                "huawei_dorado_storagepool_warning": "80",
                "huawei_dorado_storagepool_warning_overprovisioning": "",
                "huawei_dorado_storagepool_verbose": false
            },
            "volatile": null,
            "zone": null,
            "uuid": "26af503c-aef9-4ad1-8f65-176072f24621"
        }
    },
