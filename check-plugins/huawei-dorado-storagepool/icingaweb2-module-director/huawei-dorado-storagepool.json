    "Datafield": {
        "1": {
            "varname": "huawei_dorado_storagepool_always_ok",
            "caption": "Huawei Dorado Storagepool: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5a4286a2-5768-4176-9d3b-d122aa7aa7af"
        },
        "2": {
            "varname": "huawei_dorado_storagepool_cache_expire",
            "caption": "Huawei Dorado Storagepool: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "265edacb-2ba2-4ac9-a4e8-dec76c7c94e5"
        },
        "3": {
            "varname": "huawei_dorado_storagepool_critical",
            "caption": "Huawei Dorado Storagepool: Critical",
            "description": "CRIT threshold for the used capacity of a pool, as a Nagios range in percent.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a10348e0-d7cb-4ca4-9d6b-b3a1db39f0d8"
        },
        "4": {
            "varname": "huawei_dorado_storagepool_critical_overprovisioning",
            "caption": "Huawei Dorado Storagepool: Critical Overprovisioning",
            "description": "CRIT threshold for the overprovisioning of a pool, as a Nagios range in percent of its total capacity that is handed out to LUNs. Above 100 percent the pool is thin provisioned, which is what thin provisioning is for; what matters is how far the promise exceeds the disks behind it. Off by default. Example: `--critical-overprovisioning=300`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5f7dd3a8-de94-4878-93cd-151f69ffda0c"
        },
        "5": {
            "varname": "huawei_dorado_storagepool_device_id",
            "caption": "Huawei Dorado Storagepool: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b96c98a7-2f73-4d2c-84c0-ceb628ab6fae"
        },
        "6": {
            "varname": "huawei_dorado_storagepool_device_threshold_severity",
            "caption": "Huawei Dorado Storagepool: Device Threshold Severity",
            "description": "State to report for a pool that reached the capacity threshold configured on the appliance itself. That threshold is what the storage administrator set in the management GUI, so the check and the appliance agree on when a pool is full instead of each having their own opinion. A pool that carries no threshold is not affected.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_storagepool_device_threshold_severity_list"
            },
            "uuid": "4f39056b-91b8-410e-8bc1-e12490dd0316"
        },
        "7": {
            "varname": "huawei_dorado_storagepool_ignore",
            "caption": "Huawei Dorado Storagepool: Ignore",
            "description": "Skip storage pools. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the pool identifier, the pool name and the name of its disk domain, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9e4ad12e-a967-4d08-a724-ab7a898c801d"
        },
        "8": {
            "varname": "huawei_dorado_storagepool_insecure",
            "caption": "Huawei Dorado Storagepool: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4b03f7bf-ca2f-4dd8-ad4f-e5f85217dafd"
        },
        "9": {
            "varname": "huawei_dorado_storagepool_match",
            "caption": "Huawei Dorado Storagepool: Match",
            "description": "Filter by storage pools. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the pool identifier, the pool name and the name of its disk domain, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "edc45071-c629-42d7-a3bc-4f5032271ab2"
        },
        "10": {
            "varname": "huawei_dorado_storagepool_no_insecure",
            "caption": "Huawei Dorado Storagepool: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "27dcabdd-90ec-49ca-86ac-4bd79f96b25a"
        },
        "11": {
            "varname": "huawei_dorado_storagepool_no_match_severity",
            "caption": "Huawei Dorado Storagepool: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_storagepool_no_match_severity_list"
            },
            "uuid": "78d8d48a-3a16-4779-af28-e209c38d0c4b"
        },
        "12": {
            "varname": "huawei_dorado_storagepool_no_perfdata",
            "caption": "Huawei Dorado Storagepool: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d81da56c-a931-4b14-b854-189f0caf45a8"
        },
        "13": {
            "varname": "huawei_dorado_storagepool_no_proxy",
            "caption": "Huawei Dorado Storagepool: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "da63fd39-3951-4feb-818c-1f22fcb2489a"
        },
        "14": {
            "varname": "huawei_dorado_storagepool_performance",
            "caption": "Huawei Dorado Storagepool: Performance?",
            "description": "Additionally report the I/O counters of every storage pool. Costs one API request per object, so a large appliance may need a higher --timeout.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6a3968e4-48a3-41a2-9baa-e0b815556f70"
        },
        "15": {
            "varname": "huawei_dorado_storagepool_password",
            "caption": "Huawei Dorado Storagepool: Password",
            "description": "Huawei OceanStor Dorado API password. Password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "4ff52cae-f899-40dd-a484-74eaf0528711"
        },
        "16": {
            "varname": "huawei_dorado_storagepool_password_file",
            "caption": "Huawei Dorado Storagepool: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "270c09c0-d955-4183-bb3b-a54930ceda26"
        },
        "17": {
            "varname": "huawei_dorado_storagepool_scope",
            "caption": "Huawei Dorado Storagepool: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7eb761f3-0e4f-4a3b-ae73-c55a4db2dc0a"
        },
        "18": {
            "varname": "huawei_dorado_storagepool_timeout",
            "caption": "Huawei Dorado Storagepool: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "55bb8b00-ca08-451a-9436-30f1b97514a3"
        },
        "19": {
            "varname": "huawei_dorado_storagepool_url",
            "caption": "Huawei Dorado Storagepool: URL",
            "description": "Huawei OceanStor Dorado API URL. URL to the endpoint.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c7c914f9-4157-45ec-b13f-af60425d4e40"
        },
        "20": {
            "varname": "huawei_dorado_storagepool_username",
            "caption": "Huawei Dorado Storagepool: Username",
            "description": "Huawei OceanStor Dorado API username. Username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
