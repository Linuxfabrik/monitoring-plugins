        '--brief',
        help='Hide table rows for LUNs that are ok and show only those in WARN/CRIT '
        'state. Perfdata and alerting are unaffected. Worth setting on an array with '
        'many LUNs. Default: %(default)s',
        dest='BRIEF',
        action='store_true',
        default=False,
