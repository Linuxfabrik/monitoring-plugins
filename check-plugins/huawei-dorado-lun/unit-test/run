import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN

TESTS = [
    {
        # The third LUN of the fixture is not mapped to any host, so it is not
        # serving anything and is left out unless it is asked for.
        'id': 'ok-luns-healthy',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked 2 LUNs.',
            '11:0 ! LUN001 ! StoragePool001 ! 30.0GiB   ! 100.0GiB ! 30%   ! Normal (1) ! Online (27) ! [OK]',
            # Two LUNs of 100 GiB, 30 GiB and 10 GiB of it allocated.
            "'luns'=2;;;0 'luns_not_ok'=0;;;0 'capacity'=214748364800B;;;0 "
            "'allocated_capacity'=42949672960B;;;0;214748364800 "
            "'usage_percent_max'=30.0%;;;0;100",
        ],
        # The performance data summarizes the LUNs, nothing is reported per LUN.
        'assert-not-in': ['LUN003-unmapped', "'11_"],
    },
    {
        # A LUN over the operator's own threshold has to be marked in the row that
        # caused it, not only in the exit code. The cell used to carry the appliance's
        # own limit alone, so a `--warning` breach was invisible in the table.
        'id': 'warn-usage-over-the-operator-threshold-is-marked',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --warning=1 --critical=99',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '30% [WARNING]',
            '10% [WARNING]',
            # The thresholds that judge each LUN travel with the highest usage.
            "'luns_not_ok'=2;;;0",
            "'usage_percent_max'=30.0%;1;99;0;100",
        ],
    },
    {
        'id': 'ok-include-unmapped',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --include-unmapped',
        'assert-retc': STATE_OK,
        'assert-in': ['Checked 3 LUNs.', 'LUN003-unmapped'],
    },
    {
        'id': 'crit-lun-faulty',
        'test': 'stdout/luns-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors. Checked 2 LUNs.',
            '[CRITICAL]',
            "'luns'=2;;;0 'luns_not_ok'=1;;;0",
        ],
    },
    {
        # A thick LUN has its whole capacity allocated by definition, so reading
        # that as "100% full" would alert on every thick LUN forever.
        'id': 'ok-thick-lun-has-no-usage',
        'test': 'stdout/luns-thick,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --warning=80 --critical=90',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked 1 LUN.',
            '! n/a   !',
            "'allocated_capacity'=107374182400B;;;0;107374182400",
        ],
        # Without a thin LUN there is no usage to report.
        'assert-not-in': ['usage_percent'],
    },
    {
        # The thresholds are off by default, so a full thin LUN only alerts once
        # someone asks for it.
        'id': 'warn-thin-lun-full',
        'test': 'stdout/luns-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --warning=50',
        'assert-retc': STATE_CRIT,
        'assert-in': ['There are critical errors.'],
    },
    {
        # --brief keeps the alerting rows and drops the quiet ones.
        'id': 'crit-brief-hides-ok-rows',
        'test': 'stdout/luns-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --brief',
        'assert-retc': STATE_CRIT,
        'assert-in': ['LUN002'],
        'assert-not-in': ['LUN001 '],
    },
    {
        'id': 'warn-no-match-severity',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        " --match='nonexistent' --no-match-severity=warn",
        'assert-retc': STATE_WARN,
        'assert-in': ['No LUNs matched `nonexistent`.'],
    },
    {
        # The appliance carries its own capacity alarm threshold per LUN (documented
        # for thin LUNs mounted to Windows Server 2012 hosts). It only counts when its
        # switch is on.
        'id': 'ok-lun-below-device-threshold',
        'test': 'stdout/luns-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-not-in': ['[WARNING]'],
    },
    {
        # A LUN that is not mapped is not serving anything, but it only reaches the
        # check at all with --include-unmapped.
        'id': 'ok-unmapped-severity-needs-include',
        'test': 'stdout/luns-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --unmapped-severity=crit',
        'assert-retc': STATE_OK,
    },
    {
        # Real-shape LUNs (V700R001C10SPH128, Dorado 6000 V6), two mapped and one
        # unmapped. The unmapped LUN raises the state through --unmapped-severity
        # alone, so the default table has to show the Mapped column that says why.
        'id': 'warn-unmapped-lun-shows-why',
        'test': 'stdout/luns-v700-one-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --include-unmapped --unmapped-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings. Checked 3 LUNs.',
            'UUID   ! Name   ! Pool           ! Mapped       ! Allocated ! Capacity '
            '! Usage ! Health     ! Running     ! State',
            '11:0   ! lun-01 ! StoragePool001 ! yes          ! 1.7GiB    ! 30.0GiB  '
            '! 5%    ! Normal (1) ! Online (27) ! [OK]',
            '11:129 ! lun-03 ! StoragePool001 ! no [WARNING] ! 0.0B      ! 15.0GiB  '
            '! 0%    ! Normal (1) ! Online (27) ! [WARNING]',
        ],
    },
    {
        # Without --include-unmapped the unmapped LUN is not checked, and a Mapped
        # column reading "yes" on every row would be noise.
        'id': 'ok-mapped-column-only-with-unmapped-rows',
        'test': 'stdout/luns-v700-one-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --unmapped-severity=warn',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked 2 LUNs.'],
        'assert-not-in': ['Mapped', 'lun-03'],
    },
    {
        # Real LUNs (V700R001C10SPH128, Dorado 6000 V6): lun-05 is the unmapped local
        # side of a HyperMetro pair, which the appliance itself alarms on. It is checked
        # without --include-unmapped and warns by default, while the unmapped leftover
        # (lun-07) and the unmapped snapshot (lun-04) stay out. lun-02 is a record the
        # appliance sends without CAPABILITY, OWNINGCONTROLLER and several other fields.
        # The performance data summarizes the five checked LUNs: no status codes and
        # nothing per LUN. The highest usage is lun-06 (92%), which is mapped.
        'id': 'warn-unmapped-hypermetro-lun-by-default',
        'test': 'stdout/luns-v700-hypermetro-snapshot-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings. Checked 5 LUNs. 1 HyperMetro LUN is not mapped to any '
            'host on this array.',
            '11:57   ! lun-02 ! StoragePool001 ! yes                       ! 3.5TiB    '
            '! 16.0TiB  ! 21%   ! Normal (1) ! Online (27) ! [OK]',
            '11:915  ! lun-05 ! StoragePool001 ! no (HyperMetro) [WARNING] ! 1.8TiB    '
            '! 2.0TiB   ! 91%   ! Normal (1) ! Online (27) ! [WARNING]',
            "'luns'=5;;;0 'luns_not_ok'=1;;;0 'capacity'=24758338977792B;;;0 "
            "'allocated_capacity'=10168055988224B;;;0;24758338977792 "
            "'usage_percent_max'=92.0%;;;0;100",
        ],
        'assert-not-in': [
            'lun-04',
            'lun-07',
            'Capacity Alarm',
            "'11_",
            '_health_status',
            '_running_status',
        ],
    },
    {
        'id': 'crit-unmapped-hypermetro-severity',
        'test': 'stdout/luns-v700-hypermetro-snapshot-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --unmapped-hypermetro-severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-in': ['no (HyperMetro) [CRITICAL]'],
    },
    {
        # Muted, the unmapped HyperMetro LUN is still listed, and the Mapped column
        # still says why it differs from the others.
        'id': 'ok-unmapped-hypermetro-severity-ok',
        'test': 'stdout/luns-v700-hypermetro-snapshot-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --unmapped-hypermetro-severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked 5 LUNs.\n', '! no (HyperMetro) !'],
        'assert-not-in': ['is not mapped to any host'],
    },
    {
        # --unmapped-severity covers the leftover and the snapshot, not the HyperMetro
        # LUN, which has a knob of its own.
        'id': 'warn-unmapped-severity-leaves-hypermetro-alone',
        'test': 'stdout/luns-v700-hypermetro-snapshot-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --include-unmapped --unmapped-severity=warn'
        ' --unmapped-hypermetro-severity=ok',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings. Checked 7 LUNs.\n',
            '11:347  ! lun-04 ! StoragePool001 ! no [WARNING]    ! 0.0B      ',
            '11:915  ! lun-05 ! StoragePool001 ! no (HyperMetro) ! 1.8TiB    ',
            '11:1391 ! lun-07 ! StoragePool001 ! no [WARNING]    ! 0.0B      ',
        ],
    },
    {
        # The appliance's own VASA capacity alarm level is shown with --lengthy, but it
        # is not evaluated: lun-03 reports Warning (3) and lun-06 Critical (6), and the
        # check stays OK. lun-02 lacks several fields and must still render.
        'id': 'ok-capacity-alarm-level-shown-not-evaluated',
        'test': 'stdout/luns-v700-hypermetro-snapshot-unmapped,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --lengthy --unmapped-hypermetro-severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': [
            '! Usage ! Capacity Alarm !',
            '11:57   ! lun-02 ! StoragePool001 ! thin ! yes             ! 3.5TiB    '
            '! 16.0TiB  ! 21%   ! Normal (2)     !',
            '! 84%   ! Warning (3)    !',
            '! 92%   ! Critical (6)   !',
        ],
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-lun'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
