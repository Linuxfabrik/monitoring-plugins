import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN

TESTS = [
    {
        # The third LUN of the fixture is not mapped to any host, so it is not
        # serving anything and is left out unless it is asked for.
        'id': 'ok-luns-healthy',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked 2 LUNs.',
            '11:0 ! LUN001 ! StoragePool001 ! 30.0GiB   ! 100.0GiB ! 30%   ! [OK]   ! [OK]',
        ],
        'assert-not-in': ['LUN003-unmapped'],
    },
    {
        'id': 'ok-include-unmapped',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --include-unmapped',
        'assert-retc': STATE_OK,
        'assert-in': ['Checked 3 LUNs.', 'LUN003-unmapped'],
    },
    {
        'id': 'crit-lun-faulty',
        'test': 'stdout/luns-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': ['There are critical errors. Checked 2 LUNs.', '[CRITICAL]'],
    },
    {
        # A thick LUN has its whole capacity allocated by definition, so reading
        # that as "100% full" would alert on every thick LUN forever.
        'id': 'ok-thick-lun-has-no-usage',
        'test': 'stdout/luns-thick,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --warning=80 --critical=90',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked 1 LUN.', '! n/a   !'],
    },
    {
        # The thresholds are off by default, so a full thin LUN only alerts once
        # someone asks for it.
        'id': 'warn-thin-lun-full',
        'test': 'stdout/luns-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --warning=50',
        'assert-retc': STATE_CRIT,
        'assert-in': ['There are critical errors.'],
    },
    {
        # --brief keeps the alerting rows and drops the quiet ones.
        'id': 'crit-brief-hides-ok-rows',
        'test': 'stdout/luns-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --brief',
        'assert-retc': STATE_CRIT,
        'assert-in': ['LUN002'],
        'assert-not-in': ['LUN001 '],
    },
    {
        'id': 'warn-no-match-severity',
        'test': 'stdout/luns-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        " --match='nonexistent' --no-match-severity=warn",
        'assert-retc': STATE_WARN,
        'assert-in': ['No LUNs matched `nonexistent`.'],
    },
    {
        # The appliance carries its own fill threshold per LUN. Honouring it keeps the
        # check and the management GUI from each having their own opinion.
        'id': 'warn-lun-reaches-device-threshold',
        'test': 'stdout/luns-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-not-in': ['[WARNING]'],
    },
    {
        # A LUN that is not mapped is not serving anything, but it only reaches the
        # check at all with --include-unmapped.
        'id': 'ok-unmapped-severity-needs-include',
        'test': 'stdout/luns-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        ' --unmapped-severity=crit',
        'assert-retc': STATE_OK,
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-lun'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
