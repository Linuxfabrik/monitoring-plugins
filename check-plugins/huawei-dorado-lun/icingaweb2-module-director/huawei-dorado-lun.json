    "Datafield": {
        "1": {
            "varname": "huawei_dorado_lun_always_ok",
            "caption": "Huawei Dorado Lun: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3c53d2a3-0f6c-4159-97d0-ad3f8a573712"
        },
        "2": {
            "varname": "huawei_dorado_lun_brief",
            "caption": "Huawei Dorado Lun: Brief?",
            "description": "Hide table rows for LUNs that are ok and show only those in WARN/CRIT state. Perfdata and alerting are unaffected. Worth setting on an array with many LUNs.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7f54649e-f28e-4308-adb7-1eefa762f78b"
        },
        "3": {
            "varname": "huawei_dorado_lun_cache_expire",
            "caption": "Huawei Dorado Lun: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ceb6ed91-6963-47f9-8873-497525c044e5"
        },
        "4": {
            "varname": "huawei_dorado_lun_critical",
            "caption": "Huawei Dorado Lun: Critical",
            "description": "CRIT threshold for the used capacity of a thin LUN, as a Nagios range in percent. Off by default, because a thin LUN that is full is doing what it was created for; what runs out is the pool behind it. Example: `--critical=95`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9d4404bf-ffa3-4235-834a-7e77098dab9e"
        },
        "5": {
            "varname": "huawei_dorado_lun_device_id",
            "caption": "Huawei Dorado Lun: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3bb6e262-bbc3-4a62-9532-55afdffd444a"
        },
        "6": {
            "varname": "huawei_dorado_lun_include_unmapped",
            "caption": "Huawei Dorado Lun: Include Unmapped?",
            "description": "Also check LUNs that are not mapped to any host. Those are not serving anything, so they are left out by default.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "34f3ee32-4316-4d01-888b-193ad4eb5018"
        },
        "7": {
            "varname": "huawei_dorado_lun_ignore",
            "caption": "Huawei Dorado Lun: Ignore",
            "description": "Skip LUNs. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the LUN identifier, the LUN name and the name of its storage pool, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9a686254-028c-495a-ae34-5302314d1858"
        },
        "8": {
            "varname": "huawei_dorado_lun_insecure",
            "caption": "Huawei Dorado Lun: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c027f0fe-cf45-404d-8ad2-f144354b9a2e"
        },
        "9": {
            "varname": "huawei_dorado_lun_lengthy",
            "caption": "Huawei Dorado Lun: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8ebec6f9-7eb7-4186-b95b-6f2d4ad41b2c"
        },
        "10": {
            "varname": "huawei_dorado_lun_match",
            "caption": "Huawei Dorado Lun: Match",
            "description": "Filter by LUNs. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the LUN identifier, the LUN name and the name of its storage pool, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3f8ab167-862a-4679-b72a-0a3ebc515c36"
        },
        "11": {
            "varname": "huawei_dorado_lun_no_insecure",
            "caption": "Huawei Dorado Lun: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0d545980-ce08-4229-ba2d-65ac16bee268"
        },
        "12": {
            "varname": "huawei_dorado_lun_no_match_severity",
            "caption": "Huawei Dorado Lun: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_lun_no_match_severity_list"
            },
            "uuid": "de0af02a-dccb-4858-8254-a4805bfce2ef"
        },
        "13": {
            "varname": "huawei_dorado_lun_no_perfdata",
            "caption": "Huawei Dorado Lun: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "11cbb6c3-e7b3-47e6-a919-ac0869bafef5"
        },
        "14": {
            "varname": "huawei_dorado_lun_no_proxy",
            "caption": "Huawei Dorado Lun: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8ea20955-7c39-4eac-ac1b-4dc137a43b78"
        },
        "15": {
            "varname": "huawei_dorado_lun_password",
            "caption": "Huawei Dorado Lun: Password",
            "description": "Huawei OceanStor Dorado API password. Password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "efd16e6e-b836-4f74-a092-e0b08db7e290"
        },
        "16": {
            "varname": "huawei_dorado_lun_password_file",
            "caption": "Huawei Dorado Lun: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "011e38a5-557e-46a6-a9a2-a70d293bc59d"
        },
        "17": {
            "varname": "huawei_dorado_lun_scope",
            "caption": "Huawei Dorado Lun: Scope",
