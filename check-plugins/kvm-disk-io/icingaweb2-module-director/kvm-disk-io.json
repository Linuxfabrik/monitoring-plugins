    "Datafield": {
        "1": {
            "varname": "kvm_disk_io_always_ok",
            "caption": "KVM Disk I/O: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "72e67f6c-2344-48a0-b0f5-d289e7a94f17"
        },
        "2": {
            "varname": "kvm_disk_io_brief",
            "caption": "KVM Disk I/O: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "bc942f0c-6362-4dd0-b016-c8fd23584ea5"
        },
        "3": {
            "varname": "kvm_disk_io_count",
            "caption": "KVM Disk I/O: Count",
            "description": "Number of measurements the reported values are averaged over. A disk has to stay above a threshold for the whole span to alert, so a single busy minute does not.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c71982ae-a316-4e7c-ae97-cc6452305bfd"
        },
        "4": {
            "varname": "kvm_disk_io_critical_await",
            "caption": "KVM Disk I/O: Critical Await",
            "description": "CRIT threshold for the average time a read or write takes to complete, in milliseconds. Meant for a disk that is effectively hung. Supports Nagios ranges. Default: unset, latency is reported but does not alert",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "58f5f8f8-ee42-427a-8cef-a76d68f6fd55"
        },
        "5": {
            "varname": "kvm_disk_io_critical_throughput",
            "caption": "KVM Disk I/O: Critical Throughput",
            "description": "CRIT threshold for the throughput of a disk, as an absolute rate per second, in human-readable format (base is always 1024; valid qualifiers are B, KiB, MiB, GiB etc., see UNITS.md; a value without a qualifier is a number of bytes). Use it where the backing store has a known limit; `--warning` judges the same value against what the disk has been seen to manage instead. Supports Nagios ranges. Default: unset, throughput is judged against the observed maximum only. Example: `500M` alerts above 500 MiB/s.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "38b121e3-b35d-4944-b9f9-75c686c490d4"
        },
        "6": {
            "varname": "kvm_disk_io_ignore",
            "caption": "KVM Disk I/O: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "de18d240-d6e4-4428-97fb-06fd96fb4895"
        },
        "7": {
            "varname": "kvm_disk_io_lengthy",
            "caption": "KVM Disk I/O: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "9080b6a9-d8d4-4d20-9532-9905b95ee92a"
        },
        "8": {
            "varname": "kvm_disk_io_match",
            "caption": "KVM Disk I/O: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8e8e91e9-56a3-4fa5-aff1-6d5a6800d000"
        },
        "9": {
            "varname": "kvm_disk_io_no_match_severity",
            "caption": "KVM Disk I/O: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "kvm_disk_io_no_match_severity_list"
            },
            "uuid": "6446b3c3-20db-4193-81bd-5ca2aa5e626f"
        },
        "10": {
            "varname": "kvm_disk_io_no_perfdata",
            "caption": "KVM Disk I/O: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8c611187-f3c4-492e-822f-8c8910b3f032"
        },
        "11": {
            "varname": "kvm_disk_io_timeout",
            "caption": "KVM Disk I/O: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b77c265f-b130-405b-9cf6-8c87887981af"
        },
        "12": {
            "varname": "kvm_disk_io_url",
            "caption": "KVM Disk I/O: URL",
            "description": "libvirt connection URI, passed to `virsh --connect`. Use `qemu+ssh://user@host/system` to check a host that runs no local monitoring agent. Only QEMU/KVM connections report the data this check needs.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "310b658b-e74d-4673-94b9-bc066ae9cd01"
        },
        "13": {
            "varname": "kvm_disk_io_warning",
            "caption": "KVM Disk I/O: Warning",
            "description": "WARN threshold for the throughput of a disk, in percent of the most it has ever been seen to deliver. This part never goes critical: a disk working hard is worth a look, not a call at night.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b4de0770-c417-4e3b-8970-f40cef8c2381"
        },
        "14": {
            "varname": "kvm_disk_io_warning_await",
            "caption": "KVM Disk I/O: Warning Await",
            "description": "WARN threshold for the average time a read or write takes to complete, in milliseconds. Supports Nagios ranges. Default: unset, latency is reported but does not alert",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2f52b439-cc93-499f-9070-ac2014ad0592"
        },
        "15": {
            "varname": "kvm_disk_io_warning_throughput",
            "caption": "KVM Disk I/O: Warning Throughput",
            "description": "WARN threshold for the throughput of a disk, as an absolute rate per second, in human-readable format (base is always 1024; valid qualifiers are B, KiB, MiB, GiB etc., see UNITS.md; a value without a qualifier is a number of bytes). Use it where the backing store has a known limit; `--warning` judges the same value against what the disk has been seen to manage instead. Supports Nagios ranges. Default: unset, throughput is judged against the observed maximum only. Example: `400M` alerts above 400 MiB/s.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0eb02115-a10b-4364-bca2-ef9a9a59b2b1"
        }
    }
}
