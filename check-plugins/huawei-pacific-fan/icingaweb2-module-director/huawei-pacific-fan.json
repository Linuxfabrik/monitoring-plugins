            "uuid": "847fce4e-da13-4a50-9c0d-f7a44da1cc67"
        },
        "3": {
            "varname": "huawei_pacific_fan_ignore",
            "caption": "Huawei Pacific Fan: Ignore",
            "description": "Skip fans. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `frame_sn`, `name`, `node`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a2c01e0a-a49f-47f9-9f12-f9ca48be8567"
        },
        "4": {
            "varname": "huawei_pacific_fan_insecure",
            "caption": "Huawei Pacific Fan: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7343db0f-57c8-494d-8a3c-3c04e648a0d4"
        },
        "5": {
            "varname": "huawei_pacific_fan_lengthy",
            "caption": "Huawei Pacific Fan: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "31b25705-43a0-4081-8529-604c880f42f0"
        },
        "6": {
            "varname": "huawei_pacific_fan_no_insecure",
            "caption": "Huawei Pacific Fan: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "80d7a159-8bba-46e9-bcef-176e0c03e6be"
        },
        "7": {
            "varname": "huawei_pacific_fan_match",
            "caption": "Huawei Pacific Fan: Match",
            "description": "Limit to fans. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `frame_sn`, `name`, `node`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fc81ea25-655a-445f-98ed-4396d37f3b2b"
        },
        "8": {
            "varname": "huawei_pacific_fan_no_match_severity",
            "caption": "Huawei Pacific Fan: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_fan_no_match_severity_list"
            },
            "uuid": "a0272fed-ac34-4e61-919f-55916f2cbed0"
        },
        "9": {
            "varname": "huawei_pacific_fan_no_perfdata",
            "caption": "Huawei Pacific Fan: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "e787c1c9-21c4-4a03-ba34-9f7a79d796f0"
        },
        "10": {
            "varname": "huawei_pacific_fan_no_proxy",
