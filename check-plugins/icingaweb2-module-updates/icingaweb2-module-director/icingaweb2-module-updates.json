    "Datafield": {
        "1": {
            "varname": "icingaweb2_module_updates_always_ok",
            "caption": "Icingaweb2 Module Updates: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "86ecf90c-0d89-4fd3-897a-28529cc34100"
        },
        "2": {
            "varname": "icingaweb2_module_updates_branch",
            "caption": "Icingaweb2 Module Updates: Branch",
            "description": "Name of the development branch `--check-branch` compares against. `main` and `master` stand in for each other, so the default already covers repositories that disagree on the name and this rarely has to be set. Example: `--branch=develop`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "824d1d30-c32d-445e-b153-948914b17727"
        },
        "3": {
            "varname": "icingaweb2_module_updates_cache_expire",
            "caption": "Icingaweb2 Module Updates: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "db0900f2-9586-4b28-96cf-55003a859a30"
        },
        "4": {
            "varname": "icingaweb2_module_updates_check_branch",
            "caption": "Icingaweb2 Module Updates: Check Branch?",
            "description": "Also report how far behind its development branch each module is, as a number of commits. Costs one additional API request per module. Name the branch with `--branch`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "05177209-d65e-4dd2-a041-3e63dde84785"
        },
        "5": {
            "varname": "icingaweb2_module_updates_critical",
            "caption": "Icingaweb2 Module Updates: Critical",
            "description": "CRIT threshold for the number of commits a module is behind its branch. Supports Nagios ranges. Only used with `--check-branch`. Default: no critical threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c6bb6ada-c7ab-4e1d-8ab9-f05e3356a8ee"
        },
        "6": {
            "varname": "icingaweb2_module_updates_ignore",
            "caption": "Icingaweb2 Module Updates: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b94ff04f-38b9-4d00-87a1-50c603ebe4cf"
        },
        "7": {
            "varname": "icingaweb2_module_updates_include_packaged",
            "caption": "Icingaweb2 Module Updates: Include Packaged?",
            "description": "Compare modules that came from an RPM or DEB package against GitHub too. Without this they are listed but not compared, because the distribution decides their version and `rpm-updates` or `deb-updates` already reports those updates.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d446fc85-2a0d-457b-aca3-94723ec6278e"
        },
        "8": {
            "varname": "icingaweb2_module_updates_insecure",
            "caption": "Icingaweb2 Module Updates: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ac674690-baa2-4c50-960a-603d7d3da3ac"
        },
        "9": {
            "varname": "icingaweb2_module_updates_lengthy",
            "caption": "Icingaweb2 Module Updates: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8453493f-588a-4e5f-a63c-57d48a995390"
        },
        "10": {
            "varname": "icingaweb2_module_updates_match",
            "caption": "Icingaweb2 Module Updates: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "16bf983e-0b97-467a-9e8a-980c0723ad23"
        },
        "11": {
            "varname": "icingaweb2_module_updates_no_match_severity",
            "caption": "Icingaweb2 Module Updates: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "icingaweb2_module_updates_no_match_severity_list"
            },
            "uuid": "f3619061-1ae6-4c17-9ccd-7777f8ba8970"
        },
        "12": {
            "varname": "icingaweb2_module_updates_no_perfdata",
            "caption": "Icingaweb2 Module Updates: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d4ddc880-56ec-41c2-8e4f-717b64c0159e"
        },
        "13": {
            "varname": "icingaweb2_module_updates_no_proxy",
            "caption": "Icingaweb2 Module Updates: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3d924262-47cc-4fb4-bc40-0f6c882f6b4b"
        },
        "14": {
            "varname": "icingaweb2_module_updates_no_version_severity",
            "caption": "Icingaweb2 Module Updates: No Version Severity",
            "description": "State to report for a module whose version cannot be compared, which is what a Git checkout reporting its branch name instead of a version looks like, and a module shipping no module.info at all.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "icingaweb2_module_updates_no_version_severity_list"
            },
            "uuid": "1869509b-23a8-4e6e-b783-c8373b908b3f"
        },
        "15": {
            "varname": "icingaweb2_module_updates_path",
            "caption": "Icingaweb2 Module Updates: Path",
            "description": "Directory holding the Icinga Web 2 modules. Set this where `module_path` in `/etc/icingaweb2/config.ini` names another one. Can be specified multiple times. Default: /usr/share/icingaweb2/modules",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "84e5c09f-bfa0-4b67-a517-801fa60871bc"
        },
        "16": {
            "varname": "icingaweb2_module_updates_repo",
            "caption": "Icingaweb2 Module Updates: Repo",
            "description": "Where a module is published, as `module, user/repository`. Adds a module the check does not know, and overrides one it does. Can be specified multiple times. Example: `--repo=\"mymodule, ExampleOrg/icingaweb2-module-mymodule\"`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ec16a7d9-5970-464a-a1db-44898594e628"
        },
        "17": {
            "varname": "icingaweb2_module_updates_timeout",
            "caption": "Icingaweb2 Module Updates: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "04b52a88-9bdc-4cd2-85ae-4991e05faecc"
        },
        "18": {
            "varname": "icingaweb2_module_updates_token",
            "caption": "Icingaweb2 Module Updates: Token",
            "description": "GitHub API token. Raises the API limit from 60 requests per hour and IP address to 5000. Passed here, the token is visible to every user on this host for as long as the check runs, because a command-line argument shows up in the process list; prefer --token-file.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "8ba736aa-fcf7-46fc-a57a-82db8952e403"
        },
        "19": {
            "varname": "icingaweb2_module_updates_token_file",
            "caption": "Icingaweb2 Module Updates: Token File",
            "description": "Path to a file holding the GitHub API token, read from its first line. Keeps the token out of the process list, where a command line argument is visible to every user on this host. Takes precedence over `--token`. Example: `--token-file=/etc/icinga2/secrets/github`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "45bcb2be-a302-48a4-9849-64cf936c9e81"
        },
        "20": {
            "varname": "icingaweb2_module_updates_unknown_repo_severity",
            "caption": "Icingaweb2 Module Updates: Unknown Repo Severity",
            "description": "State to report for a module the check has no repository for. Supply one with `--repo` to have the module compared.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "icingaweb2_module_updates_unknown_repo_severity_list"
            },
            "uuid": "2466c399-d73b-4062-a119-f1eb7e885de8"
        },
        "21": {
            "varname": "icingaweb2_module_updates_unreachable_severity",
            "caption": "Icingaweb2 Module Updates: Unreachable Severity",
            "description": "State to report when the online source is unreachable. What is used instead - bundled offline data, a cached copy, or nothing at all - is named in the output, and a clean result then only covers what that fallback could confirm.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "icingaweb2_module_updates_unreachable_severity_list"
            },
            "uuid": "955ead79-19c9-4d6d-a488-a5736dd04bcd"
        },
        "22": {
            "varname": "icingaweb2_module_updates_warning",
            "caption": "Icingaweb2 Module Updates: Warning",
            "description": "WARN threshold for the number of commits a module is behind its branch. Supports Nagios ranges. Only used with `--check-branch`. Default: no warning threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "047785f5-3630-4883-a102-5f613ca7c189"
        }
    }
}
