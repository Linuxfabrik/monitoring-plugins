    "ServiceTemplate": {
        "tpl-service-icingaweb2-module-updates": {
            "action_url": null,
            "apply_for": null,
            "assign_filter": null,
            "check_command": "cmd-check-icingaweb2-module-updates",
            "check_interval": 86400,
            "check_period": null,
            "check_timeout": null,
            "command_endpoint": null,
            "disabled": false,
            "display_name": null,
            "enable_active_checks": null,
            "enable_event_handler": null,
            "enable_flapping": null,
            "enable_notifications": true,
            "enable_passive_checks": null,
            "enable_perfdata": true,
            "event_command": null,
            "fields": [],
            "flapping_threshold_high": null,
            "flapping_threshold_low": null,
            "groups": [],
            "host": null,
            "icon_image": "icingaweb2-module-updates.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Checks the Icinga Web 2 modules installed on this host against their releases on GitHub, so a module installed from a tarball or a Git checkout does not quietly fall behind. Modules that belong to a distribution package are left to the package manager and reported as such, which is why the check stays silent on a host whose modules all come from packages. Optionally reports how many commits a module trails a development branch by. Alerts when a module is behind its latest release. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/icingaweb2-module-updates/",
            "object_name": "tpl-service-icingaweb2-module-updates",
            "object_type": "template",
            "retry_interval": 300,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "icingaweb2_module_updates_always_ok": false,
                "icingaweb2_module_updates_branch": "main",
                "icingaweb2_module_updates_cache_expire": 1440,
                "icingaweb2_module_updates_check_branch": true,
                "icingaweb2_module_updates_ignore": [],
                "icingaweb2_module_updates_include_packaged": false,
                "icingaweb2_module_updates_insecure": false,
                "icingaweb2_module_updates_lengthy": false,
                "icingaweb2_module_updates_match": [],
                "icingaweb2_module_updates_no_match_severity": "ok",
                "icingaweb2_module_updates_no_perfdata": false,
                "icingaweb2_module_updates_no_proxy": false,
                "icingaweb2_module_updates_no_version_severity": "ok",
                "icingaweb2_module_updates_path": [],
                "icingaweb2_module_updates_repo": [],
                "icingaweb2_module_updates_timeout": 8,
                "icingaweb2_module_updates_unknown_repo_severity": "ok",
                "icingaweb2_module_updates_unreachable_severity": "ok"
            },
            "volatile": null,
            "zone": null,
            "uuid": "0f2710dc-f256-48d1-8d33-6a31c61ced63"
        }
    },
