"""Integration tests for the mysql-storage-engines check plugin.

The plugin opens a real `pymysql` connection and introspects
`information_schema.tables`, `SHOW ENGINES`, `SHOW VARIABLES` and
`SHOW DATABASES`, so a static fixture cannot drive it - we spin up
an actual MariaDB server and let the plugin talk to it over TCP.

Per CONTRIBUTING's "Combine container tests with fixtures" rule,
this file holds only the happy-path integration test. We seed the
container's `test` DB with one empty InnoDB table so the plugin
sees at least one table on the default engine - otherwise it would
warn "InnoDB is enabled but isn't being used. Add skip-innodb to ...".

The test matrix is defined by the Containerfiles under
`containerfiles/`. Each file is a Containerfile (typically a
one-line `FROM`) and gets built once via testcontainers'
DockerImage (cached across runs). Add a new MariaDB LTS by
dropping in a new Containerfile; retire one by deleting the file.

Requirements:
- podman (or docker) with a reachable socket
- `pip install testcontainers`
- `tools/run-unit-tests` auto-sets `CONTAINER_HOST` and
  `TESTCONTAINERS_RYUK_DISABLED`
"""

import os
import subprocess
import sys
import unittest

sys.path.insert(0, '..')

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
CONTAINERFILES_DIR = os.path.join(HERE, 'containerfiles')
CONTAINERFILES = sorted(
    name
    for name in os.listdir(CONTAINERFILES_DIR)
    if os.path.isfile(os.path.join(CONTAINERFILES_DIR, name))
)


class TestCheck(unittest.TestCase):
    pass


def _check_image(test, containerfile):
    path = os.path.join(CONTAINERFILES_DIR, containerfile)
    print(f'\n=== Testing {containerfile} ===', flush=True)
    with lib.lftest.run_mysql_compatible_from_containerfile(
        path,
        seed='CREATE TABLE seed_innodb (id INT PRIMARY KEY) ENGINE=InnoDB',
    ) as (_container, defaults_file):

        def run(*extra_args):
            cmd = [
                'python3',
                '../mysql-storage-engines',
                f'--defaults-file={defaults_file}',
                *extra_args,
            ]
            print(f'Run plugin: {" ".join(cmd)}', flush=True)
            result = subprocess.run(
                cmd,
                cwd=os.path.dirname(os.path.abspath(__file__)),
                capture_output=True,
                text=True,
            )
            combined = result.stdout + result.stderr
            print(f'Script output:\n{combined.strip()}', flush=True)
            return result.returncode, combined

        returncode, combined = run()
        test.assertEqual(returncode, STATE_OK)
        test.assertIn('Everything is ok.', combined)
        test.assertIn('1 table across 1 engine', combined)

        # --lengthy renders the per-engine table, which is where the engine
        # name shows up at all.
        returncode, combined = run('--lengthy')
        test.assertEqual(returncode, STATE_OK)
        test.assertIn('InnoDB', combined)

        # Filtering away the only InnoDB table leaves the server with InnoDB
        # enabled but unused, which is exactly the WARN path. Proves the
        # per-engine aggregate is built from the surviving tables.
        returncode, combined = run(r'--ignore=^test\.')
        test.assertEqual(returncode, STATE_WARN)
        test.assertIn('no `InnoDB` tables exist', combined)

        # --match keeps it, so the aggregate is not simply dropping
        # everything it sees.
        returncode, combined = run(r'--match=^test\.seed_innodb$', '--lengthy')
        test.assertEqual(returncode, STATE_OK)
        test.assertIn('InnoDB', combined)
        test.assertIn('1 table across 1 engine', combined)

        # The deprecated, hidden --ignore-tables still filters on the bare
        # table name.
        returncode, combined = run('--ignore-tables=^seed_innodb$')
        test.assertEqual(returncode, STATE_WARN)
        test.assertIn('no `InnoDB` tables exist', combined)

        # An unparseable regex is a configuration error, not a finding.
        returncode, combined = run('--match=[')
        test.assertEqual(returncode, STATE_UNKNOWN)
        test.assertIn('--match', combined)


lib.lftest.attach_each(TestCheck, CONTAINERFILES, _check_image)


if __name__ == '__main__':
    unittest.main()
