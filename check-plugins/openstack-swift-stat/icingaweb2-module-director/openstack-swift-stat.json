    "Datafield": {
        "1": {
            "varname": "openstack_swift_stat_always_ok",
            "caption": "Openstack Swift Stat: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4ecf6873-9c6b-470c-bb83-da31e79735ce"
        },
        "2": {
            "varname": "openstack_swift_stat_brief",
            "caption": "Openstack Swift Stat: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "828c8fa9-84bf-44a0-ab2b-4f988d3486cc"
        },
        "3": {
            "varname": "openstack_swift_stat_cache_expire",
            "caption": "Openstack Swift Stat: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d0bdb7da-917c-4da8-8fb1-8c6106e501a5"
        },
        "4": {
            "varname": "openstack_swift_stat_critical",
            "caption": "Openstack Swift Stat: Critical",
            "description": "CRIT threshold for remaining free space, in GiB. Only applies to containers that have a quota set.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fdcfa197-d988-4c83-856b-99368bdee9f3"
        },
        "5": {
            "varname": "openstack_swift_stat_critical_count",
            "caption": "Openstack Swift Stat: Critical Count",
            "description": "CRIT threshold for the remaining number of objects a container may still take. Only applies to containers that have an object count quota set.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f8476b3e-2ae8-4b60-bd36-2975db8055ae"
        },
        "6": {
            "varname": "openstack_swift_stat_ignore",
            "caption": "Openstack Swift Stat: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the container name.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "85657700-1c01-4b5f-aacc-f4c5f849ed99"
        },
        "7": {
            "varname": "openstack_swift_stat_insecure",
            "caption": "Openstack Swift Stat: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "802ba637-ca96-4d39-90c8-9723344bc869"
        },
        "8": {
            "varname": "openstack_swift_stat_lengthy",
            "caption": "Openstack Swift Stat: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "e334df9b-c7a0-42ed-9ef2-de032ed72f96"
        },
        "9": {
            "varname": "openstack_swift_stat_match",
            "caption": "Openstack Swift Stat: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the container name.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0077550a-f7ed-4b34-8325-92720485a3e6"
        },
        "10": {
            "varname": "openstack_swift_stat_no_match_severity",
            "caption": "Openstack Swift Stat: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "openstack_swift_stat_no_match_severity_list"
            },
            "uuid": "f675bd33-caf0-4633-acd4-d28c9b4a9501"
        },
        "11": {
            "varname": "openstack_swift_stat_no_perfdata",
            "caption": "Openstack Swift Stat: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "30311b0c-b005-4943-aa48-1ecccef0ee98"
        },
        "12": {
            "varname": "openstack_swift_stat_no_proxy",
            "caption": "Openstack Swift Stat: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fe9aa6de-6489-4de4-b4f7-f3e4f963a803"
        },
        "13": {
            "varname": "openstack_swift_stat_proxy",
            "caption": "Openstack Swift Stat: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "cbee3f68-3384-47eb-bff7-207ad8577587"
        },
        "14": {
            "varname": "openstack_swift_stat_rc_file",
            "caption": "Openstack Swift Stat: Rc File",
            "description": "Path to a rc file containing OpenStack connection parameters like OS_USERNAME (instead of specifying them on the command line). Example: `--rc-file=/var/spool/icinga2/.openstack.cnf`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "82bbe4ec-0447-443f-96d7-eb7c0b2d9325"
        },
        "15": {
            "varname": "openstack_swift_stat_timeout",
            "caption": "Openstack Swift Stat: Timeout",
            "description": "Network timeout in seconds. Applies to the whole run, not to a single request.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5381aead-532b-4161-9af8-8e1025060b92"
        },
        "16": {
            "varname": "openstack_swift_stat_warning_count",
            "caption": "Openstack Swift Stat: Warning Count",
            "description": "WARN threshold for the remaining number of objects a container may still take. Only applies to containers that have an object count quota set.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2c14817c-0468-4608-b710-c2a5f39ad447"
        },
        "17": {
            "varname": "openstack_swift_stat_warning",
            "caption": "Openstack Swift Stat: Warning",
            "description": "WARN threshold for remaining free space, in GiB. Only applies to containers that have a quota set.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e144fa43-88c7-4093-b041-1af6348bfbaa"
        }
    }
