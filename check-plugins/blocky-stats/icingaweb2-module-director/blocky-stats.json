    "Datafield": {
        "1": {
            "varname": "blocky_stats_always_ok",
            "caption": "Blocky Stats: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c8b7f9ee-7437-4682-adcc-6cd8ac02a089"
        },
        "2": {
            "varname": "blocky_stats_critical",
            "caption": "Blocky Stats: Critical",
            "description": "CRIT threshold for the share of failed queries since the last check run, in percent. A query fails when no upstream resolver answers it, and the client gets SERVFAIL. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3bb186ed-ca56-4d69-8d23-270796541aab"
        },
        "3": {
            "varname": "blocky_stats_insecure",
            "caption": "Blocky Stats: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4ed53f71-aaec-4db7-b28d-4e5371619452"
        },
        "4": {
            "varname": "blocky_stats_no_perfdata",
            "caption": "Blocky Stats: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8ce7f8ab-9f5d-4f3c-bdbb-154446b38423"
        },
        "5": {
            "varname": "blocky_stats_no_proxy",
            "caption": "Blocky Stats: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "948250df-c617-4b43-ad45-e5fb6e1549d2"
        },
        "6": {
            "varname": "blocky_stats_proxy",
            "caption": "Blocky Stats: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "71cf6544-d8d5-444b-bb32-21683a5505d8"
        },
        "7": {
            "varname": "blocky_stats_timeout",
            "caption": "Blocky Stats: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "28039227-3c12-4351-b992-ac58d8d6d5e2"
        },
        "8": {
            "varname": "blocky_stats_url",
            "caption": "Blocky Stats: URL",
            "description": "blocky Prometheus metrics endpoint, served on the HTTP port (`ports.http`) under the path set in `prometheus.path`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3765e22b-e6e0-44ad-a7a3-277440988cb7"
        },
        "9": {
            "varname": "blocky_stats_warning",
            "caption": "Blocky Stats: Warning",
            "description": "WARN threshold for the share of failed queries since the last check run, in percent. A query fails when no upstream resolver answers it, and the client gets SERVFAIL. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "58b61ea0-f36a-48ee-a477-ea13800737e6"
        },
        "10": {
            "varname": "blocky_stats_warning_age",
            "caption": "Blocky Stats: Warning Age",
            "description": "WARN threshold for the time since blocky last refreshed a deny- or allowlist successfully. A blocky that cannot download its lists keeps blocking with the entries it has, so the lists silently grow stale. A duration such as `12h`, `8D` or `2W`; `0D` disables the age check. Example: `--warning-age=12h` for lists refreshed every hour.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a41fef18-0b2c-440d-a5f8-08acb950c882"
        }
    }
