            "icon_image": "blocky-stats.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Monitors a blocky DNS proxy and ad-blocker through its Prometheus metrics endpoint. Reports the queries per second, the share of blocked, cached and failed queries, the average time the upstream resolvers take to answer and the size of the deny- and allowlists, measured between two consecutive check runs. Alerts when the share of failed queries exceeds the warning or critical threshold, when blocking is disabled, or when the lists have not been refreshed for too long. Requires `prometheus.enable: true` and an HTTP port in the blocky configuration.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/blocky-stats/",
            "object_name": "tpl-service-blocky-stats",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "blocky_stats_always_ok": false,
                "blocky_stats_critical": "50",
                "blocky_stats_insecure": false,
                "blocky_stats_no_perfdata": false,
                "blocky_stats_no_proxy": false,
                "blocky_stats_timeout": 3,
                "blocky_stats_url": "http://localhost:4000/metrics",
                "blocky_stats_warning": "5",
                "blocky_stats_warning_age": "1D"
            },
            "volatile": null,
            "zone": null,
            "uuid": "1a298575-5864-4e74-bbf3-5f54425f8783"
        }
