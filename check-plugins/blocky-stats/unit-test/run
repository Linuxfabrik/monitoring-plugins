"""Unit tests for blocky-stats.

The fixtures are `/metrics` payloads of real blocky containers (v0.24, v0.25,
v0.35.0, v0.36.0), recorded after a handful of queries. `v0-36-0-lists-stale`
is `v0-36-0-healthy` with the list refresh timestamp moved two days back, and
`not-blocky` is a node exporter line. Under `--test`, the plugin takes the
previous run as all counters at zero 60 seconds earlier and a fixed current
time, so the rates and the list age do not depend on when the tests run.

The container tests run the plugin against every blocky release in `IMAGES`, started
with `fixtures/blocky.yml`: once before any query, then after a query for a blocked
name, so a change of the metrics in a new release fails here first.
"""

import json
import os
import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import sys
import tempfile
import time
import urllib.request

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'ok-v0-36-0-healthy',
        'test': 'stdout/v0-36-0-healthy,,0',
        'params': '',
        'assert-retc': STATE_OK,
        # the first line stays short, the times and list sizes go into the perfdata
        'assert-regex': r'^0\.1 queries/s, 14\.3% blocked, 28\.6% cached, 0\.0% failed '
        r'\(blocky v0\.36\.0\)\n',
        'assert-in': [
            "'queries_per_second'=0.117;;;0",
            "'resolve_time'=0.003448s;;;0",
            "'failed'=0.0%;5;50;0;100",
        ],
        'assert-not-in': ['[WARNING]'],
    },
    {
        'id': 'ok-v0-25-oldest-supported',
        'test': 'stdout/v0-25-healthy,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['(blocky v0.25)', "'denylist_entries'=2;;;0"],
    },
    {
        # blocky v0.35.0 with a denylist group whose only list cannot be downloaded
        'id': 'ok-v0-35-0-empty-denylist-group',
        'test': 'stdout/v0-35-0-healthy,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-not-in': ['[WARNING]'],
    },
    {
        # an empty denylist group is listed, but not alerted on
        'id': 'ok-empty-denylist-group',
        'test': 'stdout/v0-36-0-empty-denylist-group,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-regex': r'(?m)^broken\s+! -\s+! 0\|',
        'assert-not-in': ['[WARNING]'],
    },
    {
        'id': 'warn-blocking-disabled',
        'test': 'stdout/v0-36-0-blocking-disabled,,0',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-regex': r'^Blocking is disabled for some or all groups \[WARNING\]',
    },
    {
        'id': 'crit-upstreams-unreachable',
        'test': 'stdout/v0-36-0-upstreams-unreachable,,0',
        'params': '',
        'assert-retc': STATE_CRIT,
        'assert-in': ['85.7% failed [CRITICAL]'],
        # no query reached an upstream, so there is no upstream time to report
        'assert-not-in': ['upstream', 'resolve_time'],
    },
    {
        'id': 'warn-upstreams-unreachable-custom-thresholds',
        'test': 'stdout/v0-36-0-upstreams-unreachable,,0',
        'params': '--warning=50 --critical=90',
        'assert-retc': STATE_WARN,
        'assert-in': ['85.7% failed [WARNING]', "'failed'=85.7%;50;90;0;100"],
    },
    {
        'id': 'ok-always-ok-masks-crit',
        'test': 'stdout/v0-36-0-upstreams-unreachable,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['[CRITICAL]'],
    },
    {
        'id': 'crit-no-perfdata',
        'test': 'stdout/v0-36-0-upstreams-unreachable,,0',
        'params': '--no-perfdata',
        'assert-retc': STATE_CRIT,
        'assert-not-in': ['|'],
    },
    {
        'id': 'warn-lists-stale',
        'test': 'stdout/v0-36-0-lists-stale,,0',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'Lists last refreshed 2D ago [WARNING]',
            "'list_age'=172800s;86400;;0",
        ],
    },
    {
        'id': 'ok-lists-stale-age-check-disabled',
        'test': 'stdout/v0-36-0-lists-stale,,0',
        'params': '--warning-age=0D',
        'assert-retc': STATE_OK,
        'assert-in': ["'list_age'=172800s;;;0"],
    },
    {
        'id': 'ok-lists-stale-below-custom-age',
        'test': 'stdout/v0-36-0-lists-stale,,0',
        'params': '--warning-age=3D',
        'assert-retc': STATE_OK,
    },
    {
        'id': 'unknown-v0-24-old-metric-names',
        'test': 'stdout/v0-24-old-metric-names,,0',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['metric names from before v0.25'],
    },
    {
        'id': 'unknown-not-blocky',
        'test': 'stdout/not-blocky,,0',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['does not serve blocky metrics'],
    },
]


IMAGES = [
    'ghcr.io/0xerr0r/blocky:v0.25',
    'ghcr.io/0xerr0r/blocky:v0.26',
    'ghcr.io/0xerr0r/blocky:v0.29.0',
    'ghcr.io/0xerr0r/blocky:v0.30.0',
    'ghcr.io/0xerr0r/blocky:v0.32.0',
    'ghcr.io/0xerr0r/blocky:v0.35.0',
    'ghcr.io/0xerr0r/blocky:v0.36.0',
]

HERE = os.path.dirname(os.path.abspath(__file__))


class TestCheck(unittest.TestCase):
    check = '../blocky-stats'


def _run_plugin(url, tmpdir):
    result = subprocess.run(  # nosec B603 - argv list, no shell
        ['../blocky-stats', f'--url={url}'],
        cwd=HERE,
        # a state database of its own, so an earlier run cannot make up the rates
        env={**os.environ, 'TMPDIR': tmpdir},
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode, result.stdout + result.stderr


def _check_image(test, image):
    lib.lftest.require_container_runtime()
    version = image.rsplit(':', 1)[1]
    with (
        tempfile.TemporaryDirectory() as tmpdir,
        lib.lftest.run_container(
            image,
            ports=[4000],
            volumes=[(os.path.join(HERE, 'fixtures/blocky.yml'), '/app/config.yml')],
            wait_log='http server is up and running',
        ) as container,
    ):
        base = (
            f'http://{container.get_container_host_ip()}'
            f':{container.get_exposed_port(4000)}'
        )
        retc, output = _run_plugin(f'{base}/metrics', tmpdir)
        test.assertEqual(retc, STATE_OK, output)
        test.assertIn(f'Waiting for more data (blocky {version})', output)
        test.assertIn("'denylist_entries'=2;;;0", output)

        request = urllib.request.Request(
            f'{base}/api/query',
            data=json.dumps({'query': 'ads.example.com', 'type': 'A'}).encode(),
            headers={'Content-Type': 'application/json'},
        )
        with urllib.request.urlopen(request, timeout=5) as response:  # nosec B310
            test.assertIn(b'BLOCKED', response.read())
        # the rates need the two runs at least a second apart
        time.sleep(2)

        retc, output = _run_plugin(f'{base}/metrics', tmpdir)
        test.assertEqual(retc, STATE_OK, output)
        test.assertRegex(
            output, r'^\S+ queries/s, 100\.0% blocked, 0\.0% cached, 0\.0% failed'
        )
        test.assertIn("'allowlist_entries'=1;;;0", output)


lib.lftest.attach_tests(TestCheck, TESTS)
lib.lftest.attach_each(
    TestCheck,
    IMAGES,
    _check_image,
    id_func=lambda image: 'ok_container_' + image.rsplit(':', 1)[1].replace('.', '_'),
)


if __name__ == '__main__':
    unittest.main()
