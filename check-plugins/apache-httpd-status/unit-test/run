import os
import sys
import time
import unittest

sys.path.insert(0, '..')

import lib.db_sqlite
import lib.disk
import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# What a `server-status?auto` response contains varies along five axes that are
# independent of each other, which is why the fixtures cover a matrix rather than a
# sequence: the ExtendedStatus setting, the MPM (only `event` reports processes and
# connections), the httpd version (the identity block and the CPU breakdown came with
# 2.4.13, `Total Duration` plus `Processes`/`Stopping` with 2.4.35, `GracefulWorkers`
# with 2.4.58, `ConnsAsyncWaitIO` with 2.4.63, all of them backported by distributions),
# the run state (a freshly started httpd omits `CPULoad`), and which other modules are
# loaded (mod_ssl, mod_cache_socache, mod_md, mod_proxy and third parties append blocks
# of their own through `ap_run_status_hook()`).
#
# The oldest rungs matter because they are what a plugin gets wrong quietly: httpd 2.2
# (CentOS 6) has no identity block, no load averages and no CPU breakdown, and 2.4.10
# (Debian 8) has the connection counters but not yet the identity block.
#
# Fixtures are named `<os>-httpd-<version>-<mpm>-ext-<on|off>[-<variant>][-<n>]` and
# were captured against real podman containers.
#
# Every testcase passes its own `--url`. The plugin keys its rate cache by URL, so a
# unique URL gives a testcase a baseline of its own and keeps it independent of whatever
# ran before it. The rate scenarios at the bottom use that deliberately the other way
# round: their steps share one URL so the second step finds the first one's sample.

FIXTURE_ROOT = 'stdout'
URL = 'http://localhost/server-status'


def _cache_db():
    # Resolve via the lib so the reset below removes the exact file the plugin uses,
    # including the secured per-user directory db_sqlite stores it in.
    filename = 'linuxfabrik-monitoring-plugins-apache-httpd-status.db'
    ok, db_path = lib.db_sqlite.get_db_path(filename=filename)
    return db_path if ok else os.path.join(lib.disk.get_tmpdir(), filename)


CACHE_DB = _cache_db()


# One entry per captured platform: (fixture, expected worker usage in the first line).
# Covers "this vendor's output parses and the plugin reads the right number of worker
# slots out of it". Behaviour that is not platform specific is asserted in TESTS below.
PLATFORMS = [
    ('centos6-httpd-2.2.15-prefork-ext-off', '0.4% worker usage (1/256)'),
    ('centos6-httpd-2.2.15-prefork-ext-on-2', '0.4% worker usage (1/256)'),
    ('debian8-httpd-2.4.10-event-ext-off', '0.7% worker usage (1/150)'),
    ('debian8-httpd-2.4.10-event-ext-on-2', '0.7% worker usage (1/150)'),
    ('debian9-httpd-2.4.25-event-ext-off', '0.7% worker usage (1/150)'),
