    ('rhel9-httpd-2.4.62-event-ext-off', '0.2% worker usage (1/400)'),
    ('rhel9-httpd-2.4.62-event-ext-on-3', '0.2% worker usage (1/400)'),
    ('rhel9-httpd-2.4.62-prefork-ext-on-2', '0.4% worker usage (1/256)'),
    ('rhel10-httpd-2.4.63-event-ext-off', '0.2% worker usage (1/400)'),
    ('rhel10-httpd-2.4.63-event-ext-on-3', '0.2% worker usage (1/400)'),
]


TESTS = [
    # The same fixture at 81.8% worker usage, driven through all three states.
    {
        'id': 'ok-below-warn',
        'test': f'{FIXTURE_ROOT}/fedora34-httpd-2.4.48-worker-ext-on-3,,0',
        'params': '--url=http://example.com/ok-below-warn --warning=90 --critical=95',
        'assert-retc': STATE_OK,
        'assert-in': ['81.8% worker usage (327/400)'],
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    {
        'id': 'warn-above-warn',
        'test': f'{FIXTURE_ROOT}/fedora34-httpd-2.4.48-worker-ext-on-3,,0',
        'params': '--url=http://example.com/warn-above-warn --warning=80 --critical=95',
        'assert-retc': STATE_WARN,
        'assert-in': ['81.8% worker usage (327/400) [WARNING]'],
    },
    {
        'id': 'crit-above-crit',
        'test': f'{FIXTURE_ROOT}/fedora34-httpd-2.4.48-worker-ext-on-3,,0',
        'params': '--url=http://example.com/crit-above-crit --warning=50 --critical=75',
        'assert-retc': STATE_CRIT,
        'assert-in': ['81.8% worker usage (327/400) [CRITICAL]'],
    },
    {
        # Nagios range: alert while usage sits outside 20..90, so 81.8% is fine but a
        # nearly idle server is not.
        'id': 'ok-nagios-range-inside',
        'test': f'{FIXTURE_ROOT}/fedora34-httpd-2.4.48-worker-ext-on-3,,0',
        'params': '--url=http://example.com/in-range --warning=20:90 --critical=10:95',
        'assert-retc': STATE_OK,
    },
    {
        # An almost idle server can be the symptom, so a lower bound has to alert too.
        'id': 'warn-nagios-range-below-lower-bound',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-3,,0',
        'params': '--url=http://example.com/below --warning=20:90 --critical=0:95',
        'assert-retc': STATE_WARN,
        'assert-in': ['0.2% worker usage (1/400) [WARNING]'],
    },
    {
        'id': 'ok-always-ok-overrides-the-state',
        'test': f'{FIXTURE_ROOT}/fedora34-httpd-2.4.48-worker-ext-on-3,,0',
        'params': '--url=http://example.com/always-ok --always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['[WARNING]'],
    },
    {
        # The slots draining an old generation during a graceful restart show up as 'G'
        # in the scoreboard while mod_status counts them as neither busy nor graceful,
        # because it skips every quiescing process. Reading the scoreboard instead of
        # BusyWorkers is what keeps the check honest here: 20 'G' plus 1 'W' is 21 of
        # 400 slots, not the 1 of 400 that BusyWorkers reports.
        'id': 'ok-graceful-restart-counts-draining-slots',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-graceful-2,,0',
        'params': '--url=http://example.com/graceful',
        'assert-retc': STATE_OK,
        'assert-in': [
            '5.2% worker usage (21/400)',
            "'apache_workers_finishing'=20",
            "'apache_busy_workers'=1",
            "'apache_processes_stopping'=3",
        ],
    },
    {
        # ExtendedStatus off costs the counters and everything derived from them, but
        # httpd still reports its identity, its uptime, the load averages and the
        # connection and process counters.
        'id': 'ok-extendedstatus-off-still-reports-gauges',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-off,,0',
        'params': '--url=http://example.com/ext-off',
        'assert-retc': STATE_OK,
        'assert-in': [
            "'apache_system_load1'=2.13",
            "'apache_connections_total'=0",
            "'apache_processes'=3",
            'up 2s',
        ],
        'assert-not-in': ['apache_requests_per_second'],
    },
    {
        # The load averages belong to the machine httpd runs on, and mod_status never
        # says how many CPUs that machine has. Dividing is only correct when the check
        # runs there itself, which a loopback URL guarantees and a remote one does not.
        'id': 'ok-load-normalized-only-against-a-local-server',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-off,,0',
        'params': '--url=http://localhost/server-status',
        'assert-retc': STATE_OK,
        'assert-in': ["'apache_system_load1'=2.13", 'apache_system_load1_per_cpu'],
    },
    {
        'id': 'ok-load-stays-raw-against-a-remote-server',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-off,,0',
        'params': '--url=http://web01.example.com/server-status',
        'assert-retc': STATE_OK,
        'assert-in': ["'apache_system_load1'=2.13"],
        'assert-not-in': ['per_cpu', 'per CPU'],
    },
    {
        # The event MPM is the only one answering AP_MPMQ_IS_ASYNC with 1, so prefork
        # and worker report no process or connection counters at all.
        'id': 'ok-prefork-reports-no-connection-gauges',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-prefork-ext-on-2,,0',
        'params': '--url=http://example.com/prefork',
        'assert-retc': STATE_OK,
        'assert-in': ["'apache_busy_workers'=1", "'apache_graceful_workers'=0"],
        'assert-not-in': ['apache_connections_total', 'apache_processes'],
    },
    {
        # ConnsAsyncWaitIO arrived with httpd 2.4.63 and is reported alongside the
        # other async connection counters.
        'id': 'ok-reports-wait-io-connections',
        'test': f'{FIXTURE_ROOT}/rhel10-httpd-2.4.63-event-ext-on-3,,0',
        'params': '--url=http://example.com/wait-io',
        'assert-retc': STATE_OK,
        'assert-in': ["'apache_connections_wait_io'=0"],
    },
    {
        # httpd 2.2 predates the whole identity block, the load averages, the CPU
        # breakdown and the async connection counters, and it does not open its
        # response with the server name either. What is left is the scoreboard, which
        # is exactly why the check is built on it.
        'id': 'ok-httpd-2-2-reports-workers-only',
        'test': f'{FIXTURE_ROOT}/centos6-httpd-2.2.15-prefork-ext-off,,0',
        'params': '--url=http://example.com/httpd22',
        'assert-retc': STATE_OK,
        'assert-regex': r'^0\.4% worker usage \(1/256\)',
        'assert-in': ["'apache_busy_workers'=1", "'apache_idle_workers'=7"],
        'assert-not-in': [
            'apache_connections_total',
            'apache_graceful_workers',
            'apache_system_load1',
            'apache_processes',
            # the summary's uptime segment; 'Starting up' in the table is not it
            ', up ',
        ],
    },
    {
        # httpd 2.4.10 is past the async connection counters (2.4.0) but before the
        # identity block and the load averages (2.4.13), so the summary carries no
        # server name and no uptime while the connection metrics are there.
        'id': 'ok-pre-2-4-13-has-connections-but-no-identity',
        'test': f'{FIXTURE_ROOT}/debian8-httpd-2.4.10-event-ext-off,,0',
        'params': '--url=http://example.com/pre2413',
        'assert-retc': STATE_OK,
        'assert-regex': r'^0\.7% worker usage \(1/150\)',
        'assert-in': ["'apache_connections_total'=0"],
        'assert-not-in': [
            'apache_graceful_workers',
            'apache_system_load1',
            'apache_processes',
        ],
    },
    {
        # Processes and Stopping arrived with 2.4.35, together with Total Duration, so
        # 2.4.25 reports the connections without the process counters.
        'id': 'ok-pre-2-4-35-has-no-process-counters',
        'test': f'{FIXTURE_ROOT}/debian9-httpd-2.4.25-event-ext-on-2,,0',
        'params': '--url=http://example.com/pre2435',
        'assert-retc': STATE_OK,
        'assert-in': ["'apache_connections_total'=0", "'apache_system_load1'="],
        'assert-not-in': ['apache_processes', 'apache_graceful_workers'],
    },
    {
        # mod_ssl and mod_qos append blocks of their own after the scoreboard. Their
        # keys must not reach the parsed data, and their marker lines must not be
        # mistaken for the server name.
        'id': 'ok-extension-module-block-does-not-leak',
        'test': f'{FIXTURE_ROOT}/fedora34-httpd-2.4.48-worker-ext-on-3,,0',
        'params': '--url=http://example.com/extension-block',
        'assert-retc': STATE_WARN,
        'assert-in': ['192.168.122.97: 81.8% worker usage'],
        'assert-not-in': [
            'CacheType',
            'CacheUsage',
            'QS_AllConn',
            'TLSSessionCacheStatus',
        ],
    },
    {
        # Before httpd 2.4.13 the response opened with the first metric instead of a
        # server name line, so the summary starts with the usage.
        'id': 'ok-response-without-a-server-name-line',
        'test': f'{FIXTURE_ROOT}/rhel7-httpd-2.4.6-prefork-ext-on-2,,0',
        'params': '--url=http://example.com/no-server-name',
        'assert-retc': STATE_OK,
        'assert-regex': r'^0\.4% worker usage',
    },
    {
        # There is no verbosity switch. Everything mod_status reported has to be in the
        # default output, because that is the one an admin reads in the web interface.
        'id': 'ok-default-output-holds-every-reported-value',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-3,,0',
        'params': '--url=http://example.com/default-output',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Flag',
            'Worker State',
            'Server Name',
            'Server Version',
            'Server MPM',
            'Server Built',
            'Current Time',
            'Restart Time',
            'Uptime',
            'Parent Server ConfigGeneration',
            'Parent Server MPMGeneration',
            'CPUUser',
            'Connections',
            'Processes',
            'Workers Total',
            'Load15',
        ],
    },
    {
        'id': 'ok-no-perfdata-suppresses-the-metrics',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-3,,0',
        'params': '--url=http://example.com/no-perfdata --no-perfdata',
        'assert-retc': STATE_OK,
        'assert-not-in': ['apache_workers_occupied_percent'],
    },
    {
        # A URL that answers but is not the status handler, for example because
        # mod_status is not configured and a catch-all served the error page.
        'id': 'unknown-endpoint-is-not-mod-status',
        'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-mod-status-not-configured,,0',
        'params': '--url=http://example.com/not-configured',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['did not answer with Apache mod_status data'],
    },
]


# Cumulative counters become per-second rates against the previous run, so a rate needs
# two samples taken apart in time. Each scenario replays consecutive captures under one
# shared URL, with a second in between because the cache timestamps whole seconds.
RATE_SCENARIOS = [
    {
        'id': 'rhel9-httpd-2.4.62-event-ext-on',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s', 'apache_requests_per_second'],
            },
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-3,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-regex': r'req/s, [^,]+/s, up ',
                'assert-in': [
                    'apache_requests_per_second',
                    'apache_bytes_per_second',
                    'apache_cpu_percent',
                    'apache_seconds_per_request',
                ],
            },
        ],
    },
    {
        'id': 'rhel9-httpd-2.4.62-prefork-ext-on',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-prefork-ext-on-1,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-prefork-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-in': ['req/s', 'apache_requests_per_second'],
            },
        ],
    },
    {
        # The rate ladder, bottom rung. httpd 2.2 reports neither `Total Duration` nor
        # the CPU breakdown, so mean request duration and CPU usage have no source at
        # all. Reporting them as zero would say "answers every request instantly on no
        # CPU", which is why an absent counter drops its rate instead of defaulting.
        'id': 'centos6-httpd-2.2.15-prefork-ext-on',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/centos6-httpd-2.2.15-prefork-ext-on-1,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/centos6-httpd-2.2.15-prefork-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-in': ['req/s', 'apache_requests_per_second'],
                'assert-not-in': [
                    'Request Duration',
                    'apache_cpu_percent',
                    'apache_seconds_per_request',
                ],
            },
        ],
    },
    {
        # Same rung as httpd 2.2: 2.4.6 predates both the CPU breakdown (2.4.13) and
        # `Total Duration` (2.4.35).
        'id': 'rhel7-httpd-2.4.6-prefork-ext-on',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/rhel7-httpd-2.4.6-prefork-ext-on-1,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/rhel7-httpd-2.4.6-prefork-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-in': ['req/s', 'apache_requests_per_second'],
                'assert-not-in': [
                    'Request Duration',
                    'apache_cpu_percent',
                    'apache_seconds_per_request',
                ],
            },
        ],
    },
    {
        # Middle rung: 2.4.25 has the CPU breakdown but still no `Total Duration`.
        'id': 'debian9-httpd-2.4.25-event-ext-on',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/debian9-httpd-2.4.25-event-ext-on-1,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/debian9-httpd-2.4.25-event-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-in': ['req/s', 'apache_cpu_percent'],
                'assert-not-in': ['Request Duration', 'apache_seconds_per_request'],
            },
        ],
    },
    {
        # Top rung: 2.4.59 delivers every counter the check derives a rate from.
        'id': 'debian10-httpd-2.4.59-event-ext-on',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/debian10-httpd-2.4.59-event-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/debian10-httpd-2.4.59-event-ext-on-3,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-in': [
                    'Request Duration',
                    'apache_cpu_percent',
                    'apache_seconds_per_request',
                ],
            },
        ],
    },
    {
        # An httpd restart between two runs sets the counters back to zero. Both
        # samples are real captures of the same host, taken before and after a
        # restart, which the differing RestartTime shows. The rates have to
        # disappear for one run rather than come out negative or enormous.
        'id': 'rhel9-httpd-2.4.62-event-restarted-counters',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-2,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-3,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-in': ['req/s', 'apache_requests_per_second'],
            },
            {
                'test': (
                    f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-on-graceful-1,,0'
                ),
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s', 'apache_requests_per_second'],
            },
        ],
    },
    {
        # ExtendedStatus is off, so httpd reports no counters and no rate can follow,
        # not even after several runs.
        'id': 'rhel9-httpd-2.4.62-event-ext-off',
        'steps': [
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-off,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s'],
            },
            {
                'test': f'{FIXTURE_ROOT}/rhel9-httpd-2.4.62-event-ext-off,,0',
                'params': f'--url={URL}',
                'assert-retc': STATE_OK,
                'assert-not-in': ['req/s', 'apache_requests_per_second'],
            },
        ],
    },
]


class TestCheck(unittest.TestCase):
    check = '../apache-httpd-status'


def _check_platform(test, platform):
    fixture, expected = platform
    lib.lftest.run(
        test,
        test.check,
        {
            'test': f'{FIXTURE_ROOT}/{fixture},,0',
            'params': f'--url=http://example.com/{fixture}',
            'assert-retc': STATE_OK,
            'assert-in': [expected],
        },
    )


def _run_rate_scenario(test, scenario):
    # Start from a clean cache so the first step of a scenario really is a first run.
    if os.path.exists(CACHE_DB):
        os.remove(CACHE_DB)
    for i, step in enumerate(scenario['steps'], start=1):
        if i > 1:
            # The cache stores whole seconds, and a zero-second interval yields no rate.
            time.sleep(1)
        with test.subTest(step=i):
            lib.lftest.run(test, test.check, step)


lib.lftest.attach_tests(TestCheck, TESTS)
lib.lftest.attach_each(TestCheck, PLATFORMS, _check_platform, id_func=lambda it: it[0])
lib.lftest.attach_each(
    TestCheck, RATE_SCENARIOS, _run_rate_scenario, id_func=lambda it: it['id']
)


if __name__ == '__main__':
    unittest.main()
