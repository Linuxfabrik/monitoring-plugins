    ('debian12-httpd-2.4.66-event-ext-off', '0.7% worker usage (1/150)'),
    ('debian12-httpd-2.4.66-event-ext-on-3', '0.7% worker usage (1/150)'),
    ('debian13-httpd-2.4.66-event-ext-off', '0.7% worker usage (1/150)'),
    ('debian13-httpd-2.4.66-event-ext-on-3', '0.7% worker usage (1/150)'),
    ('fedora34-httpd-2.4.48-event-ext-off', '0.2% worker usage (1/400)'),
    ('fedora34-httpd-2.4.48-worker-ext-on-2', '0.5% worker usage (2/400)'),
    ('fedora43-httpd-2.4.66-event-ext-off', '0.2% worker usage (1/400)'),
    ('fedora43-httpd-2.4.66-event-ext-on-3', '0.2% worker usage (1/400)'),
    ('rhel7-httpd-2.4.6-prefork-ext-off', '0.8% worker usage (2/256)'),
    ('rhel7-httpd-2.4.6-prefork-ext-on-2', '0.4% worker usage (1/256)'),
