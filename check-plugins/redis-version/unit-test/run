"""Unit tests for the redis-version check plugin.

The fixtures in `stdout/` are the raw `redis-server --version` outputs
captured from every Redis cycle that endoflife.date currently lists
(5.0 through 8.6) using the official `redis:<tag>` images on Docker
Hub. The plugin runs its regex parser against each one.

The testcases assert the parsed version and nothing else. An end-of-life
verdict is derived from live endoflife.date data and from today's date, so
pinning one here breaks as soon as upstream re-dates a cycle or a date passes.
`lib.version.check_eol()` is covered against synthetic cycles in the lib repo
instead, where the expectation cannot age.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-redis-5-0',
        'test': 'stdout/redis-server-v5.0,,0',
        'assert-in': ['Redis v5.0.14'],
    },
    {
        'id': 'parses-redis-6-0',
        'test': 'stdout/redis-server-v6.0,,0',
        'assert-in': ['Redis v6.0.20'],
    },
    {
        'id': 'parses-redis-6-2',
        'test': 'stdout/redis-server-v6.2,,0',
        'assert-in': ['Redis v6.2.21'],
    },
    {
        'id': 'parses-redis-7-0',
        'test': 'stdout/redis-server-v7.0,,0',
        'assert-in': ['Redis v7.0.15'],
    },
    {
        'id': 'parses-redis-7-2',
        'test': 'stdout/redis-server-v7.2,,0',
        'assert-in': ['Redis v7.2.13'],
    },
    {
        'id': 'parses-redis-7-4',
        'test': 'stdout/redis-server-v7.4,,0',
        'assert-in': ['Redis v7.4.8'],
    },
    {
        'id': 'parses-redis-8-0',
        'test': 'stdout/redis-server-v8.0,,0',
        'assert-in': ['Redis v8.0.6'],
    },
    {
        'id': 'parses-redis-8-2',
        'test': 'stdout/redis-server-v8.2,,0',
        'assert-in': ['Redis v8.2.5'],
    },
    {
        'id': 'parses-redis-8-4',
        'test': 'stdout/redis-server-v8.4,,0',
        'assert-in': ['Redis v8.4.2'],
    },
    {
        'id': 'parses-redis-8-6',
        'test': 'stdout/redis-server-v8.6,,0',
        'assert-in': ['Redis v8.6.2'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Redis not found.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../redis-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
