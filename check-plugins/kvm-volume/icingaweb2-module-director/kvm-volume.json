                "kvm_volume_always_ok": false,
                "kvm_volume_brief": false,
                "kvm_volume_ignore": [],
                "kvm_volume_lengthy": false,
                "kvm_volume_match": [],
                "kvm_volume_no_match_severity": "ok",
                "kvm_volume_no_perfdata": false,
                "kvm_volume_timeout": 8,
                "kvm_volume_url": "qemu:///system"
