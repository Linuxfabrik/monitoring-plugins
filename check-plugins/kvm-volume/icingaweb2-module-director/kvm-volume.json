        },
        "2": {
            "varname": "kvm_volume_brief",
            "caption": "KVM Volume: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1699ca57-7c47-4d91-a29f-f2d4575f98fc"
        },
        "3": {
            "varname": "kvm_volume_critical",
            "caption": "KVM Volume: Critical",
            "description": "CRIT threshold for the space a pool has promised its volumes, in percent of the storage underneath it. Above 100 the pool has promised more than it has. Supports Nagios ranges. Default: unset, the figure is reported but does not alert",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a4831d5b-27f3-4b7d-ae3e-1a58cad4f56e"
        },
        "4": {
            "varname": "kvm_volume_ignore",
            "caption": "KVM Volume: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "35a5f7da-fced-4b34-8a71-913c2d737a37"
        },
        "5": {
            "varname": "kvm_volume_lengthy",
            "caption": "KVM Volume: Lengthy?",
