"""Unit tests for the grafana-version check plugin.

The fixtures in `stdout/` are the raw `grafana-server -v` and `grafana -v`
outputs captured from the official `docker.io/grafana/grafana-oss:<tag>` and
`docker.io/grafana/grafana:<tag>` images on Docker Hub. There is no Red Hat
family Grafana container, so the upstream image is the right source. The
Enterprise and beta fixtures follow the format string in the Grafana source
(`pkg/cmd/grafana-server/commands/cli.go`, `pkg/server/bootstrap/servers.go`),
since there is no free image for them. The deprecation banner that newer
`grafana-server` releases print does not start with "Version", so the plugin
picks the version line.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-grafana-10-4',
        'test': 'stdout/grafana-server-v10.4,,0',
        'assert-in': ['Grafana v10.4.0'],
    },
    {
        'id': 'parses-grafana-11-5',
        'test': 'stdout/grafana-server-v11.5,,0',
        'assert-in': ['Grafana v11.5.0'],
    },
    {
        'id': 'parses-grafana-12-0',
        'test': 'stdout/grafana-server-v12.0,,0',
        'assert-in': ['Grafana v12.0.0'],
    },
    {
        'id': 'parses-grafana-12-4',
        'test': 'stdout/grafana-server-v12.4,,0',
        'assert-in': ['Grafana v12.4.0'],
    },
    {
        'id': 'parses-grafana-5-4',
        'test': 'stdout/grafana-server-v5.4,,0',
        'assert-in': ['Grafana v5.4.5'],
    },
    {
        'id': 'parses-grafana-8-5',
        'test': 'stdout/grafana-server-v8.5,,0',
        'assert-in': ['Grafana v8.5.27'],
    },
    {
        'id': 'parses-grafana-12-0-beta',
        'test': 'stdout/grafana-server-v12.0-beta,,0',
        'assert-in': ['Grafana v12.0.0-beta1 ', "'grafana-version'=12.0;"],
    },
    {
        'id': 'parses-grafana-12-4-security',
        'test': 'stdout/grafana-server-v12.4-security,,0',
        'assert-in': ['Grafana v12.4.3+security-02 ', "'grafana-version'=12.43;"],
    },
    {
        'id': 'parses-grafana-13-2',
        'test': 'stdout/grafana-server-v13.2,,0',
        'assert-in': ['Grafana v13.2.3'],
    },
    {
        'id': 'parses-grafana-binary-13-2',
        'test': 'stdout/grafana-v13.2,,0',
        'assert-in': ['Grafana v13.2.3'],
    },
    {
        'id': 'parses-grafana-enterprise-10-4',
        'test': 'stdout/grafana-server-enterprise-v10.4,,0',
        'assert-in': ['Grafana v10.4.0'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Grafana not found', '--path'],
    },
    {
        'id': 'unknown-misleading-version-line',
        'test': 'stdout/misleading-version-line,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Grafana not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../grafana-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
