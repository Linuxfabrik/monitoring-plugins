"""Unit tests for the python-version check plugin.

The plugin judges the Python release it is running under. It has no `--test`
hook, so there is nothing here to drive it with.

The end-of-life half is not tested here: `lib.version.check_eol()` is the same code
in every `*-version` plugin, and a verdict it derives from live endoflife.date data
and today's date cannot be pinned without breaking as soon as upstream re-dates a
cycle or a date passes. It is covered twice without the network instead, and that is
where a case belongs: against synthetic cycles in the lib repo
(`tests/version/unit-test/run`), and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import unittest

from lib.globals import STATE_WARN


class TestTimeout(unittest.TestCase):
    """A binary that never answers ends the check with a warning once `--timeout`
    has passed, instead of keeping it running until the monitoring server kills it.
    """

    def test_warn_python_hangs(self):
        result = subprocess.run(  # nosec B603 - argv list, no shell
            ['../python-version', '--path=fixtures/hang', '--timeout=1'],
            capture_output=True,
            text=True,
            check=False,
        )
        self.assertEqual(result.returncode, STATE_WARN)
        self.assertIn(
            'Timeout after 1s while running `fixtures/hang --version', result.stdout
        )


if __name__ == '__main__':
    unittest.main()
