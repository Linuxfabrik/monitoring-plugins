import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        # only the 25-character task id a swarm appends is cut off. Two containers
        # an admin named with a dot stay two containers instead of collapsing into
        # one row, and one metric name, that reports whatever came last
        'id': 'ok-dotted-names-kept',
        'test': 'stdout/dotted-names,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['backup.daily', 'backup.hourly', 'stackdemo_redis.1'],
        'assert-not-in': ['stackdemo_redis.1.7wvfsd0eiepbhcv2p4kwbxm2q'],
    },
    {
        # a check that may not talk to the engine says nothing about the engine:
        # it is deployed wrong, not broken, so it must not raise a false alarm
        'id': 'unknown-no-permission',
        'test': ',stderr/permission-denied,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No permission to talk to the container engine'],
    },
    {
        # an engine that is not answering is the outage this check reports
        'id': 'crit-engine-not-running',
        'test': ',stderr/daemon-not-running,1',
        'assert-retc': STATE_CRIT,
        'assert-in': ['Is the docker daemon running?'],
    },
    {
        'id': 'ok-empty-no-containers',
        'test': 'stdout/empty-no-containers,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['No containers to check.'],
    },
    {
        'id': 'ok-one-container-shortname',
        'test': 'stdout/one-container-traefik,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok, 1 container checked.',
            'Container         ! Status  ! Health  ! Restarts ! Uptime ! State',
            'traefik_traefik.2 ! running ! healthy ! 0        ! 4W 1D  ! [OK]',
            "'containers_checked'=1;;;0",
            "'containers_running'=1;;;0",
            "'containers_unhealthy'=0;;;0",
        ],
    },
    {
        'id': 'ok-one-container-full-name',
        'test': 'stdout/one-container-traefik,,0',
        'params': '--full-name',
        'assert-retc': STATE_OK,
        'assert-in': [
            'traefik_traefik.2.1idw12p2yqpxutlzkcwign4at ! running ! healthy ! 0        ! 4W 1D  ! [OK]',
        ],
    },
    {
        # a container removed between `docker ps` and `docker inspect` makes the
        # command fail while the containers it did find are still reported
        'id': 'ok-inspect-partially-failed',
        'test': 'stdout/one-container-traefik,stderr/one-container-traefik,1',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok, 1 container checked.'],
    },
    {
        # nothing usable came back at all, so the engine could not be asked
        'id': 'crit-inspect-failed',
        'test': ',stderr/one-container-traefik,1',
        'assert-retc': STATE_CRIT,
        'assert-in': ['No such object'],
    },
    {
        'id': 'crit-mixed-unhealthy-by-default',
        'test': 'stdout/mixed-states,,0',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'app-unhealthy: health unhealthy [CRITICAL]',
            'app-no-healthcheck ! running ! -         ! 0        ! 4W 1D  ! [OK]',
            'app-unhealthy      ! running ! unhealthy ! 3        ! 4W 1D  ! [CRITICAL]',
            "'containers_checked'=5;;;0",
            "'containers_unhealthy'=1;;;0",
        ],
    },
    {
        'id': 'crit-mixed-status-running',
        'test': 'stdout/mixed-states,,0',
        'params': '--status=running',
        'assert-retc': STATE_CRIT,
        'assert-in': ['app-exited: status exited (want running) [CRITICAL]'],
    },
    {
        'id': 'warn-mixed-restarts',
        'test': 'stdout/mixed-states,,0',
        'params': '--warning-restarts=5 --ignore=app-unhealthy',
        'assert-retc': STATE_WARN,
        'assert-in': ['app-flapping: 12 restarts [WARNING]'],
    },
    {
        'id': 'warn-mixed-min-uptime',
        'test': 'stdout/mixed-states,,0',
        'params': '--warning-uptime=2D: --ignore=app-unhealthy',
        'assert-retc': STATE_WARN,
        'assert-in': ['app-flapping: up 1D [WARNING]'],
    },
    {
        'id': 'ok-match-filter',
        'test': 'stdout/mixed-states,,0',
        'params': '--match=^app-healthy$',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok, 1 container checked.'],
    },
    {
        'id': 'ok-ignore-filter',
        'test': 'stdout/mixed-states,,0',
        'params': '--ignore=app-unhealthy --ignore=app-exited',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok, 3 containers checked.'],
    },
    {
        'id': 'ok-no-match-default',
        'test': 'stdout/mixed-states,,0',
        'params': '--match=^nope$',
        'assert-retc': STATE_OK,
        'assert-in': ['No containers to check.'],
    },
    {
        'id': 'crit-no-match-severity',
        'test': 'stdout/mixed-states,,0',
        'params': '--match=^nope$ --no-match-severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-in': ['No containers to check.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../docker-container'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
