class TestCheck(unittest.TestCase):
    pass


def _run(params):
    result = subprocess.run(
        [PLUGIN, *params],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode, result.stdout + result.stderr


def _check_case(test, case):
    returncode, combined = _run(case['params'])
    test.assertEqual(
        returncode,
        case['assert-retc'],
        f'expected retc {case["assert-retc"]}, got {returncode}.\nOutput: {combined}',
    )
    for needle in case.get('assert-in', []):
        test.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
    for needle in case.get('assert-not-in', []):
        test.assertNotIn(
            needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
        )


lib.lftest.attach_each(TestCheck, CASES, _check_case, id_func=lambda it: it['id'])


class TestArrivalRate(unittest.TestCase):
    """A burst of failed passwords alerts, the same burst an hour ago does not."""

    def setUp(self):
        self.scratch_dir = tempfile.mkdtemp(prefix='burst-', dir=HERE)

    def tearDown(self):
        shutil.rmtree(self.scratch_dir, ignore_errors=True)

    def _write_failures(self, count, minutes_ago, peers=1):
        """Write `count` failed passwords, spread evenly over `peers` addresses."""
        path = os.path.join(self.scratch_dir, 'secure')
        first = datetime.datetime.now() - datetime.timedelta(minutes=minutes_ago)
        with open(path, 'w', encoding='utf-8') as handle:
            for index in range(count):
                logged_at = first + datetime.timedelta(seconds=index)
                handle.write(
                    FAILURE_LINE.format(
                        timestamp=_stamp(logged_at),
                        peer=f'198.51.100.{7 + index % peers}',
                    )
                    + '\n'
                )
        return path

    def test_burst_within_the_window_warns(self):
        path = self._write_failures(count=20, minutes_ago=5)
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn(
            '20 authentication failures from 198.51.100.7 in the last 10m', combined
        )
        self.assertIn('guessing run', combined)

    def test_burst_within_the_window_crits_above_the_threshold(self):
        path = self._write_failures(count=20, minutes_ago=5)
        returncode, combined = _run(
            [f'--server-log={path}', '--auth-failures-critical=10']
        )
        self.assertEqual(returncode, STATE_CRIT, combined)

    def test_a_threshold_of_zero_turns_the_counter_off(self):
        path = self._write_failures(count=20, minutes_ago=5)
        returncode, combined = _run(
            [
                f'--server-log={path}',
                '--auth-failures-warning=0',
                '--auth-failures-critical=0',
            ]
        )
        self.assertEqual(returncode, STATE_OK, combined)

    def test_the_same_burst_spread_over_many_addresses_is_quiet(self):
        # Twenty failures, but no address got past two of them. That is the open
        # network going past, and what an intrusion prevention system blocks
        # long before this check would have anything to say.
        path = self._write_failures(count=20, minutes_ago=5, peers=10)
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_OK, combined)
        self.assertIn('2 authentication failures from 198.51.100.', combined)
        self.assertIn('(20 in total from 10 addresses)', combined)

    def test_the_total_is_what_no_per_source_judges(self):
        path = self._write_failures(count=20, minutes_ago=5, peers=10)
        returncode, combined = _run([f'--server-log={path}', '--no-per-source'])
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn('20 authentication failures in the last 10m', combined)
        self.assertNotIn('in total from', combined)

    def test_the_same_burst_an_hour_ago_is_quiet(self):
        path = self._write_failures(count=20, minutes_ago=60)
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_OK, combined)
        self.assertIn('0 authentication failures in the last 10m', combined)
        self.assertIn('(20 in the window read)', combined)

    def test_a_wider_window_sees_the_older_burst(self):
        path = self._write_failures(count=20, minutes_ago=60)
        returncode, combined = _run([f'--server-log={path}', '--lookback=7200'])
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn(
            '20 authentication failures from 198.51.100.7 in the last 2h', combined
        )


class TestSourceDetection(unittest.TestCase):
    """Where the check looks when `--server-log` says nothing."""

    def test_the_redhat_family_keeps_it_in_var_log_secure(self):
        root = config_root('rhel')
        self.assertEqual(
            sshd_logfile.get_log_file_real_path(root), f'{root}/var/log/secure'
        )

    def test_the_debian_family_keeps_it_in_var_log_auth_log(self):
        root = config_root('debian')
        self.assertEqual(
            sshd_logfile.get_log_file_real_path(root), f'{root}/var/log/auth.log'
        )

    def test_a_host_without_a_syslog_daemon_falls_back_to_the_unit(self):
        # Both names the distributions use, and both directories systemd reads.
        self.assertIsNone(sshd_logfile.get_log_file_real_path(config_root('unit-rhel')))
        self.assertEqual(
            sshd_logfile.get_unit(config_root('unit-rhel')), 'sshd.service'
        )
        self.assertEqual(
            sshd_logfile.get_unit(config_root('unit-debian')), 'ssh.service'
        )

    def test_a_host_with_neither_is_reported_rather_than_guessed_at(self):
        root = config_root('nothing')
        self.assertIsNone(sshd_logfile.get_log_file_real_path(root))
        self.assertIsNone(sshd_logfile.get_unit(root))


class TestSourceAddress(unittest.TestCase):
    """Which address a line is counted under, and who gets to decide that."""

    def test_the_shapes_sshd_writes_the_peer_in(self):
        for line, expected in (
            (
                'Aug 28 19:25:07 h sshd-session[2]: Failed password for alice'
                ' from 198.51.100.7 port 54882 ssh2',
                '198.51.100.7',
            ),
            (
                'Aug 28 19:25:07 h sshd-session[2]: error: PAM: Authentication'
                ' failure for alice from 198.51.100.7',
                '198.51.100.7',
            ),
            (
                'Aug 28 19:25:42 h sshd[3]: drop connection #1 from'
                ' [198.51.100.7]:41728 on [192.0.2.1]:22 past Maxstartups',
                '198.51.100.7',
            ),
            (
                'Aug 28 19:24:00 h sshd[4]: Timeout before authentication for'
                ' connection from 198.51.100.7 to 192.0.2.1, pid = 260',
                '198.51.100.7',
            ),
            (
                'Aug 28 19:28:27 h sshd-session[5]: ROOT LOGIN REFUSED FROM'
                ' 198.51.100.7 port 36544',
                '198.51.100.7',
            ),
            (
                'Aug 28 19:28:36 h sshd-session[6]: Unable to negotiate with'
                ' 2001:DB8::42 port 53420: no matching key exchange method found',
                '2001:db8::42',
            ),
        ):
            self.assertEqual(sshd_logfile.get_source(line), expected, line)

    def test_the_two_spellings_of_one_client_are_one_source(self):
        # A dual-stack listener writes both, and counting them apart would split
        # a burst across two buckets.
        plain = (
            'Aug 28 19:25:07 h sshd-session[2]: error: PAM: Authentication'
            ' failure for alice from 198.51.100.7'
        )
        mapped = plain.replace('198.51.100.7', '::ffff:198.51.100.7')
        self.assertEqual(sshd_logfile.get_source(mapped), '198.51.100.7')
        self.assertEqual(
            sshd_logfile.get_source(mapped), sshd_logfile.get_source(plain)
        )

    def test_the_clock_of_the_line_is_not_an_address(self):
        line = 'Aug 28 19:25:07 h sshd-session[2]: Connection closed by 19:25:07'
        self.assertIsNone(sshd_logfile.get_source(line))

    def test_a_client_cannot_choose_the_source_it_is_counted_under(self):
        # Parts of these lines are the client's own text - the account it asked
        # for, the identification string it sent - so a client that writes
        # `from <address> port <n> ssh2` into them would otherwise move its own
        # lines into somebody else's bucket, or spread them out to stay below a
        # threshold. Injected in front of the real address and behind it.
        with open(fixture('sshd-injected-source.txt'), encoding='utf-8') as handle:
            lines = [line for line in handle.read().splitlines() if line.strip()]
        self.assertEqual(len(lines), 7)
        for line in lines:
            self.assertEqual(sshd_logfile.get_source(line), '198.51.100.7', line)


class TestLogLevel(unittest.TestCase):
    """What sshd was told to log, which decides what there is to read."""

    def test_a_level_somebody_turned_down(self):
        self.assertEqual(
            sshd_logfile.get_log_level(config_root('quiet-loglevel')), 'ERROR'
        )

    def test_the_first_value_wins_and_a_drop_in_stands_above_the_file(self):
        # `Include /etc/ssh/sshd_config.d/*.conf` is the first directive of the
        # configurations the distributions ship, so a drop-in beats the
        # `LogLevel ERROR` further down in the same file.
        self.assertEqual(
            sshd_logfile.get_log_level(config_root('loglevel-include')), 'VERBOSE'
        )

    def test_a_match_block_is_not_the_server_wide_setting(self):
        # The `Match Address` block of that same fixture sets `QUIET`, which
        # applies per connection and must not be read as the server's setting.
        self.assertNotEqual(
            sshd_logfile.get_log_level(config_root('loglevel-include')), 'QUIET'
        )

    def test_a_host_whose_configuration_names_none(self):
        # sshd then logs at its own default, which is `INFO`, and there is
        # nothing to say.
        self.assertIsNone(sshd_logfile.get_log_level(config_root('unit-rhel')))
        self.assertIsNone(sshd_logfile.get_log_level(config_root('nothing')))


class TestLineReading(unittest.TestCase):
    """The distinctions the counters rest on, each against a real line."""

    def _hits(self, group, key, line):
        for event in group:
            if event['key'] == key:
                return bool(event['regex'].search(line))
        raise AssertionError(f'no event named {key}')

    def test_a_failure_for_an_account_that_exists_is_not_an_invalid_user(self):
        line = (
            'Aug 28 19:25:07 host sshd-session[262]: Failed password for alice'
            ' from 127.0.0.1 port 54882 ssh2'
        )
        self.assertTrue(self._hits(sshd_logfile.RATE_EVENTS, 'auth_failures', line))
        self.assertFalse(self._hits(sshd_logfile.RATE_EVENTS, 'invalid_users', line))

    def test_a_failure_for_an_account_that_does_not_exist_counts_once(self):
        # sshd writes one `Invalid user` per connection and one `Failed password
        # for invalid user` per attempt, so only the first is counted.
        announcement = (
            'Aug 28 19:25:14 host sshd-session[269]: Invalid user nosuchuser'
            ' from 127.0.0.1 port 53918'
        )
        attempt = (
            'Aug 28 19:25:16 host sshd-session[269]: Failed password for invalid'
            ' user nosuchuser from 127.0.0.1 port 53918 ssh2'
        )
        self.assertTrue(
            self._hits(sshd_logfile.RATE_EVENTS, 'invalid_users', announcement)
        )
        self.assertFalse(self._hits(sshd_logfile.RATE_EVENTS, 'invalid_users', attempt))
        self.assertFalse(self._hits(sshd_logfile.RATE_EVENTS, 'auth_failures', attempt))

    def test_a_penalty_drop_is_not_a_maxstartups_drop(self):
        # `PerSourcePenalties` keeping a known-bad source away is the server
        # working as intended; being at `MaxStartups` turns away whoever is next.
        penalty = (
            'Aug 28 19:24:00 host sshd[229]: drop connection #0 from'
            ' [127.0.0.1]:50864 on [127.0.0.1]:22 penalty: exceeded LoginGraceTime'
        )
        throttle = (
            'Aug 28 19:25:42 host sshd[231]: drop connection #1 from'
            ' [127.0.0.1]:41728 on [127.0.0.1]:22 past Maxstartups'
        )
        self.assertTrue(
            self._hits(sshd_logfile.RATE_EVENTS, 'aborted_connections', penalty)
        )
        self.assertFalse(
            self._hits(sshd_logfile.RATE_EVENTS, 'throttled_connections', penalty)
        )
        self.assertTrue(
            self._hits(sshd_logfile.RATE_EVENTS, 'throttled_connections', throttle)
        )

    def test_the_preauth_echo_of_a_refused_root_login_is_not_a_second_one(self):
        # Both lines are the message, so both match; what keeps the attempt from
        # counting twice is that the second is recognized as the echo of the
        # first. Matching only the one without the suffix would lose the older
        # wording, which carries no port and ends where the address ends.
        monitor = (
            'Aug 28 19:28:27 host sshd-session[212]: ROOT LOGIN REFUSED FROM'
            ' 127.0.0.1 port 36544'
        )
        echo = f'{monitor} [preauth]'
        older = 'Jan  5 01:31:41 www sshd[1643]: ROOT LOGIN REFUSED FROM 127.0.0.1'
        for line in (monitor, echo, older):
            self.assertTrue(
                self._hits(sshd_logfile.EVENTS, 'root_login_refusals', line), line
            )
        self.assertTrue(sshd_logfile.is_preauth_echo(monitor, echo))
        self.assertFalse(sshd_logfile.is_preauth_echo(monitor, older))

    def test_another_program_saying_the_same_thing_is_not_counted(self):
        # `killed by signal` is not sshd's alone, and the journal of a unit as
        # well as a shared authentication log carry other programs' lines.
        foreign = (
            'Aug 28 19:48:02 host systemd[1]: foo.service: Main process 261'
            ' killed by signal 11'
        )
        self.assertIsNotNone(sshd_logfile.PROGRAM_REGEX.search(foreign))
        self.assertIsNone(sshd_logfile.IDENTIFIER_REGEX.search(foreign))
        # A line without any program header is taken as sshd's, which is what a
        # container logging its standard error looks like.
        bare = 'Server listening on 0.0.0.0 port 22.'
        self.assertIsNone(sshd_logfile.PROGRAM_REGEX.search(bare))

    def test_the_identifier_covers_the_split_daemon(self):
        for identifier in ('sshd', 'sshd-session', 'sshd-auth'):
            line = f'Aug 28 19:25:03 host {identifier}[231]: whatever it said'
            self.assertIsNotNone(sshd_logfile.IDENTIFIER_REGEX.search(line), identifier)
        # Everything else that logs to the same facility is not sshd's.
        for line in (
            'Aug 28 19:25:05 host unix_chkpwd[264]: password check failed',
            'Aug 28 19:25:41 host su: pam_unix(su-l:session): session opened',
            'Aug 28 19:25:41 host sudo: alice : TTY=pts/0 ; COMMAND=/bin/ls',
        ):
            self.assertIsNone(sshd_logfile.IDENTIFIER_REGEX.search(line), line)

    def test_two_listening_addresses_are_one_start(self):
        first = 'Aug 28 19:25:03 host sshd[231]: Server listening on 0.0.0.0 port 22.'
        second = 'Aug 28 19:25:03 host sshd[231]: Server listening on :: port 22.'
        later = 'Aug 28 19:25:33 host sshd[231]: Server listening on 0.0.0.0 port 22.'
        self.assertTrue(sshd_logfile.is_repeated_line(first, second, 0, 1))
        self.assertFalse(sshd_logfile.is_repeated_line(second, later, 1, 9))

    def test_a_source_without_timestamps_falls_back_to_neighbourhood(self):
        first = 'Server listening on 0.0.0.0 port 22.'
        second = 'Server listening on :: port 22.'
        self.assertTrue(sshd_logfile.is_repeated_line(first, second, 0, 1))
        self.assertFalse(sshd_logfile.is_repeated_line(first, second, 0, 5))


class TestPathConfinement(unittest.TestCase):
    """A `--server-log` that resolves outside /var/log (here a scratch file in
    the temp directory) is refused, so a plugin running under sudo cannot be
    turned into an arbitrary file read (GHSA-f54c-p5vg-mr5c)."""

    def setUp(self):
        self.scratch_dir = tempfile.mkdtemp(prefix='sshd-logfile-confine-')
        self.scratch_file = os.path.join(self.scratch_dir, 'secure')
        with open(self.scratch_file, 'w', encoding='utf-8') as handle:
            handle.write('Aug 28 19:25:03 host sshd[231]: secret\n')

    def tearDown(self):
        shutil.rmtree(self.scratch_dir, ignore_errors=True)

    def test_server_log_outside_allowed_roots_is_refused(self):
        returncode, combined = _run([f'--server-log={self.scratch_file}'])
        self.assertEqual(returncode, STATE_UNKNOWN, combined)
        self.assertIn('Refusing to read', combined)
        self.assertNotIn('secret', combined)


if __name__ == '__main__':
    unittest.main()
