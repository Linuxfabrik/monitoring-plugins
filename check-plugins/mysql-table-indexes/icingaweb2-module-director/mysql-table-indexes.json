            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Checks user schemas in MySQL/MariaDB for two replication- and performance-relevant defects: base tables with no index at all (mysqltuner's `mysql_tables()` check) and InnoDB base tables without a user-defined `PRIMARY KEY`. The second case is a documented hotspot for ROW-based replication: the replica has to materialise each row event against an internal hidden 6-byte index, which can degrade to a full table scan per row event. Alerts when either count crosses `--warning` / `--critical`. `--match` and `--ignore` narrow the scan down to a single schema or table. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/mysql-table-indexes/",
            "object_name": "tpl-service-mysql-table-indexes",
            "object_type": "template",
