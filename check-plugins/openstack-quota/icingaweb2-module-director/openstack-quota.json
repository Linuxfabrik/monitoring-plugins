    "Datafield": {
        "1": {
            "varname": "openstack_quota_always_ok",
            "caption": "Openstack Quota: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "deffdabe-27ea-4c1d-bb67-7cee21bd13be"
        },
        "2": {
            "varname": "openstack_quota_brief",
            "caption": "Openstack Quota: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "13c7fd65-fb97-49a9-a5e5-1d8619af7c3a"
        },
        "3": {
            "varname": "openstack_quota_cache_expire",
            "caption": "Openstack Quota: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "96cf5a84-277d-4113-8180-487055065642"
        },
        "4": {
            "varname": "openstack_quota_critical",
            "caption": "Openstack Quota: Critical",
            "description": "CRIT threshold for the share of a quota that is in use, in percent. Only applies to a quota that has a limit. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8656ce5f-fd37-4fd7-a6f0-ae4b0cd15051"
        },
        "5": {
            "varname": "openstack_quota_ignore",
            "caption": "Openstack Quota: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the quota name, which is the resource prefixed with its service, for example `compute_cores` or `network_port`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "af2e0000-a3cd-4a34-8538-1f07bf747d9d"
        },
        "6": {
            "varname": "openstack_quota_insecure",
            "caption": "Openstack Quota: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "cf2cf073-374a-460e-a9f0-6876d22d8b53"
        },
        "7": {
            "varname": "openstack_quota_lengthy",
            "caption": "Openstack Quota: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d6463004-1fd2-4520-adc3-6c15b5ebeef1"
        },
        "8": {
            "varname": "openstack_quota_match",
            "caption": "Openstack Quota: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the quota name, which is the resource prefixed with its service, for example `compute_cores` or `network_port`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3fe563d9-271c-46d2-83ce-755e4971f028"
        },
        "9": {
            "varname": "openstack_quota_no_match_severity",
            "caption": "Openstack Quota: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "openstack_quota_no_match_severity_list"
            },
            "uuid": "c3352499-5853-4b11-a5fc-4bbc2ca444d3"
        },
        "10": {
            "varname": "openstack_quota_no_perfdata",
            "caption": "Openstack Quota: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f5f659b4-c427-4831-8b8f-7b71ada9a769"
        },
        "11": {
            "varname": "openstack_quota_no_proxy",
            "caption": "Openstack Quota: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "018cd8e9-1516-4fb9-a3ad-b15e4049748e"
        },
        "12": {
            "varname": "openstack_quota_proxy",
            "caption": "Openstack Quota: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6229e0ec-e02c-477a-b06c-e0f7b713badf"
        },
        "13": {
            "varname": "openstack_quota_rc_file",
            "caption": "Openstack Quota: Rc File",
            "description": "Path to a rc file containing OpenStack connection parameters like OS_USERNAME (instead of specifying them on the command line). Example: `--rc-file=/var/spool/icinga2/.openstack.cnf`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6f0c382d-8ab0-4fbe-84a3-7cb11955a677"
        },
        "14": {
            "varname": "openstack_quota_service",
            "caption": "Openstack Quota: Service",
            "description": "OpenStack service to report the quotas of. Can be specified multiple times. A service that does not answer is reported as a warning, so name the ones this cloud actually runs. Example: `--service=compute --service=network`. If not specified, all of them are checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "array",
                "datalist": "openstack_quota_service_list"
            },
            "uuid": "9627ea47-3ca6-4532-8fb5-61fac0abb497"
        },
        "15": {
            "varname": "openstack_quota_timeout",
            "caption": "Openstack Quota: Timeout",
            "description": "Network timeout in seconds. Applies to the whole run, not to a single request.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f622b081-c131-4edb-89e6-ef339d62cd09"
        },
        "16": {
            "varname": "openstack_quota_warning",
            "caption": "Openstack Quota: Warning",
            "description": "WARN threshold for the share of a quota that is in use, in percent. Only applies to a quota that has a limit. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f996dcf5-9ab8-43fa-ba14-06261cc36e2f"
        }
    }
