            "max_check_attempts": 5,
            "notes": "Reports how full the quotas of an OpenStack project are, for compute, block storage and network alike. Alerts when the share of a quota that is in use reaches the thresholds, so a project running out of instances, volumes or ports is noticed before the next deployment fails, and when one of the APIs cannot be reached in time. A quota the cloud reports as unlimited has nothing to run out of and is counted rather than listed. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/openstack-quota/",
            "object_name": "tpl-service-openstack-quota",
            "object_type": "template",
