{
    "Command": {
        "cmd-check-cpu-usage": {
            "uuid": "c-1",
            "object_name": "cmd-check-cpu-usage",
            "object_type": "object",
            "command": "/usr/lib64/nagios/plugins/cpu-usage",
            "arguments": {
                "--count": "$cpu_usage_count$",
                "--critical": "$cpu_usage_critical$",
                "--warning": "$cpu_usage_warning$"
            }
        },
        "cmd-check-nextcloud-stats": {
            "uuid": "c-2",
            "object_name": "cmd-check-nextcloud-stats",
            "object_type": "object",
            "command": "/usr/lib64/nagios/plugins/nextcloud-stats",
            "arguments": {
                "--password": "$nextcloud_stats_password$",
                "--url": "$nextcloud_stats_url$",
                "--username": "$nextcloud_stats_login$"
            }
        },
        "cmd-check-swap-usage": {
            "uuid": "c-3",
            "object_name": "cmd-check-swap-usage",
            "object_type": "object",
            "command": "/usr/lib64/nagios/plugins/swap-usage",
            "arguments": {
                "--critical": "$swap_usage_critical$",
                "--warning": "$swap_usage_warning$"
            }
        },
        "cmd-check-legacy": {
            "uuid": "own-c-1",
            "object_name": "cmd-check-legacy",
            "object_type": "object",
            "command": "/usr/lib64/nagios/plugins/legacy",
            "arguments": {
                "--x": "$legacy_x$"
            }
        }
    },
    "HostTemplate": {
        "tpl-host-generic": {
            "uuid": "h-1",
            "object_name": "tpl-host-generic",
            "object_type": "template"
        },
        "tpl-host-linux": {
            "uuid": "h-2",
            "object_name": "tpl-host-linux",
            "object_type": "template",
            "imports": [
                "tpl-host-generic"
            ],
            "vars": {
                "_override_servicevars": {
                    "Swap Usage": {
                        "swap_usage_warning": "55"
                    }
                }
            }
        },
        "tpl-host-customer": {
            "uuid": "own-h-1",
            "object_name": "tpl-host-customer",
            "object_type": "template",
            "imports": [
                "tpl-host-linux"
            ],
            "vars": {
                "_override_servicevars": {
                    "Old Service": {
                        "old_service_warning": "1"
                    },
                    "Swap Usage": {
                        "swap_usage_crit": "99",
                        "swap_usage_critical": 90,
                        "swap_usage_warning": "70"
                    }
                }
            }
        },
        "tpl-host-unused": {
            "uuid": "own-h-2",
            "object_name": "tpl-host-unused",
            "object_type": "template",
            "vars": {
                "_override_servicevars": {
                    "Swap Usage": {
                        "swap_usage_warning": "60"
                    }
                }
            }
        }
    },
    "ServiceTemplate": {
        "tpl-service-generic": {
            "uuid": "s-0",
            "object_name": "tpl-service-generic",
            "object_type": "template",
            "vars": {
                "criticality": "C"
            }
        },
        "tpl-service-cpu-usage": {
            "uuid": "s-1",
            "object_name": "tpl-service-cpu-usage",
            "object_type": "template",
            "imports": [
                "tpl-service-generic"
            ],
            "check_command": "cmd-check-cpu-usage",
            "vars": {
                "cpu_usage_critical": 90,
                "cpu_usage_warning": 80
            }
        },
        "tpl-service-nextcloud-stats": {
            "uuid": "s-2",
            "object_name": "tpl-service-nextcloud-stats",
            "object_type": "template",
            "imports": [
                "tpl-service-generic"
            ],
            "check_command": "cmd-check-nextcloud-stats",
            "vars": {
                "nextcloud_stats_login": "admin",
                "nextcloud_stats_url": "http://localhost/ocs"
            }
        },
        "tpl-service-swap-usage": {
            "uuid": "s-3",
            "object_name": "tpl-service-swap-usage",
            "object_type": "template",
            "imports": [
                "tpl-service-generic"
            ],
            "check_command": "cmd-check-swap-usage",
            "vars": {
                "swap_usage_critical": 90,
                "swap_usage_warning": 50
            }
        },
        "tpl-service-cpu-usage-customer": {
            "uuid": "own-1",
            "object_name": "tpl-service-cpu-usage-customer",
            "object_type": "template",
            "imports": [
                "tpl-service-cpu-usage"
            ],
            "vars": {
                "cpu_usage_count": 3,
                "cpu_usage_critical": "90",
                "cpu_usage_warn": "85",
                "cpu_usage_warning": "90",
                "criticality": "A"
            }
        },
        "tpl-service-cpu-usage-customer-db": {
            "uuid": "own-2",
            "object_name": "tpl-service-cpu-usage-customer-db",
            "object_type": "template",
            "imports": [
                "tpl-service-cpu-usage-customer"
            ],
            "vars": {
                "cpu_usage_critical": "95"
            }
        },
        "tpl-service-legacy": {
            "uuid": "own-3",
            "object_name": "tpl-service-legacy",
            "object_type": "template",
            "imports": [
                "tpl-service-generic"
            ],
            "check_command": "cmd-check-legacy",
            "vars": {
                "legacy_x": "1"
            }
        },
        "tpl-service-swap-usage-plain": {
            "uuid": "own-4",
            "object_name": "tpl-service-swap-usage-plain",
            "object_type": "template",
            "imports": [
                "tpl-service-swap-usage"
            ]
        },
        "tpl-service-nextcloud-stats-customer": {
            "uuid": "own-5",
            "object_name": "tpl-service-nextcloud-stats-customer",
            "object_type": "template",
            "imports": [
                "tpl-service-nextcloud-stats"
            ],
            "vars": {
                "nextcloud_stats_login": "nextcloud-admin",
                "nextcloud_stats_password": "linuxfabrik",
                "nextcloud_stats_url": "https://nagios:linuxfabrik@cloud.example.com/ocs"
            }
        }
    },
    "Datafield": {
        "1": {
            "uuid": "df-1",
            "varname": "nextcloud_stats_login",
            "settings": {
                "visibility": "hidden"
            }
        }
    }
}
