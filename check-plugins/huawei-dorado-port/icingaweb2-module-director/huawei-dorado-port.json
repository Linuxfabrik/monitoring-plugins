        "4": {
            "varname": "huawei_dorado_port_ignore",
            "caption": "Huawei Dorado Port: Ignore",
            "description": "Skip ports. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the port identifier, its location and its name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e9276d5c-3695-465e-9924-d3c40ce6d2f1"
        },
        "5": {
            "varname": "huawei_dorado_port_insecure",
            "caption": "Huawei Dorado Port: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "63036143-243a-4d3c-850e-cf5e0324f2d5"
        },
        "6": {
            "varname": "huawei_dorado_port_link_down_severity",
            "caption": "Huawei Dorado Port: Link Down Severity",
            "description": "State to report for a port whose link is down. A port that is simply not cabled reports the same thing, which is why this defaults to not alerting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_port_link_down_severity_list"
            },
            "uuid": "1532a5d2-366b-4cc6-971f-44b547f8f3d6"
        },
        "7": {
            "varname": "huawei_dorado_port_match",
            "caption": "Huawei Dorado Port: Match",
            "description": "Filter by ports. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the port identifier, its location and its name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9935b572-2bcf-45d2-8f16-a22b2ac5bf4e"
        },
        "8": {
            "varname": "huawei_dorado_port_no_insecure",
            "caption": "Huawei Dorado Port: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1776e8a1-7119-401a-b489-e68a8b6e6f65"
        },
        "9": {
            "varname": "huawei_dorado_port_no_match_severity",
            "caption": "Huawei Dorado Port: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_port_no_match_severity_list"
            },
            "uuid": "60f31447-ef67-4217-8e17-249de24cdf73"
        },
