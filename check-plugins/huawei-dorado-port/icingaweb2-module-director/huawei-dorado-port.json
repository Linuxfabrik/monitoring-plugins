            "max_check_attempts": 5,
            "notes": "Checks the health and link status of the front-end ports of a Huawei OceanStor Dorado storage system via the REST API (/fc_port, /eth_port, /sas_port and /bond_port endpoints). Alerts when a port reports a non-normal health status, when it negotiated a speed below the one it is configured or built for, and optionally when a link is down. Reports the link error counters the appliance keeps as per-second rates. Supports reporting the I/O counters via --performance.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/huawei-dorado-port/",
            "object_name": "tpl-service-huawei-dorado-port",
            "object_type": "template",
            "retry_interval": 30,
            "service_set": null,
            "template_choice": null,
            "use_agent": false,
            "use_var_overrides": null,
            "vars": {
                "criticality": "A",
                "huawei_dorado_port_always_ok": false,
                "huawei_dorado_port_brief": false,
                "huawei_dorado_port_cache_expire": 15,
                "huawei_dorado_port_critical_errors": "",
                "huawei_dorado_port_device_id": "",
                "huawei_dorado_port_ignore": [],
                "huawei_dorado_port_insecure": true,
                "huawei_dorado_port_link_down_severity": "ok",
                "huawei_dorado_port_match": [],
                "huawei_dorado_port_no_match_severity": "ok",
                "huawei_dorado_port_no_perfdata": false,
                "huawei_dorado_port_no_proxy": false,
                "huawei_dorado_port_performance": false,
                "huawei_dorado_port_scope": "0",
                "huawei_dorado_port_slow_port_severity": "warn",
                "huawei_dorado_port_timeout": 3,
                "huawei_dorado_port_warning_errors": "",
                "huawei_dorado_port_verbose": false
            },
            "volatile": null,
            "zone": null,
            "uuid": "f378edd7-959a-4ff7-8167-958c5ace2137"
        }
