import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_WARN

TESTS = [
    {
        'id': 'warn-no-server-used-v1',
        'test': 'stdout/no-server-used-v1,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['No NTP server used.'],
    },
    {
        'id': 'warn-no-server-used-v2',
        'test': 'stdout/no-server-used-v2,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['No NTP server used.'],
    },
    {
        'id': 'ok-stratum-2-synced-v1',
        'test': 'stdout/stratum-2-synced-v1,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['Stratum is 2'],
    },
    {
        'id': 'warn-no-server-used-v3',
        'test': 'stdout/no-server-used-v3,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['No NTP server used.'],
    },
    {
        'id': 'ok-stratum-2-synced-v2',
        'test': 'stdout/stratum-2-synced-v2,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['Stratum is 2'],
    },
    # A host disciplined by a PTP hardware clock: stratum 1, a Reference that
    # is a clock name instead of a hex refid, root delay and dispersion in
    # microseconds rather than milliseconds, and no LinkNTPServers line.
    {
        'id': 'ok-stratum-1-phc-reference',
        'test': 'stdout/stratum-1-phc-reference,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['Stratum is 1', "'stratum'=1;6;;0;16"],
    },
    # Same fixture, --stratum lowered to 1, so stratum 1 is now at the bar.
    {
        'id': 'warn-stratum-1-at-threshold',
        'test': 'stdout/stratum-1-phc-reference,,0',
        'params': '--stratum=1',
        'assert-retc': STATE_WARN,
        'assert-in': ['Stratum is 1 (is >= 1'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../ntp-systemd-timesyncd'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
