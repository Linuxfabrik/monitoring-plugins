                "journald_query_always_ok": false,
                "journald_query_icinga_callback": false,
                "journald_query_ignore": [],
                "journald_query_match": [],
                "journald_query_no_match_severity": "ok",
                "journald_query_insecure": true,
                "journald_query_no_perfdata": false,
                "journald_query_no_proxy": false,
                "journald_query_priority": "emerg..err",
                "journald_query_severity": "warn",
                "journald_query_since": "\\-8h",
                "journald_query_timeout": 5,
                "journald_query_unit": [],
                "journald_query_user_unit": []
            },
            "volatile": null,
            "zone": null,
            "uuid": "05c83f7f-ed1c-43b9-a700-48784db7dce6"
