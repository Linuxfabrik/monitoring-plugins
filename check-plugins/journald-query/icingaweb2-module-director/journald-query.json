    "Datafield": {
        "1": {
            "varname": "journald_query_always_ok",
            "caption": "Journald Query: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "560110e0-80de-4cc0-b0b9-463fc35295f0"
        },
        "2": {
            "varname": "journald_query_facility",
            "caption": "Journald Query: Facility",
            "description": "Filter output by syslog facility (passed to journalctl). Takes a comma-separated list of numbers or facility names.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ac2f79f6-71e4-43cc-a7ef-714c2f5f9163"
        },
        "3": {
            "varname": "journald_query_icinga_callback",
            "caption": "Journald Query: Icinga Callback?",
            "description": "Ask the monitoring server whether the service running this check is acknowledged. Where it is, what this run reports is remembered as already handled, so it no longer raises an alert on the following runs. Requires `--icinga-url`, `--icinga-username`, `--icinga-password` and `--icinga-service-name`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4d0f66b1-4af3-4fd0-a9af-6131bca6d713"
        },
        "4": {
            "varname": "journald_query_icinga_password",
            "caption": "Journald Query: Icinga Password",
            "description": "Monitoring server API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "e926a25f-0619-49ae-b2df-c2bbc19d569c"
        },
        "5": {
            "varname": "journald_query_icinga_service_name",
            "caption": "Journald Query: Icinga Service Name",
            "description": "Unique name of the service running this check, as the monitoring server knows it. Take it from the `__name` service attribute. Example: `monitoring-server!my-service-name`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c089e878-e795-44fd-8eb3-b8ed3a481c91"
        },
        "6": {
            "varname": "journald_query_icinga_url",
            "caption": "Journald Query: Icinga URL",
            "description": "Monitoring server API URL. Example: `https://monitoring.example.com:5665`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c9673f89-f55d-4e48-a963-289f3eee4d5a"
        },
        "7": {
            "varname": "journald_query_icinga_username",
            "caption": "Journald Query: Icinga Username",
            "description": "Monitoring server API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7f4f778f-2111-416a-b464-a60be0dec120"
        },
        "8": {
            "varname": "journald_query_identifier",
            "caption": "Journald Query: Identifier",
            "description": "Show messages for the specified syslog identifier (passed to journalctl).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f8067419-b975-4dc2-8907-1d55b64f4895"
        },
        "9": {
            "varname": "journald_query_ignore",
            "caption": "Journald Query: Ignore",
            "description": "Ignore an event whose MESSAGE field matches this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Example: `--ignore='(?i)linuxfabrik'`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a7605c6c-dd26-4859-9b2e-12eac6957349"
        },
        "10": {
            "varname": "journald_query_match",
            "caption": "Journald Query: Match",
            "description": "Only report an event whose MESSAGE field matches this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Example: `--match='(?i)out of memory'`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fc6c6893-3581-4063-bae6-5e868fb637b9"
        },
        "11": {
            "varname": "journald_query_no_match_severity",
            "caption": "Journald Query: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "journald_query_no_match_severity_list"
            },
            "uuid": "74b7ec4f-372b-4957-bb84-f8c9ba3929d6"
        },
        "12": {
            "varname": "journald_query_insecure",
            "caption": "Journald Query: Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7d905e4c-8461-4a4e-b98d-3dc3412562cf"
        },
        "13": {
            "varname": "journald_query_no_insecure",
            "caption": "Journald Query: No Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c0c48247-d133-48de-925e-65e57a7d66d5"
        },
        "14": {
            "varname": "journald_query_no_perfdata",
            "caption": "Journald Query: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1e52be09-5804-4288-91d7-203047c24e79"
        },
        "15": {
            "varname": "journald_query_no_proxy",
            "caption": "Journald Query: No Proxy?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "55e6d16f-1454-46a3-927e-78d19f7fd1f0"
        },
        "16": {
            "varname": "journald_query_priority",
            "caption": "Journald Query: Priority",
            "description": "Filter output by message priorities or priority ranges (passed to journalctl).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "365b15ae-a51c-4e48-a457-994549b05d76"
        },
        "17": {
            "varname": "journald_query_proxy",
            "caption": "Journald Query: Proxy",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6152a13b-e966-4c68-8ee9-a9a697e440e4"
        },
        "18": {
            "varname": "journald_query_severity",
            "caption": "Journald Query: Severity",
            "description": "Severity for alerts when journalctl returns results.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "journald_query_severity_list"
            },
            "uuid": "13f9360c-fa85-47f2-9503-9e91a73695f7"
        },
        "19": {
            "varname": "journald_query_since",
            "caption": "Journald Query: Since",
            "description": "Show entries on or newer than the specified date (passed to journalctl).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "858a4298-5f7e-41af-be65-a0028115b7be"
        },
        "20": {
            "varname": "journald_query_timeout",
            "caption": "Journald Query: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "157f271f-7d0a-449b-87a3-422afaba2ce1"
        },
        "21": {
            "varname": "journald_query_unit",
            "caption": "Journald Query: Unit",
            "description": "Show messages for the specified systemd unit UNIT|PATTERN (passed to journalctl). Can be specified multiple times.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8a6371ec-9b10-4bd3-b689-731b4dfeea67"
        },
        "22": {
            "varname": "journald_query_user_unit",
            "caption": "Journald Query: User Unit",
            "description": "Show messages for the specified user session unit (passed to journalctl). Can be specified multiple times.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "68787d9f-3bcd-46c8-8341-5f8d199bf098"
        }
    }
