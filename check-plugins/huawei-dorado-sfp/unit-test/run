# https://github.com/Linuxfabrik/monitoring-plugins/blob/main/CONTRIBUTING.md

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN

TESTS = [
    {
        # The fields as the firmware sends them: upper case, padded with blanks to a
        # fixed width. One healthy 10G module, one FC port with its link down and no
        # light (`RXPOWER` `[1]`, -40 dBm), and one 4-lane QSFP reporting the "no
        # value" marker in every lane and in `SFPMODETYPE`.
        # Verified against V700R001C10SPH128 on a Dorado 6000 V6.
        'id': 'ok-sfps-upper-case-fields',
        'test': 'stdout/sfps-upper-case-fields,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Location ',
            'CTE0.A.IOM0.P0 ! interface module ! Hisense      ! LTF8502-BC+   ! '
            'multi-mode ! 10000  ! -2.51',
            'CTE0.A.P0      ! controller       ! LUXSHARE-ICT ! L99QF029-SD-R ! '
            'unknown    ! 100000 ! --',
            "'CTE0_A_IOM0_P0_rx_power'=-2.51;",
            "'CTE0_A_IOM0_P0_speed'=10000;",
            "'CTE0_A_IOM0_P0_tx_power'=",
        ],
        # The health and link states are in the table and drive the state, never
        # perfdata.
        'assert-not-in': [
            'Unknown',
            "'_",
            '[CRITICAL]',
            'CTE0_A_P0_rx_power',
            '_health_status',
            '_running_status',
        ],
    },
    {
        # A port whose link is down receives no light, so its receive power is shown
        # and graphed but not judged: an unused port must not go CRIT.
        'id': 'ok-link-down-rx-power-not-judged',
        'test': 'stdout/sfps-upper-case-fields,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin',
        'assert-retc': STATE_OK,
        'assert-regex': r'CTE0\.A\.IOM1\.P3 .* -40\.0    ! -1\.44 .* Link down \(11\)'
        r' .* \[OK\]',
        'assert-in': ["'CTE0_A_IOM1_P3_rx_power'=-40.0;;-13.2:5.0"],
    },
    {
        # --link-down-severity alone decides about such a port.
        'id': 'warn-link-down-severity-upper-case-fields',
        'test': 'stdout/sfps-upper-case-fields,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --link-down-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['There are warnings.', '[WARNING]'],
        'assert-not-in': ['[CRITICAL]'],
    },
    {
        # The filter reaches the location the firmware reports in upper case.
        'id': 'ok-match-on-upper-case-location',
        'test': 'stdout/sfps-upper-case-fields,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        "--username=admin --match='CTE0\\.A\\.IOM1\\.P3$'",
        'assert-retc': STATE_OK,
        'assert-in': ['CTE0.A.IOM1.P3'],
        'assert-not-in': ['CTE0.A.IOM0.P0', 'CTE0.A.P0 '],
    },
    {
        # The blank padding is stripped, so an anchored filter on the vendor works.
        'id': 'ok-match-on-padded-vendor',
        'test': 'stdout/sfps-upper-case-fields,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        "--username=admin --match='Hisense$'",
        'assert-retc': STATE_OK,
        'assert-in': ['CTE0.A.IOM0.P0'],
        'assert-not-in': ['CTE0.A.IOM1.P3', 'CTE0.A.P0 '],
    },
    {
        # The vendor's response example reports the "no value" marker as the speed,
        # which must not be graphed as 4.29e9 Mbit/s.
        'id': 'ok-speed-not-reported',
        'test': 'stdout/sfp-speed-not-reported,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin',
        'assert-retc': STATE_OK,
        'assert-not-in': ['_speed', '4294967295'],
    },
    {
        # The spelling of the REST Interface Reference's parameter table: camelCase.
        # Both spellings are read. An SFP carries no TYPE, so the modules are
        # identified by their location rather than by the TYPE:ID every other
        # object on this appliance has.
        'id': 'ok-sfps-healthy',
        'test': 'stdout/sfps-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            # Column widths follow the widest value, so the row is asserted per cell.
            'CTE0.A.IOM0.P0 ! interface module ! HUAWEI ! SFP-32G-FC ! single-mode',
            'Link up (10)',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the inventory ones out.
        'id': 'ok-sfps-healthy-core-columns',
        'test': 'stdout/sfps-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Location       ! Sits In          ! Mbit/s ! Link',
            'Link up (10)',
        ],
        'assert-not-in': ['Vendor', 'SFP-32G-FC', 'single-mode'],
    },
    {
        # A module whose light is well inside the range it declares for itself.
        # 10000 * 0.1 uW is 1 mW, which is 0 dBm.
        'id': 'ok-optical-power-inside-the-module-range',
        'test': 'stdout/sfp-power-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.', '0.0', '3.01'],
        # The critical range in the performance data is the module's own: 1000 and
        # 50000 tenths of a microwatt are -10 dBm and 6.99 dBm.
        'assert-regex': r"_rx_power'=0\.0;;-10\.0:6\.99",
    },
    {
        # Receive power below the minimum the module itself reports: a degrading
        # transceiver or a dirty connector, long before the link drops.
        'id': 'crit-optical-power-below-the-module-minimum',
        'test': 'stdout/sfp-power-rx-too-low,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': ['There are critical errors.', '-20.0', '[CRITICAL]'],
    },
    {
        # A module reporting its bounds the wrong way round used to become an invalid
        # Nagios range, which took the whole check to UNKNOWN without naming it.
        'id': 'ok-module-reports-an-inverted-operating-range',
        'test': 'stdout/sfp-power-range-inverted,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.'],
    },
    {
        # The operator's own range still applies to such a module.
        'id': 'crit-inverted-range-still-honours-an-explicit-range',
        'test': 'stdout/sfp-power-range-inverted,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin '
        '--rx-power-critical=1:6',
        'assert-retc': STATE_CRIT,
    },
    {
        # An explicit critical range replaces the module's own, for an appliance whose
        # transceivers report a range nobody wants to be alerted on.
        'id': 'ok-optical-power-against-an-explicit-range',
        'test': 'stdout/sfp-power-rx-too-low,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin '
        '--rx-power-critical=-25:0',
        'assert-retc': STATE_OK,
    },
    {
        # A warning range does not replace the module's own critical range; it adds an
        # earlier step to it.
        'id': 'crit-explicit-warning-keeps-the-module-critical-range',
        'test': 'stdout/sfp-power-rx-too-low,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin '
        '--rx-power-warning=-25:0',
        'assert-retc': STATE_CRIT,
    },
    {
        # Every optical field filled with the appliance's "no reading" marker, which is
        # what the vendor's own response example shows. dBm is undefined for it.
        'id': 'ok-optical-power-not-reported',
        'test': 'stdout/sfp-power-not-reported,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-not-in': ['_rx_power', '_tx_power'],
    },
    {
        # The second module has its link down, which is what an uncabled one
        # reports too, so it stays quiet unless asked otherwise.
        'id': 'warn-link-down-severity',
        'test': 'stdout/sfps-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        ' --link-down-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['There are warnings.'],
    },
    {
        'id': 'crit-sfp-faulty',
        'test': 'stdout/sfps-one-faulty,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': ['There are critical errors.', '[CRITICAL]'],
    },
    {
        # A purely SAS-attached array has no optical module, and firmware older
        # than V700R001C10 does not serve this endpoint at all.
        'id': 'ok-no-sfps',
        'test': 'stdout/no-sfps,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['No optical modules found.'],
    },
    {
        # The filter reaches the serial number, which is what a support case is
        # opened with.
        'id': 'ok-match-filters-on-serial',
        'test': 'stdout/sfps-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        " --match='SN00000000$'",
        'assert-retc': STATE_OK,
        'assert-in': ['CTE0.A.IOM0.P0'],
        'assert-not-in': ['CTE0.A.IOM0.P1'],
    },
    {
        'id': 'crit-no-match-severity',
        'test': 'stdout/sfps-healthy,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin'
        " --match='nonexistent' --no-match-severity=crit",
        'assert-retc': STATE_CRIT,
        'assert-in': ['No optical modules matched `nonexistent`.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-sfp'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
