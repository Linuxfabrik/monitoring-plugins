            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Checks the health, link status and optical power of the optical modules (SFP) of a Huawei OceanStor Dorado storage system via the REST API (/sfp endpoint). Alerts when a module reports a non-normal health status, when its receive or transmit power leaves the range the module itself reports as its operating range, and optionally when its link is down. A degrading transceiver or a dirty connector shows up as falling receive power long before the link drops. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/huawei-dorado-sfp/",
            "object_name": "tpl-service-huawei-dorado-sfp",
            "object_type": "template",
            "retry_interval": 30,
            "service_set": null,
            "template_choice": null,
            "use_agent": false,
            "use_var_overrides": null,
            "vars": {
                "criticality": "A",
                "huawei_dorado_sfp_always_ok": false,
                "huawei_dorado_sfp_brief": true,
                "huawei_dorado_sfp_cache_expire": 15,
                "huawei_dorado_sfp_device_id": "",
                "huawei_dorado_sfp_ignore": [],
                "huawei_dorado_sfp_insecure": true,
                "huawei_dorado_sfp_link_down_severity": "ok",
                "huawei_dorado_sfp_lengthy": false,
                "huawei_dorado_sfp_match": [],
                "huawei_dorado_sfp_no_match_severity": "ok",
                "huawei_dorado_sfp_no_perfdata": false,
                "huawei_dorado_sfp_no_proxy": false,
                "huawei_dorado_sfp_rx_power_critical": "",
                "huawei_dorado_sfp_rx_power_warning": "",
                "huawei_dorado_sfp_scope": "0",
                "huawei_dorado_sfp_tx_power_critical": "",
                "huawei_dorado_sfp_tx_power_warning": "",
                "huawei_dorado_sfp_timeout": 3,
                "huawei_dorado_sfp_verbose": false
            },
            "volatile": null,
            "zone": null,
            "uuid": "469755b9-c174-4e42-88d2-6e1c77bb6890"
        }
    },
