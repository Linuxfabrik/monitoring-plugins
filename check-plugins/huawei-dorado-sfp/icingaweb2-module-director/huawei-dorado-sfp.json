    "Datafield": {
        "1": {
            "varname": "huawei_dorado_sfp_always_ok",
            "caption": "Huawei Dorado Sfp: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2b4e1711-bafa-45b6-9ca5-79a05ee01b03"
        },
        "2": {
            "varname": "huawei_dorado_sfp_brief",
            "caption": "Huawei Dorado Sfp: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on. Worth setting on an array with many optical modules.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d5f7702a-e035-4f8d-b348-f0bcc377970b"
        },
        "3": {
            "varname": "huawei_dorado_sfp_cache_expire",
            "caption": "Huawei Dorado Sfp: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b3d0c302-95e6-426f-a71a-13e576996c36"
        },
        "4": {
            "varname": "huawei_dorado_sfp_device_id",
            "caption": "Huawei Dorado Sfp: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7ef3a9dc-2e36-4d1a-be5a-4ac22b0bce2e"
        },
        "5": {
            "varname": "huawei_dorado_sfp_ignore",
            "caption": "Huawei Dorado Sfp: Ignore",
            "description": "Skip optical modules. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the module identifier, its location, vendor, model and serial number, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d0dd97e8-32bc-4373-8ed6-497cc59550b3"
        },
        "6": {
            "varname": "huawei_dorado_sfp_insecure",
            "caption": "Huawei Dorado Sfp: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f0663e90-f401-48f7-ac42-d50e7a331753"
        },
        "7": {
            "varname": "huawei_dorado_sfp_link_down_severity",
            "caption": "Huawei Dorado Sfp: Link Down Severity",
            "description": "State to report for a port whose link is down. A port that is simply not cabled reports the same thing, which is why this defaults to not alerting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_sfp_link_down_severity_list"
            },
            "uuid": "c561692d-fefe-4d1a-a8a6-ab155a4ca12a"
        },
        "8": {
            "varname": "huawei_dorado_sfp_lengthy",
            "caption": "Huawei Dorado Sfp: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fd0df42a-cb03-4799-948b-29fc7c579444"
        },
        "9": {
            "varname": "huawei_dorado_sfp_match",
            "caption": "Huawei Dorado Sfp: Match",
            "description": "Limit to optical modules. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the module identifier, its location, vendor, model and serial number, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e13fd3e5-3795-4b82-b80a-9b5272b320c6"
        },
        "10": {
            "varname": "huawei_dorado_sfp_no_insecure",
            "caption": "Huawei Dorado Sfp: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3e79dff6-38f2-4377-99c4-187b81646bda"
        },
        "11": {
            "varname": "huawei_dorado_sfp_no_match_severity",
            "caption": "Huawei Dorado Sfp: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_sfp_no_match_severity_list"
            },
            "uuid": "d76a76d3-407f-4d16-bd10-892875fde589"
        },
        "12": {
            "varname": "huawei_dorado_sfp_no_perfdata",
            "caption": "Huawei Dorado Sfp: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4d41c0d1-aa66-4b00-b686-a3f2611291b4"
        },
        "13": {
            "varname": "huawei_dorado_sfp_no_proxy",
            "caption": "Huawei Dorado Sfp: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2a67ba39-c483-491f-b6c6-9feaeba471d9"
        },
        "14": {
            "varname": "huawei_dorado_sfp_password",
            "caption": "Huawei Dorado Sfp: Password",
            "description": "Huawei OceanStor Dorado API password. Password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "1408db38-4083-4d69-a0d3-38294ec3f20b"
        },
        "15": {
            "varname": "huawei_dorado_sfp_password_file",
            "caption": "Huawei Dorado Sfp: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "3c4b0d48-b318-453c-90c0-91c46b706be8"
        },
        "16": {
            "varname": "huawei_dorado_sfp_rx_power_critical",
            "caption": "Huawei Dorado Sfp: Rx Power Critical",
            "description": "CRIT threshold for the receive power of a module, as a Nagios range in dBm. Defaults to the operating range the module itself reports, so a transceiver is judged against its own data sheet rather than against one number for the whole appliance. Example: `--rx-power-critical=-14:0`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8d22e5f6-c251-4458-9827-8941c4692eae"
        },
        "17": {
            "varname": "huawei_dorado_sfp_rx_power_warning",
            "caption": "Huawei Dorado Sfp: Rx Power Warning",
            "description": "WARN threshold for the receive power of a module, as a Nagios range in dBm. Example: `--rx-power-warning=-12:-1`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "116be64b-91d2-4680-819e-506061fb60e0"
        },
        "18": {
            "varname": "huawei_dorado_sfp_scope",
            "caption": "Huawei Dorado Sfp: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6fdb16ae-50c8-4e74-a805-a77250d133f5"
        },
        "19": {
            "varname": "huawei_dorado_sfp_tx_power_critical",
            "caption": "Huawei Dorado Sfp: Tx Power Critical",
            "description": "CRIT threshold for the transmit power of a module, as a Nagios range in dBm. Defaults to the operating range the module itself reports. Example: `--tx-power-critical=-9:3`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a8a6eee0-8467-40eb-a0cf-736de2e3fecc"
        },
        "20": {
            "varname": "huawei_dorado_sfp_tx_power_warning",
            "caption": "Huawei Dorado Sfp: Tx Power Warning",
            "description": "WARN threshold for the transmit power of a module, as a Nagios range in dBm. Example: `--tx-power-warning=-8:2`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "70572221-7e38-4895-94e6-223f3903cbb2"
        },
        "21": {
            "varname": "huawei_dorado_sfp_timeout",
            "caption": "Huawei Dorado Sfp: Timeout",
