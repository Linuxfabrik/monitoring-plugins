    "ServiceTemplate": {
        "tpl-service-huawei-dorado-sfp": {
            "action_url": null,
            "apply_for": null,
            "assign_filter": null,
            "check_command": "cmd-check-huawei-dorado-sfp",
            "check_interval": 300,
            "check_period": null,
