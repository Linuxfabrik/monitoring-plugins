import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        # a check that may not talk to the engine says nothing about the engine:
        # it is deployed wrong, not broken, so it must not raise a false alarm
        'id': 'unknown-no-permission',
        'test': ',stderr/permission-denied,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No permission to talk to the container engine'],
    },
    {
        # an engine that is not answering is the outage this check reports
        'id': 'crit-engine-not-running',
        'test': ',stderr/daemon-not-running,1',
        'assert-retc': STATE_CRIT,
        'assert-in': ['Is the docker daemon running?'],
    },
    {
        # --always-ok suppresses the alert of an engine that is down or failing
        'id': 'ok-always-ok-engine-not-running',
        'test': ',stderr/daemon-not-running,1',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['(always ok)'],
    },
    {
        'id': 'ok-empty-no-containers',
        'test': 'stdout/empty-no-containers,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['No containers to check.'],
    },
    {
        'id': 'ok-one-container-shortname',
        'test': 'stdout/one-container-traefik,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Container         ! CPU % ! Mem %',
            '------------------+-------+------',
            'traefik_traefik.2 ! 0.0   ! 0.0',
            # per-container perfdata (https://github.com/Linuxfabrik/monitoring-plugins/issues/1104)
            "'traefik_traefik_2_cpu_usage'=0.0%",
            "'traefik_traefik_2_mem_usage'=0.0%",
        ],
    },
    {
        'id': 'ok-one-container-full-name',
        'test': 'stdout/one-container-traefik,,0',
        'params': '--full-name',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Container                                   ! CPU % ! Mem %',
            '--------------------------------------------+-------+------',
            'traefik_traefik.2.1idw12p2yqpxutlzkcwign4at ! 0.0   ! 0.0',
            "'traefik_traefik_2_1idw12p2yqpxutlzkcwign4at_cpu_usage'=0.0%",
            "'traefik_traefik_2_1idw12p2yqpxutlzkcwign4at_mem_usage'=0.0%",
        ],
    },
    {
        'id': 'ok-three-containers-graylog-stack',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Container     ! CPU % ! Mem %',
            '--------------+-------+------',
            'elasticsearch ! 188.8 ! 16.7',
            'graylog       ! 204.2 ! 5.7',
            'mongo         ! 0.3   ! 1.9',
            "'elasticsearch_cpu_usage'=188.8%",
            "'elasticsearch_mem_usage'=16.7%",
            "'graylog_cpu_usage'=204.2%",
            "'graylog_mem_usage'=5.7%",
            "'mongo_cpu_usage'=0.3%",
            "'mongo_mem_usage'=1.9%",
        ],
    },
    {
        'id': 'ok-many-gitlab-runners-long-names',
        'test': 'stdout/many-gitlab-runners,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Container                                                           ! CPU % ! Mem %',
            '--------------------------------------------------------------------+-------+------',
            'runner-7ayh6h5f-project-107-concurrent-0-37b2c7aee9359db9-build     ! 95.0  ! 1.2',
            'runner-7ayh6h5f-project-19-concurrent-0-99f0211c36d59d01-build      ! 59.5  ! 1.0',
            'runner-7ayh6h5f-project-49-concurrent-0-e180afe41fc754dc-predefined ! 79.5  ! 0.1',
            "'runner_7ayh6h5f_project_107_concurrent_0_37b2c7aee9359db9_build_cpu_usage'=95.0%",
            "'runner_7ayh6h5f_project_49_concurrent_0_e180afe41fc754dc_predefined_mem_usage'=0.1%",
        ],
    },
    {
        # a container the engine could not collect statistics for is listed, but
        # neither measured nor alerted on
        'id': 'ok-stats-unavailable',
        'test': 'stdout/stats-unavailable,,0',
        'params': '--warning-cpu=9999 --critical-cpu=9999',
        'assert-retc': STATE_OK,
        'assert-in': [
            'graylog   ! 204.2 ! 5.7',
            'mongo     ! -     ! -',
            "'graylog_cpu_usage'=204.2%",
        ],
        'assert-not-in': ["'mongo_cpu_usage'"],
    },
    {
        'id': 'ok-match-filter',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'params': '--match=^graylog$ --warning-cpu=9999 --critical-cpu=9999',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. 1 container checked.',
            "'graylog_cpu_usage'=204.2%",
        ],
    },
    {
        'id': 'ok-ignore-filter',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'params': '--ignore=mongo --warning-cpu=9999 --critical-cpu=9999',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. 2 containers checked.'],
    },
    {
        'id': 'crit-no-match-severity',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'params': '--match=^nope$ --no-match-severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-in': ['No containers to check.'],
    },
    {
        # with --count=1 the single sample decides; the CPU thresholds are plain upper
        # bounds, the memory threshold is an inverted range that alerts inside 0..2
        'id': 'crit-cpu-and-mem-ranges',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'params': '--count=1 --warning-cpu=150 --critical-cpu=200 --critical-mem=@0:2',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '"elasticsearch" cpu 188.8% [WARNING]',
            '"graylog" cpu 204.2% [CRITICAL]',
            '"mongo" memory 1.9% [CRITICAL]',
            "'mongo_mem_usage'=1.9%;90;@0:2;0;100",
        ],
    },
    {
        # the same CPU usage does not alert before --count samples agree
        'id': 'ok-cpu-range-waits-for-count',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'params': '--count=2 --warning-cpu=150 --critical-cpu=200',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. 3 containers checked'],
    },
    {
        'id': 'unknown-invalid-range',
        'test': 'stdout/three-containers-graylog-stack,,0',
        'params': '--warning-mem=10:5',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Invalid Nagios range for --warning-mem ("10:5")'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../docker-stats'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
