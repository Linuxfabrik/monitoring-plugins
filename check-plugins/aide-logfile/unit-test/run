import atexit
import datetime
import os
import re
import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# In --test mode the fixture stands in for /var/log/aide/aide.log. The fixtures in
# stdout/ are real reports of AIDE, written with the configuration of the LFOps aide
# role (report_level added_removed_entries, verbose=7 on aide 0.16):
#   *-rocky8       aide 0.16 on Rocky 8
#   *-ubuntu2204   aide 0.17.4 on Ubuntu 22.04
#   *-debian12     aide 0.18.3 on Debian 12
#   *-debian13     aide 0.19.1 on Debian 13
#   init-*         `aide --init`
#   clean-*        `aide --check` without differences
#   findings-*     `aide --check` after appending a line to /etc/hosts, adding a file
#                  to /etc/sudoers.d and a setuid binary to /usr/local/bin, and
#                  removing /etc/issue.net
#   update-*       `aide --update` on the same host, which writes a new database;
#                  the test points it at a database below unit-test/ that exists
#                  (not moved yet) or does not (moved over the old one)
#   dailyaidecheck-debian13
#                  the daily check of Debian's aide-common 0.19.1, an update run
#   aborted-rocky8 `aide --check` without a database: aide 0.16 writes the error
#                  into the report and exits with 18
#   empty          the same on aide 0.17 and newer, which leave the report empty
#   json-debian13  `aide --check` with report_format=json
# The age of a report is measured against the real clock, so the fixed fixtures
# switch the age check off with --max-age 0, and the age cases use reports that are
# written below with a start relative to now. So are the reports too large to be
# worth keeping in the repository.
HERE = os.path.dirname(os.path.abspath(__file__))


def read_fixture(name):
    with open(os.path.join(HERE, 'stdout', name), encoding='utf-8') as f:
        return f.read()


def write_fixture(name, text):
    """Write a generated report. It has to live below unit-test/, the only place the
    plugin reads a fixture from.
    """
    path = os.path.join(HERE, 'stdout', name)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(text)
    atexit.register(os.remove, path)


def with_start(text, hours_ago):
    """Return the report with a start timestamp `hours_ago` hours in the past, in
    local time with the UTC offset, as AIDE writes it.
    """
    start = datetime.datetime.now().astimezone() - datetime.timedelta(hours=hours_ago)
    return re.sub(
        r'^Start timestamp: [^(]+\(',
        f'Start timestamp: {start:%Y-%m-%d %H:%M:%S %z} (',
        text,
        flags=re.MULTILINE,
    )


def with_added(text, count, template):
    """Return findings-debian13 with `count` more added files: the summary is
    raised accordingly, and the new files are listed ahead of the real ones.
    """
    text = re.sub(
        r'^(  Added entries:\s+)(\d+)$',
        lambda m: f'{m.group(1)}{int(m.group(2)) + count}',
        text,
        flags=re.MULTILINE,
    )
    added = ''.join(template.format(i) for i in range(count))
    return text.replace(
        'Added entries:\n---------------------------------------------------\n\n',
        'Added entries:\n---------------------------------------------------\n\n'
        + added,
        1,
    )


clean = read_fixture('clean-debian13')
findings = read_fixture('findings-debian13')
write_fixture('generated-1h-old', with_start(clean, 1))
write_fixture('generated-30h-old', with_start(clean, 30))
write_fixture('generated-init-30h-old', with_start(read_fixture('init-debian13'), 30))
# 20,000 added files make a report of about 1 MiB, and the changed files, listed
# after the added ones, must still show up
write_fixture(
    'generated-large',
    with_added(findings, 20000, 'f++++++++++++++++++: /usr/share/linuxfabrik/{}\n'),
)
# beyond the 16 MiB the check reads, the lists that follow are only counted
write_fixture(
    'generated-huge',
    with_added(
        findings,
        200000,
        'f++++++++++++++++++: /usr/share/linuxfabrik/'
        + 'a-rather-long-file-name-of-some-package/{}\n',
    ),
)
# report_level=minimal (aide 0.17 and newer): the outline and nothing else
write_fixture(
    'generated-minimal',
    'AIDE found differences between database and filesystem!!\n',
)
# a report written without line breaks cannot fill the memory
write_fixture('generated-no-line-breaks', 'x' * (1024 * 1024))


def with_database_out(text, path):
    """Return the report of an update run that names `path` as its new database."""
    return re.sub(
        r'^New AIDE database written to .+$',
        f'New AIDE database written to {path}',
        text,
        flags=re.MULTILINE,
    )


# An update run is accepted once its new database is gone, moved over the old one.
# The reports name the database below unit-test/, so the result does not depend on
# the host the tests run on: `pending` holds a new database, `moved` does not.
MOVED = os.path.join(HERE, 'stdout', 'moved', 'aide.db.new.gz')
PENDING = os.path.join(HERE, 'stdout', 'aide.db.new.gz')
write_fixture('aide.db.new.gz', '')
for name in ('update-rocky8', 'update-debian13', 'dailyaidecheck-debian13'):
    write_fixture(
        f'generated-{name}-moved', with_database_out(read_fixture(name), MOVED)
    )
    write_fixture(
        f'generated-{name}-pending', with_database_out(read_fixture(name), PENDING)
    )
# a report cannot make the check probe for a file that is no AIDE database
write_fixture(
    'generated-update-not-a-database',
    with_database_out(read_fixture('update-debian13'), '/nonexistent/linuxfabrik'),
)

