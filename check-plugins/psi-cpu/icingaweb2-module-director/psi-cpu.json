            "settings": {},
            "uuid": "92f46782-bf9f-4613-a209-57606de3abd5"
        },
        "2": {
            "varname": "psi_cpu_critical",
            "caption": "Psi CPU: Critical",
            "description": "CRIT threshold for the CPU pressure, in percent of wall clock time, measured over the last minute. Supports Nagios ranges. Example: `80` alerts where work waits for a CPU 80 percent of the time.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6ad3f1b8-b348-4821-ac96-eb320404b2f1"
        },
        "3": {
            "varname": "psi_cpu_critical_avg10",
            "caption": "Psi CPU: Critical Avg10",
            "description": "CRIT threshold for the CPU pressure, in percent of wall clock time, measured over the last ten seconds. Catches a burst that the one minute average smooths away, at the price of alerting on a stall that is over before anybody looks. Supports Nagios ranges. Example: `90` alerts where work waited for a CPU for nine of the last ten seconds. Default: no critical threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "656de428-3a88-4fc8-b2ef-36f5fb528384"
        },
        "4": {
            "varname": "psi_cpu_no_perfdata",
            "caption": "Psi CPU: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "cf142433-5534-4090-b516-c3881300e3dc"
        },
        "5": {
            "varname": "psi_cpu_severity_no_psi",
            "caption": "Psi CPU: Severity No Psi",
            "description": "Severity for alerting if the kernel keeps no pressure statistics.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "psi_cpu_severity_no_psi_list"
            },
            "uuid": "ea36d39d-8ea2-4730-ad5d-94550b69a4c3"
        },
        "6": {
            "varname": "psi_cpu_warning",
            "caption": "Psi CPU: Warning",
            "description": "WARN threshold for the CPU pressure, in percent of wall clock time, measured over the last minute. Supports Nagios ranges. Example: `50` alerts where work waits for a CPU 50 percent of the time.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fe14dcbc-0b07-41d0-b8e0-f49728e7ba60"
        },
        "7": {
            "varname": "psi_cpu_warning_avg10",
            "caption": "Psi CPU: Warning Avg10",
            "description": "WARN threshold for the CPU pressure, in percent of wall clock time, measured over the last ten seconds. Catches a burst that the one minute average smooths away, at the price of alerting on a stall that is over before anybody looks. Supports Nagios ranges. Example: `80` alerts where work waited for a CPU for eight of the last ten seconds. Default: no warning threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
