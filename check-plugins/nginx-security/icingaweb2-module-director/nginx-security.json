        "2": {
            "varname": "nginx_security_brief",
            "caption": "Nginx Security: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "78a9bf6d-9af5-490d-9580-9dd78789a6b4"
        },
        "3": {
            "varname": "nginx_security_command",
            "caption": "Nginx Security: Command",
            "description": "Path to the NGINX binary. Probed automatically in the PATH if not given. Example: `--command=/usr/local/nginx/sbin/nginx`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6e356180-c61b-4047-b5a1-aa6df1567110"
        },
        "4": {
            "varname": "nginx_security_ignore",
            "caption": "Nginx Security: Ignore",
            "description": "Any check whose name matches this Python regex will be dropped from the report. Use it for a finding the site knowingly accepts, for example a dynamic module the service needs. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Example: `--ignore=^Dynamic modules$`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bc1ccae3-e6c1-4549-93c4-615ade690dbd"
        },
        "5": {
            "varname": "nginx_security_match",
            "caption": "Nginx Security: Match",
            "description": "Only report the checks whose name matches this Python regex. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "19ee0e0a-5c10-4b8a-86ea-f314dc9e1f14"
        },
        "6": {
            "varname": "nginx_security_no_match_severity",
            "caption": "Nginx Security: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "nginx_security_no_match_severity_list"
            },
            "uuid": "b17b604b-cde8-46c6-b830-c415e960645b"
        },
        "7": {
            "varname": "nginx_security_no_perfdata",
            "caption": "Nginx Security: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "b39cb612-c7ca-431d-9f22-3bb48ba5e31d"
        },
        "8": {
            "varname": "nginx_security_severity",
            "caption": "Nginx Security: Severity",
