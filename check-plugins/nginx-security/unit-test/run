import re
import subprocess
import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    # Stock nginx 1.30.4. The account side is clean out of the box; the
    # configuration tree carries the distribution defaults 0644 and 0755, which
    # the benchmark's hardening target does not accept.
    {
        'id': 'warn-stock-configuration-tree-is-world-readable',
        'test': 'stdout/stock',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 of 9 checks failed.',
            'nginx (uid 101)',
            'Not root, uid below UID_MIN, no privileged group, '
            'not a known shared account.',
            '9 paths readable by other.',
            "'nginx_checks_failed'=2",
        ],
        'assert-not-in': ['path writable by other'],
    },
    # Everything below /etc/nginx tightened. What remains is the modules
    # directory, which is a symlink whose target `chmod -R` never reaches.
    {
        'id': 'warn-hardened-tree-keeps-the-symlinked-modules-directory',
        'test': 'stdout/hardened',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 of 9 paths', '1 path readable by other.'],
    },
    # The same host with the two account checks excluded, which is how a site
    # accepts a finding it knows about.
    {
        'id': 'ok-hardened-without-the-tree-check',
        'test': 'stdout/hardened',
        'params': '--ignore=^Config',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. All 7 checks passed, 2 overridden.',
            'overridden [OK]',
        ],
    },
    # Worker running as root, a member of a privileged group, an interactive
    # shell, and a configuration file anybody may rewrite.
    {
        'id': 'warn-root-worker-and-writable-configuration',
        'test': 'stdout/loose',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '5 of 9 checks failed.',
            'root (uid 0)',
            'runs as root',
            'member of root',
            'Not one of the shells that exit instead of opening a session.',
            '1 path writable by other, 8 paths readable by other.',
        ],
    },
    {
        'id': 'crit-root-worker-with-severity-crit',
        'test': 'stdout/loose',
        'params': '--severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-in': ['[CRITICAL]'],
    },
    {
        'id': 'ok-root-worker-with-always-ok',
        'test': 'stdout/loose',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['5 of 9 checks failed.'],
    },
    # A password that can actually be used, as opposed to the "*" the
    # distributions ship, which cannot.
    {
        'id': 'warn-account-carries-a-usable-password',
        'test': 'stdout/usable-password',
        'params': '--match=^Account',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'usable password',
            'The account carries a password that can be used.',
            '`passwd -l root`',
        ],
    },
    # "*" is not a lock, but nothing can be logged in with either.
    {
        'id': 'ok-account-without-password-login',
        'test': 'stdout/loose',
        'params': '--match=^Account.locked',
        'assert-retc': STATE_OK,
        'assert-in': ['no password login'],
    },
    # --brief drops the passing rows without changing the counts or the state.
    {
        'id': 'warn-brief-hides-passing-rows',
        'test': 'stdout/loose',
        'params': '--brief',
        'assert-retc': STATE_WARN,
        'assert-in': ['5 of 9 checks failed.', "'nginx_checks_evaluated'=9"],
        'assert-not-in': ['[OK]'],
    },
    # An excluded check keeps its row and says so, instead of vanishing.
    {
        'id': 'warn-an-ignored-check-is-reported-as-overridden',
        'test': 'stdout/hardened',
        'params': "--ignore='Dynamic modules'",
        'assert-retc': STATE_WARN,
        'assert-in': [
            '1 overridden.',
            'overridden [OK]',
            "'nginx_checks_overridden'=1",
        ],
    },
    # A filter given a module name instead of a check name matches nothing and
    # would otherwise leave a report that looks like a run without any filter.
    {
        'id': 'warn-a-filter-that-matches-nothing-is-named',
        'test': 'stdout/hardened',
        'params': '--ignore=ngx_http_geoip_module',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '`ngx_http_geoip_module` matched no check',
            'take the name as it stands in the `Check Name` column',
        ],
    },
    # The benchmark asks for this outright (2.2.1): a worker account that can
    # sudo is a root shell away from owning the host.
    {
        'id': 'warn-worker-account-may-use-sudo',
        'test': 'stdout/loose',
        'params': "--match='Account sudo'",
        'assert-retc': STATE_WARN,
        'assert-in': [
            '1 sudo rule',
            'Can take privileges back through sudo.',
            'Remove the rules that name `root`',
        ],
    },
    # Everything filtered out: report the configured severity, not a pass.
    {
        'id': 'ok-nothing-checked',
        'test': 'stdout/stock',
        'params': '--ignore=.',
        'assert-retc': STATE_OK,
        'assert-in': ['Nothing checked.'],
    },
    {
        'id': 'warn-nothing-checked-with-severity',
        'test': 'stdout/stock',
        'params': '--ignore=. --no-match-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['Nothing checked.'],
    },
    # Nothing configures the request body size, so the built-in default applies
    # everywhere without anybody having decided so.
    {
        'id': 'warn-stock-request-body-limit-is-the-default',
        'test': 'stdout/stock',
        'params': '--match=^Request',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '1m (default)',
            'Not configured, so the built-in default applies everywhere.',
        ],
    },
    # A restrictive limit in the http block, raised in the location that takes
    # uploads, which is what the benchmark asks for.
    {
        'id': 'ok-hardened-request-body-limit',
        'test': 'stdout/hardened',
        'params': '--match=^Request',
        'assert-retc': STATE_OK,
        'assert-in': ['2m, 50m'],
        'assert-not-in': ['(default)'],
    },
    # A zero is the one value that really does remove the limit.
    {
        'id': 'warn-request-body-limit-lifted',
        'test': 'stdout/loose',
        'params': '--match=^Request',
        'assert-retc': STATE_WARN,
        'assert-in': ['0 removes the limit, so a request body may be any size.'],
    },
    {
        'id': 'unknown-missing-fixture',
        'test': 'stdout/does-not-exist',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['not found'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../nginx-security'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestCheckNames(unittest.TestCase):
    """The `--ignore='<name>'` every recommendation prints carries no anchors,
    which is only correct while the names stay unambiguous as substrings and free
    of regular expression metacharacters. Both are properties of the names, so
    they are pinned here rather than left to whoever adds the next check."""

    def setUp(self):
        completed = subprocess.run(
            [sys.executable, '../nginx-security', '--test=stdout/stock'],
            capture_output=True,
            text=True,
            check=False,
        )
        self.output = completed.stdout
        self.titles = [
            line.split(' ! ')[0].strip()
            for line in self.output.splitlines()
            if ' ! ' in line and not line.startswith('Check Name')
        ]

    def test_the_fixture_produced_names(self):
        self.assertGreater(len(self.titles), 4, self.output)

    def test_no_name_carries_a_regex_metacharacter(self):
        for title in self.titles:
            self.assertIsNone(
                re.search(r'[.^$*+?()\[\]{}|\\]', title),
                f'{title} would not survive being used as a pattern',
            )

    def test_no_name_is_a_substring_of_another(self):
        for title in self.titles:
            for other in self.titles:
                if title != other:
                    self.assertNotIn(
                        title,
                        other,
                        f'--ignore={title!r} would also drop {other!r}',
                    )


if __name__ == '__main__':
    unittest.main()
