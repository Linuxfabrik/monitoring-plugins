            "uuid": "72f5f94f-6a5c-4b01-91df-46e543399755"
        },
        "6": {
            "varname": "avelon_tickets_ignore",
            "caption": "Avelon Tickets: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2dc6b06f-3ab9-4d7f-aa96-508416b55370"
        },
        "7": {
            "varname": "avelon_tickets_insecure",
            "caption": "Avelon Tickets: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "13013b8a-daf3-4510-837b-81e01c4f9477"
        },
        "8": {
            "varname": "avelon_tickets_lengthy",
            "caption": "Avelon Tickets: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "596b76d4-137a-4479-9292-fff70e9fd4a3"
        },
        "9": {
            "varname": "avelon_tickets_match",
            "caption": "Avelon Tickets: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7ce4080b-20f3-410a-a48a-dad505b5d440"
        },
        "10": {
            "varname": "avelon_tickets_no_proxy",
            "caption": "Avelon Tickets: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1ecc5f5a-d5e5-42a4-9643-2cc1925b0f8c"
        },
        "11": {
            "varname": "avelon_tickets_password",
            "caption": "Avelon Tickets: Password",
            "description": "Password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "f87eaa68-f459-4f24-b500-7b9a095f7b68"
        },
        "12": {
            "varname": "avelon_tickets_proxy",
            "caption": "Avelon Tickets: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b0323fc4-ad10-4771-ada4-09012ce6b1f4"
        },
        "13": {
            "varname": "avelon_tickets_timeout",
            "caption": "Avelon Tickets: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9d51d510-5b36-4853-9a5c-7adbc0bef9af"
        },
        "14": {
            "varname": "avelon_tickets_type",
            "caption": "Avelon Tickets: Type",
            "description": "Ticket type to check. `ALARM` is raised by a device or a data point, `BUILDING` is a report by a tenant or a user, `SYSTEM_MONITOR` is a system event. Can be specified multiple times. Example: `--type=ALARM --type=SYSTEM_MONITOR`. Default: ALARM",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "array",
                "datalist": "avelon_tickets_type_list"
            },
            "uuid": "7369d158-c903-4f70-9937-b5063ec834dd"
        },
