        "5": {
            "varname": "avelon_tickets_critical",
            "caption": "Avelon Tickets: Critical",
            "description": "Ticket status that returns CRIT. `none` returns CRIT for no status. Takes precedence over `--warning`. Can be specified multiple times. Example: `--critical=OPEN --critical=REOPENED`. Default: none",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "array",
                "datalist": "avelon_tickets_critical_list"
