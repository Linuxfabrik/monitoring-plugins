    "Datafield": {
        "1": {
            "varname": "huawei_dorado_quota_always_ok",
            "caption": "Huawei Dorado Quota: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4617bf0f-7b7d-40a2-b31d-cbdc865b57da"
        },
        "2": {
            "varname": "huawei_dorado_quota_brief",
            "caption": "Huawei Dorado Quota: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on. Worth setting on an appliance with many quotas.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0e39606e-63a7-4555-a2a0-ba0692ca1f08"
        },
        "3": {
            "varname": "huawei_dorado_quota_cache_expire",
            "caption": "Huawei Dorado Quota: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4920acd0-7ff3-440d-afcb-2d6247dca3f8"
        },
        "4": {
            "varname": "huawei_dorado_quota_critical",
            "caption": "Huawei Dorado Quota: Critical",
            "description": "CRIT threshold in percent. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5e2b22b9-b115-4c8a-a098-be85d09eb90f"
        },
        "5": {
            "varname": "huawei_dorado_quota_device_id",
            "caption": "Huawei Dorado Quota: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3ee3aa61-a5ce-4a33-9162-16dc74f4170b"
        },
        "6": {
            "varname": "huawei_dorado_quota_ignore",
            "caption": "Huawei Dorado Quota: Ignore",
            "description": "Skip quotas. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the share name, including the owner of a user or user group quota, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "63852309-008b-40f4-a625-622f001d06b2"
        },
        "7": {
            "varname": "huawei_dorado_quota_insecure",
            "caption": "Huawei Dorado Quota: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c178a783-1791-4e51-a0c4-a86c8a542133"
        },
        "8": {
            "varname": "huawei_dorado_quota_lengthy",
            "caption": "Huawei Dorado Quota: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "58da8455-e5ba-446e-9e39-61cfadae0efc"
        },
        "9": {
            "varname": "huawei_dorado_quota_match",
            "caption": "Huawei Dorado Quota: Match",
            "description": "Limit to quotas. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the share name, including the owner of a user or user group quota, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f666b117-df14-4721-a18b-697c2f27634a"
        },
        "10": {
            "varname": "huawei_dorado_quota_no_insecure",
            "caption": "Huawei Dorado Quota: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6000485e-2ecf-42e8-a4d6-96c89c1aa778"
        },
        "11": {
            "varname": "huawei_dorado_quota_no_match_severity",
            "caption": "Huawei Dorado Quota: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_quota_no_match_severity_list"
            },
            "uuid": "37271828-b7b9-45a0-a3a3-fbf3017cf9ee"
        },
        "12": {
            "varname": "huawei_dorado_quota_no_perfdata",
            "caption": "Huawei Dorado Quota: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "130315ee-7d12-411e-984d-95b96969495c"
        },
        "13": {
            "varname": "huawei_dorado_quota_no_proxy",
            "caption": "Huawei Dorado Quota: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "60a3edd2-a23e-4b7a-a2e7-4a965ee9ce63"
        },
        "14": {
            "varname": "huawei_dorado_quota_password",
            "caption": "Huawei Dorado Quota: Password",
            "description": "Huawei OceanStor Dorado API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "fe097c78-ce91-4fba-a2eb-30a2a18059b3"
        },
        "15": {
            "varname": "huawei_dorado_quota_password_file",
            "caption": "Huawei Dorado Quota: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "bafc2cb9-a780-4a41-99e1-f1d63a8e7495"
        },
        "16": {
            "varname": "huawei_dorado_quota_proxy",
            "caption": "Huawei Dorado Quota: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0ec5aa15-8c1c-49eb-aaeb-653379214c29"
        },
        "17": {
            "varname": "huawei_dorado_quota_quota_type",
            "caption": "Huawei Dorado Quota: Quota Type",
            "description": "Type of quota to check. Can be specified multiple times. Example: `--quota-type=directory --quota-type=user`. Default: directory",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "array",
                "datalist": "huawei_dorado_quota_quota_type_list"
            },
            "uuid": "032ad4fc-5577-4132-9f5d-7bd4e1f891f1"
        },
        "18": {
            "varname": "huawei_dorado_quota_scope",
            "caption": "Huawei Dorado Quota: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ff9da7e3-e08c-49dc-9c57-832399242a06"
        },
        "19": {
            "varname": "huawei_dorado_quota_timeout",
            "caption": "Huawei Dorado Quota: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7f7e51c4-227c-4f50-a25a-cf5604a01f5a"
        },
        "20": {
            "varname": "huawei_dorado_quota_url",
            "caption": "Huawei Dorado Quota: URL",
            "description": "Huawei OceanStor Dorado API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
