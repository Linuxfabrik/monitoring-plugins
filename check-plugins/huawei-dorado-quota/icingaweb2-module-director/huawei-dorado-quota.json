    "ServiceTemplate": {
        "tpl-service-huawei-dorado-quota": {
            "action_url": null,
            "apply_for": null,
            "assign_filter": null,
            "check_command": "cmd-check-huawei-dorado-quota",
            "check_interval": 3600,
