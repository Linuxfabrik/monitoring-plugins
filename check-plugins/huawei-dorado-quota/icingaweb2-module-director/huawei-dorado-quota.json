            "uuid": "bc8d9425-fdf0-4102-a614-e5f08b3a0d7a"
        },
        "21": {
            "varname": "huawei_dorado_quota_username",
            "caption": "Huawei Dorado Quota: Username",
            "description": "Huawei OceanStor Dorado API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
