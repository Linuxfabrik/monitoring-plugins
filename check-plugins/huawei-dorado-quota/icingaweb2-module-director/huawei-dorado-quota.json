            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Checks how full the quotas of a Huawei OceanStor Dorado storage system are via the REST API (/FS_QUOTA endpoint). Walks all file systems and reports the used space of every quota, the quotas of their dtrees (the directories a share is usually created on) included, relative to its configured hard quota. Quotas without a hard quota are skipped, because there is no limit to compare against. Alerts when the used space in percent reaches the warning or critical threshold. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/huawei-dorado-quota/",
            "object_name": "tpl-service-huawei-dorado-quota",
            "object_type": "template",
            "retry_interval": 30,
            "service_set": null,
            "template_choice": null,
            "use_agent": false,
            "use_var_overrides": null,
            "vars": {
                "criticality": "A",
                "huawei_dorado_quota_always_ok": false,
                "huawei_dorado_quota_brief": false,
                "huawei_dorado_quota_cache_expire": 15,
                "huawei_dorado_quota_critical": "90",
                "huawei_dorado_quota_device_id": "",
                "huawei_dorado_quota_ignore": [],
                "huawei_dorado_quota_insecure": true,
                "huawei_dorado_quota_lengthy": true,
                "huawei_dorado_quota_match": [],
                "huawei_dorado_quota_no_match_severity": "ok",
                "huawei_dorado_quota_no_perfdata": false,
                "huawei_dorado_quota_no_proxy": false,
                "huawei_dorado_quota_quota_type": [],
                "huawei_dorado_quota_scope": "0",
                "huawei_dorado_quota_timeout": 3,
                "huawei_dorado_quota_verbose": false,
                "huawei_dorado_quota_warning": "80"
            },
            "volatile": null,
            "zone": null,
            "uuid": "6859eb23-92ec-4763-82c3-e18db43ecce9"
        }
    },
