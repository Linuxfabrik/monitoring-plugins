import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# The plugin reads two data sources: `docker info` (suffix `-info`) and,
# on a manager, `docker node ls` (suffix `-nodes`). A single `--test`
# base path drives both fixtures; a scenario without a `-nodes` file
# simulates a worker node that cannot list the cluster, and a scenario
# with a `-nodes` file in the stderr slot simulates a command that failed.
# The `quorum-lost` and `manager-healthy` fixtures are recordings from a
# three-manager swarm on Docker 28.5.2, taken before and after two of the
# three managers were stopped.
TESTS = [
    {
        'id': 'ok-manager-healthy',
        'test': 'stdout/manager-healthy,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Swarm is active',
            '2/2 nodes ready',
            '1/1 manager reachable',
        ],
    },
    {
        'id': 'ok-manager-healthy-lengthy',
        'test': 'stdout/manager-healthy,,0',
        'params': '--lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Hostname ! Status ! Avail. ! Manager ! Engine ! State',
            'docker-1 ! Ready  ! Active ! Leader  ! 24.0.7 ! [OK]',
            'docker-2 ! Ready  ! Active ! -       ! 24.0.7 ! [OK]',
        ],
    },
    {
        'id': 'ok-worker-active',
        'test': 'stdout/worker-active,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['Swarm is active', 'worker node'],
        # a worker cannot list the cluster, so no node/manager counts
        'assert-not-in': ['nodes ready', 'reachable'],
    },
    {
        'id': 'crit-not-in-swarm',
        'test': 'stdout/not-in-swarm,,0',
        'assert-retc': STATE_CRIT,
        'assert-in': ['local node state is "inactive"'],
    },
    {
        'id': 'warn-pending',
        'test': 'stdout/pending,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['local node state is "pending"'],
    },
    {
        'id': 'warn-node-down',
        'test': 'stdout/node-down,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'node docker-2 is Down',
            '1/2 nodes ready',
        ],
    },
    {
        # a manager that has just (re)started moves every node it has not heard
        # from yet to "Unknown" and turns it into "Down" itself once the node
        # misses its heartbeats. Restarting the docker daemon on a manager must
        # not raise an alarm for the rest of the cluster.
        'id': 'ok-nodes-not-reporting-yet',
        'test': 'stdout/nodes-unknown,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Swarm is active',
            '1/3 nodes ready (2 not reporting yet)',
            "'nodes_pending'=2;;;0",
        ],
        'assert-not-in': ['[WARNING]'],
    },
    {
        'id': 'ok-worker-lengthy-lists-its-managers',
        'test': 'stdout/worker-active,,0',
        'params': '--lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'worker node',
            'Manager         ! Node ID',
            '192.0.2.10:2377 ! a1b2c3d4e5f6',
        ],
    },
    {
        'id': 'crit-managers-unreachable',
        # the leader still answers and reports the other two managers as
        # unreachable, the short window before it steps down itself
        'test': 'stdout/managers-unreachable,,0',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'manager quorum lost',
            '1/3 reachable',
        ],
    },
    {
        'id': 'crit-quorum-lost',
        # once the quorum is gone, the daemon refuses to list the cluster at
        # all; `docker info` keeps reporting the node as an active manager
        'test': 'stdout/quorum-lost,stderr/quorum-lost,1',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'this manager cannot reach the swarm control plane',
            'The swarm does not have a leader',
        ],
        # without an answer from the cluster there is no inventory to report
        'assert-not-in': ['nodes ready', "'nodes_total'"],
    },
    {
        'id': 'unknown-unparseable-info',
        # a Podman host answers `docker info` without a Swarm object,
        # so the JSON is `null` and the swarm state cannot be determined
        'test': 'stdout/podman-null,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Podman does not support swarm mode'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../docker-swarm'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
