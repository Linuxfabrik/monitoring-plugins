    "Datafield": {
        "1": {
            "varname": "huawei_pacific_service_always_ok",
            "caption": "Huawei Pacific Service: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ff65ccde-faf5-4c18-876d-72c7560ad680"
        },
        "2": {
            "varname": "huawei_pacific_service_brief",
            "caption": "Huawei Pacific Service: Brief?",
            "description": "Hide table rows for processes that are running and show only those that are not. Perfdata and alerting are unaffected: every process still emits perfdata and still drives the overall check state.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2e05d465-05f6-4292-b286-baac76fdf319"
        },
        "3": {
            "varname": "huawei_pacific_service_cache_expire",
            "caption": "Huawei Pacific Service: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1cb9ba01-357e-4602-8ac3-962c80c0913c"
        },
        "4": {
            "varname": "huawei_pacific_service_ignore",
            "caption": "Huawei Pacific Service: Ignore",
            "description": "Skip processes. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the node name and the process name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "768fbf4c-e8dc-46f5-9c76-d3f2e2d2ab0a"
        },
        "5": {
            "varname": "huawei_pacific_service_insecure",
            "caption": "Huawei Pacific Service: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "a65dba1b-d114-4eb5-8648-b40c336fbe07"
        },
        "6": {
            "varname": "huawei_pacific_service_lengthy",
            "caption": "Huawei Pacific Service: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2c844681-7972-4ef7-a986-0291d2edc8e0"
        },
        "7": {
            "varname": "huawei_pacific_service_match",
            "caption": "Huawei Pacific Service: Match",
            "description": "Limit to processes. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the node name and the process name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "39dcd2ae-0eaf-4534-9059-fe4ba8a9ecce"
        },
        "8": {
            "varname": "huawei_pacific_service_no_insecure",
            "caption": "Huawei Pacific Service: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "a0eb1d33-4ab6-4da9-92b2-7a7aa4afb578"
        },
        "9": {
            "varname": "huawei_pacific_service_no_match_severity",
            "caption": "Huawei Pacific Service: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_service_no_match_severity_list"
            },
            "uuid": "d90e1e26-c328-429e-97a0-f26b430e50a9"
        },
        "10": {
            "varname": "huawei_pacific_service_no_perfdata",
            "caption": "Huawei Pacific Service: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6f3d7a20-9719-4d8e-8bec-ba0f683fc4cc"
        },
        "11": {
            "varname": "huawei_pacific_service_no_proxy",
            "caption": "Huawei Pacific Service: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8f11e7f8-5bba-46a2-9b1c-7524fbbe3421"
        },
        "12": {
            "varname": "huawei_pacific_service_password",
            "caption": "Huawei Pacific Service: Password",
            "description": "Huawei OceanStor Pacific API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "fc936ec6-887a-4bc6-a37a-0027594711a1"
        },
        "13": {
            "varname": "huawei_pacific_service_password_file",
            "caption": "Huawei Pacific Service: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "1baf9877-cfde-439f-9ad8-b4deae6ed1f3"
        },
        "14": {
            "varname": "huawei_pacific_service_scope",
            "caption": "Huawei Pacific Service: Scope",
            "description": "Huawei OceanStor Pacific API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8592c28a-97be-4d7b-b433-6fbcba01410b"
        },
        "15": {
            "varname": "huawei_pacific_service_silent_node_severity",
            "caption": "Huawei Pacific Service: Silent Node Severity",
            "description": "State to report for a cluster node that the process query returns nothing for. Its processes are unmonitored for as long as that lasts, which is not the same as knowing they are down.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_service_silent_node_severity_list"
            },
            "uuid": "71798fba-deb9-4b2c-a540-48414f65832e"
        },
        "16": {
            "varname": "huawei_pacific_service_timeout",
            "caption": "Huawei Pacific Service: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d2d38de6-aa2f-49b4-8c4f-09e5cb3c77c2"
        },
        "17": {
            "varname": "huawei_pacific_service_url",
            "caption": "Huawei Pacific Service: URL",
            "description": "Huawei OceanStor Pacific API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "018b2078-4077-4609-87a9-9ef0aa587e14"
        },
        "18": {
            "varname": "huawei_pacific_service_username",
            "caption": "Huawei Pacific Service: Username",
            "description": "Huawei OceanStor Pacific API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b6899386-cd78-412f-8677-bafc5330ef42"
        },
        "19": {
            "varname": "huawei_pacific_service_verbose",
            "caption": "Huawei Pacific Service: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "af7cd7af-da04-4527-9fbe-57082f296d2f"
        }
    }
}
