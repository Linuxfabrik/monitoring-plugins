"""Unit tests for the apache-tomcat-version check plugin.

The fixtures in `stdout/` are `bin/version.sh` outputs in the form
"Server version: Apache Tomcat/X.Y.Z". The 8.5, 9.0, 10.1 and 11.0
captures are the real output of the official `docker.io/library/tomcat`
images; the 7.0.28 capture reuses the same format with the version from
issue #126. The plugin parses the same `Apache Tomcat/(\\d+\\.\\d+\\.\\d+)`
string whether it comes from `version.sh` or from the `server.info` line
of `catalina.jar`, so a single set of fixtures covers both code paths.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        'id': 'ok-parses-tomcat-7-0-28',
        'test': 'stdout/version-tomcat7,,0',
        # --always-ok pins the return code: what this case verifies is that the version
        # is read out of the command output, and the end-of-life verdict behind it moves
        # with the calendar and with what endoflife.date answers.
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['Apache Tomcat v7.0.28'],
    },
    {
        'id': 'ok-parses-tomcat-8-5-100',
        'test': 'stdout/version-tomcat85,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['Apache Tomcat v8.5.100'],
    },
    {
        'id': 'ok-tomcat-9-0-118',
        'test': 'stdout/version-tomcat9,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['Apache Tomcat v9.0.118'],
    },
    {
        'id': 'ok-parses-tomcat-10-1-55',
        'test': 'stdout/version-tomcat10,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['Apache Tomcat v10.1.55'],
    },
    {
        'id': 'ok-parses-tomcat-11-0-23',
        'test': 'stdout/version-tomcat11,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['Apache Tomcat v11.0.23'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Apache Tomcat not found at', '--catalina-home'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../apache-tomcat-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
