"""Unit tests for the openjdk-redhat-version check plugin.

The fixtures in `stderr/` are the raw `java -version` outputs
captured from the official Red Hat UBI8 OpenJDK images
(`registry.access.redhat.com/ubi8/openjdk-{8,11,17,21}`), from
`registry.access.redhat.com/ubi9/ubi` and from
`registry.fedoraproject.org/fedora:43` after a `dnf install` of the
`java-*-openjdk-headless` packages. Java writes the version banner to
STDERR (yes, really), so the fixtures live under `stderr/` and the
plugin's --test argument is invoked as `,stderr/<file>,0`. The
`*-java-options`, `*-java-tool-options` and `vm-init-error` fixtures
carry the "Picked up ..." lines the JVM and the launcher print before
the banner when JAVA_TOOL_OPTIONS, _JAVA_OPTIONS or JDK_JAVA_OPTIONS
are set.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-openjdk-8',
        'test': ',stderr/java-version-openjdk-8,0',
        'assert-in': [
            'Java (Red Hat build of OpenJDK) v1.8.0_482 ',
            "'openjdk-redhat-version'=1.80482;",
        ],
    },
    {
        'id': 'parses-openjdk-11',
        'test': ',stderr/java-version-openjdk-11,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v11.0.25'],
    },
    {
        'id': 'parses-openjdk-17',
        'test': ',stderr/java-version-openjdk-17,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v17.0.18'],
    },
    {
        'id': 'parses-openjdk-21',
        'test': ',stderr/java-version-openjdk-21,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v21.0.10'],
    },
    {
        'id': 'parses-openjdk-8-behind-picked-up-java-options',
        'test': ',stderr/java-version-openjdk-8-java-options,0',
        'assert-in': [
            'Java (Red Hat build of OpenJDK) v1.8.0_504 ',
            "'openjdk-redhat-version'=1.80504;",
        ],
        'assert-not-in': ['v1.2', 'v3.4', 'a 1.2'],
    },
    {
        'id': 'parses-openjdk-17-behind-picked-up-java-tool-options',
        'test': ',stderr/java-version-openjdk-17-java-tool-options,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v17.0.20.1'],
        'assert-not-in': ['a 1.2'],
    },
    {
        'id': 'parses-openjdk-21-behind-picked-up-jdk-java-options',
        'test': ',stderr/java-version-openjdk-21-jdk-java-options,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v21.0.12.1'],
        'assert-not-in': ['c 5.6'],
    },
    {
        'id': 'parses-openjdk-25-without-lts-marker',
        'test': ',stderr/java-version-openjdk-25,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v25.0.4.1'],
    },
    {
        'id': 'parses-openjdk-27-early-access',
        'test': ',stderr/java-version-openjdk-27-ea,0',
        'assert-in': [
            'Java (Red Hat build of OpenJDK) v27-ea ',
            "'openjdk-redhat-version'=27.0;",
        ],
    },
    {
        'id': 'unknown-vm-init-error-behind-picked-up-line',
        'test': ',stderr/java-version-vm-init-error,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Java not found', '--path'],
        'assert-not-in': ['a 1.2'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Java not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../openjdk-redhat-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
