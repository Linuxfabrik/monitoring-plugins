"""Unit tests for the openjdk-redhat-version check plugin.

The fixtures in `stderr/` are the raw `java -version` outputs
captured from the official Red Hat UBI8 OpenJDK images
(`registry.access.redhat.com/ubi8/openjdk-{8,11,17,21}`). Java
writes the version banner to STDERR (yes, really), so the
fixtures live under `stderr/` and the plugin's --test argument
is invoked as `,stderr/<file>,0`. The plugin runs its
`r'\\"(.*)\\"'` regex against the stderr payload.

The testcases assert the parsed version and nothing else. An end-of-life
verdict is derived from live endoflife.date data and from today's date, so
pinning one here breaks as soon as upstream re-dates a cycle or a date passes.
`lib.version.check_eol()` is covered against synthetic cycles in the lib repo
instead, where the expectation cannot age.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-openjdk-8',
        'test': ',stderr/java-version-openjdk-8,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v1.8.0.482'],
    },
    {
        'id': 'parses-openjdk-11',
        'test': ',stderr/java-version-openjdk-11,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v11.0.25'],
    },
    {
        'id': 'parses-openjdk-17',
        'test': ',stderr/java-version-openjdk-17,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v17.0.18'],
    },
    {
        'id': 'parses-openjdk-21',
        'test': ',stderr/java-version-openjdk-21,0',
        'assert-in': ['Java (Red Hat build of OpenJDK) v21.0.10'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Java', 'not found.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../openjdk-redhat-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
