    "Datafield": {
        "1": {
            "varname": "md_raid_always_ok",
            "caption": "Md Raid: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "36b47ff2-d68c-4e4c-8c29-f101b7f11875"
        },
        "2": {
            "varname": "md_raid_ignore",
            "caption": "Md Raid: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2e02f253-09df-4834-8508-dce5a7f69aa7"
        },
        "3": {
            "varname": "md_raid_lengthy",
            "caption": "Md Raid: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d602ceb1-14a4-4277-8f17-d323dcd3cb8f"
        },
        "4": {
            "varname": "md_raid_match",
            "caption": "Md Raid: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fc0f9dbf-8dd6-4c73-81c1-ab7ec58a128c"
        },
        "5": {
            "varname": "md_raid_mirror_mismatch_severity",
            "caption": "Md Raid: Mirror Mismatch Severity",
            "description": "State to report when a consistency check found inconsistent sectors on a mirrored array (RAID 1, RAID 10). A page written while the check reads it, and above all a swap area, produce differences between the copies that nothing ever reads back, which is why this defaults to not alerting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "md_raid_mirror_mismatch_severity_list"
            },
            "uuid": "1378c2a7-450a-48b9-bf29-2a6ae6857b41"
        },
        "6": {
            "varname": "md_raid_mismatch_severity",
            "caption": "Md Raid: Mismatch Severity",
            "description": "State to report when a consistency check found inconsistent sectors on a parity array (RAID 4, RAID 5, RAID 6). On such an array the difference points at hardware rather than at the way the data was written.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "md_raid_mismatch_severity_list"
            },
            "uuid": "9345ce88-5638-4239-a936-3516bf853c0d"
        },
        "7": {
            "varname": "md_raid_no_arrays_severity",
            "caption": "Md Raid: No Arrays Severity",
            "description": "State to report when the host runs no software RAID array at all. An array is assembled from the superblocks on its members at every boot, so an array that used to be here and is gone is worth looking at.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "md_raid_no_arrays_severity_list"
            },
            "uuid": "b29d7699-3aa3-4966-874a-75058e54967b"
        },
        "8": {
            "varname": "md_raid_no_match_severity",
            "caption": "Md Raid: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "md_raid_no_match_severity_list"
            },
            "uuid": "1d9bf875-8a42-4b69-bffd-954414a71ea9"
        },
        "9": {
            "varname": "md_raid_no_perfdata",
            "caption": "Md Raid: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "54cae3a6-233c-4afa-9e89-d0bbab454898"
        },
        "10": {
            "varname": "md_raid_severity",
            "caption": "Md Raid: Severity",
            "description": "Severity for alerting. Applies to an array that is running on fewer members than it was built for, so it has lost the redundancy it is meant to provide, and to a member the kernel threw out that is still attached to an array a spare has already brought back to its full width.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "md_raid_severity_list"
            },
            "uuid": "0957ab0c-c6fd-44b0-8ca2-4f3ddc30c44d"
        }
    }
