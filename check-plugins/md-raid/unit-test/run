import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# md-raid reads files and runs no command, so its fixtures are directory trees under
# `config/` that stand in for the host's /proc and /sys, selected with the hidden
# `--config-root` hook. Each tree holds a `proc/mdstat` and the `sys/block/md*/md`
# attributes belonging to it.
#
# Every fixture but the last two was captured from a running kernel 7.1 in a qemu guest
# booted on /boot/vmlinuz-7.1.10-200.fc44.x86_64 with a busybox initramfs carrying
# mdadm 4.3, with eight virtio disks to build arrays on.
# /proc/sys/dev/raid/speed_limit_max was turned down to 100 KiB/s wherever a sync had
# to be caught while it was running:
#
#   healthy-raid0-linear-raid10   three arrays side by side. raid0 and linear are the
#                                 two levels that print no `[n/m] [UU]` line and publish
#                                 neither `degraded` nor `sync_action` nor
#                                 `mismatch_cnt`, because they have no redundancy to
#                                 report on
#   raid10-degraded               the same three arrays after `mdadm --fail` on one
#                                 member of the raid10: `[4/3] [_UUU]` plus the `(F)`
#                                 flag
#   raid1-recovery-onto-spare     a failed member plus a spare being built up. The array
#                                 is degraded and recovering at the same time
#   raid1-check-running           `echo check > sync_action`, caught at 1.1%
#   raid1-write-mostly-spare      a member carrying two flags at once, `vda[3](W)(S)`.
#                                 A flag group read as a character class instead of as
#                                 whole `(X)` items loses both of them
#   raid1-auto-read-only          an array stopped mid-resync and reassembled with
#                                 `md_mod.start_ro=1`. `active (auto-read-only)` with a
#                                 bare `resync=PENDING` where the progress line would
#                                 be, next to a second array that is really resyncing
#   raid1-mismatch                256 KiB written straight onto one member behind the
#                                 kernel's back, then a check run to completion:
#                                 `mismatch_cnt` reads 512 while /proc/mdstat reports
#                                 the array as perfectly healthy. This is the one
#                                 failure mode that is invisible without reading /sys
#   raid1-broken                  both members marked faulty via
#                                 `sys/block/md0/md/dev-*/state`, with `fail_last_dev`
#                                 set so the kernel lets the last one go. `broken` in
#                                 /proc/mdstat and in `array_state`, `[2/0] [__]`
#   raid1-inactive                incremental assembly with only one of two members
#                                 present. No personality, no `[n/m]` line, and `level`,
#                                 `degraded`, `raid_disks` and `mismatch_cnt` all absent
#   raid0-broken                  the PCI device of one raid0 member removed, then
#                                 written to. Both the kernel log and `array_state` say
#                                 broken while every member still reads `in_sync`,
#                                 because raid0 never marks a member faulty
#   raid1-degraded-read-only      a degraded array put into read-only mode. Adding a
#                                 member to it fails with EROFS, which the instruction
#                                 has to take into account
#   raid5-empty-slot-idle         a degraded array whose failed member was removed and
#                                 that has nothing rebuilding, so the slot is simply
#                                 unfilled. There is nothing to take out here, which is a
#                                 different instruction from the one a faulty member gets
#   named-and-unnamed             an array created as `/dev/md/raid5` next to one
#                                 without a name. The kernel device is `md127` and the
#                                 udev symlink carries the name
#   raid5-healthy-with-spare      a spare sitting in an otherwise complete array
#   raid5-spare-took-over         the same array after `mdadm --fail`, once the spare
#                                 has finished rebuilding. The array is back to `[3/3]
#                                 [UUU]` and `degraded` reads 0, while the member the
#                                 kernel threw out is still attached and still carries
#                                 its `(F)`. Nothing is degraded and a disk has died all
#                                 the same
#   raid5-reshape-running         `mdadm --grow --raid-devices=4`, caught at 2.7%.
#                                 `raid_disks` reads `4 (3)` while this runs, which is
#                                 the one place the attribute is not a plain number
#   raid1-member-states           three members of a healthy raid1 carrying one of the
#                                 states the kernel publishes only next to the array,
#                                 `blocked`, `want_replacement` and `write_error`,
#                                 written straight to `dev-<device>/state`. /proc/mdstat
#                                 prints `[3/3] [UUU]` all the same. A second, plainly
#                                 healthy raid1 sits beside them, so the same tree
#                                 carries the case where nothing is flagged
#   raid5-degraded-frozen         `echo frozen > sync_action` before failing a member of
#                                 a raid5 that has a spare in it. The array is degraded,
#                                 the disk to rebuild onto is right there, and nothing
#                                 happens: /proc/mdstat prints no progress line and only
#                                 `sync_action` says why
#   no-arrays                     the same kernel before any array was created
#
# Two fixtures are assembled by hand, because they are the absence of something:
#
#   no-md-support                 a kernel with no md support loaded at all, where
#                                 /proc/mdstat does not exist. An empty directory never
#                                 reaches git, so the tree carries a neighbouring file.
#                                 This is not the same case as `no-arrays`: there the
#                                 md code is in the kernel and the arrays are gone, here
#                                 the host never had one
#
# One wording is neither captured nor fixtured: `resync=DELAYED`, which an array gets
# while another array on the same physical disk syncs first. It reaches the check
# through the same code path as the captured `resync=PENDING`. The three REMOTE
# forms of a clustered array do too.
TESTS = [
    {
        'id': 'ok-three-arrays-healthy',
        'test': '',
        'params': '--config-root=config/healthy-raid0-linear-raid10',
        'assert-retc': STATE_OK,
        'assert-in': [
            '3 software RAID arrays, all of them intact.',
            'md0',
            'md1',
            'md2',
            "'arrays'=3",
            "'arrays_degraded'=0",
        ],
    },
    {
        'id': 'ok-raid0-and-linear-report-no-redundancy',
        'test': '',
        'params': '--config-root=config/healthy-raid0-linear-raid10 --lengthy',
        'assert-retc': STATE_OK,
        # both levels publish no degraded counter, and the check must read that as
        # "not applicable" instead of as a missing member
        'assert-regex': r'md0\s+!\s+-\s+!\s+raid0\s+!\s+2\s',
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    {
        'id': 'ok-raid5-with-a-spare',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare',
        'assert-retc': STATE_OK,
        'assert-in': ['1 software RAID array, intact.', "'devices_spare'=1"],
    },
    {
        'id': 'ok-reshape-in-progress',
        'test': '',
        'params': '--config-root=config/raid5-reshape-running',
        'assert-retc': STATE_OK,
        'assert-in': ['md5: reshape 2.7%', "'arrays_syncing'=1"],
    },
    {
        'id': 'ok-check-in-progress',
        'test': '',
        'params': '--config-root=config/raid1-check-running',
        'assert-retc': STATE_OK,
        'assert-in': ['md0: check 1.1%'],
    },
    {
        'id': 'ok-write-mostly-spare-counts-as-a-spare',
        'test': '',
        'params': '--config-root=config/raid1-write-mostly-spare --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            "'devices_spare'=1",
            "'devices_faulty'=0",
            'vda (write-mostly, spare)',
        ],
    },
    {
        'id': 'ok-auto-read-only-with-a-pending-resync',
        'test': '',
        'params': '--config-root=config/raid1-auto-read-only --lengthy',
        'assert-retc': STATE_OK,
        # the array that only has a resync pending is not one that is syncing, so it
        # shows up in the table and not in the progress line
        'assert-in': [
            'resync pending',
            'active (auto-read-only)',
            "'arrays_syncing'=1",
        ],
        'assert-regex': r'md1: resync 1\.5%',
    },
    {
        'id': 'ok-mismatch-on-a-mirror-does-not-alert',
        'test': '',
        'params': '--config-root=config/raid1-mismatch',
        'assert-retc': STATE_OK,
        'assert-in': [
            'md0: 512 inconsistent sectors from the last consistency check.',
            "'md0_mismatch_cnt'=512",
            'does not have to mean corruption',
        ],
    },
    {
        'id': 'warn-mismatch-on-a-mirror-raised',
        'test': '',
        'params': (
            '--config-root=config/raid1-mismatch --mirror-mismatch-severity=warn'
        ),
        'assert-retc': STATE_WARN,
        'assert-in': ['512 inconsistent sectors'],
    },
    {
        'id': 'warn-failed-member-on-an-array-a-spare-brought-back',
        'test': '',
        'params': '--config-root=config/raid5-spare-took-over',
        'assert-retc': STATE_WARN,
        # the array is complete again, so nothing but the member flag says a disk died
        'assert-in': [
            'md1: complete again but still carrying 1 failed member (vdc).',
            "'arrays_degraded'=0",
            "'devices_faulty'=1",
        ],
    },
    {
        'id': 'ok-failed-member-lowered',
        'test': '',
        'params': '--config-root=config/raid5-spare-took-over --severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ['still carrying 1 failed member (vdc)'],
    },
    {
        'id': 'ok-a-named-array-is-reported-with-its-name',
        'test': '',
        'params': '--config-root=config/named-and-unnamed --lengthy',
        'assert-retc': STATE_OK,
        # the kernel device stays the identifier, in the table and in the performance
        # data, and the name the array was created under sits beside it
        'assert-regex': r'md127\s+!\s+raid5\s+!\s+raid5\s',
        'assert-in': ["'md127_mismatch_cnt'=0", 'md0   ! -'],
    },
    {
        'id': 'ok-a-filter-matches-the-name-as-well-as-the-device',
        'test': '',
        'params': '--config-root=config/named-and-unnamed --match=^raid5$',
        'assert-retc': STATE_OK,
        'assert-in': ['1 software RAID array, intact.', 'md127'],
        'assert-not-in': ['md0 '],
    },
    {
        'id': 'warn-degraded-array-with-an-empty-slot',
        'test': '',
        'params': '--config-root=config/raid5-empty-slot-idle',
        'assert-retc': STATE_WARN,
        # nothing was thrown out, a slot simply never got filled, so the instruction
        # must not name a member to remove
        'assert-in': [
            'md0 is short of a member without the kernel having thrown one out',
            '`mdadm --detail /dev/md0`',
        ],
        'assert-not-in': ['--remove'],
    },
    {
        'id': 'warn-degraded-array',
        'test': '',
        'params': '--config-root=config/raid10-degraded',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'md2: degraded, running on 3 of 4 devices.',
            # the commands name this host's array and this host's member, never an
            # example device somebody could copy onto the wrong array
            'md2 lost vde.',
            '`mdadm /dev/md2 --remove /dev/vde`',
            "'arrays_degraded'=1",
            "'devices_faulty'=1",
        ],
        'assert-not-in': ['/dev/md0', '/dev/sdb'],
    },
    {
        'id': 'warn-degraded-read-only-array-needs-readwrite-first',
        'test': '',
        'params': '--config-root=config/raid1-degraded-read-only',
        'assert-retc': STATE_WARN,
        # adding a member to a read-only array fails with EROFS, so the instruction has
        # to say what comes before the --add
        'assert-in': [
            '`mdadm /dev/md0 --remove /dev/vda`',
            '`mdadm --readwrite /dev/md0` comes first',
        ],
    },
    {
        'id': 'warn-degraded-array-does-not-mention-readwrite',
        'test': '',
        'params': '--config-root=config/raid10-degraded',
        'assert-retc': STATE_WARN,
        # a read-write array needs no such step, and an auto-read-only one is switched
        # over by the kernel itself
        'assert-not-in': ['--readwrite'],
    },
    {
        'id': 'warn-degraded-array-while-recovering',
        'test': '',
        'params': '--config-root=config/raid1-recovery-onto-spare',
        'assert-retc': STATE_WARN,
        'assert-in': ['md0: recovery 1.5%', 'already rebuilding onto a replacement'],
    },
    {
        'id': 'crit-degraded-array-raised',
        'test': '',
        'params': '--config-root=config/raid10-degraded --severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'degraded\s+\[CRITICAL\]',
    },
    {
        'id': 'ok-degraded-array-lowered',
        'test': '',
        'params': '--config-root=config/raid10-degraded --severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ['md2: degraded, running on 3 of 4 devices.'],
    },
    {
        'id': 'crit-broken-mirror',
        'test': '',
        'params': '--config-root=config/raid1-broken',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'md0: broken.',
            'mdadm --assemble --force',
            "'arrays_broken'=1",
        ],
    },
    {
        'id': 'crit-broken-raid0',
        'test': '',
        'params': '--config-root=config/raid0-broken --lengthy',
        'assert-retc': STATE_CRIT,
        # raid0 never marks a member faulty, so the array-level word is the only signal
        'assert-in': ['md0: broken.', "'devices_faulty'=0"],
    },
    {
        'id': 'crit-inactive-array',
        'test': '',
        'params': '--config-root=config/raid1-inactive',
        'assert-retc': STATE_CRIT,
        'assert-in': ['md0: inactive.', "'arrays_inactive'=1", 'mdadm --detail'],
        'assert-not-in': ["'arrays_broken'=1"],
    },
    {
        'id': 'warn-no-array-at-all',
        'test': '',
        'params': '--config-root=config/no-arrays',
        'assert-retc': STATE_WARN,
        'assert-in': ['No software RAID array on this host', "'arrays'=0"],
    },
    {
        'id': 'ok-no-array-at-all-lowered',
        'test': '',
        'params': '--config-root=config/no-arrays --no-arrays-severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ['No software RAID array on this host'],
    },
    {
        'id': 'warn-kernel-without-md-support',
        'test': '',
        'params': '--config-root=config/no-md-support',
        'assert-retc': STATE_WARN,
        # a kernel that never assembled an array carries no /proc/mdstat at all, which
        # is a different statement from a host whose arrays are gone
        'assert-in': ['This kernel has no software RAID support loaded'],
        'assert-not-in': ['Either every array was dismantled'],
    },
    {
        'id': 'warn-member-states-the-array-itself-does-not-report',
        'test': '',
        'params': '--config-root=config/raid1-member-states --lengthy',
        'assert-retc': STATE_WARN,
        # the array is at its full width and the kernel is unhappy about every one of
        # its members all the same
        'assert-in': [
            'md0: vda has unacknowledged bad blocks, so writes to it wait, '
            'vdb is marked for replacement, vdc has seen a write error.',
            'vda (blocked), vdb (want_replacement), vdc (write_error)',
            '`mdadm /dev/md0 --add` followed by a device',
            '`cat /sys/block/md0/md/dev-vda/unacknowledged_bad_blocks`',
            "'devices_flagged'=3",
        ],
        # the healthy array beside it says nothing, and neither array is degraded
        'assert-not-in': ['md1:', "'arrays_degraded'=1"],
    },
    {
        'id': 'ok-member-states-lowered',
        'test': '',
        'params': '--config-root=config/raid1-member-states --member-severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ['vdb is marked for replacement'],
    },
    {
        'id': 'crit-member-states-raised',
        'test': '',
        'params': '--config-root=config/raid1-member-states --member-severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'member flagged\s+\[CRITICAL\]',
    },
    {
        'id': 'warn-a-degraded-array-whose-sync-is-frozen-does-not-rebuild',
        'test': '',
        'params': '--config-root=config/raid5-degraded-frozen --lengthy',
        'assert-retc': STATE_WARN,
        # the spare is already in the array, so the instruction must not ask for another
        # device, and it must say that nothing moves until the sync is thawed
        'assert-in': [
            'md0: sync frozen, degraded, running on 2 of 3 devices.',
            'A spare is attached to md0 already (vdd)',
            '`echo idle > /sys/block/md0/md/sync_action` comes before any of it',
            "'arrays_sync_frozen'=1",
        ],
        'assert-not-in': ['The array rebuilds on its own from there'],
    },
    {
        'id': 'warn-an-array-short-of-a-spare',
        'test': '',
        'params': '--config-root=config/raid10-degraded --spares=1',
        'assert-retc': STATE_WARN,
        # raid0 and linear have nothing to rebuild onto, so a spare count means nothing
        # to them and they are not graded against one
        'assert-in': [
            'md2: degraded, running on 3 of 4 devices, short of 1 spare device.',
            'md2 holds 0 of the 1 spare device it is expected to',
            "'devices_spare_missing'=1",
        ],
        'assert-not-in': ['md0:', 'md1:'],
    },
    {
        'id': 'ok-an-array-holding-the-spare-it-is-expected-to',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare --spares=1',
        'assert-retc': STATE_OK,
        'assert-in': ['1 software RAID array, intact.', "'devices_spare_missing'=0"],
    },
    {
        'id': 'ok-a-pinned-spare-count-wins-over-the-one-for-every-array',
        'test': '',
        'params': (
            '--config-root=config/raid5-healthy-with-spare --spares=2 --spares=md5=1'
        ),
        'assert-retc': STATE_OK,
        'assert-in': ['1 software RAID array, intact.'],
    },
    {
        'id': 'crit-spares-severity-raised',
        'test': '',
        'params': (
            '--config-root=config/raid5-healthy-with-spare --spares=2 '
            '--spares-severity=crit'
        ),
        'assert-retc': STATE_CRIT,
        'assert-in': ['short of 1 spare device'],
    },
    {
        'id': 'unknown-invalid-spare-count',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare --spares=md5=many',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Invalid --spares value'],
        # a typo in a parameter is the expected answer, not a defect worth a stack trace
        'assert-not-in': ['Traceback'],
    },
    {
        'id': 'ok-sync-progress-reaches-the-performance-data',
        'test': '',
        'params': '--config-root=config/raid1-check-running',
        'assert-retc': STATE_OK,
        'assert-in': [
            "'md0_sync_percent'=1.1%;;;0;100",
            "'md0_sync_bytes_per_second'=917504B",
        ],
    },
    {
        'id': 'ok-an-idle-array-has-no-sync-progress-to-report',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare',
        'assert-retc': STATE_OK,
        'assert-not-in': ['_sync_percent', '_sync_bytes_per_second'],
    },
    {
        'id': 'ok-match-picks-one-array',
        'test': '',
        'params': '--config-root=config/raid10-degraded --match=^md0$',
        'assert-retc': STATE_OK,
        'assert-in': ['1 software RAID array, intact.'],
        'assert-not-in': ['md2'],
    },
    {
        'id': 'ok-ignore-drops-the-degraded-array',
        'test': '',
        'params': '--config-root=config/raid10-degraded --ignore=^md2$',
        'assert-retc': STATE_OK,
        'assert-not-in': ['md2'],
    },
    {
        'id': 'ok-everything-filtered-out',
        'test': '',
        'params': '--config-root=config/raid10-degraded --match=^nothing$',
        'assert-retc': STATE_OK,
        'assert-in': ['filtered out by --match or --ignore'],
    },
    {
        'id': 'warn-everything-filtered-out-raised',
        'test': '',
        'params': (
            '--config-root=config/raid10-degraded --match=^nothing$ '
            '--no-match-severity=warn'
        ),
        'assert-retc': STATE_WARN,
        'assert-in': ['filtered out by --match or --ignore'],
    },
    {
        'id': 'unknown-invalid-regex',
        'test': '',
        'params': '--config-root=config/raid10-degraded --match=[',
        'assert-retc': STATE_UNKNOWN,
    },
    {
        'id': 'ok-always-ok-suppresses-a-broken-array',
        'test': '',
        'params': '--config-root=config/raid1-broken --always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['md0: broken.'],
    },
    {
        'id': 'ok-no-perfdata',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare --no-perfdata',
        'assert-retc': STATE_OK,
        'assert-not-in': ["'arrays'="],
    },
    {
        'id': 'ok-lengthy-adds-columns',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': ['Metadata', 'Flagged Members', 'Mismatches', 'Sync'],
    },
    {
        'id': 'ok-default-output-hides-the-extra-columns',
        'test': '',
        'params': '--config-root=config/raid5-healthy-with-spare',
        'assert-retc': STATE_OK,
        'assert-not-in': ['Metadata', 'Mismatches'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../md-raid'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
