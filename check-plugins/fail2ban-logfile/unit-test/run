"""Unit tests for fail2ban-logfile.

The `file-v1-1-0-*` and `journal-v1-1-0-*` fixtures are what fail2ban 1.1.0 (EPEL)
wrote on Rocky 10 containers, one scenario after the other: a healthy run, an action
whose command fails, the iptables ban action without iptables, a database that cannot
be opened, firewall rules flushed while fail2ban ran, a banned client that showed up
again 70 seconds after its ban, a line from the future and a host name in `ignoreip`
that does not resolve, and under systemd a restart into a jail without a log file,
the recovery, and `logtarget = SYSTEMD-JOURNAL`.

The others are anonymized excerpts of production hosts: `file-v1-1-1-ineffective-
bans-wrong-port` an sshd jail that banned on port 22 while sshd listened on another
port, `file-v1-1-0-journal-lost` an sshd jail whose journal file disappeared,
`file-v1-0-2-database-corrupt` a corrupt database, `file-v1-1-1-dns-lookups` a filter
that took the virtual host name for the client, and `file-v1-1-1-lost-rules-before-
restart` the errors of a stop whose rules were already gone, followed by a start.

A fixture read as it stands would sit inside the rate window on the day it was
captured and outside it on every day after, so the fixtures the rate is judged on
are copied with all their lines moved by one offset, see aged().
"""

import atexit
import datetime
import os
import re
import shutil
import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN = os.path.join(HERE, '..', 'fail2ban-logfile')

# The log has to be read from below `unit-test/`, which is where the plugin allows
# itself to read outside /var/log.
SCRATCH = tempfile.mkdtemp(prefix='fail2ban-logfile-', dir=HERE)
atexit.register(shutil.rmtree, SCRATCH, True)

TIMESTAMP_REGEX = re.compile(r'^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})(,\d+ )')
TIMESTAMP_FORMAT = '%Y-%m-%d %H:%M:%S'

# Taken once, so two logs aged alike start in the same second.
NOW = datetime.datetime.now()


def aged(name, minutes_ago=2):
    """Copy a fixture, moving its lines so the last of them is `minutes_ago` old.
    The whole block is shifted by one offset, so the lines keep their spacing."""
    with open(os.path.join(HERE, 'fixtures', name), encoding='utf-8') as handle:
        lines = handle.read().splitlines()
    moments = []
    for line in lines:
        match = TIMESTAMP_REGEX.match(line)
        moments.append(
            datetime.datetime.strptime(match.group(1), TIMESTAMP_FORMAT)
            if match
            else None
        )
    known = [moment for moment in moments if moment is not None]
    shift = NOW - datetime.timedelta(minutes=minutes_ago) - known[-1]
    path = os.path.join(SCRATCH, f'{os.path.splitext(name)[0]}-{minutes_ago}.log')
    with open(path, 'w', encoding='utf-8') as handle:
        for line, moment in zip(lines, moments):
            if moment is None:
                handle.write(line + '\n')
                continue
            moved = moment + shift
            handle.write(f'{moved:{TIMESTAMP_FORMAT}}{line[19:]}\n')
    return path


def fixture(name):
    return os.path.join(HERE, 'fixtures', name)


def config_root(name):
    return os.path.join(HERE, 'config', name)


CASES = [
