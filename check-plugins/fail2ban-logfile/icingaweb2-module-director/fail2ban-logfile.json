            "icon_image": "fail2ban-logfile.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Scans the log of fail2ban for the problems that leave a host unprotected while fail2ban itself keeps running and its jails keep listing bans: ban actions that fail, firewall rules that disappeared, bans that do not stop the client, jails that stopped reading their log, a database fail2ban cannot use, host names resolved instead of addresses, log lines fail2ban cannot place in time, and configuration errors that kept fail2ban or a jail from starting. Startups, shutdowns and bans are counted alongside them. Alerts when one of those problems shows up, when banned clients keep appearing in the logs more often than the thresholds allow within `--lookback`, and when a line arrives at a level `--critical-level` or `--warning-level` covers. Lines about the current fail2ban process count; what a process before the last startup wrote is history, because a restart rebuilds the firewall rules and rereads the configuration. The log is read from the file `logtarget` in the fail2ban configuration names, together with the journal of the fail2ban unit, which holds the errors of a start that failed, or from a file (`/var/log` only) or a container (`docker:`/`podman:`/`kubectl:`) named with `--server-log`. Requires root or sudo.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/fail2ban-logfile/",
            "object_name": "tpl-service-fail2ban-logfile",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "fail2ban_logfile_always_ok": false,
                "fail2ban_logfile_critical_level": "CRITICAL",
                "fail2ban_logfile_icinga_callback": false,
                "fail2ban_logfile_ignore": [],
                "fail2ban_logfile_ineffective_bans_critical": 0,
                "fail2ban_logfile_ineffective_bans_warning": 10,
                "fail2ban_logfile_insecure": true,
                "fail2ban_logfile_lookback": 3600,
                "fail2ban_logfile_match": [],
                "fail2ban_logfile_no_match_severity": "ok",
                "fail2ban_logfile_no_perfdata": false,
                "fail2ban_logfile_no_proxy": false,
                "fail2ban_logfile_server_log": [],
                "fail2ban_logfile_timeout": 8,
                "fail2ban_logfile_warning_level": "ERROR"
            },
            "volatile": null,
            "zone": null,
            "uuid": "37b46e6c-634a-4211-8175-93dd28891e39"
        }
    },
