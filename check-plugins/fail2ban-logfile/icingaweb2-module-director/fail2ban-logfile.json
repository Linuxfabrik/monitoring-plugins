    "Datafield": {
        "1": {
            "varname": "fail2ban_logfile_always_ok",
            "caption": "Fail2ban Logfile: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "02447128-3d6b-4cb2-b437-c8debb5fba25"
        },
        "2": {
            "varname": "fail2ban_logfile_critical_level",
            "caption": "Fail2ban Logfile: Critical Level",
            "description": "Least severe fail2ban log level that returns CRITICAL. Each level includes everything more severe than itself, so `ERROR` covers `CRITICAL` as well. Case-sensitive. `none` lets no level return CRITICAL, which leaves the events this check names as the only way to reach it. Example: `--critical-level=ERROR`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "fail2ban_logfile_critical_level_list"
            },
            "uuid": "2efe6315-0fb2-4f88-9ec0-0e93b58c1bab"
        },
        "3": {
            "varname": "fail2ban_logfile_icinga_callback",
            "caption": "Fail2ban Logfile: Icinga Callback?",
            "description": "Ask the monitoring server whether the service running this check is acknowledged. Where it is, what this run reports is remembered as already handled, so it no longer raises an alert on the following runs. Requires `--icinga-url`, `--icinga-username`, `--icinga-password` and `--icinga-service-name`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "89dacedf-93b3-4dd0-9288-22495eed9855"
        },
        "4": {
            "varname": "fail2ban_logfile_icinga_password",
            "caption": "Fail2ban Logfile: Icinga Password",
            "description": "Monitoring server API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "434255ab-0caa-4585-8b3b-266b3925d0a9"
        },
        "5": {
            "varname": "fail2ban_logfile_icinga_service_name",
            "caption": "Fail2ban Logfile: Icinga Service Name",
            "description": "Unique name of the service running this check, as the monitoring server knows it. Take it from the `__name` service attribute. Example: `monitoring-server!my-service-name`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bfb7ded1-cb45-4b65-8f58-d00192ddf74f"
        },
        "6": {
            "varname": "fail2ban_logfile_icinga_url",
            "caption": "Fail2ban Logfile: Icinga URL",
            "description": "Monitoring server API URL. Example: `https://monitoring.example.com:5665`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "953a1456-58e7-4e99-aa56-6f61c1ecddb7"
        },
        "7": {
            "varname": "fail2ban_logfile_icinga_username",
            "caption": "Fail2ban Logfile: Icinga Username",
            "description": "Monitoring server API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6aec5776-9724-4109-a9c0-0285d90c6aae"
        },
        "8": {
            "varname": "fail2ban_logfile_ignore",
            "caption": "Fail2ban Logfile: Ignore",
            "description": "Ignore a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. Example: `--ignore='(?i)linuxfabrik'`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "59bbdf3f-53b2-412e-9e2b-ff4c4e12bbbc"
        },
        "9": {
            "varname": "fail2ban_logfile_ineffective_bans_critical",
            "caption": "Fail2ban Logfile: Ineffective Bans Critical",
            "description": "Number of banned clients that showed up in the logs again more than a minute after their ban within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--ineffective-bans-critical=100`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "50b44555-a1fd-49bc-b4e7-23fa220a8e10"
        },
        "10": {
            "varname": "fail2ban_logfile_ineffective_bans_warning",
            "caption": "Fail2ban Logfile: Ineffective Bans Warning",
            "description": "Number of banned clients that showed up in the logs again more than a minute after their ban within `--lookback` that returns WARNING. 0 turns the threshold off. Example: `--ineffective-bans-warning=50`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bdda65f6-8069-49e1-af5d-d0e25ba06abb"
        },
        "11": {
            "varname": "fail2ban_logfile_insecure",
            "caption": "Fail2ban Logfile: Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5df5e7b9-aee2-4da5-9369-1ede5be6146b"
        },
        "12": {
            "varname": "fail2ban_logfile_lookback",
            "caption": "Fail2ban Logfile: Lookback",
            "description": "Banned clients that show up in the logs again are counted within this window rather than reported one by one. Time window in seconds to look back over, ending at the moment of the run. Only what falls within it is counted, so what is reported is how often something happened lately rather than a total that keeps growing for as long as the source is kept. Example: `--lookback=86400`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "dcf5d25c-ea4d-4bed-acd8-6d30f9b902ea"
        },
        "13": {
            "varname": "fail2ban_logfile_match",
            "caption": "Fail2ban Logfile: Match",
            "description": "Only consider a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Example: `--match='\\[sshd\\]'`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4f01aeea-c6c8-4f09-8fb8-96691cf8132f"
        },
        "14": {
            "varname": "fail2ban_logfile_no_insecure",
            "caption": "Fail2ban Logfile: No Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "110087a6-67db-41cb-8680-fbf7a6fbeef8"
        },
        "15": {
            "varname": "fail2ban_logfile_no_match_severity",
            "caption": "Fail2ban Logfile: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "fail2ban_logfile_no_match_severity_list"
            },
            "uuid": "543c4e07-9b34-4436-8133-ea803befacbd"
        },
        "16": {
            "varname": "fail2ban_logfile_no_perfdata",
            "caption": "Fail2ban Logfile: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "39f9faa2-6127-4158-a765-cf3891b50c83"
        },
        "17": {
            "varname": "fail2ban_logfile_no_proxy",
            "caption": "Fail2ban Logfile: No Proxy?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c92a3cd4-dc8d-4256-a37d-906de7f6365c"
        },
        "18": {
            "varname": "fail2ban_logfile_proxy",
            "caption": "Fail2ban Logfile: Proxy",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "19ee7723-60c6-472e-a6c0-ac2987b1fb2b"
        },
        "19": {
            "varname": "fail2ban_logfile_server_log",
            "caption": "Fail2ban Logfile: Server Log",
            "description": "Log source to read from. Accepts a file path, `docker:CONTAINER`, `podman:CONTAINER`, `kubectl:CONTAINER` or `systemd:UNITNAME`. Can be specified multiple times, and everything named is then read as one window; a source named twice is read once. If omitted, the check reads the file `logtarget` in the fail2ban configuration names, and the journal of `fail2ban.service`. Example: `--server-log=/var/log/fail2ban.log`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "57f1252c-6b64-4614-804f-f7b8063af794"
        },
        "20": {
            "varname": "fail2ban_logfile_timeout",
            "caption": "Fail2ban Logfile: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "59fd5732-669a-4548-99ee-275adcd289df"
        },
        "21": {
            "varname": "fail2ban_logfile_warning_level",
            "caption": "Fail2ban Logfile: Warning Level",
            "description": "Least severe fail2ban log level that returns WARNING. Each level includes everything more severe than itself, and a level that `--critical-level` already covers returns CRITICAL instead. Case-sensitive. `none` lets no level return WARNING, which leaves the events this check names as the only way to reach it. Example: `--warning-level=WARNING`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "fail2ban_logfile_warning_level_list"
            },
            "uuid": "1d3df8f1-2ea4-4a7d-bd28-743425ae2438"
        }
    }
}
