DESCRIPTION = """Scans the log of fail2ban for the problems that leave a host unprotected
while fail2ban itself keeps running and its jails keep listing bans: ban actions that fail,
firewall rules that disappeared, bans that do not stop the client, jails that stopped
reading their log, a database fail2ban cannot use, host names resolved instead of
addresses, log lines fail2ban cannot place in time, and configuration errors that kept
fail2ban or a jail from starting. Startups, shutdowns and bans are counted alongside them.
Alerts when one of those problems shows up, when banned clients keep appearing in the logs
more often than the thresholds allow within `--lookback`, and when a line arrives at a
level `--critical-level` or `--warning-level` covers.
Lines about the current fail2ban process count; what a process before the last startup
wrote is history, because a restart rebuilds the firewall rules and rereads the
configuration.
The log is read from the file `logtarget` in the fail2ban configuration names, together
with the journal of the fail2ban unit, which holds the errors of a start that failed, or
from a file (`/var/log` only) or a container (`docker:`/`podman:`/`kubectl:`) named with
`--server-log`.
Requires root or sudo."""

# What `--critical-level` and `--warning-level` accept on top of the levels
# themselves: no level at all raises that state, which leaves the named events as
# the only way to reach it.
LEVEL_NONE = 'none'

DEFAULT_CRITICAL_LEVEL = 'CRITICAL'
DEFAULT_ICINGA_CALLBACK = False
# Measured on four production hosts whose sshd jail banned on the wrong port: banned
# clients showed up in the log late enough for fail2ban to warn in almost every hour,
# up to 289 times an hour. Healthy hosts showed none for weeks; a single long request
# finishing after the ban of its client can still produce one, hence some headroom.
DEFAULT_INEFFECTIVE_BANS_CRITICAL = 0
DEFAULT_INEFFECTIVE_BANS_WARNING = 10
DEFAULT_INSECURE = True
DEFAULT_LOOKBACK = 3600  # seconds
DEFAULT_NO_MATCH_SEVERITY = 'ok'
DEFAULT_NO_PROXY = False
DEFAULT_TIMEOUT = 8
DEFAULT_WARNING_LEVEL = 'ERROR'

ACK_RETENTION_DAYS = 30
MAXLINES = 30000  # maximum log lines to consider from the end of the source
ROTATED_FILES = 1

# fail2ban reads `fail2ban.conf`, then `fail2ban.d/*.conf`, then `fail2ban.local`,
# then `fail2ban.d/*.local`, each overriding the one before (`ConfigReader.read()` in
# `client/configreader.py`). Only these fixed, root-owned locations are looked at, so
# nothing a log holds can point the check at another file.
CONFIG_DIR = '/etc/fail2ban'
# The unit the fail2ban packages of the Red Hat family, Debian and Ubuntu install.
UNIT_CANDIDATES = ('fail2ban.service',)
UNIT_DIRECTORIES = (
    '/etc/systemd/system',
    '/usr/lib/systemd/system',
    '/lib/systemd/system',
)
# The `logtarget` values that are not a file (`Server.setLogTarget()` in
# `server/server.py`). All of them end up in the journal of the unit on a host with
# systemd: SYSLOG through the syslog socket, STDOUT and STDERR through the unit's
# standard streams.
NON_FILE_TARGETS = ('STDERR', 'STDOUT', 'SYSLOG', 'SYSTEMD-JOURNAL')

SOURCE_PATH_MAX_LEN = 32

# What the journal calls fail2ban: `fail2ban-server` for what the server prints, and
# `fail2ban` for what it logs with `logtarget = SYSTEMD-JOURNAL`.
IDENTIFIER_PREFIX = 'fail2ban'

# fail2ban writes `%(asctime)s %(name)-24s[%(process)d]: %(levelname)-7s %(message)s`
# to a file (`Server.setLogTarget()`), so a logger name of 24 characters or more runs
# into the `[`. Its own levels NOTICE, MSG, TRACEDEBUG and HEAVYDEBUG sit between the
# standard ones. Verified against fail2ban 1.0.2 and 1.1.1 on Rocky 8, 9 and 10,
# 1.1.0 on Rocky 10 (EPEL), 1.0.2 and 1.1.0 on Debian 12 and 13, and 0.11.2, 1.0.2
# and 1.1.0 on Ubuntu 22.04, 24.04 and 26.04.
LINE_REGEX = re.compile(
    r'^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}),\d+ (\S+?)\s*\[\d+\]: (\S+)\s+(.*)$'
)
TIMESTAMP_FORMAT = '%Y-%m-%d %H:%M:%S'

# A command an action ran, logged by `fail2ban.utils` as several lines that share the
# id of the command: `exec:` (the command, which can span several lines), `stderr:`,
# `stdout:`, `returned`, `killed with`, `timed out after` (`executeCmd()` in
# `server/utils.py`). They explain the failed action that follows, so they are shown
# with it and not counted by their level.
COMMAND_REGEX = re.compile(r'^(?:[0-9a-f]+|\.\.\.) -- (\S.*)$')
COMMAND_DETAIL_REGEX = re.compile(r'^(?:stderr: |killed with |timed out after )')

# A command an administrator ran with `fail2ban-client` and that fail2ban refused,
# for example unbanning an address that is not banned (`Transmitter.proceed()` in
# `server/transmitter.py`). The administrator saw the answer on the command line, so
# it is counted, but does not alert. The configuration the client sends at startup
# (`server-stream`) is the exception, see the configuration errors below.
CLIENT_COMMAND_REGEX = re.compile(r'^Command \[(?!.server-stream)')

# The start of a fail2ban server (`Server.start()` in `server/server.py`). Everything a
# process logs lies between its start and the next one. A start whose configuration
# fails does not get this far: its errors go to standard error, that is the journal
# of the unit, and they follow the last start that worked.
STARTUP_REGEX = re.compile(r'^Starting Fail2ban v(\S+)')

# The levels that say something is wrong, worst first.
LEVELS = (
    {'level': 'CRITICAL', 'perfdata': 'fail2ban_critical_lines'},
    {'level': 'ERROR', 'perfdata': 'fail2ban_error_lines'},
    {'level': 'WARNING', 'perfdata': 'fail2ban_warning_lines'},
)
LEVEL_CHOICES = [item['level'] for item in LEVELS] + [LEVEL_NONE]

# The events worth naming on their own, because the level alone does not say what
# happened. Taken from the error and warning messages of the fail2ban server and
# client (fail2ban 1.1.1, `server/*.py` and `client/*.py`), every one of them either
# assigned to an event here or deliberately left to its level, see the README; the
# events were reproduced on fail2ban 1.1.0 (Rocky 10, EPEL) and seen on production
# hosts running fail2ban 1.0.2, 1.1.0 and 1.1.1.
EVENTS = (
    {
        'key': 'config_errors',
        'label': 'configuration error',
        'perfdata': 'fail2ban_config_errors',
        # A start that failed (`client/fail2banserver.py`, `client/fail2bancmdline.py`,
        # `client/fail2banclient.py`), a jail fail2ban skipped (`client/jailsreader.py`,
        # `client/jailreader.py`, `client/configreader.py`, `server/jail.py`), and
        # settings fail2ban replaced or could not apply (`server/filter.py`,
        # `server/ipdns.py`, `server/jail.py`, `server/server.py`). A host name in
        # `ignoreip` that does not resolve leaves that host unprotected from bans.
        'regex': re.compile(
            r'^(?:Failed during configuration'
            r'|Async configuration of server failed'
            r'|Could not start (?:server|fail2ban-server)'
            r'|Fail2ban seems to be already running'
            r'|Server already running'
            r'|NOK: '
            r'|Command \[.server-stream'
            r'|Errors in jail '
            r'|Unable to read the filter'
            r'|Unable to read action'
            r'|Found no accessible config files'
            r'|Could not read config files'
            r'|Error decoding config file'
            r'|Have not found any log file'
            r'|File .* is a dangling link'
            r'|No filter set for jail'
            r'|No actions were defined for'
            r'|Wrong (?:value|\S+ value)'
            r'|Incorrect value .* specified for usedns'
            r'|Unknown backend'
            r'|Could only initiated'
            r'|Failed to initialize any backend'
            r'|ban time increment is not available'
            r'|Jail name .* might be too long'
            r'|Unable to find a corresponding IP address for'
            r'|Retrieving IPs set from .* failed'
            r'|Unable to log to'
            r'|Syslog socket file: .* does not exists'
            r'|Unable to set facility'
            r'|Unable to create PID file'
            r'|Unable to import fail2ban database module)'
        ),
        'state': STATE_WARN,
        'recommendation': (
            'fail2ban did not start, started without a jail or replaced a setting,'
            ' because of its configuration; the lines above say which file, jail or'
            ' setting, and `fail2ban-client --test` checks the configuration without'
            ' starting anything'
        ),
    },
    {
        'key': 'action_failures',
        'label': 'failed action',
        'perfdata': 'fail2ban_action_failures',
        # `server/actions.py`, `server/jail.py`: a ban, unban, reban, start, stop or
        # flush of an action that failed, so the firewall did not do what fail2ban
        # lists. The command and its error output precede the line, see
        # COMMAND_REGEX.
        'regex': re.compile(
            r'^(?:Failed to (?:execute (?:ban|reban|unban) jail'
            r'|start jail|stop jail|flush bans in jail|get .* bans merged)'
            r'|\[[^\]]+\] unhandled error in actions thread'
            r'|Stop .* of jail .* failed)'
        ),
        'state': STATE_WARN,
        'recommendation': (
            'Ban actions failed, so the firewall does not hold the bans fail2ban'
            ' lists; the command errors above say why, `fail2ban-client get sshd'
            ' actions` names the actions of the sshd jail'
        ),
    },
    {
        'key': 'lost_rules',
        'label': 'lost firewall rule set',
        'perfdata': 'fail2ban_lost_rules',
        # `server/action.py`, `server/actions.py`: `actioncheck` found the rules of an
        # action gone, typically after the firewall was reloaded or flushed. fail2ban
        # rebuilds them at the next ban; until then, its bans have no effect.
        'regex': re.compile(
            r'^(?:Invariant check failed'
            r'|Unable to restore environment)'
        ),
        'state': STATE_WARN,
        'recommendation': (
            'The firewall rules of fail2ban disappeared while it ran, usually because'
            ' the firewall was reloaded or flushed, and the bans had no effect until'
            ' fail2ban rebuilt them; reload the firewall in a way that keeps the'
            ' `f2b-*` chains or sets, or restart fail2ban after a reload'
        ),
    },
    {
        'key': 'reader_failures',
        'label': 'failed log reader',
        'perfdata': 'fail2ban_reader_failures',
        # `server/filter*.py`, `server/datetemplate.py`, `server/observer.py`: a jail
        # that cannot open, follow or parse its log or journal, or an observer that
        # stopped. Such a jail bans no one, while `fail2ban-client status` still lists
        # it. Seen on a production host whose sshd jail lost the journal file it read
        # and failed every two seconds from then on.
        'regex': re.compile(
            r'^(?:Caught unhandled exception in main cycle'
            r'|Too many errors at once'
            r'|Too many errors\. Remove file'
            r'|Failed to process line'
            r'|Unable to open '
            r'|Error opening (?!fail2ban persistent database)'
            r'|Error during seek'
            r'|Internal error in FileContainer'
            r'|Unable to get stat on'
            r'|Error reading line from systemd journal'
            r'|Error adding journal match'
            r'|Error restoring journal matches'
            r'|Error in FilterPyinotify callback'
            r'|Failed to remove watch'
            r'|findFailure failed to parse timeText'
            r'|Compile .* failed, expression'
            r'|Observer stopped after error)'
        ),
        'state': STATE_WARN,
        'recommendation': (
            'A jail stopped reading its log or journal, so it bans no one while it'
            ' is still listed as running; restart fail2ban, and if the error comes'
            ' back, check that the log the jail names (`fail2ban-client get sshd'
            ' logpath` for the sshd jail) exists and is readable'
        ),
    },
    {
        'key': 'database_errors',
        'label': 'database error',
        'perfdata': 'fail2ban_database_errors',
        # `server/database.py`, `server/jail.py`, and the SQLite errors the observer
        # logs bare (`server/observer.py`), see DATABASE_ERROR_REGEX.
        'regex': re.compile(
            r'^(?:Restore (?:bans|ticket) failed'
            r'|Error (?:connecting to|opening) fail2ban persistent database'
            r'|\s*Error repairing of fail2ban database'
            r'|Database update failed'
            r'|Failed to upgrade database'
            r'|json (?:dumps|loads) failed)'
        ),
        'state': STATE_WARN,
        'recommendation': (
            'fail2ban cannot use its database (`dbfile` in `fail2ban.conf`, usually'
            ' `/var/lib/fail2ban/fail2ban.sqlite3`), so it neither restores bans after'
            ' a restart nor bans repeat offenders longer; stop fail2ban, move the file'
            ' aside and start it again, which creates a new database and forgets the'
            ' current bans'
        ),
    },
    {
        'key': 'dns_lookups',
        'label': 'host name lookup',
        'perfdata': 'fail2ban_dns_lookups',
        # `DNSUtils.textToIp()` in `server/ipdns.py`, with `usedns = warn`, the
        # default: a filter caught something that is not an address and fail2ban
        # resolved it. Seen 700,000 times in two weeks on a host whose filter took the
        # virtual host name in front of the client address for the client.
        'regex': re.compile(r'^Determined IP using DNS Lookup: '),
        'state': STATE_WARN,
        'recommendation': (
            'A filter caught a host name instead of an address, and fail2ban bans'
            ' what that name resolves to, possibly this server itself; fix the filter'
            ' or the log format, or set `usedns = yes` in the jail where the log'
            ' really holds host names only, or `usedns = no` to ignore such lines'
        ),
    },
    {
        'key': 'timestamp_problems',
        'label': 'timestamp problem',
        'perfdata': 'fail2ban_timestamp_problems',
        # `Filter.processLine()` and `Filter.findFailure()` in `server/filter.py`,
        # each logged once a day per jail. A line dated after the current time points
        # to a wrong time zone or clock, and a match without a date is dropped, so it
        # bans no one. A line dated well before the current time is not named here: a
        # long request, a WebSocket for example, is logged with its start time when
        # it ends, hours later.
        'regex': re.compile(
            r'^\[[^\]]+\] (?:Detected a log entry .* after the current time'
            r'|Found a match but no valid date/time found)'
        ),
        'state': STATE_WARN,
        'recommendation': (
            'fail2ban cannot place the lines of a jail in time: lines from the future'
            ' point to a wrong time zone or clock where the log is written, and'
            ' matches without a date are dropped; set `datepattern` for the jail or'
            ' fix the time settings of the application writing the log'
        ),
    },
)

# SQLite errors the observer logs without saying they are about the database
# (`logSys.error('%s', e)` in `server/observer.py`). Seen on a production host whose
# database was corrupt: 128 of them next to the failed restore of the bans.
DATABASE_ERROR_REGEX = re.compile(
    r'^(?:database disk image is malformed'
    r'|database is locked'
    r'|database or disk is full'
    r'|disk I/O error'
    r'|file is not a database'
    r'|unable to open database file'
    r'|attempt to write a readonly database'
    r'|no such table)'
)

# The lines that belong to an event named above and add nothing to it: the companion
# lines fail2ban logs with a timestamp problem.
COMPANION_REGEX = re.compile(
    r'^\[[^\]]+\] (?:Match without a timestamp'
    r'|Please try setting a custom date pattern)'
)

# Lines about bans, judged by how many of them arrived within `--lookback`.
RATE_EVENTS = (
    {
        'key': 'ineffective_bans',
        'label': 'ineffective ban',
        'perfdata': 'fail2ban_ineffective_bans',
        # A banned address that shows up in the log again. fail2ban logs it as a
        # WARNING only when the line arrived more than a minute after the ban, "very
        # long time, something may be wrong" (`Actions.__checkBan()` in
        # `server/actions.py`), and at a lower level before that, when the ban may
        # simply not have taken effect yet. Seen on production hosts whose sshd jail
        # banned on port 22 while sshd listened on another port, and on a web server
        # whose banned clients went on over their open connections.
        'regex': re.compile(r'^\[[^\]]+\] \S+ already banned$'),
        'critical': 'INEFFECTIVE_BANS_CRITICAL',
        'warning': 'INEFFECTIVE_BANS_WARNING',
        'recommendation': (
            'Banned clients kept showing up in the logs more than a minute after'
            ' their ban, so the ban does not stop them; check that the `port` of the'
            ' jail is the port the service listens on, that the `banaction` works on'
            ' this firewall, and that a web server closes the open connections of a'
            ' banned client'
        ),
    },
)

# Lifecycle markers, counted but never alerting on.
LIFECYCLE = (
    {
        'key': 'startups',
        'label': 'startup',
        'perfdata': 'fail2ban_startups',
        'regex': STARTUP_REGEX,
        'verb': 'detected',
    },
    {
        'key': 'shutdowns',
        'label': 'shutdown',
        'perfdata': 'fail2ban_shutdowns',
        'regex': re.compile(r'^Exiting Fail2ban'),
        'verb': 'detected',
    },
    {
        'key': 'bans',
        'label': 'ban',
        'perfdata': 'fail2ban_bans',
        'regex': re.compile(r'^\[[^\]]+\] (?:Restore )?Ban '),
        'verb': 'logged',
    },
)

# What differs between two lines saying the same thing, for grouping them in a
# listing: addresses, the details of an action, durations and command ids.
MESSAGE_MASKS = (
    (re.compile(r" info 'ActionInfo\(.*?\)':"), ':'),
    (re.compile(r'\b\d{1,3}(?:\.\d{1,3}){3}(?:/\d+)?\b'), '*'),
    # three colons at least, or `::`, so a time of day (`20:27:38`) is left alone
    (
        re.compile(
            r'\b(?:[0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}\b'
            r'|(?<![\w:])[0-9a-fA-F:]*::[0-9a-fA-F:]*(?![\w:])'
        ),
        '*',
    ),
    (re.compile(r'= \{[^}]*\}'), '= {*}'),
    (re.compile(r'\b\d+[dhms](?: \d+[hms])*\b'), '*'),
    (re.compile(r'\bat 0x[0-9a-f]+\b'), ''),
)
MESSAGE_MAX_LEN = 200


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    # Developer-only hook: it prefixes every path the check opens, so the fixture
    # tests can stand a directory tree in for the host's file system. Deliberately
    # not named `--test-...`, because argparse would then resolve a bare `--test`
    # into it.
    parser.add_argument(
        '--config-root',
        help=argparse.SUPPRESS,
        dest='CONFIG_ROOT',
        default='',
    )

    parser.add_argument(
        '--critical-level',
        help='Least severe fail2ban log level that returns CRITICAL. '
        'Each level includes everything more severe than itself, so `ERROR` '
        'covers `CRITICAL` as well. '
        'Case-sensitive. '
        '`none` lets no level return CRITICAL, which leaves the events this '
        'check names as the only way to reach it. '
        'Example: `--critical-level=ERROR`. '
        'Default: %(default)s',
        dest='CRITICAL_LEVEL',
        choices=LEVEL_CHOICES,
        default=DEFAULT_CRITICAL_LEVEL,
    )

    parser.add_argument(
        '--icinga-callback',
        help=lib.args.help('--icinga-callback'),
        dest='ICINGA_CALLBACK',
        action='store_true',
        default=DEFAULT_ICINGA_CALLBACK,
    )

    parser.add_argument(
        '--icinga-password',
        help=lib.args.help('--icinga-password'),
        dest='ICINGA_PASSWORD',
    )

    parser.add_argument(
        '--icinga-service-name',
        help=lib.args.help('--icinga-service-name'),
        dest='ICINGA_SERVICE_NAME',
    )

    parser.add_argument(
        '--icinga-url',
        help=lib.args.help('--icinga-url'),
        dest='ICINGA_URL',
    )

    parser.add_argument(
        '--icinga-username',
        help=lib.args.help('--icinga-username'),
        dest='ICINGA_USERNAME',
    )

    parser.add_argument(
        '--ignore',
        help='Ignore a log line matching this Python regular expression. '
        'The log line is lowercased before matching, so write the pattern in '
        'lowercase (or use the `(?i)` flag). '
        'Can be specified multiple times. '
        "Example: `--ignore='(?i)linuxfabrik'`",
        action='append',
        default=None,
        dest='IGNORE',
    )

    parser.add_argument(
        '--ineffective-bans-critical',
        help='Number of banned clients that showed up in the logs again more than '
        'a minute after their ban within `--lookback` that returns CRITICAL. '
        '0 turns the threshold off. '
        'Example: `--ineffective-bans-critical=100`. '
        'Default: %(default)s',
        dest='INEFFECTIVE_BANS_CRITICAL',
        type=int,
        default=DEFAULT_INEFFECTIVE_BANS_CRITICAL,
    )

    parser.add_argument(
        '--ineffective-bans-warning',
        help='Number of banned clients that showed up in the logs again more than '
        'a minute after their ban within `--lookback` that returns WARNING. '
        '0 turns the threshold off. '
        'Example: `--ineffective-bans-warning=50`. '
        'Default: %(default)s',
        dest='INEFFECTIVE_BANS_WARNING',
        type=int,
        default=DEFAULT_INEFFECTIVE_BANS_WARNING,
    )

    parser.add_argument(
        '--insecure',
        help='Applies to the connection to the monitoring server that '
        '`--icinga-callback` makes, which is the only network connection this '
        'check opens. ' + lib.args.help('--insecure'),
        dest='INSECURE',
        action='store_true',
        default=DEFAULT_INSECURE,
    )

    parser.add_argument(
        '--lookback',
        help='Banned clients that show up in the logs again are counted within '
        'this window rather than reported one by one. '
        + lib.args.help('--lookback')
        + ' Example: `--lookback=86400`. '
        'Default: %(default)s (seconds)',
        dest='LOOKBACK',
        type=int,
        default=DEFAULT_LOOKBACK,
    )

    parser.add_argument(
        '--match',
        help='Only consider a log line matching this Python regular expression. '
        'The log line is lowercased before matching, so write the pattern in '
