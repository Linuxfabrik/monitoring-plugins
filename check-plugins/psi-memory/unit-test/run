import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# psi-memory reads a file and runs no command, so its fixtures are directory trees under
# `config/` that stand in for the host's /proc, selected with the hidden `--config-root`
# hook. Each tree holds the one file the check reads.
#
# Where the fixtures come from, all captured on this workstation (Fedora 44, kernel 7.1)
# unless noted:
#
#   idle      an unloaded host
#   thrash    a scope limited with MemoryHigh=150M walking a 900 MiB buffer for a minute
#             and a half, so the kernel evicts and faults the same pages back in
#             continuously. Both lines read 20.23 % over the last minute, which is the
#             state the check exists for
#   burst     a cgroup limited to 128 MiB reading a 900 MiB file with six readers, so
#             the kernel evicts and faults the same pages back in continuously, read
#             fourteen seconds in. The ten second average has risen and the one minute
#             average has not caught up yet, which is the shape --warning-avg10 and
#             --critical-avg10 exist for. Captured at cgroup scope, which the kernel
#             publishes in the same format as /proc/pressure
#   no-psi    a host whose kernel keeps no pressure statistics: /proc is there,
#             /proc/pressure is not. That is what the whole Red Hat family boots into,
#             because it ships CONFIG_PSI_DEFAULT_DISABLED=y
#   malformed derived from the idle capture by replacing one average with a word. No
#             kernel prints this; the fixture exists to prove that a value the check
#             cannot read is reported instead of silently becoming a zero
#
# The same fixture drives several testcases with different thresholds, which is what the
# thresholds are for: the state belongs to the testcase id, not to the fixture name.
TESTS = [
    {
        'id': 'ok-an-idle-host',
        'test': '',
        'params': '--config-root=config/idle',
        'assert-retc': STATE_OK,
        'assert-in': ['memory pressure, last minute: ', "'full_avg60'="],
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    {
        # The state the check exists for: the host spends a fifth of its time with
        # every task that had work to do waiting for memory.
        'id': 'crit-a-host-that-thrashes',
        'test': '',
        'params': '--config-root=config/thrash',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'memory pressure, last minute: some 20.23%, full 20.23% [CRITICAL]',
            'Work is stalling on memory.',
            'memory-paging',
        ],
    },
    {
        'id': 'warn-below-the-critical-threshold',
        'test': '',
        'params': '--config-root=config/thrash --warning=5 --critical=50',
        'assert-retc': STATE_WARN,
        'assert-in': ['[WARNING]'],
        'assert-not-in': ['[CRITICAL]'],
    },
    {
        # A host that is expected to page, a batch node for example, wants the pressure
        # graphed and nobody woken. `~:` is the Nagios range for "any value is fine".
        'id': 'ok-thresholds-turned-off-with-a-range',
        'test': '',
        'params': '--config-root=config/thrash --warning=~: --critical=~:',
        'assert-retc': STATE_OK,
        'assert-in': ['memory pressure, last minute: some 20.23%'],
        'assert-not-in': ['[WARNING]', '[CRITICAL]', 'Work is stalling'],
    },
    {
        'id': 'ok-always-ok-masks-the-crit',
        'test': '',
        'params': '--config-root=config/thrash --always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['[CRITICAL]'],
    },
    {
        'id': 'crit-no-perfdata-drops-the-perfdata-only',
        'test': '',
        'params': '--config-root=config/thrash --no-perfdata',
        'assert-retc': STATE_CRIT,
        'assert-in': ['[CRITICAL]'],
        'assert-not-in': ["'full_avg60'="],
    },
    {
        'id': 'ok-every-window-is-reported',
        'test': '',
        'params': '--config-root=config/thrash --warning=~: --critical=~:',
        'assert-retc': STATE_OK,
        'assert-in': [
            'some = at least one task waited for memory',
            'full = every task with work to do waited for memory',
            'avg10',
            'avg300',
        ],
    },
    {
        # The default leaves the ten second average unjudged, so a burst that the one
        # minute average smooths away stays in the graph and out of the alert.
        'id': 'ok-a-burst-is-not-judged-by-default',
        'test': '',
        'params': '--config-root=config/burst',
        'assert-retc': STATE_OK,
        'assert-in': ["'full_avg10'=6.23%;;;0;100"],
        'assert-not-in': ['[WARNING]', '[CRITICAL]', 'last ten seconds'],
    },
    {
        # The same reading with a threshold on the ten second average: the one minute
        # average is still inside its range, and the burst alerts on its own.
        'id': 'warn-a-burst-alerts-once-avg10-has-a-threshold',
        'test': '',
        'params': '--config-root=config/burst --warning-avg10=5',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'memory pressure, last minute: some 1.65%, full 1.65%; '
            'last ten seconds: full 6.23% [WARNING]',
            "'full_avg10'=6.23%;5;;0;100",
        ],
        'assert-not-in': ['[CRITICAL]'],
    },
    {
        'id': 'crit-a-burst-past-the-critical-threshold',
        'test': '',
        'params': '--config-root=config/burst --warning-avg10=5 --critical-avg10=6',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'last ten seconds: full 6.23% [CRITICAL]',
            'Work is stalling on memory.',
        ],
    },
    {
        # A burst inside its range is not worth a word in the headline, even though the
        # check judged it.
        'id': 'ok-a-judged-burst-within-its-range-stays-quiet',
        'test': '',
        'params': '--config-root=config/burst --warning-avg10=20',
        'assert-retc': STATE_OK,
        'assert-not-in': ['last ten seconds', '[WARNING]', '[CRITICAL]'],
    },
    {
        # Both windows out of range at once: each is named with its own state.
        'id': 'crit-the-minute-and-the-burst-alert-together',
        'test': '',
        'params': '--config-root=config/burst --warning=1 --critical=1.5 '
        '--warning-avg10=5',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'full 1.65% [CRITICAL]',
            'last ten seconds: full 6.23% [WARNING]',
        ],
    },
    {
        # The Red Hat default. Nothing to measure, and the check says how to change
        # that instead of going quiet or alerting.
        'id': 'ok-a-kernel-without-pressure-statistics',
        'test': '',
        'params': '--config-root=config/no-psi',
        'assert-retc': STATE_OK,
        'assert-in': [
            'This kernel keeps no pressure statistics',
            '`psi=1`',
        ],
        'assert-not-in': ['memory pressure'],
    },
    {
        'id': 'warn-a-kernel-without-pressure-statistics-can-alert',
        'test': '',
        'params': '--config-root=config/no-psi --severity-no-psi=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['This kernel keeps no pressure statistics'],
    },
    {
        'id': 'unknown-a-value-that-is-no-number',
        'test': '',
        'params': '--config-root=config/malformed',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['which is no average'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../psi-memory'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
