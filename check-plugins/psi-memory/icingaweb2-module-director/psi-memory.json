            "icon_image": "psi-memory.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Reports how much of its time a host loses waiting for memory, taken from the pressure stall information of the Linux kernel. A pressure of 10 percent means that for a tenth of the time work could not go on because memory was contended. The check alerts on the share of time in which every task that had work to do was stalled at once, averaged over the last minute. That is the state in which the machine spends its cycles waiting instead of working, and it answers what neither memory usage nor swap usage can: whether the shortage costs anything. A host whose kernel keeps no pressure statistics is reported as OK, because there is nothing to measure; raise --severity-no-psi to flag it where the statistics are expected. Alerts when the pressure leaves the warning or critical range.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/psi-memory/",
            "object_name": "tpl-service-psi-memory",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "psi_memory_always_ok": false,
                "psi_memory_critical": "20",
                "psi_memory_no_perfdata": false,
                "psi_memory_severity_no_psi": "ok",
                "psi_memory_warning": "5"
            },
            "volatile": null,
            "zone": null,
            "uuid": "16c1a935-9a89-46b7-aabe-31e8ec2aed3e"
        }
    },
