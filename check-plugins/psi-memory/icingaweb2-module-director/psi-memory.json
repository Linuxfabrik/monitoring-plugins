    "Datafield": {
        "1": {
            "varname": "psi_memory_always_ok",
            "caption": "Psi Memory: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "dbc982a1-2e4e-4ecc-b325-76bc99312167"
        },
        "2": {
            "varname": "psi_memory_critical",
            "caption": "Psi Memory: Critical",
            "description": "CRIT threshold for the memory pressure, in percent of wall clock time, measured over the last minute. Supports Nagios ranges. Example: `10` alerts where 10 percent of the time is lost.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "35f1e3df-1f54-407c-8852-1a9e2397c893"
        },
        "3": {
            "varname": "psi_memory_critical_avg10",
            "caption": "Psi Memory: Critical Avg10",
            "description": "CRIT threshold for the memory pressure, in percent of wall clock time, measured over the last ten seconds. Catches a burst that the one minute average smooths away, at the price of alerting on a stall that is over before anybody looks. Supports Nagios ranges. Example: `90` alerts where work waited for memory for nine of the last ten seconds. Default: no critical threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "16844797-656d-4558-929c-986beb98fe91"
        },
        "4": {
            "varname": "psi_memory_no_perfdata",
            "caption": "Psi Memory: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f6774261-eec8-44f0-be3a-e92d3e51ce8c"
        },
        "5": {
            "varname": "psi_memory_severity_no_psi",
            "caption": "Psi Memory: Severity No Psi",
            "description": "Severity for alerting if the kernel keeps no pressure statistics.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "psi_memory_severity_no_psi_list"
            },
            "uuid": "6dce2060-1a91-45ef-ad5c-b7abea279d59"
        },
        "6": {
            "varname": "psi_memory_warning",
            "caption": "Psi Memory: Warning",
            "description": "WARN threshold for the memory pressure, in percent of wall clock time, measured over the last minute. Supports Nagios ranges. Example: `5` alerts where 5 percent of the time is lost.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e0837d79-29be-4a54-ab10-cbfbc6e5432a"
        },
        "7": {
            "varname": "psi_memory_warning_avg10",
            "caption": "Psi Memory: Warning Avg10",
            "description": "WARN threshold for the memory pressure, in percent of wall clock time, measured over the last ten seconds. Catches a burst that the one minute average smooths away, at the price of alerting on a stall that is over before anybody looks. Supports Nagios ranges. Example: `80` alerts where work waited for memory for eight of the last ten seconds. Default: no warning threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
