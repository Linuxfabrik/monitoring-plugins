            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d998b9b6-7579-4d21-aa5b-5729f8732101"
        },
        "4": {
            "varname": "huawei_dorado_expboard_ignore",
            "caption": "Huawei Dorado Expboard: Ignore",
            "description": "Skip expansion boards. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a05167f9-9663-4651-a875-66557a4426d7"
        },
        "5": {
            "varname": "huawei_dorado_expboard_insecure",
            "caption": "Huawei Dorado Expboard: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "b9c3a5d9-317c-4387-b2fb-bd35124a0b0a"
        },
        "6": {
            "varname": "huawei_dorado_expboard_no_insecure",
            "caption": "Huawei Dorado Expboard: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "39a39f33-a97e-42d2-ba08-e39661d5d7d0"
        },
        "7": {
            "varname": "huawei_dorado_expboard_match",
            "caption": "Huawei Dorado Expboard: Match",
            "description": "Limit to expansion boards. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a9f80456-f04e-415f-915d-8e13f7bf64c9"
        },
        "8": {
            "varname": "huawei_dorado_expboard_no_match_severity",
            "caption": "Huawei Dorado Expboard: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_expboard_no_match_severity_list"
            },
            "uuid": "6fd102ae-b309-459a-801f-c1a1ef57d86c"
        },
        "9": {
            "varname": "huawei_dorado_expboard_no_perfdata",
            "caption": "Huawei Dorado Expboard: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8d309e14-ef7d-4bbc-9f65-380c9ad14663"
        },
        "10": {
