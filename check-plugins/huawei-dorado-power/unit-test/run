import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        # The last module reports no input (health 11) and offline (running 28).
        # An offline power supply has stopped doing its job, so the check has to
        # reach CRITICAL rather than the WARNING it used to report for every
        # non-normal state alike.
        'id': 'crit-power-supplies-offline',
        'test': 'stdout/power-supplies-warning,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            # Column widths follow the widest value in each column, so the header is
            # asserted per column rather than as one fixed-width line.
            'UUID',
            'SerialNumber',
            'Health',
            'Running',
            '23:23.0.0  ! CTE0.PSU0   ! HUAWEI       ! PAC2000S12-BG ! 12345678',
            '23:23.0.3  ! CTE0.PSU3   ! HUAWEI       ! PAC2000S12-BG ! 12345678',
            '23:0.0B.0  ! CTE0.PSU 0  ! VAPEL        ! HSP960-D1205D ! 21022701328NE5000004',
            '! [CRITICAL]',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the inventory ones out.
        'id': 'crit-power-supplies-offline-core-columns',
        'test': 'stdout/power-supplies-warning,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'UUID       ! Location    ! Health        ! Running      ! State',
        ],
        'assert-not-in': ['SerialNumber', 'Manufacturer', 'Produced'],
    },
    {
        # Healthy supplies whose firmware reports 0 for both voltages. That is no
        # reading, so it must neither be graphed as a flat line at zero, which looks
        # like a dead feed, nor printed as 0.0 V. Verified against V700R001C10SPH128
        # on a Dorado 6000 V6.
        'id': 'ok-power-supplies-no-voltage-reading',
        'test': 'stdout/power-supplies-no-voltage-reading,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'UUID       ! Location    ! Health     ! Running     ! State',
            '23:23.72.0 ! DAE040.PSU0 ! Normal (1) ! Online (27) ! [OK]',
        ],
        # With no reading and no status code in the performance data, nothing is
        # left to report there, and no stray pipe may follow the table.
        'assert-not-in': [
            '! 0.0 ',
            'In (V)',
            'Out (V)',
            '_input_voltage=',
            '_output_voltage=',
            '|',
        ],
    },
    {
        # The performance data carries the voltages and the temperature with its
        # thresholds, never a status code: the state already reports those.
        'id': 'ok-power-supply-perfdata-without-status-codes',
        'test': 'stdout/power-supply-with-readings,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin '
        '--warning-temperature=40',
        'assert-retc': STATE_OK,
        'assert-in': [
            "'23_23_0_0_input_voltage'=230.0;;;0 ",
            "'23_23_0_0_output_voltage'=12.2;;;0 ",
            "'23_23_0_0_temperature'=31;40;;0",
        ],
        'assert-not-in': ['_health_status', '_running_status'],
    },
    {
        # A power supply whose feed is dead answers with health 11 (no input). That is
        # not a reduced state the array keeps serving in, so it has to reach CRITICAL.
        # A second supply failing the same way takes the array with it.
        'id': 'crit-power-supply-without-input',
        'test': 'stdout/power-supply-without-input,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': ['There are critical errors.'],
        # A supply reporting no temperature must not be graphed at 0 degrees.
        'assert-not-in': ['_temperature='],
    },
    {
        # An appliance always has power modules. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-power-modules',
        'test': 'stdout/no-power-modules,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no power modules.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-power'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
