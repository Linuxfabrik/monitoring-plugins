            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d7bdbb44-746d-4943-953f-7bfc846babe2"
        },
        "5": {
            "varname": "huawei_dorado_power_ignore",
            "caption": "Huawei Dorado Power: Ignore",
            "description": "Skip power modules. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4b20ce89-e172-4eae-8155-d3eed15419c0"
        },
        "6": {
            "varname": "huawei_dorado_power_insecure",
            "caption": "Huawei Dorado Power: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7d84abbc-95b0-44e8-ba2f-df7f1b14b1bd"
        },
        "7": {
            "varname": "huawei_dorado_power_no_insecure",
            "caption": "Huawei Dorado Power: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "998ae686-07bf-4da5-9342-199dedc610d6"
        },
        "8": {
            "varname": "huawei_dorado_power_match",
            "caption": "Huawei Dorado Power: Match",
            "description": "Filter by power modules. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f43eabd4-2d97-4033-b042-8dec4f0b1587"
        },
        "9": {
            "varname": "huawei_dorado_power_no_match_severity",
            "caption": "Huawei Dorado Power: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
