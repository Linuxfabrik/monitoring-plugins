            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7feefd9f-7b32-490f-9bce-0233b6e1051e"
        },
        "12": {
            "varname": "wordpress_version_unreachable_severity",
            "caption": "WordPress Version: Unreachable Severity",
            "description": "State to report when the online source is unreachable. What is used instead - bundled offline data, a cached copy, or nothing at all - is named in the output, and a clean result then only covers what that fallback could confirm.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "wordpress_version_unreachable_severity_list"
            },
            "uuid": "0a526dd5-c7b4-422d-883e-92b90b5e4e12"
