        'params': '--match=^www',
        'assert-retc': STATE_OK,
        'assert-in': ['1 certificates renew as scheduled.'],
        'assert-not-in': ['mail.example.com'],
    },
    {
        'id': 'ok-brief-hides-healthy-rows',
        'build': lambda root: (
            _add_store(root, 'www.example.com'),
            _add_store(root, 'mail.example.com', days_valid=45),
        ),
        'params': '--brief',
        'assert-retc': STATE_OK,
        'assert-not-in': ['www.example.com_ecc !', 'Days Left'],
    },
    {
        'id': 'ok-cert-home-defaults-to-the-configuration-directory',
        # an installation that was never given --cert-home keeps the stores in the
        # configuration directory itself, and account.conf then names no CERT_HOME
        'build': lambda root: (
            _write(
                os.path.join(root, 'account.conf'), "ACCOUNT_EMAIL='a@example.com'\n"
            ),
            _add_store(root, 'www.example.com'),
            shutil.move(
                os.path.join(root, 'certs', 'www.example.com_ecc'),
                os.path.join(root, 'www.example.com_ecc'),
            ),
            shutil.rmtree(os.path.join(root, 'certs')),
        ),
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['1 certificates renew as scheduled.'],
    },
    {
        'id': 'ok-directory-without-a-dot-is-not-a-store',
        # acme.sh iterates `$CERT_HOME/*.*` and `$CERT_HOME/*:*`, so it never looks into
        # a directory whose name carries neither, and neither does this check
        'build': lambda root: (
            _add_store(root, 'www.example.com'),
            os.makedirs(os.path.join(root, 'certs', 'backup'), exist_ok=True),
            _write(
                os.path.join(root, 'certs', 'backup', 'backup.conf'), "Le_Domain='x'\n"
            ),
        ),
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['1 certificates renew as scheduled.'],
        'assert-not-in': ['backup'],
    },
    {
        'id': 'warn-no-certificate-stores',
        # the configuration directory an installation that was given --config-home
        # leaves behind: the script and its hook directories, no certificates. A check
        # pointed at it would otherwise report OK forever while looking at nothing
        'build': lambda root: [
            os.makedirs(os.path.join(root, 'certs'), exist_ok=True),
            os.makedirs(os.path.join(root, 'dnsapi'), exist_ok=True),
            _write(os.path.join(root, 'acme.sh'), '#!/usr/bin/env sh\n'),
        ],
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ['No certificate stores in', 'LE_CONFIG_HOME'],
    },
    {
        'id': 'ok-no-certificate-stores-with-severity-ok',
        'build': lambda root: os.makedirs(os.path.join(root, 'certs'), exist_ok=True),
        'params': '--severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ['No certificate stores in'],
    },
    {
        'id': 'unknown-no-configuration-directory',
        'build': lambda root: None,
        'params': '--path=/nonexistent/acme.sh',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No acme.sh configuration found'],
    },
    {
        'id': 'unknown-invalid-regex',
        'build': lambda root: _add_store(root, 'www.example.com'),
        'params': '--match=(',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['contains one or more errors'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../acmesh-status'


def _run_scenario(test, scenario):
    root = tempfile.mkdtemp(prefix='lfmp-acmesh-status-')
    try:
        _build(scenario, root)
        params = scenario['params']
        if '--path=' not in params:
            params = f'--path={root} {params}'.strip()
        testcase = {
            key: value for key, value in scenario.items() if key.startswith('assert')
        }
        # this check reads a directory tree rather than the output of a command, so it
        # has no --test hook; the empty value is dropped by parse_known_args()
        testcase['test'] = ''
        testcase['params'] = params
        lib.lftest.run(test, test.check, testcase)
    finally:
        shutil.rmtree(root, ignore_errors=True)


lib.lftest.attach_each(TestCheck, SCENARIOS, _run_scenario, id_func=lambda it: it['id'])


if __name__ == '__main__':
    unittest.main()
