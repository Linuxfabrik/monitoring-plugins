    "Datafield": {
        "1": {
            "varname": "acmesh_status_always_ok",
            "caption": "Acmesh Status: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8d81868a-af1d-4cd8-8686-75ffe8a1e084"
        },
        "2": {
            "varname": "acmesh_status_brief",
            "caption": "Acmesh Status: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "745ee486-0632-48da-acca-4059de2dadb2"
        },
        "3": {
            "varname": "acmesh_status_critical",
            "caption": "Acmesh Status: Critical",
            "description": "CRIT threshold for the time remaining until a certificate expires. Accepts a Nagios range in days (`5:`), a percentage of the total validity period (`10%`, CRIT when less than 10% of the lifetime is left), or a duration with a unit (`3d`, `12h`, `2W`, `1M`; CRIT when less time than that is left). Examples: `5:` `10%` `3d`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "aaf6e6ef-335b-44f6-87d0-102e55a35420"
        },
        "4": {
            "varname": "acmesh_status_grace_renewal",
            "caption": "Acmesh Status: Grace Renewal",
            "description": "How long an overdue renewal is tolerated before it counts towards the state. Set this to cover the interval the acme.sh renewal job runs at, so a run that has not happened yet is not reported as a failure. Starts at the renewal time acme.sh recorded for the certificate. A duration such as `12h`, `8D` or `2W`; `0D` disables the grace period. Example: `--grace-renewal=8D` for a job that runs weekly.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "936fa434-baa1-4004-838a-56dff3a70ad6"
        },
        "5": {
            "varname": "acmesh_status_ignore",
            "caption": "Acmesh Status: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6b2581eb-0923-4c78-8efc-cfcddba8cb7f"
        },
        "6": {
            "varname": "acmesh_status_lengthy",
            "caption": "Acmesh Status: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "48d448fb-98b7-4874-89a6-ed61fa22dfdf"
        },
        "7": {
            "varname": "acmesh_status_match",
            "caption": "Acmesh Status: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4792dd65-fc3b-4d85-b774-1e9eaed8468b"
        },
        "8": {
            "varname": "acmesh_status_no_match_severity",
            "caption": "Acmesh Status: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "acmesh_status_no_match_severity_list"
            },
            "uuid": "cd748ba5-5b29-40a8-9a4c-060de97727d5"
        },
        "9": {
            "varname": "acmesh_status_no_perfdata",
            "caption": "Acmesh Status: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6c5aca38-0ee7-4699-9ffc-ff0bba70809e"
        },
        "10": {
            "varname": "acmesh_status_path",
            "caption": "Acmesh Status: Path",
            "description": "Directory acme.sh keeps its configuration in, the one it is called with as `--config-home`. The certificate store is read from the `CERT_HOME` recorded there, and from this directory itself where that names none. Example: `--path=/etc/acme.sh`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b3f7cc08-d808-4ab7-85a1-bff03b60ad3d"
        },
        "11": {
            "varname": "acmesh_status_severity",
            "caption": "Acmesh Status: Severity",
            "description": "Severity assigned to a certificate whose renewal is overdue, whose installed copy is missing, which carries no issued certificate, or which is still deployed after having been detached from renewal. Each of these keeps the certificate valid for the time being, which is why they default to %(default)s; the expiry thresholds raise the state on their own as the deadline comes closer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "acmesh_status_severity_list"
            },
            "uuid": "1da5aaa3-753e-49e8-9828-2f8ad5e769b0"
        },
        "12": {
            "varname": "acmesh_status_warning",
            "caption": "Acmesh Status: Warning",
            "description": "WARN threshold for the time remaining until a certificate expires. Accepts a Nagios range in days (`14:`), a percentage of the total validity period (`25%`, WARN when less than 25% of the lifetime is left), or a duration with a unit (`10d`, `12h`, `2W`, `1M`; WARN when less time than that is left). Examples: `14:` `25%` `10d`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "64cea0bf-6d39-4379-87d1-ddbc59b8c437"
        }
    }
}
