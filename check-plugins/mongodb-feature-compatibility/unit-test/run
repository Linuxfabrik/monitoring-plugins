"""Unit tests for the mongodb-feature-compatibility check plugin.

The fixtures in `stdout/` are what the plugin's mongosh script printed, captured with
mongosh 2.14 against mongodb-org 7.0.48 and 8.0.38 on Rocky 9, with and without
authorization. `mongodb-8.0-fcv-7.0` is 8.0 binaries started on the data files of
7.0 before `setFeatureCompatibilityVersion` was run. The `mongodb-9.0-` fixtures come
from docker.io/library/mongo 9.0.8 with `enableTestCommands`: an upgrade from 8.0
interrupted by the failpoints `failUpgrading` (early) and `failBeforeUpdatingFcvDoc`
(late), a downgrade to 8.0 interrupted by `failBeforeUpdatingFcvDoc`, and a finished
downgrade to 8.0.
`stderr/mongosh-connection-refused` is mongosh pointed at a port nothing listens on
(exit code 1).
"""

import sys

sys.path.insert(0, '..')

import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'ok-fcv-matches-7-0',
        'test': 'stdout/mongodb-7.0-fcv-7.0,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['MongoDB v7.0.48, featureCompatibilityVersion 7.0'],
        'assert-not-in': ['[WARNING]', '|'],
    },
    {
        'id': 'ok-fcv-matches-8-0',
        'test': 'stdout/mongodb-8.0-fcv-8.0,,0',
        'assert-retc': STATE_OK,
        'assert-in': ['MongoDB v8.0.38, featureCompatibilityVersion 8.0'],
        'assert-not-in': ['[WARNING]', 'setFeatureCompatibilityVersion'],
    },
    {
        # 8.0 binaries on the data files of 7.0, `setFeatureCompatibilityVersion` not run
        'id': 'warn-fcv-lower-than-binary',
        'test': 'stdout/mongodb-8.0-fcv-7.0,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'MongoDB v8.0.38, featureCompatibilityVersion 7.0 [WARNING]\n',
            'It is lower than the release of the binaries, 8.0.',
            'Either the upgrade to 8.0 is not finished, finish it with '
            '`db.adminCommand({setFeatureCompatibilityVersion: "8.0", confirm: true})`',
            'Or the downgrade to 7.0 is finished',
        ],
    },
    {
        # a downgrade from 9.0 to 8.0 that completed, binaries not yet replaced
        'id': 'warn-fcv-downgrade-finished-binaries-not-replaced',
        'test': 'stdout/mongodb-9.0-fcv-8.0,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'featureCompatibilityVersion 8.0 [WARNING]',
            'Or the downgrade to 8.0 is finished',
        ],
    },
    {
        # failpoint `failUpgrading`: `version` stays at the start
        'id': 'warn-fcv-upgrade-interrupted-early',
        'test': 'stdout/mongodb-9.0-fcv-8.0-upgrading-to-9.0,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'MongoDB v9.0.8, featureCompatibilityVersion 8.0, upgrade from 8.0 to 9.0 '
            'not finished [WARNING]\n',
            'Finish it with '
            '`db.adminCommand({setFeatureCompatibilityVersion: "9.0", confirm: true})`.',
        ],
        'assert-not-in': ['downgrade'],
    },
    {
        # failpoint `failBeforeUpdatingFcvDoc`: `version` already at the target, which
        # matches the binaries, so only `targetVersion` tells
        'id': 'warn-fcv-upgrade-interrupted-late',
        'test': 'stdout/mongodb-9.0-fcv-9.0-upgrading-from-8.0,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'featureCompatibilityVersion 9.0, upgrade from 8.0 to 9.0 not finished '
            '[WARNING]',
            'setFeatureCompatibilityVersion: "9.0"',
        ],
        'assert-not-in': ['downgrade'],
    },
    {
        # failpoint `failBeforeUpdatingFcvDoc` while downgrading: the check must not ask
        # to finish an upgrade
        'id': 'warn-fcv-downgrade-interrupted',
        'test': 'stdout/mongodb-9.0-fcv-8.0-downgrading-from-9.0,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'featureCompatibilityVersion 8.0, downgrade from 9.0 to 8.0 not finished '
            '[WARNING]',
            'Finish it with '
            '`db.adminCommand({setFeatureCompatibilityVersion: "8.0", confirm: true})`.',
        ],
        'assert-not-in': ['upgrade'],
    },
    {
        'id': 'ok-always-ok-fcv-lower-than-binary',
        'test': 'stdout/mongodb-8.0-fcv-7.0,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['featureCompatibilityVersion 7.0 [WARNING]'],
    },
    {
        'id': 'unknown-login-required',
        'test': 'stdout/mongodb-7.0-login-required,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'MongoDB v7.0.48 requires a login',
            '`clusterMonitor`',
            '`getParameter`',
        ],
    },
    {
        'id': 'unknown-user-lacks-privilege',
        'test': 'stdout/mongodb-7.0-user-lacks-privilege,,0',
        'params': '--username=monitoring --password=linuxfabrik',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'does not let the user `monitoring` read the featureCompatibilityVersion',
            '`clusterMonitor`',
        ],
        'assert-not-in': ['lsid'],
    },
    {
        'id': 'unknown-wrong-password',
        'test': 'stdout/mongodb-7.0-wrong-password,,0',
        'params': '--username=monitoring --password=linuxfabrik',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Failed to authenticate'],
        'assert-not-in': ['linuxfabrik'],
    },
    {
        'id': 'unknown-password-without-username',
        'test': 'stdout/mongodb-8.0-fcv-8.0,,0',
        'params': '--password=linuxfabrik',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['no `--username`'],
    },
    {
        'id': 'unknown-username-without-password',
        'test': 'stdout/mongodb-8.0-fcv-8.0,,0',
        'params': '--username=monitoring',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['no password', '`--password-file`'],
    },
    {
        'id': 'unknown-connection-refused',
        'test': ',stderr/mongosh-connection-refused,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'mongosh could not connect to MongoDB at 127.0.0.1:27017',
            'ECONNREFUSED',
        ],
    },
    {
        'id': 'unknown-mongosh-fails-silently',
        'test': ',,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'mongosh could not connect to MongoDB at 127.0.0.1:27017: exit code 1, '
            'no message',
        ],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['MongoDB not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../mongodb-feature-compatibility'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestTimeout(unittest.TestCase):
    """A mongosh that never answers, as it does for 30 seconds against an unreachable
    host, ends the check with a warning once `--timeout` has passed, instead of keeping
    it running until the monitoring server kills it.
    """

    def test_warn_mongosh_hangs(self):
        result = subprocess.run(  # nosec B603 - argv list, no shell
            [
                '../mongodb-feature-compatibility',
                '--hostname=192.0.2.1',
                '--path=fixtures/hang',
                '--timeout=1',
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        self.assertEqual(result.returncode, STATE_WARN)
        self.assertIn(
            'Timeout after 1s while connecting to MongoDB at 192.0.2.1:27017.',
            result.stdout,
        )


if __name__ == '__main__':
    unittest.main()
