    "Datafield": {
        "1": {
            "varname": "huawei_dorado_disk_always_ok",
            "caption": "Huawei Dorado Disk: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "e90be21f-aad0-4a0e-b866-cd01d3e1f7a1"
        },
        "2": {
            "varname": "huawei_dorado_disk_brief",
            "caption": "Huawei Dorado Disk: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on. Worth setting on an array with many disks.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1d5669cf-b6d7-4f87-9328-a44c9389152d"
        },
        "3": {
            "varname": "huawei_dorado_disk_cache_expire",
            "caption": "Huawei Dorado Disk: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8f7c13ac-e398-4dc7-ad32-a7d90d8cd598"
        },
        "4": {
            "varname": "huawei_dorado_disk_critical",
            "caption": "Huawei Dorado Disk: Critical",
            "description": "CRIT threshold for the remaining life of a disk, as a Nagios range in days.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a73cf7b2-0987-4a42-9b08-7db6339993fa"
        },
        "5": {
            "varname": "huawei_dorado_disk_critical_temperature",
            "caption": "Huawei Dorado Disk: Critical Temperature",
            "description": "CRIT threshold in degrees Celsius. Off by default, because a healthy operating temperature depends on the drive model and on where the array stands. Example: `--critical-temperature=50`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "76438a57-12a4-46ed-98b5-342e39b04a3c"
        },
        "6": {
            "varname": "huawei_dorado_disk_critical_health_mark",
            "caption": "Huawei Dorado Disk: Critical Health Mark",
            "description": "CRIT threshold for the health score of a disk, as a Nagios range. The appliance scores a disk from 0 to 100, where 100 is a disk with nothing wrong with it. Flash media report 255 instead, which is a \"not applicable\" marker and is never compared. Off by default, so an update cannot start alerting on a fleet nobody has looked at yet. 65: is what field practice suggests. Example: `--critical-health-mark=65:`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "eafeaa55-b344-4b83-8551-ecf98b2f6531"
        },
        "7": {
            "varname": "huawei_dorado_disk_critical_wear",
            "caption": "Huawei Dorado Disk: Critical Wear",
            "description": "CRIT threshold for the wear of a disk, as a Nagios range in percent of its service life used up. Spinning media report -1 instead and are never compared. Off by default. Example: `--critical-wear=90`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6bf949ce-261c-4c03-b1c6-4f47729c6440"
        },
        "8": {
            "varname": "huawei_dorado_disk_device_id",
            "caption": "Huawei Dorado Disk: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8f504620-1c41-416b-9a36-1d078292929a"
        },
        "9": {
            "varname": "huawei_dorado_disk_ignore",
            "caption": "Huawei Dorado Disk: Ignore",
            "description": "Skip disks. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "42cbc24d-346e-443a-80b4-88fdd7b90480"
        },
        "10": {
            "varname": "huawei_dorado_disk_insecure",
            "caption": "Huawei Dorado Disk: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8ac64528-1939-47e8-924b-edc93867751b"
        },
        "11": {
            "varname": "huawei_dorado_disk_lengthy",
            "caption": "Huawei Dorado Disk: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0ec94e2a-f44e-4dd3-97ad-4f2580f93bcd"
        },
        "12": {
            "varname": "huawei_dorado_disk_no_insecure",
            "caption": "Huawei Dorado Disk: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ca5525a5-9182-4b7d-947e-9d3886f51cf0"
        },
        "13": {
            "varname": "huawei_dorado_disk_match",
            "caption": "Huawei Dorado Disk: Match",
            "description": "Limit to disks. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d8aa7266-4982-4972-a64a-2940b5a673bf"
        },
        "14": {
            "varname": "huawei_dorado_disk_no_match_severity",
            "caption": "Huawei Dorado Disk: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_disk_no_match_severity_list"
            },
            "uuid": "827ca8e0-ce74-44c3-98e0-0e92ac441927"
        },
        "15": {
            "varname": "huawei_dorado_disk_no_perfdata",
            "caption": "Huawei Dorado Disk: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "575eaac1-ab3f-4699-8153-f7fa47571144"
        },
        "16": {
            "varname": "huawei_dorado_disk_no_proxy",
            "caption": "Huawei Dorado Disk: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "a3afe705-a0fa-465c-8e2b-038759a210bb"
        },
        "17": {
            "varname": "huawei_dorado_disk_password",
            "caption": "Huawei Dorado Disk: Password",
            "description": "Huawei OceanStor Dorado API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "c670e7e0-164c-4be4-bcac-40e91975ef8f"
        },
        "18": {
            "varname": "huawei_dorado_disk_password_file",
            "caption": "Huawei Dorado Disk: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "ec76968b-7735-44bd-89d1-0eea25194552"
        },
        "19": {
            "varname": "huawei_dorado_disk_proxy",
            "caption": "Huawei Dorado Disk: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6d4b8637-d3b6-4399-b86a-490efbdb40ad"
        },
        "20": {
            "varname": "huawei_dorado_disk_scope",
            "caption": "Huawei Dorado Disk: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c47efb1f-3a9b-4476-8c0e-2f1d5f530025"
        },
        "21": {
            "varname": "huawei_dorado_disk_unused_disk_severity",
            "caption": "Huawei Dorado Disk: Unused Disk Severity",
            "description": "State to report for a disk that sits in the chassis without belonging to a pool. Worth raising on an array where every disk is meant to be in use, so a disk that silently dropped out of its pool is noticed.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_disk_unused_disk_severity_list"
            },
            "uuid": "cd4427bb-fea8-4a92-b710-5ab3e8b7d30d"
        },
        "22": {
            "varname": "huawei_dorado_disk_timeout",
            "caption": "Huawei Dorado Disk: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e9ac5392-e663-4d9a-a639-ea404495949c"
        },
        "23": {
            "varname": "huawei_dorado_disk_url",
            "caption": "Huawei Dorado Disk: URL",
