            "varname": "huawei_dorado_disk_warning_health_mark",
            "caption": "Huawei Dorado Disk: Warning Health Mark",
            "description": "WARN threshold for the health score of a disk, as a Nagios range. The appliance scores a disk from 0 to 100, where 100 is a disk with nothing wrong with it. Flash media report 255 instead, which is a \"not applicable\" marker and is never compared. Off by default, so an update cannot start alerting on a fleet nobody has looked at yet. 75: is what field practice suggests. Example: `--warning-health-mark=75:`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "205a0c80-dc8d-4e0f-a26e-cda9bbbc13ce"
        },
        "27": {
            "varname": "huawei_dorado_disk_warning_temperature",
            "caption": "Huawei Dorado Disk: Warning Temperature",
            "description": "WARN threshold in degrees Celsius. Off by default, because a healthy operating temperature depends on the drive model and on where the array stands. Example: `--warning-temperature=45`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "74854b6f-ec79-42db-a576-c689007e8b93"
