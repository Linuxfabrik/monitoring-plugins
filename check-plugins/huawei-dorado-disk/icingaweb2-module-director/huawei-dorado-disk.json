        "28": {
            "varname": "huawei_dorado_disk_warning_wear",
            "caption": "Huawei Dorado Disk: Warning Wear",
            "description": "WARN threshold for the wear of a disk, as a Nagios range in percent of its service life used up. Spinning media report -1 instead and are never compared. Off by default. Example: `--warning-wear=80`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
