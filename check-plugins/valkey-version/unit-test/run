"""Unit tests for the valkey-version check plugin.

The fixtures in `stdout/` are the raw `valkey-server --version`
outputs captured from the official `docker.io/valkey/valkey:<tag>`
images on Docker Hub. There is no Red Hat family Valkey container
yet, so we fall back to the upstream image. The plugin runs its
`r' v=(.*?) '` regex against each one. Note that the 7.2 line
starts with "Server v=" while 8.x and 9.x start with
"Valkey server v=" - both shapes are covered.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-valkey-7-2',
        'test': 'stdout/valkey-server-v7.2,,0',
        'assert-in': ['Valkey v7.2.12'],
    },
    {
        'id': 'parses-valkey-8-0',
        'test': 'stdout/valkey-server-v8.0,,0',
        'assert-in': ['Valkey v8.0.7'],
    },
    {
        'id': 'parses-valkey-8-1',
        'test': 'stdout/valkey-server-v8.1,,0',
        'assert-in': ['Valkey v8.1.6'],
    },
    {
        'id': 'parses-valkey-9-0',
        'test': 'stdout/valkey-server-v9.0,,0',
        'assert-in': ['Valkey v9.0.3'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Valkey not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../valkey-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
