import os
import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_WARN

# The expected timestamps below are local times in Europe/Zurich, and the plugin
# prints local time. Pin the zone so the result does not depend on the host the
# tests run on; the plugin inherits it.
os.environ['TZ'] = 'Europe/Zurich'

TESTS = [
    {
        'id': 'warn-backup-2021-06-17',
        'test': 'stdout/backup-2021-06-17,,',
        'assert-retc': STATE_WARN,
        'assert-in': ['Last Backup to [MAIL]user@example.ch at 2021-06-17 01:17:08 ('],
    },
]


class TestCheck(unittest.TestCase):
    check = '../starface-backup-status'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
