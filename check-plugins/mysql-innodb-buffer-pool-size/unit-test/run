# https://github.com/Linuxfabrik/monitoring-plugins/blob/main/CONTRIBUTING.md

"""Integration tests for the mysql-innodb-buffer-pool-size check plugin.

The plugin opens a real `pymysql` connection and reads
`innodb_buffer_pool_size` / `innodb_log_file_size` from
`SHOW VARIABLES`, plus InnoDB data length from
`information_schema.engine_status`. A static fixture cannot drive
it - we spin up an actual MariaDB server, boot it with a pinned
`innodb_buffer_pool_size=32M` so the assertion can target a
deterministic size, and let the plugin talk to it over TCP.

Per CONTRIBUTING's "Combine container tests with fixtures" rule,
this file holds only the happy-path integration test. A freshly
booted server with 32 MiB buffer pool and no user data has nothing
to miss, so the plugin returns STATE_OK. The first run only records
the buffer pool counters as a baseline, the second one reports the
miss ratio since the first.

The pool of such a server is mostly free, so it is reported with its
usage and not as full.

On MariaDB the same container then gets a table about four times the
size of the buffer pool, and the plugin has to tell the two workloads
apart that a size comparison cannot: a hot set that fits into the pool
(OK) and random lookups across the whole table (WARN). The table is
filled from the `seq` engine, which MySQL does not ship. With the table
loaded the pool has to count as full. Waits for a free page need
sessions that change pages faster than InnoDB frees them, which this
test does not produce; it asserts that reads alone cause none.

The test matrix is defined by the Containerfiles under
`containerfiles/`. Each file is a Containerfile (typically a
one-line `FROM`) and gets built once via testcontainers'
DockerImage (cached across runs). Add a new MariaDB LTS by
dropping in a new Containerfile; retire one by deleting the file.

Requirements:
- podman (or docker) with a reachable socket
- `pip install testcontainers`
- `tools/run-unit-tests` auto-sets `CONTAINER_HOST` and
  `TESTCONTAINERS_RYUK_DISABLED`
"""

import os
import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import sys
import time
import unittest

sys.path.insert(0, '..')

import pymysql

import lib.lftest
from lib.globals import STATE_OK, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
CONTAINERFILES_DIR = os.path.join(HERE, 'containerfiles')
CONTAINERFILES = sorted(
    name
    for name in os.listdir(CONTAINERFILES_DIR)
    if os.path.isfile(os.path.join(CONTAINERFILES_DIR, name))
)


# About 120 MiB of rows in front of the 32 MiB buffer pool.
WORKLOAD_ROWS = 300000
# The first rows, a few hundred pages, which fit into the buffer pool.
WORKLOAD_HOT_ROWS = 2000
WORKLOAD_LOOKUPS = 20000


class TestCheck(unittest.TestCase):
    pass


def _run_plugin(cmd):
    # The rate helper stores whole seconds, and two runs in the same second have
    # no interval to compute a rate over.
    time.sleep(2)
    print(f'Run plugin: {" ".join(cmd)}', flush=True)
    result = subprocess.run(  # nosec B603 - argv list, no shell
        cmd,
        cwd=os.path.dirname(os.path.abspath(__file__)),
        capture_output=True,
        text=True,
    )
    combined = result.stdout + result.stderr
    print(f'Script output:\n{combined.strip()}', flush=True)
    return result.returncode, combined


def _lookups(cursor, id_range):
    for i in range(WORKLOAD_LOOKUPS):
        # A fixed stride instead of random numbers keeps the test reproducible
        # and still spreads the lookups evenly over the range.
        cursor.execute('select pad from t where id = %s', (i * 7919 % id_range + 1,))
        cursor.fetchall()


def _check_workloads(test, defaults_file, cmd):
    conn = pymysql.connect(read_default_file=defaults_file, autocommit=True)
    try:
        with conn.cursor() as cursor:
            cursor.execute(
                'create table t (id int primary key, pad char(255)) engine=innodb'
            )
            cursor.execute(
                f"insert into t select seq, repeat('x', 255)"  # nosec B608 - constant
                f' from seq_1_to_{WORKLOAD_ROWS}'
            )
            # Warm up the hot set, then measure it on its own.
            _lookups(cursor, WORKLOAD_HOT_ROWS)
            _run_plugin(cmd)
            _lookups(cursor, WORKLOAD_HOT_ROWS)
            retc, combined = _run_plugin(cmd)
            test.assertEqual(retc, STATE_OK)
            test.assertRegex(combined, r'Buffer pool miss ratio: \d+\.\d% since')
            # four times its size went through the pool, so it is down to the
            # reserve of free pages InnoDB keeps
            test.assertRegex(
                combined,
                r'`innodb_buffer_pool_size`\s*\(32\.0+\s*MiB, full, \d+\.\d% in use\)',
            )
            test.assertNotIn('Sessions found no free page', combined)

            _lookups(cursor, WORKLOAD_ROWS)
            retc, combined = _run_plugin(cmd)
            test.assertEqual(retc, STATE_WARN)
            test.assertRegex(
                combined, r'Buffer pool miss ratio: \d+\.\d% since.*\[WARNING\]'
            )
    finally:
        conn.close()


def _check_image(test, containerfile):
    lib.lftest.require_container_runtime()
    path = os.path.join(CONTAINERFILES_DIR, containerfile)
    print(f'\n=== Testing {containerfile} ===', flush=True)
    with lib.lftest.run_mysql_compatible_from_containerfile(
        path,
        # Pin only the buffer pool so the assertion can target a
        # deterministic 32 MiB. The log/redo size is left at the image
        # default on purpose: `--innodb-log-file-size` was removed in
        # MySQL 9.3.0, so pinning it would break that container's boot,
        # and the plugin no longer evaluates the log-size-to-buffer-pool
        # ratio anyway.
        # The reserve of free pages InnoDB keeps is `innodb_lru_scan_depth`,
        # by default 1536 of the 2028 pages a pool of this size has on
        # MariaDB. With that the pool settles anywhere between 24% and 55% in
        # use, and whether it is full cannot be told. A reserve of 256 pages
        # lets it fill up as a pool of a realistic size does.
        extra_args='--innodb-buffer-pool-size=33554432 --innodb-lru-scan-depth=256',
    ) as (_container, defaults_file):
        cmd = [
            'python3',
            '../mysql-innodb-buffer-pool-size',
            f'--defaults-file={defaults_file}',
        ]
        for _run in ('baseline', 'interval'):
            retc, combined = _run_plugin(cmd)
            test.assertEqual(retc, STATE_OK)
            # an empty server leaves most of the pool free, so it is not "full"
            test.assertRegex(
                combined,
                r'`innodb_buffer_pool_size`\s*\(32\.0+\s*MiB, \d+\.\d% in use\)',
            )
            test.assertIn('mysql_innodb_buffer_pool_pct_used', combined)
        # Every container gets its own temporary defaults file, and the plugin
        # keeps one baseline per defaults file, so the second run always has one.
        test.assertRegex(
            combined,
            r'Buffer pool miss ratio: (\d+\.\d% since|no page requests)',
        )

        if containerfile.startswith('mariadb-'):
            _check_workloads(test, defaults_file, cmd)


lib.lftest.attach_each(TestCheck, CONTAINERFILES, _check_image)


if __name__ == '__main__':
    unittest.main()
