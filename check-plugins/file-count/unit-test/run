import sys

sys.path.insert(0, '..')  # Adds higher directory to python modules path.


import os
import tempfile
import unittest

import lib.base
import lib.shell
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN


def tmpdir_with_files(count):
    """A directory holding `count` empty files."""
    tmpdir = tempfile.mkdtemp()
    for i in range(count):
        with open(os.path.join(tmpdir, f'file{i}.log'), 'wb'):
            pass
    return tmpdir


class TestCheck(unittest.TestCase):
    def _run(self, filename, *extra):
        cmd = ['../file-count', '--filename', filename, *extra]
        stdout, stderr, retc = lib.base.coe(lib.shell.shell_exec(cmd))
        self.assertEqual(stderr, '')
        return stdout, retc

    def test_ok_without_a_threshold_nothing_is_named(self):
        tmpdir = tmpdir_with_files(3)
        stdout, retc = self._run(f'{tmpdir}/*.log')
        self.assertEqual(retc, STATE_OK)
        self.assertIn('Found 3 matching files', stdout)
        self.assertNotIn(' in (', stdout)

    def test_ok_names_the_range_the_count_stayed_within(self):
        tmpdir = tmpdir_with_files(3)
        stdout, retc = self._run(f'{tmpdir}/*.log', '--warning', '5')
        self.assertEqual(retc, STATE_OK)
        self.assertIn('Found 3 matching files, in (0..5)', stdout)

    def test_warn_names_the_range_the_count_broke(self):
        tmpdir = tmpdir_with_files(3)
        stdout, retc = self._run(f'{tmpdir}/*.log', '--warning', '2')
        self.assertEqual(retc, STATE_WARN)
        self.assertIn('not in (0..2) [WARNING]', stdout)

    def test_crit_wins_over_warn(self):
        tmpdir = tmpdir_with_files(3)
        stdout, retc = self._run(f'{tmpdir}/*.log', '--warning', '1', '--critical', '2')
        self.assertEqual(retc, STATE_CRIT)
        self.assertIn('not in (0..2) [CRITICAL]', stdout)
        self.assertNotIn('[WARNING]', stdout)

    def test_a_lower_bound_alerts_on_too_few_files(self):
        tmpdir = tmpdir_with_files(3)
        stdout, retc = self._run(f'{tmpdir}/*.log', '--warning', '5:')
        self.assertEqual(retc, STATE_WARN)
        self.assertIn('Found 3 matching files, not in (5..inf) [WARNING]', stdout)

    def test_an_empty_glob_counts_nothing(self):
        tmpdir = tempfile.mkdtemp()
        stdout, retc = self._run(f'{tmpdir}/*.log', '--warning', '5')
        self.assertEqual(retc, STATE_OK)
        self.assertIn('Found 0 matching files', stdout)


if __name__ == '__main__':
    unittest.main()
