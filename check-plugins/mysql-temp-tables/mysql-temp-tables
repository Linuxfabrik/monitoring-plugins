"""See the check's README for more details."""

import argparse
import sys

import lib.args
import lib.base
import lib.db_mysql
import lib.db_sqlite
import lib.human
from lib.globals import STATE_OK, STATE_UNKNOWN

__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026111301'

DESCRIPTION = """Reports the percentage of MySQL/MariaDB temporary tables that were created on disk
(`Created_tmp_disk_tables` divided by `Created_tmp_tables`). A temporary table goes to disk when it
outgrows the smaller of `tmp_table_size` and `max_heap_table_size`, but on MariaDB also at any size
when it holds a `TEXT` or `BLOB` column, which includes many `information_schema` queries. The
counters cannot tell the two apart, so the percentage is a tuning hint for databases whose queries
the admin controls, not an operational state. Alerts only when `--warning` / `--critical` are
given, and not during the first hour of uptime, because the percentage is a lifetime average over
only a handful of queries then."""

DEFAULT_DEFAULTS_FILE = '/var/spool/icinga2/.my.cnf'
DEFAULT_DEFAULTS_GROUP = 'client'
# mysqltuner flags more than 25% temp tables on disk. Here the percentage is
# only reported unless `--warning` / `--critical` ask for it: the global
# counters mix temp tables that outgrow the limits with those that go to disk
# at any size (`TEXT`/`BLOB` columns, `information_schema`). Measured on a
# Nextcloud host (MariaDB 11.4): 85% of the disk temp tables came from the
# monitoring user's and mariadb-dump's `information_schema` queries, and the
# processlist query still went to disk with both limits at 1 GiB. Following
# mysqltuner's "raise the limits" advice there only grew the peak memory,
# since every connection may hold such a temp table.
DEFAULT_WARN = None
DEFAULT_CRIT = None
DEFAULT_TIMEOUT = 3

# Below this uptime we skip the percentage alert because it is a lifetime
# average over only a handful of queries (same window as `mysql-table-cache`
# and `mysql-thread-cache`).
WARMUP_UPTIME_SECONDS = 3600

SQLITE_DB = 'linuxfabrik-monitoring-plugins-mysql-temp-tables.db'


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '-c',
        '--critical',
        help=lib.args.help('--critical') + ' Supports Nagios ranges. '
        'Example: `--critical=50`. '
        'Default: not evaluated, the percentage is only reported.',
        dest='CRIT',
        default=DEFAULT_CRIT,
    )

    parser.add_argument(
        '--defaults-file',
        help='MySQL/MariaDB cnf file to read user, host and password from. '
        'Example: `--defaults-file=/var/spool/icinga2/.my.cnf`. '
        'Default: %(default)s',
        dest='DEFAULTS_FILE',
        default=DEFAULT_DEFAULTS_FILE,
    )

    parser.add_argument(
        '--defaults-group',
        help=lib.args.help('--defaults-group') + ' Default: %(default)s',
        dest='DEFAULTS_GROUP',
        default=DEFAULT_DEFAULTS_GROUP,
    )

    parser.add_argument(
        '--no-perfdata',
        help=lib.args.help('--no-perfdata'),
        dest='NO_PERFDATA',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--timeout',
        help=lib.args.help('--timeout') + ' Default: %(default)s (seconds)',
        dest='TIMEOUT',
        type=int,
        default=DEFAULT_TIMEOUT,
    )

    parser.add_argument(
        '-w',
        '--warning',
        help=lib.args.help('--warning') + ' Supports Nagios ranges. '
        'Example: `--warning=25`. '
        'Default: not evaluated, the percentage is only reported.',
        dest='WARN',
        default=DEFAULT_WARN,
    )

    args, _ = parser.parse_known_args()
    return args


def get_vars(conn):
    sql = """
        show global variables
        where variable_name like 'max_heap_table_size'
            or variable_name like 'tmp_table_size'
            ;
          """
    return lib.base.coe(lib.db_mysql.select(conn, sql))


def get_status(conn):
    sql = """
        show global status
        where variable_name like 'Created_tmp_disk_tables'
            or variable_name like 'Created_tmp_tables'
            or variable_name like 'Uptime'
            ;
          """
    return lib.base.coe(lib.db_mysql.select(conn, sql))


def main():
    """The main function. This is where the magic happens."""

    # logic taken from mysqltuner.pl:mysql_stats(), section "Temporary tables"
    # (percentage and `max_tmp_table_size` formula). Deliberately not taken
    # over: the default 25% alert and the advice to raise the limits towards
    # 256 MiB, see DEFAULT_WARN.

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)

    # fetch data
    mysql_connection = {
        'defaults_file': args.DEFAULTS_FILE,
        'defaults_group': args.DEFAULTS_GROUP,
        'timeout': args.TIMEOUT,
    }
    conn = lib.base.coe(lib.db_mysql.connect(mysql_connection))
    lib.base.coe(lib.db_mysql.check_privileges(conn))

    myvar = lib.db_mysql.lod2dict(get_vars(conn))
    mystat = lib.db_mysql.lod2dict(get_status(conn))
    lib.db_mysql.close(conn)

    # init some vars
    state = STATE_OK
    sections = []
    facts = []
    # All recommendations from all WARN/CRIT paths land here and render once
    # at the end as a `Recommendations:\n* ...` bulleted block.
    recommendations = []
    perfdata = ''

    created_tmp_tables = int(mystat['Created_tmp_tables'])
    created_tmp_disk_tables = int(mystat['Created_tmp_disk_tables'])
    uptime = int(mystat.get('Uptime') or 0)
    warming_up = uptime < WARMUP_UPTIME_SECONDS
    evaluated = bool(args.WARN or args.CRIT)
    tmp_table_size = int(myvar['tmp_table_size'])
    max_heap_table_size = int(myvar['max_heap_table_size'])
    # The effective in-memory limit for an internal temp table is the
    # smaller of `tmp_table_size` and `max_heap_table_size`; once a single
    # temp table exceeds it, MySQL/MariaDB spills the table to disk
    # (MySQL Reference Manual on `tmp_table_size`; MariaDB Knowledge Base
    # on `tmp_table_size`). mysqltuner's `max_tmp_table_size` calculation
    # in `mysqltuner.pl:mysql_stats()` mirrors that with `MIN(...)`.
    effective_cap = min(tmp_table_size, max_heap_table_size)

    # analyze data
    # On a freshly booted server with no traffic `Created_tmp_tables` can be
    # zero; mysqltuner pins the percentage to 0 in that case to avoid the
    # false-positive low-rate alert.
    pct_temp_disk = (
        round(created_tmp_disk_tables / created_tmp_tables * 100, 1)
        if created_tmp_tables > 0
        else 0.0
    )

    # The `Created_tmp_tables > 0` guard mirrors mysqltuner: on a server that
    # has not yet materialised a single temporary table the percentage is
    # meaningless.
    # mysqltuner does not skip a freshly booted server; we do (Linuxfabrik
    # addition): right after a restart the lifetime percentage rests on a few
    # hundred temp tables (seen: 140 on disk / 453 total = 30.9% -> WARN, gone
    # after 44 minutes).
    if created_tmp_tables > 0 and evaluated and not warming_up:
        state = lib.base.get_state(
            pct_temp_disk,
            args.WARN,
            args.CRIT,
            _operator='range',
        )
        if state != STATE_OK:
            # MariaDB puts a temp table with a BLOB or TEXT column on disk at any
            # size (create_tmp_table() in sql/sql_select.cc, 11.8), so the limits
            # only help if that is not the cause. sys.statements_with_temp_tables
            # refuses a plain monitoring account with ERROR 1356, the tables below
            # do not.
            recommendations.append(
                'Find the queries behind this first: `SELECT DIGEST_TEXT, '
                'COUNT_STAR, SUM_CREATED_TMP_DISK_TABLES FROM '
                'performance_schema.events_statements_summary_by_digest ORDER '
                'BY SUM_CREATED_TMP_DISK_TABLES DESC LIMIT 10;`, and the users '
                'behind it: `SELECT USER, SUM(SUM_CREATED_TMP_DISK_TABLES) FROM '
                'performance_schema.events_statements_summary_by_user_by_event_name '
                'GROUP BY USER;`'
            )
            recommendations.append(
                'A query with as many disk tables as executions reads a `TEXT` '
                'or `BLOB` column or `information_schema`, including the queries '
                'of monitoring checks and backups. MariaDB puts such a temp table '
                'on disk at any size, so raising `tmp_table_size` and '
                '`max_heap_table_size` does not help there'
            )
            recommendations.append(
                f'Raise `tmp_table_size` (currently '
                f'{lib.human.bytes2human(tmp_table_size)}) and '
                f'`max_heap_table_size` (currently '
                f'{lib.human.bytes2human(max_heap_table_size)}) only for queries '
                f'with fewer disk tables than executions, both to the same value '
                f'just above their largest temp table. Every connection may hold '
                f'such a temp table, so the limit counts `max_connections` times '
                f'in the peak memory (see the mysql-memory check)'
            )
            recommendations.append(
                'Audit `SELECT DISTINCT` and `GROUP BY` queries that run '
                'without a `LIMIT` clause; those are the classic source of '
                'oversized temporary tables'
            )

    # build the message
    if created_tmp_tables > 0:
        facts.append(
            f'Temporary tables created on disk: {pct_temp_disk}% '
            f'({lib.human.number2human(created_tmp_disk_tables)} on disk '
            f'/ {lib.human.number2human(created_tmp_tables)} total)'
            f'{lib.base.state2str(state, prefix=" ")}'
        )
        if evaluated and warming_up:
            facts.append(
                f'Server is warming up (uptime {lib.human.seconds2human(uptime)}'
                f' < 1 h); percentage alert suppressed'
            )
    else:
        facts.append(
            'No temporary tables created yet (`Created_tmp_tables` = 0); '
            'percentage check skipped'
        )
    facts.append(
        f'`tmp_table_size` = {lib.human.bytes2human(tmp_table_size)}, '
        f'`max_heap_table_size` = '
        f'{lib.human.bytes2human(max_heap_table_size)}'
    )
    facts_text = '. '.join(facts) + '.'
    if state == STATE_OK:
        sections.append('Everything is ok. ' + facts_text)
    else:
        sections.append(facts_text)
    if recommendations:
        sections.append(
            'Recommendations:\n' + '\n'.join(f'* {r}' for r in recommendations)
        )
    msg = '\n\n'.join(sections)

    perfdata += lib.base.get_perfdata(
        'mysql_max_heap_table_size',
        max_heap_table_size,
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_tmp_table_size',
        tmp_table_size,
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_max_tmp_table_size',
        effective_cap,
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_pct_temp_disk',
        pct_temp_disk,
        uom='%',
        warn=args.WARN,
        crit=args.CRIT,
        _min=0,
        _max=100,
    )

    # Per-CONTRIBUTING: emit the cumulative counters as per-second deltas
    # (computed in-plugin against a local SQLite cache) instead of `uom='c'`
    # continuous counters that force Grafana to do non_negative_difference()
    # per panel.
    rates = lib.db_sqlite.per_second_deltas(
        SQLITE_DB,
        'mysql-temp-tables',
        {
            'created_tmp_disk_tables': created_tmp_disk_tables,
            'created_tmp_tables': created_tmp_tables,
        },
    )
    if rates is not None:
        perfdata += lib.base.get_perfdata(
            'mysql_created_tmp_disk_tables_per_second',
            round(rates['created_tmp_disk_tables'], 2),
            _min=0,
        )
        perfdata += lib.base.get_perfdata(
            'mysql_created_tmp_tables_per_second',
            round(rates['created_tmp_tables'], 2),
            _min=0,
        )

    # over and out
    lib.base.oao(
        msg, state, perfdata, always_ok=args.ALWAYS_OK, no_perfdata=args.NO_PERFDATA
    )


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
