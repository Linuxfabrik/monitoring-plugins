            "varname": "ntp_chronyd_stratum",
            "caption": "NTP Chronyd: Stratum",
            "description": "Warns if the stratum of this host is greater than or equal to this value. Stratum 1 indicates a computer with a locally attached reference clock. A computer that is synchronised to a stratum 1 computer is at stratum 2. A computer that is synchronised to a stratum 2 computer is at stratum 3, and so on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
