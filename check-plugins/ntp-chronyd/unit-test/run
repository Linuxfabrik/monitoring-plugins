import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_WARN

TESTS = [
    {
        'id': 'warn-no-server-reachable',
        'test': 'stdout/no-server-reachable,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'NTP server not reachable. No NTP server is used.',
            'MS Name/IP address         Stratum Poll Reach LastRx Last sample               ',
            '===============================================================================',
            '^? 192.0.2.1                     0   7     0     -',
        ],
    },
    {
        'id': 'ok-stratum-3-synced',
        'test': 'stdout/stratum-3-synced,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            'NTP offset is -2.589ms, Stratum is 3, Leap status is Normal',
            'Reference ID    : D42D9003',
            'Stratum         : 3',
        ],
    },
    {
        # chronyd is not running. chronyc says so on stdout and exits 1; captured
        # from chrony 4.1 on openSUSE Leap 15.5.
        'id': 'warn-chronyd-not-running',
        'test': 'stdout/chronyd-not-running,,1',
        'assert-retc': STATE_WARN,
        'assert-in': ['`chronyc tracking` failed (exit 1): 506 Cannot talk to daemon'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../ntp-chronyd'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
