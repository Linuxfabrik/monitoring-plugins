            "uuid": "d3e5e84d-315a-4e41-9e09-2724e71d4611"
        },
        "4": {
            "varname": "huawei_dorado_host_ignore",
            "caption": "Huawei Dorado Host: Ignore",
            "description": "Skip hosts. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `NAME`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b1eca47d-6121-40c4-a608-70b91abc15d4"
        },
        "5": {
            "varname": "huawei_dorado_host_insecure",
            "caption": "Huawei Dorado Host: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2c291265-29d8-4c61-a6be-bbd5ff90ffd0"
        },
        "6": {
            "varname": "huawei_dorado_host_no_insecure",
            "caption": "Huawei Dorado Host: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fe9fac5a-3bea-4d85-bd31-c38442037b6e"
        },
        "7": {
            "varname": "huawei_dorado_host_match",
            "caption": "Huawei Dorado Host: Match",
            "description": "Filter by hosts. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `NAME`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1ec911d6-37c4-43d5-8eee-0849b11da233"
        },
        "8": {
            "varname": "huawei_dorado_host_no_match_severity",
            "caption": "Huawei Dorado Host: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_host_no_match_severity_list"
            },
            "uuid": "b63a52e7-d25c-432a-be58-b7bf16859432"
        },
        "9": {
            "varname": "huawei_dorado_host_no_perfdata",
            "caption": "Huawei Dorado Host: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fb962b02-a19b-4cbe-aa14-252f0fd0a2a1"
        },
        "10": {
