import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'warn-hosts-one-warning',
        'test': 'stdout/hosts-one-warning,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings.',
            # Column widths follow the widest value in each column, so the header is
            # asserted per column rather than as one fixed-width line. `Location` is
            # not among them: no host in this listing carries one, so the column is
            # left out instead of printed as a wall of hyphens.
            'UUID',
            'Name',
            'OS',
            'Allocated',
            'Health',
            'Running',
            '21:1  ! host1     ! Solaris',
            '21:2  ! host2     ! Linux',
            '21:0  ! site01-01 ! VMware ESX',
            '21:11 ! site02-06 ! VMware ESX',
            '[WARNING]',
            # The allocated capacity is a sector count in the response and is shown
            # in bytes. 54858341776 sectors of 512 bytes is about 25 TiB.
            '21:0  ! site01-01 ! VMware ESX ! 25.5TiB',
            "'hosts'=14;;;0 'hosts_not_ok'=1;;;0",
        ],
        # The performance data summarizes the hosts instead of graphing each one.
        'assert-not-in': [
            "'21_",
            '_allocated_capacity',
            '_health_status',
            '_running_status',
        ],
    },
    {
        # A host that is still configured on the array but whose server is gone reports
        # health status 18 (Offline), and the array raises no alarm for it. Record taken
        # from a Dorado 6000 V6, V700R001C10SPH128.
        'id': 'warn-host-offline-by-default',
        'test': 'stdout/hosts-one-offline,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings.',
            'Offline (18) ! Normal (1) ! [WARNING]',
            "'hosts'=2;;;0 'hosts_not_ok'=1;;;0",
        ],
    },
    {
        'id': 'crit-host-offline-severity-crit',
        'test': 'stdout/hosts-one-offline,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin '
        '--host-offline-severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            'Offline (18) ! Normal (1) ! [CRITICAL]',
        ],
    },
    {
        'id': 'ok-host-offline-severity-ok',
        'test': 'stdout/hosts-one-offline,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin '
        '--host-offline-severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Offline (18) ! Normal (1) ! [OK]',
            # A host whose state is set to OK is not counted as not OK.
            "'hosts'=2;;;0 'hosts_not_ok'=0;;;0",
        ],
    },
    {
        # `--host-offline-severity` only covers "Offline". A host without a redundant
        # link (17) still warns when offline hosts are set to OK.
        'id': 'warn-host-offline-severity-leaves-other-codes',
        'test': 'stdout/hosts-one-warning,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin '
        '--host-offline-severity=ok',
        'assert-retc': STATE_WARN,
        'assert-in': ['Single link / No redundant link (17) ! Normal (1) ! [WARNING]'],
    },
    {
        # An appliance may legitimately have no hosts configured. Without a filter
        # that is a healthy reading, not a query that went wrong.
        'id': 'ok-no-hosts-configured',
        'test': 'stdout/no-hosts,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['No hosts configured.'],
    },
    {
        'id': 'warn-no-match',
        'test': 'stdout/hosts-one-warning,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin '
        '--match=NOSUCHHOST --no-match-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['No hosts matched `NOSUCHHOST`.'],
    },
    {
        # The appliance reports success as the string '0' on some endpoints. Reading
        # that as an error used to take the whole check to UNKNOWN.
        'id': 'ok-success-code-as-string',
        'test': 'stdout/hosts-success-code-as-string,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
    },
    {
        'id': 'unknown-api-error',
        'test': 'stdout/api-error,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['the hosts', '-401'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-host'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
