import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        'id': 'ok-fans-healthy',
        'test': 'stdout/fans-healthy,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'UUID            ! Location      ! Runlevel   ! Health     ! Running     ! State',
            '----------------+---------------+------------+------------+-------------+------',
            '211:211.0.0.00  ! CTE0.A.FAN0   ! normal (1) ! Normal (1) ! Running (2) ! [OK] ',
            '211:211.0.0.01  ! CTE0.A.FAN1   ! normal (1) ! Normal (1) ! Running (2) ! [OK] ',
            '211:211.0.0.02  ! CTE0.A.FAN2   ! normal (1) ! Normal (1) ! Running (2) ! [OK] ',
            "'fans'=53;;;0 'fans_not_ok'=0;;;0",
        ],
        # The performance data summarizes the fans instead of graphing each one.
        'assert-not-in': [
            "'211_",
            '_health_status',
            '_run_level',
            '_running_status',
        ],
    },
    {
        # An appliance always has fans. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-fans',
        'test': 'stdout/no-fans,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no fans.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-fan'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
