    "Datafield": {
        "1": {
            "varname": "lvm_volume_groups_always_ok",
            "caption": "Lvm Volume Groups: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7cb9fdf2-2b9e-4f77-a029-1911fc96cadc"
        },
        "2": {
            "varname": "lvm_volume_groups_brief",
            "caption": "Lvm Volume Groups: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "45dd3416-097b-4c96-a2c6-934b47b72c68"
        },
        "3": {
            "varname": "lvm_volume_groups_critical",
            "caption": "Lvm Volume Groups: Critical",
            "description": "CRIT threshold for how much of a volume group is handed out to logical volumes, in percent. Not set by default, because a volume group with every extent in use is a normal state and not a fault; set it where free space has to be kept for a thin pool or a snapshot to grow into. Supports Nagios ranges. Example: `--critical=95` keeps a twentieth of the group free for a pool or a snapshot to grow into.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2e9c124f-d802-4054-b1d0-59417ccb6171"
        },
        "4": {
            "varname": "lvm_volume_groups_ignore",
            "caption": "Lvm Volume Groups: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d1e8dddd-6d41-4cad-979b-ac6f8bd7f4c5"
        },
        "5": {
            "varname": "lvm_volume_groups_match",
            "caption": "Lvm Volume Groups: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "55739254-950a-4c25-a304-df897b213330"
        },
        "6": {
            "varname": "lvm_volume_groups_no_match_severity",
            "caption": "Lvm Volume Groups: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "lvm_volume_groups_no_match_severity_list"
            },
            "uuid": "8e3f3132-7b3f-43d8-b3a1-a3a6397dba31"
        },
        "7": {
            "varname": "lvm_volume_groups_no_perfdata",
            "caption": "Lvm Volume Groups: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "20991274-9076-4fca-bc21-0e7ba18e5dbb"
        },
