"""Unit tests for the mysql-logfile check plugin.

The plugin's parser (severity detection, ignore filters, output structure) can
be exercised purely against static log fixtures via the `--server-log` flag, so
these tests do not need a running MySQL/MariaDB server. The
`performance_schema.error_log` path requires a real MySQL 8.0.22+ server and is
not covered here; it should be tested with a container fixture instead, once
testcontainers ships a suitable MySQL 8 image.
"""

import importlib.machinery
import importlib.util
import os
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

FIXTURES_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'fixtures')
PLUGIN = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'mysql-logfile')


def fixture(name):
    return os.path.join(FIXTURES_DIR, name)


def _load_plugin_module():
    """Import the hyphen-named plugin as a Python module for direct function
    unit tests."""
    loader = importlib.machinery.SourceFileLoader('mysql_logfile', PLUGIN)
    spec = importlib.util.spec_from_loader('mysql_logfile', loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


mysql_logfile = _load_plugin_module()


CASES = [
    {
        'id': 'ok-no-errors-no-warnings',
        'fixture': 'sample-ok.txt',
        'extra': [],
        'retc': STATE_OK,
        'assert_in': [
            'No errors found',
            'No warnings found',
            '1 startup detected',
            'No shutdowns detected',
        ],
        'assert_not_in': [
            'Recommendations:',
        ],
    },
    {
        'id': 'warn-one-warning',
        'fixture': 'sample-warning.txt',
        'extra': [],
        'retc': STATE_WARN,
        'assert_in': [
            '1 warning found',
            '[WARNING]',
            'Recommendations:',
            'Check the warning in',
        ],
    },
    {
        'id': 'crit-one-error-one-warning',
        'fixture': 'sample-error.txt',
        'extra': [],
        'retc': STATE_CRIT,
        'assert_in': [
            '1 error found',
            '2 warnings found',
            '[CRITICAL]',
            'Errors:',
            'Warnings:',
            'Recommendations:',
            'Check the error in',
            'Check the warnings in',
        ],
    },
    {
        'id': 'ok-tracks-startups-and-shutdowns',
        'fixture': 'sample-restarts.txt',
        'extra': [],
        'retc': STATE_OK,
        'assert_in': [
            'No errors found',
            'No warnings found',
            '3 startups detected',
            '2 shutdowns detected',
            'Startups:',
            'Shutdowns:',
        ],
    },
    {
        'id': 'ok-bracket-tag-only-no-false-positives',
        'fixture': 'sample-bracket-tag-only.txt',
        'extra': [],
        'retc': STATE_OK,
        'assert_in': [
            'No errors found',
            'No warnings found',
        ],
        # The fixture contains the words "errors" / "warnings" in [Note] lines.
        # Old substring-match would have flagged them; the bracket-tag match
        # must not.
        'assert_not_in': [
            '[CRITICAL]',
            '[WARNING]',
        ],
    },
    {
        'id': 'warn-ignore-pattern-suppresses-warning',
        'fixture': 'sample-warning.txt',
        'extra': ['--ignore-pattern', 'self signed'],
        'retc': STATE_OK,
        'assert_in': ['No warnings found'],
    },
    {
        'id': 'warn-ignore-regex-suppresses-warning',
        'fixture': 'sample-error.txt',
        'extra': ['--ignore-regex', r'sha256_password'],
        'retc': STATE_CRIT,  # error still present
        'assert_in': ['1 warning found'],  # one of two warnings was filtered
    },
    {
        # The counters of offending lines alert from their first hit on, so their
        # warn field is `0` ("outside 0..0"); the log size carries the 32 MiB
        # cutoff the check really warns at, and the lifecycle counters none.
        'id': 'crit-perfdata-carries-the-thresholds',
        'fixture': 'sample-error.txt',
        'extra': [],
        'retc': STATE_CRIT,
        'assert_in': [
            "'mysql_error_lines'=1;0;;0",
            "'mysql_warning_lines'=2;0;;0",
            "'mysql_logfile_size'=467B;33554432;;0",
            "'mysql_startups'=1;;;0",
            "'mysql_shutdowns'=0;;;0",
        ],
    },
    {
        # logrotate moved the older half of the log aside; without reading it the
        # startup would have disappeared from the report the moment it did.
        # Exactly one predecessor on purpose: git stores no modification times,
        # so a fresh clone stamps every fixture with the checkout time and the
        # order of several of them would be whatever the filesystem said.
        'id': 'crit-reads-across-the-rotation',
        'fixture': 'rotated/mysqld.err',
        'extra': [],
        'retc': STATE_CRIT,
        'assert_in': [
            'Read 5 lines from ',
            # the predecessor is named, so the fact says where they came from
            'mysqld.err.1`',
            '1 startup detected',
            '1 error found',
            '2 warnings found',
        ],
    },
    {
        # A run against one account from one host, taken off MariaDB 11.8. The
        # `[Warning]` these carry no longer counts as a warning of the server's,
        # because a mistyped password is not the server being unwell.
        'id': 'ok-denied-logins-are-counted-per-source',
        'fixture': 'mariadb-denied-logins.txt',
        'extra': ['--lookback', '31536000'],
        'retc': STATE_OK,
        'assert_in': [
            '4 denied logins from localhost in the last',
            '(7 in total from 2 addresses)',
            'No warnings found',
        ],
    },
    {
        'id': 'warn-a-run-against-one-account-reaches-the-threshold',
        'fixture': 'mariadb-denied-logins.txt',
        'extra': ['--lookback', '31536000', '--access-denied-warning', '4'],
        'retc': STATE_WARN,
        'assert_in': [
            '4 denied logins from localhost',
            'which is what a guessing run against a database account looks like',
        ],
    },
    {
        # Without the split by source the seven of them count together, which is
        # what `--no-per-source` is for.
        'id': 'warn-no-per-source-judges-the-total',
        'fixture': 'mariadb-denied-logins.txt',
        'extra': [
            '--lookback',
            '31536000',
            '--no-per-source',
            '--access-denied-warning',
            '7',
        ],
        'retc': STATE_WARN,
        'assert_in': ['7 denied logins in the last'],
    },
    {
        'id': 'ok-the-threshold-can-be-switched-off',
        'fixture': 'mariadb-denied-logins.txt',
        'extra': [
            '--lookback',
            '31536000',
            '--access-denied-warning',
            '0',
            '--access-denied-critical',
            '0',
        ],
        'retc': STATE_OK,
    },
    {
        'id': 'ok-match-drops-everything',
        'fixture': 'sample-error.txt',
        'extra': ['--match', 'nothing-in-this-log-matches-this'],
        'retc': STATE_OK,
        'assert_in': ['Nothing checked: `--match` dropped all'],
    },
    {
        'id': 'unknown-match-drops-everything-with-severity',
        'fixture': 'sample-error.txt',
        'extra': [
            '--match',
            'nothing-in-this-log-matches-this',
            '--no-match-severity=unknown',
        ],
        'retc': STATE_UNKNOWN,
        'assert_in': ['Nothing checked'],
    },
    {
        'id': 'always-ok-masks-crit',
        'fixture': 'sample-error.txt',
        'extra': ['--always-ok'],
        'retc': STATE_OK,
        'assert_in': ['[CRITICAL]'],
    },
]


class TestCheck(unittest.TestCase):
    pass


def _make_test(case):
    def _test(self):
        cmd = [PLUGIN, f'--server-log={fixture(case["fixture"])}', *case['extra']]
        result = subprocess.run(cmd, capture_output=True, text=True, check=False)
        combined = result.stdout + result.stderr
        self.assertEqual(
            result.returncode,
            case['retc'],
            f'expected retc {case["retc"]}, got {result.returncode}.'
            f'\nOutput: {combined}',
        )
        for needle in case.get('assert_in', []):
            self.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
        for needle in case.get('assert_not_in', []):
            self.assertNotIn(
                needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
            )

    return _test


for _case in CASES:
    _method = 'test_' + _case['id'].replace('-', '_')
    setattr(TestCheck, _method, _make_test(_case))


class TestIcingaCallback(unittest.TestCase):
    """The acknowledgement callback needs all four connection parameters, and
    says so instead of failing halfway through the run."""

    def test_callback_without_credentials_is_refused(self):
        cmd = [
            PLUGIN,
            f'--server-log={fixture("sample-error.txt")}',
            '--icinga-callback',
        ]
        result = subprocess.run(cmd, capture_output=True, text=True, check=False)
        combined = result.stdout + result.stderr
        self.assertEqual(result.returncode, STATE_UNKNOWN, combined)
        self.assertIn('`--icinga-callback` requires', combined)

    def test_callback_is_not_reached_on_a_clean_log(self):
        # nothing to acknowledge means no call to the monitoring server, so an
        # unreachable one must not turn a healthy check into a failure
        cmd = [
            PLUGIN,
            f'--server-log={fixture("sample-ok.txt")}',
            '--icinga-callback',
            '--icinga-url=https://monitoring.example.invalid:5665',
            '--icinga-username=username',
            '--icinga-password=linuxfabrik',
            '--icinga-service-name=host!service',
            '--timeout=1',
        ]
        result = subprocess.run(cmd, capture_output=True, text=True, check=False)
        combined = result.stdout + result.stderr
        self.assertEqual(result.returncode, STATE_OK, combined)
        self.assertNotIn('acknowledgement', combined)


class TestPathConfinement(unittest.TestCase):
    """A --server-log that resolves outside /var/log and /var/lib/mysql (here a
    /tmp scratch file) is refused, so a root-run plugin cannot be turned into an
    arbitrary file read (GHSA-f54c-p5vg-mr5c)."""

    def setUp(self):
        self.scratch_dir = tempfile.mkdtemp(prefix='mysql-logfile-confine-')
        self.scratch_file = os.path.join(self.scratch_dir, 'error.log')
        with open(self.scratch_file, 'w', encoding='utf-8') as handle:
            handle.write('2026-07-08T00:00:00 [ERROR] secret\n')

    def tearDown(self):
        shutil.rmtree(self.scratch_dir, ignore_errors=True)

    def test_server_log_outside_allowed_roots_is_refused(self):
        cmd = [PLUGIN, f'--server-log={self.scratch_file}']
        result = subprocess.run(cmd, capture_output=True, text=True, check=False)
        combined = result.stdout + result.stderr
        self.assertEqual(result.returncode, STATE_UNKNOWN, combined)
        self.assertIn('Refusing to read', combined)
        self.assertNotIn('secret', combined)


class TestSourceAddress(unittest.TestCase):
    """Which host a denied login is counted under."""

    def test_the_host_the_server_names(self):
        for source, expected in (
            ('198.51.100.7', '198.51.100.7'),
            # The same client, written the two ways a dual-stack server writes it.
            ('::ffff:198.51.100.7', '198.51.100.7'),
            ('2001:DB8::1', '2001:db8::1'),
            # A name is all the server resolved it to, and is kept as it stands.
            ('localhost', 'localhost'),
        ):
            line = (
                f'2026-08-29  6:23:25 3 [Warning] Access denied for user'
                f" 'root'@'{source}' (using password: YES)"
            )
            self.assertEqual(mysql_logfile.get_source(line), expected, source)

    def test_a_line_that_is_not_a_denied_login(self):
        self.assertIsNone(
            mysql_logfile.get_source(
                '2026-08-29  6:23:00 0 [Note] mariadbd: ready for connections.'
            )
        )


if __name__ == '__main__':
    unittest.main()
