            "varname": "mysql_logfile_ignore",
            "caption": "MySQL Logfile: Ignore",
            "description": "Ignore a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. Example: `--ignore='(?i)linuxfabrik'`.",
