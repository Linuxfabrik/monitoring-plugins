            "varname": "mysql_logfile_no_match_severity",
            "caption": "MySQL Logfile: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "mysql_logfile_no_match_severity_list"
