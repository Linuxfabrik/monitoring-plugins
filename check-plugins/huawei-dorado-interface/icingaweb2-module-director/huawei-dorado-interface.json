        "1": {
            "varname": "huawei_dorado_interface_always_ok",
            "caption": "Huawei Dorado Interface: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
