        },
        "2": {
            "varname": "huawei_dorado_interface_cache_expire",
            "caption": "Huawei Dorado Interface: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1c347af4-d2c4-446f-993c-de3feb40b591"
        },
        "3": {
            "varname": "huawei_dorado_interface_device_id",
            "caption": "Huawei Dorado Interface: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5e77e96b-d936-4d99-b7c4-71a866510b8b"
        },
        "4": {
            "varname": "huawei_dorado_interface_ignore",
            "caption": "Huawei Dorado Interface: Ignore",
            "description": "Skip interface modules. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "baea7721-9f1c-4781-ae9d-8c34689d2a60"
        },
        "5": {
            "varname": "huawei_dorado_interface_insecure",
            "caption": "Huawei Dorado Interface: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4217d09f-11de-439b-ba7d-1095da7c79e1"
        },
        "6": {
            "varname": "huawei_dorado_interface_match",
            "caption": "Huawei Dorado Interface: Match",
            "description": "Limit to interface modules. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `LOCATION`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "dff3a8db-d22c-4144-b6a7-104832d3a33e"
        },
        "7": {
            "varname": "huawei_dorado_interface_no_insecure",
            "caption": "Huawei Dorado Interface: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f1258420-71c5-4ad3-9f24-9c8912e5844a"
        },
        "8": {
            "varname": "huawei_dorado_interface_no_match_severity",
            "caption": "Huawei Dorado Interface: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_interface_no_match_severity_list"
            },
            "uuid": "7f2f4973-72ed-4581-a05b-7fa072c49403"
        },
        "9": {
            "varname": "huawei_dorado_interface_no_perfdata",
            "caption": "Huawei Dorado Interface: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "a37b322b-b922-40d2-ad55-a07536762088"
        },
        "10": {
            "varname": "huawei_dorado_interface_no_proxy",
            "caption": "Huawei Dorado Interface: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "15a217a2-745c-42b0-a16c-52476ebbfb6e"
        },
        "11": {
            "varname": "huawei_dorado_interface_password",
            "caption": "Huawei Dorado Interface: Password",
            "description": "Huawei OceanStor Dorado API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "70b8cefe-35d4-42f8-acf5-4617160bbe87"
        },
        "12": {
            "varname": "huawei_dorado_interface_password_file",
            "caption": "Huawei Dorado Interface: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "dbc9a493-b74e-49bd-b513-78a366eeb374"
        },
        "13": {
            "varname": "huawei_dorado_interface_proxy",
            "caption": "Huawei Dorado Interface: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "94022e47-0322-4061-941f-862d244f0248"
        },
        "14": {
            "varname": "huawei_dorado_interface_scope",
            "caption": "Huawei Dorado Interface: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "beefd816-0440-4076-a07e-b8584ce83548"
        },
        "15": {
            "varname": "huawei_dorado_interface_timeout",
            "caption": "Huawei Dorado Interface: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0520b6f8-3b48-4523-9ffe-17c9105984ea"
        },
        "16": {
            "varname": "huawei_dorado_interface_url",
            "caption": "Huawei Dorado Interface: URL",
            "description": "Huawei OceanStor Dorado API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0252c4f4-5cc2-41d1-a233-fbb3437c0951"
        },
        "17": {
            "varname": "huawei_dorado_interface_username",
            "caption": "Huawei Dorado Interface: Username",
            "description": "Huawei OceanStor Dorado API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7102a09d-6a3d-44fb-bee9-116a3da240ae"
        },
        "18": {
            "varname": "huawei_dorado_interface_verbose",
            "caption": "Huawei Dorado Interface: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "203cf554-2cff-47aa-812d-23d24af9269f"
        }
    }
