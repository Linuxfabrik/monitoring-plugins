"""See the check's README for more details."""

import argparse
import sys

import lib.args
import lib.base
import lib.lftest
import lib.qts
import lib.txt
import lib.url
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

try:
    import xmltodict
except ImportError:
    print('Python module "xmltodict" is not installed.')
    sys.exit(STATE_UNKNOWN)


__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026092901'

DESCRIPTION = """Checks disk SMART values on QNAP appliances running QTS via the API. Reports drive
health and temperature against the thresholds configured in QTS. A disk that reports no
temperature is rated by its health only.
Alerts when any disk reports a non-normal SMART status or reaches a temperature threshold."""

DEFAULT_INSECURE = False
DEFAULT_NO_PROXY = False
DEFAULT_TIMEOUT = 6
DEFAULT_USERNAME = 'admin'


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--insecure',
        help=lib.args.help('--insecure'),
        dest='INSECURE',
        action='store_true',
        default=DEFAULT_INSECURE,
    )

    parser.add_argument(
        '--no-perfdata',
        help=lib.args.help('--no-perfdata'),
        dest='NO_PERFDATA',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--no-proxy',
        help=lib.args.help('--no-proxy'),
        dest='NO_PROXY',
        action='store_true',
        default=DEFAULT_NO_PROXY,
    )

    parser.add_argument(
        '--password',
        help='QTS API password.',
        dest='PASSWORD',
        required=True,
    )

    parser.add_argument(
        '--proxy',
        help=lib.args.help('--proxy'),
        dest='PROXY',
        default=None,
    )

    parser.add_argument(
        '--test',
        help=lib.args.help('--test'),
        dest='TEST',
        type=lib.args.csv,
    )

    parser.add_argument(
        '--timeout',
        help=lib.args.help('--timeout') + ' Default: %(default)s (seconds)',
        dest='TIMEOUT',
        type=int,
        default=DEFAULT_TIMEOUT,
    )

    parser.add_argument(
        '--url',
        help='QTS-based appliance URL. Example: `--url=https://192.168.1.1:8080`.',
        dest='URL',
        required=True,
    )

    parser.add_argument(
        '--username',
        help='QTS API username. Default: %(default)s',
        dest='USERNAME',
        default=DEFAULT_USERNAME,
    )

    args, _ = parser.parse_known_args()
    return args


def main():
    """The main function. This is where the magic happens."""

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)

    # fetch data
    if args.TEST is None:
        auth_sid = lib.base.coe(lib.qts.get_auth_sid(args))
        url = f'{args.URL}/cgi-bin/disk/qsmart.cgi?func=all_hd_data&sid={auth_sid}'
        qsmart = lib.base.coe(
            lib.url.fetch(
                url,
                insecure=args.INSECURE,
                no_proxy=args.NO_PROXY,
                proxy=args.PROXY,
                timeout=args.TIMEOUT,
            )
        )
        url = (
            f'{args.URL}/cgi-bin/management/manaRequest.cgi'
            f'?subfunc=sysinfo&hd=no&multicpu=1&sid={auth_sid}'
        )
        result = lib.base.coe(
            lib.url.fetch(
                url,
                insecure=args.INSECURE,
                no_proxy=args.NO_PROXY,
                proxy=args.PROXY,
                timeout=args.TIMEOUT,
            )
        )
    else:
        # do not call the appliance, put in test data
        base = args.TEST[0]
        qsmart = lib.lftest.test_text(args.TEST, f'{base}-qsmart')
        result = lib.lftest.test_text(args.TEST, f'{base}-sysinfo')
    data = xmltodict.parse(qsmart)['QDocRoot']
    if data['authPassed'] == '0':
        lib.base.cu('Insufficient permissions.')
    sysinfo = xmltodict.parse(result)['QDocRoot']
    if sysinfo['authPassed'] == '0':
        lib.base.cu('Insufficient permissions.')

    # init some vars
    disk_count = 0
    state = STATE_OK
    msg_body = ''
    perfdata = ''
    root = sysinfo['func']['ownContent']['root']
    # xmltodict returns a single element as a dict and several ones as a list
    disks = data['Disk_Info']['entry']
    if isinstance(disks, dict):
        disks = [disks]

    # analyze data
    for disk in disks:
        if not disk.get('Serial'):  # skip empty slots
            continue
        disk_count += 1

        # QTS 4.2 does not report `hd_is_ssd` (python-qnapstats fixtures of a TS-110
        # and a TS-659), such a disk is rated as a hard disk
        if disk.get('hd_is_ssd') == '1':
            warn = int(root['SSDTempWarnT'])
            crit = int(root['SSDTempErrT'])
        else:
            warn = int(root['HDTempWarnT'])
            crit = int(root['HDTempErrT'])

        # A disk without a sensor, a virtual disk of QuTScloud for example, reports an
        # empty temperature. Reporting it as 0 degrees would put a made-up value into
        # the graphs, so such a disk is only rated by its health.
        disk_temperature = (disk.get('Temperature') or {}).get('oC')
        if disk_temperature is None:
            disk_state = STATE_OK
            temperature = 'Temp n/a'
        else:
            disk_temperature = int(disk_temperature)
            disk_state = lib.base.get_state(
                disk_temperature, warn, crit, _operator='ge'
            )
            temperature = f'Temp {disk_temperature}°C (Thresholds: {warn}/{crit}°C)'
            alias = disk.get('Disk_Alias', 'Unknown Alias').replace(' ', '_')
            model = disk['Model'].replace(' ', '_')
            serial = disk['Serial'].replace(' ', '_')
            perfdata += lib.base.get_perfdata(
                f'{alias}_{model}_{serial}_temperature',
                disk_temperature,
                warn=warn,
                crit=crit,
                _min=0,
            )
        if disk['Health'] != 'OK':
            disk_state = STATE_WARN

        state = lib.base.get_worst(disk_state, state)
        msg_body += (
            f'* {disk.get("Disk_Alias", "Unknown Alias")}'
            f' ({disk["Model"]}'
            f', SerNo {disk["Serial"]}'
            f', {temperature})'
            f'{lib.base.state2str(disk_state, prefix=" ")}\n'
        )

    # build the message
    if disk_count:
        msg_header = f'Checked {disk_count} {lib.txt.pluralize("disk", disk_count)}.'
        if state == STATE_CRIT:
            msg_header += ' There are critical errors.'
        elif state == STATE_WARN:
            msg_header += ' There are warnings.'
        else:
            msg_header += ' All are healthy.'
        # over and out
        lib.base.oao(
            f'{msg_header}\n{msg_body}',
            state,
            perfdata,
            always_ok=args.ALWAYS_OK,
            no_perfdata=args.NO_PERFDATA,
        )
    else:
        # over and out
        lib.base.cu('Did not find any disk.')


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
