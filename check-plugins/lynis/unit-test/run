import concurrent.futures
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# In --test mode the plugin treats the fixture as the report.dat of one audited
# host (host discovery, the SSH transport and the remote lynis run are skipped).
# The fixtures in stdout/ are anonymised, RFC-5737 sample reports:
#   report-warn  hardening_index 68, one warning, three suggestions (myhost)
#   report-ok    hardening_index 80, no warnings (otherhost)
# The expected state lives in the testcase id and depends on the fixture plus
# the thresholds: the state is the worst of the hardening index against
# --warning/--critical and "any lynis warning -> at least WARNING".
TESTS = [
    {
        'id': 'ok-clean-report',
        'test': 'stdout/report-ok,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            '1/1 host audited (1 address probed)',
            'otherhost:/var/log/lynis-report.dat ! 192.0.2.28 ! 0    ! 1    ! 80',
            # a suggestion is advice, it carries no state
            'Suggestions:\n* otherhost: BOOT-5264: Consider hardening system '
            'services.\n',
        ],
        'assert-not-in': ['[WARNING]', 'Findings:'],
    },
    {
        'id': 'warn-lynis-warning-present',
        'test': 'stdout/report-warn,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'Findings:\n* myhost: MAIL-8818: Found some information disclosure in '
            'SMTP banner (OS or software name). [WARNING]\n\nSuggestions:',
            '`lynis show details MAIL-8818`',
            '`skip-test=MAIL-8818`',
            # suggestions as a plain list, with their details
            '* myhost: BOOT-5264: Consider hardening system services. Run '
            "'/usr/bin/systemd-analyze security SERVICE' for each service.",
            '* myhost: KRNL-5820: If not required, consider explicit disabling of '
            'core dump.',
        ],
        # sorted by test ID, not in the order lynis ran the tests
        'assert-regex': r'Suggestions:\n\* myhost: AUTH-9230: .*\n'
        r'\* myhost: BOOT-5264: .*\n\* myhost: KRNL-5820: ',
    },
    {
        # deprecated, still accepted so that existing service definitions keep
        # working
        'id': 'warn-lengthy-is-ignored',
        'test': 'stdout/report-warn,,0',
        'params': '--lengthy',
        'assert-retc': STATE_WARN,
        'assert-in': ['Suggestions:\n* myhost: AUTH-9230'],
    },
    {
        'id': 'warn-index-below-threshold',
        'test': 'stdout/report-ok,,0',
        'params': '--warning 90:',
        'assert-retc': STATE_WARN,
        'assert-regex': r'! 80 +! \[WARNING\]',
    },
    {
        'id': 'crit-index-below-critical',
        'test': 'stdout/report-ok,,0',
        'params': '--warning 90: --critical 85:',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'! 80 +! \[CRITICAL\]',
    },
    {
        'id': 'ok-always-ok-masks-warning',
        'test': 'stdout/report-warn,,0',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['MAIL-8818: Found some information disclosure'],
    },
    # the network scan, reduced to one host
    {
        'id': 'ok-network-clean-report',
        'test': 'stdout/report-ok,,0',
        'params': '--host=otherhost',
        'assert-retc': STATE_OK,
        'assert-in': ['1/1 host audited', 'otherhost', '192.0.2.28'],
    },
    {
        'id': 'warn-network-names-the-host-of-a-finding',
        'test': 'stdout/report-warn,,0',
        'params': '--host=myhost',
        'assert-retc': STATE_WARN,
        'assert-regex': r'myhost:/var/log/lynis-report.dat.*\[WARNING\]'
        r'(?s:.*)\* myhost: MAIL-8818: .*\[WARNING\]'
        r'(?s:.*)\* myhost: AUTH-9230: .*\n\* myhost: BOOT-5264: ',
    },
    # values that would reach a root-run lynis as something else than a name
    {
        'id': 'unknown-skip-test-with-newline',
        'test': 'stdout/report-ok,,0',
        'params': "'--lynis-skip-test=MAIL-8818\nplugindir=/tmp'",
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['is not a lynis test ID'],
    },
    {
        'id': 'unknown-skip-test-with-trailing-newline',
        'test': 'stdout/report-ok,,0',
        'params': "'--lynis-skip-test=MAIL-8818\n'",
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['is not a lynis test ID'],
    },
    {
        'id': 'unknown-test-group-with-path',
        'test': 'stdout/report-ok,,0',
        'params': '--lynis-test-group=../../tmp/x',
        'assert-retc': STATE_UNKNOWN,
    },
    {
        'id': 'unknown-auditor-with-quote',
        'test': 'stdout/report-ok,,0',
        'params': """'--lynis-auditor=a"$(id)"'""",
        'assert-retc': STATE_UNKNOWN,
    },
    {
        'id': 'unknown-more-than-one-category',
        'test': 'stdout/report-ok,,0',
        'params': '--lynis-test-category=security --lynis-test-category=performance',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['--lynis-test-category can only be given once.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../lynis'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestNothingAudited(unittest.TestCase):
    """A fixture cannot cover what the plugin does when no target answers,
    because --test replaces the whole SSH transport. These cases point the
    plugin at an address from the documentation range (RFC 5737) that has no
    host behind it, which is what a subnet scan hits on almost every address.
    """

    def run_plugin(self, *params):
        """Run the plugin against an unreachable address and return
        (stdout, returncode).
        """
        with tempfile.TemporaryDirectory() as source:
            # The plugin only requires a `lynis` executable in the given source
            # directory, so no local lynis installation is needed here: the
            # probe fails long before the copy would be pushed.
            with open(os.path.join(source, 'lynis'), 'w') as file:
                file.write('#!/bin/sh\n')
            result = subprocess.run(
                [
                    '../lynis',
                    '--host=192.0.2.1',
                    '--connect-timeout=1',
                    f'--lynis-source={source}',
                    *params,
                ],
                capture_output=True,
                check=False,
                text=True,
            )
        return result.stdout, result.returncode

    def test_warn_no_host_answered(self):
        stdout, retc = self.run_plugin()
        self.assertEqual(retc, STATE_WARN)
        # the addresses probed stay apart from the hosts that answered
        self.assertIn('0/0 hosts audited (1 address probed)', stdout)
        # and the summary says why nothing was reached
        self.assertIn('Not reachable over SSH:', stdout)

    def test_ok_no_match_severity_overrides(self):
        stdout, retc = self.run_plugin('--no-match-severity=ok')
        self.assertEqual(retc, STATE_OK)
        self.assertIn('0/0 hosts audited (1 address probed)', stdout)


# Cross-distro container tests.
#
# The fixtures above exercise the report parsing and threshold logic, but they
# skip the part this plugin is really about: assembling a self-contained lynis
# copy from a real distro installation and running the audit over SSH. The
# layout of an installed lynis differs across distributions (the plugins
# directory lives under /usr/share/lynis on RHEL/Fedora/Arch but under
# /etc/lynis on Debian/Ubuntu), and that difference decides whether the audit
# produces a report at all. A static fixture cannot capture this.
#
# Each Containerfile under containerfiles/ installs lynis (the distro package,
# or the upstream self-contained tree on SLES, which has no package), an SSH
# server and client, sudo and rsync, and sets up password-less root SSH to
# itself. The test then runs the plugin inside the container as an
# unprivileged user (the scan refuses to run as root), auditing 127.0.0.1 over
# its normal SSH transport, where the container is both the management host
# (where the lynis copy is assembled from the distro layout) and the audit
# target. All images are built and audited in parallel; one assertion method
# per distro then checks that the audit produced a report.
CONTAINERFILES = [
    'archlinux-vlatest',
    'debian-v12',
    'debian-v13',
    'fedora-v43',
    'rhel-v8',
    'rhel-v9',
    'rhel-v10',
    'sles-v15',
    'sles-v16',
    'ubuntu-v2204',
    'ubuntu-v2404',
    'ubuntu-v2604',
]

HERE = os.path.dirname(os.path.abspath(__file__))
LIB_DIR = os.path.realpath(os.path.join(HERE, '..', 'lib'))
PLUGIN = os.path.realpath(os.path.join(HERE, '..', 'lynis'))

# The network scan runs as an unprivileged user that holds a copy of root's key.
# StrictHostKeyChecking/known-hosts are disabled because the throwaway host key
# changes on every build.
NETWORK_USER_SETUP = (
    'useradd --create-home lfmp 2>/dev/null; '
    'install -d -o lfmp -m 700 /home/lfmp/.ssh && '
    'install -o lfmp -m 600 /root/.ssh/id_ed25519 /home/lfmp/.ssh/id_ed25519'
)
NETWORK_CMD = (
    # sudo rather than su, which the SLES 16 image does not ship. The interpreter
    # is looked up as root, because sudo's secure_path does not reach the one SLES
    # installs.
    'PY=$(command -v python3); '
    'sudo --user=lfmp --set-home sh -c "cd /tmp && $PY ./lynis '
    '--host=127.0.0.1 --username=root --identity=/home/lfmp/.ssh/id_ed25519 '
    '--ssh-option=StrictHostKeyChecking=no '
    '--ssh-option=UserKnownHostsFile=/dev/null '
    '--connect-timeout=10 --verbose"'
)

# Start sshd (path differs between distros) and wait until a key-based
# self-login actually works before the audit connects.
SSHD_START = (
    '/usr/sbin/sshd 2>/dev/null || /usr/bin/sshd; '
    'for _ in $(seq 1 30); do '
    'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null '
    '-o BatchMode=yes -i /root/.ssh/id_ed25519 root@127.0.0.1 true 2>/dev/null '
    '&& break; sleep 0.3; done'
)

# Audit output per Containerfile, filled in parallel by setUpModule().
_RESULTS = {}


def _audit_in_container(containerfile):
    """Build one distro image, start its sshd and run the network scan of
    127.0.0.1 inside it. Returns a dict with the exit code and output of the run.
    """
    from testcontainers.core.container import DockerContainer
    from testcontainers.core.image import DockerImage

    image_tag = f'lfmp-lynis-{containerfile}'.lower()
    # clean_up=False keeps the built image so the next run reuses cached layers
    # instead of rebuilding from the base image (see cpu-usage for the rationale).
    with DockerImage(
        path=HERE,
        dockerfile_path=f'containerfiles/{containerfile}',
        tag=image_tag,
        clean_up=False,
    ) as image:
        # `,z` relabels the mount for SELinux on podman/rhel hosts so the
        # container can read the bind-mounted plugin and lib. The lowercase
        # (shared) label is required because every distro container mounts the
        # same source concurrently; the uppercase `,Z` (private) label would
        # relabel the shared source per container and race the parallel peers
        # into "Permission denied".
        container = (
            DockerContainer(str(image.tag))
            .with_volume_mapping(LIB_DIR, '/tmp/lib', mode='ro,z')
            .with_volume_mapping(PLUGIN, '/tmp/lynis', mode='ro,z')
        )
        with container:
            container.exec(['sh', '-c', SSHD_START])
            container.exec(['sh', '-c', NETWORK_USER_SETUP])
            network = container.exec(['sh', '-c', NETWORK_CMD])
            return {
                'exit_code': network.exit_code,
                'output': (network.output or b'').decode('utf-8', 'replace'),
            }


def setUpModule():
    """Build every distro image and run its audit, all in parallel, before the
    per-distro assertion methods run. A failure in one container is captured and
    surfaced by that distro's own test, never aborting the others.
    """
    if not lib.lftest.container_runtime_available():
        return
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(CONTAINERFILES)) as pool:
        futures = {pool.submit(_audit_in_container, cf): cf for cf in CONTAINERFILES}
        for future in concurrent.futures.as_completed(futures):
            containerfile = futures[future]
            try:
                _RESULTS[containerfile] = future.result()
            except Exception as exc:  # report, do not abort the other containers
                _RESULTS[containerfile] = {'error': repr(exc)}


def _assert_audit(test, containerfile):
    """Assert that the audit inside `containerfile` produced a report."""
    lib.lftest.require_container_runtime()
    result = _RESULTS.get(containerfile)
    if result is None:
        test.skipTest('container did not run')
    if 'error' in result:
        test.fail(f'{containerfile}: container run errored: {result["error"]}')
    output = result['output']
    print(
        f'\n=== {containerfile} network (exit {result["exit_code"]}) ===\n'
        f'{output.strip()}',
        flush=True,
    )
    # The plugin pins the pushed copy with --usecwd, which lynis only supports
    # from 2.7 on. A distro packaging an older lynis has nothing to audit;
    # skip rather than fail. The plugin surfaces the error correctly, which
    # is what matters there.
    if "Invalid option '--usecwd'" in output:
        test.skipTest(f'{containerfile}: packaged lynis is too old (no --usecwd)')
    # Before the plugin-dir fix, Debian/Ubuntu fail here: lynis aborts with
    # "invalid plugin directory" and the plugin reports "audit produced no
    # report" / "0/1 host audited".
    test.assertNotIn('audit produced no report', output)
    test.assertIn('1/1 host audited', output)
    # A fresh container is not hardened, so the per-host state is OK, WARN or
    # CRIT depending on the hardening index and warnings, but never UNKNOWN
    # (UNKNOWN means the audit itself failed).
    test.assertNotEqual(result['exit_code'], STATE_UNKNOWN)


class TestContainer(unittest.TestCase):
    pass


lib.lftest.attach_each(TestContainer, CONTAINERFILES, _assert_audit)


if __name__ == '__main__':
    unittest.main()
