DESCRIPTION = """Runs a lynis security audit across the hosts of a subnet or a host list from
a single management host, and reports each host's hardening index, its findings (the lynis
warnings) and the hardening suggestions of lynis. It discovers the targets (the subnet of the
default interface, a chosen interface or network, or an explicit host list), connects to each
one over SSH, copies a self-contained copy of lynis over, runs the audit there via password-less
sudo, retrieves the report and removes its temporary files. Alerts when a host is below the
hardening index threshold or reports a finding, and when the scan audited no host at all,
naming why the targets did not answer. The worst per-host result determines the overall state.
The scan runs as an unprivileged user and refuses to run as root. Security posture is
informational drift rather than a time-critical availability event, so by default only
WARNING is raised. The check is meant to run at most once per day. To evaluate the audit a
host runs on its own, use lynis-logfile on that host."""

DEFAULT_AUDIT_TIMEOUT = 600
DEFAULT_CONNECT_TIMEOUT = 3
DEFAULT_CRIT = ''
DEFAULT_MAX_WORKERS = 10
DEFAULT_NO_MATCH_SEVERITY = 'warn'
DEFAULT_PORT = 22
DEFAULT_WARN = '65:'

# Where lynis writes its output on a target when it runs privileged. The report and the
# log are left in place after the audit so an admin can inspect the details.
LYNIS_CUSTOM_PROFILE = lib.lynis.CUSTOM_PROFILE
LYNIS_LOG = lib.lynis.LOG
LYNIS_PID = lib.lynis.PID
LYNIS_REPORT = lib.lynis.REPORT

# Test IDs (`SSH-7408`, with an optional `:subtest` for skip-test), test groups and
# test categories. A value is written into a profile that lynis reads as root, so a
# newline must never get through: it would add a profile line of the caller's
# choice, `plugindir=` for example, which makes lynis source scripts from there.
# The patterns are applied with fullmatch(): `$` would still let a trailing newline
# through.
LYNIS_NAME_REGEX = re.compile(r'[A-Za-z0-9_-]+(?::[A-Za-z0-9_-]+)?')
# Auditor names and profile paths travel inside a double-quoted remote command in
# the network scan, and lynis splits the profile list on whitespace. From 3.1 on,
# lynis itself aborts on any argument with a character outside `[:space:]`,
# `a-zA-Z0-9` and `/._:=-` (SafeInput() in include/functions), a comma included.
LYNIS_AUDITOR_REGEX = re.compile(r'[A-Za-z0-9 ._-]+')
LYNIS_PROFILE_REGEX = re.compile(r'[A-Za-z0-9./_-]+')

# Per-run remote work directory. lynis is a script that must be executed, so the
# directory has to live on a partition mounted without "noexec". Hardened hosts
# (exactly the ones being audited) usually mount /var/tmp and /tmp noexec, so the
# candidates are probed in order and the first one that can actually execute a
# file is used. The name is also used to validate the path before any removal.
REMOTE_WORKDIR_NAME = 'linuxfabrik-monitoring-plugins-lynis'
REMOTE_WORKDIR_BASES = ['/var/tmp', '/tmp', '"$HOME"', '/root', '/']  # nosec B108

# Where a packaged lynis keeps its plugins and default profile on the management
# host varies by distro (RHEL/Fedora/Arch ship the plugins under
# /usr/share/lynis, Debian/Ubuntu under /etc/lynis). These mirror lynis' own
# search order so the assembled copy is self-contained on every distro, which
# matters because a missing plugins directory aborts the remote audit.
LOCAL_PLUGIN_DIRS = (
    '/usr/local/lynis/plugins',
    '/usr/local/share/lynis/plugins',
    '/usr/share/lynis/plugins',
    '/etc/lynis/plugins',
)
LOCAL_PROFILE_FILES = (
    '/etc/lynis/default.prf',
    '/usr/share/lynis/default.prf',
)


