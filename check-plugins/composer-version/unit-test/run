"""Unit tests for the composer-version check plugin.

The fixtures in `stdout/` are the raw `composer --version` outputs
captured from the official `docker.io/library/composer:<tag>`
images on Docker Hub. Composer is a single PHP file shipped under
the `composer` upstream image; there is no Red Hat family
container that carries an interesting matrix of versions, so the
upstream image is the right source. The plugin runs its
`r'n (\\d+\\.\\d+\\.?\\d*)'` regex against each one.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import subprocess
import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'parses-composer-2-2-lts',
        'test': 'stdout/composer-version-2.2,,0',
        'assert-in': ['Composer v2.2.26'],
    },
    {
        'id': 'parses-composer-2-7',
        'test': 'stdout/composer-version-2.7,,0',
        'assert-in': ['Composer v2.7.9'],
    },
    {
        'id': 'parses-composer-2-8',
        'test': 'stdout/composer-version-2.8,,0',
        'assert-in': ['Composer v2.8.12'],
    },
    {
        'id': 'parses-composer-2-9',
        'test': 'stdout/composer-version-2.9,,0',
        'assert-in': ['Composer v2.9.5'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Composer not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../composer-version'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestTimeout(unittest.TestCase):
    """A binary that never answers ends the check with a warning once `--timeout`
    has passed, instead of keeping it running until the monitoring server kills it.
    """

    def test_warn_composer_hangs(self):
        result = subprocess.run(
            ['../composer-version', '--path=fixtures/hang', '--timeout=1'],
            capture_output=True,
            text=True,
            check=False,
        )
        self.assertEqual(result.returncode, STATE_WARN)
        self.assertIn(
            'Timeout after 1s while running `fixtures/hang --version', result.stdout
        )


if __name__ == '__main__':
    unittest.main()
