            "description": "WARN threshold for the time since ntpd last synchronized the clock. A duration such as `30m`, `2h` or `1D`; `0D` disables it.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
