        },
        "4": {
            "varname": "ntp_ntpd_critical_sources",
            "caption": "NTP Ntpd: Critical Sources",
            "description": "CRIT threshold for the number of usable NTP sources. Supports Nagios ranges. Example: `--critical-sources=1:` alerts if no source is usable.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9bf172ad-5b38-41be-8044-8a9eb353d1b3"
        },
        "5": {
            "varname": "ntp_ntpd_no_perfdata",
            "caption": "NTP Ntpd: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0406f40d-b393-4bed-a015-c0267f6fd74b"
        },
        "6": {
            "varname": "ntp_ntpd_stratum",
            "caption": "NTP Ntpd: Stratum",
            "description": "Warns if the stratum of this host is greater than or equal to this value. Stratum 1 indicates a computer with a locally attached reference clock. A computer that is synchronised to a stratum 1 computer is at stratum 2. A computer that is synchronised to a stratum 2 computer is at stratum 3, and so on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
