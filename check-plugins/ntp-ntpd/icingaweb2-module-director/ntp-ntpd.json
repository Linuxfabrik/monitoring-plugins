            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "089be0f0-442c-4c43-aacd-49bf366f1301"
        },
        "3": {
            "varname": "ntp_ntpd_critical_age",
            "caption": "NTP Ntpd: Critical Age",
            "description": "CRIT threshold for the time since ntpd last synchronized the clock. A duration such as `30m`, `2h` or `1D`; `0D` disables it.",
