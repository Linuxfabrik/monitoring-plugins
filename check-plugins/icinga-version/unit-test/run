"""Unit tests for the icinga-version check plugin.

The fixtures in `stdout/` are the raw `icinga2 --version` outputs
captured from official Debian and Ubuntu container images
(`docker.io/library/debian:{11,12,13}` and
`docker.io/library/ubuntu:{22.04,24.04}`) after a fresh
`apt-get install icinga2`. There is no Red Hat family image
that ships icinga2 in the default repos, and the upstream
`docker.io/icinga/icinga2` image emits "(version: v...)" via its
DockerEntrypoint wrapper which the plugin's
`r'\\(version: r(\\d+\\.\\d+\\.\\d+)'` regex deliberately rejects
(it expects the Debian `r<X>.<Y>.<Z>-1` shape).

The testcases assert the parsed version and nothing else. An end-of-life
verdict is derived from live endoflife.date data and from today's date, so
pinning one here breaks as soon as upstream re-dates a cycle or a date passes.
`lib.version.check_eol()` is covered against synthetic cycles in the lib repo
instead, where the expectation cannot age.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-debian11-icinga-2-12-3',
        'test': 'stdout/icinga2-version-debian11,,0',
        'assert-in': ['Icinga v2.12.3'],
    },
    {
        'id': 'parses-ubuntu22-icinga-2-13-2',
        'test': 'stdout/icinga2-version-ubuntu22,,0',
        'assert-in': ['Icinga v2.13.2'],
    },
    {
        'id': 'parses-debian12-icinga-2-13-6',
        'test': 'stdout/icinga2-version-debian12,,0',
        'assert-in': ['Icinga v2.13.6'],
    },
    {
        'id': 'parses-ubuntu24-icinga-2-14-2',
        'test': 'stdout/icinga2-version-ubuntu24,,0',
        'assert-in': ['Icinga v2.14.2'],
    },
    {
        'id': 'parses-debian13-icinga-2-14-6',
        'test': 'stdout/icinga2-version-debian13,,0',
        'assert-in': ['Icinga v2.14.6'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Icinga not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../icinga-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
