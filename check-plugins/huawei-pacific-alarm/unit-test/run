import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN

TESTS = [
    {
        'id': 'ok-no-alarms',
        'test': 'stdout/alarms-none,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.', 'No active alarms.'],
    },
    {
        'id': 'crit-critical-alarm',
        'test': 'stdout/alarms-critical,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'License Has Expired.*\[CRITICAL\]',
    },
    {
        'id': 'warn-major-alarm',
        'test': 'stdout/alarms-major,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_WARN,
        'assert-regex': r'Disk Predicted To Fail.*\[WARNING\]',
    },
    {
        # The appliance embeds HTML entities in the texts it generates, so an
        # alarm name reaches the output with the bracket it stands for.
        'id': 'crit-alarm-html-entities',
        'test': 'stdout/alarms-html-entities,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': ['Controller (CTE0.A) Is Offline'],
        'assert-not-in': ['&#40;'],
    },
    {
        # The filter selects a subset; what it drops must not be checked either. The
        # alarm that survives is the critical one, so the state comes from it alone.
        'id': 'crit-match-filters-alarms',
        'test': 'stdout/alarms-critical,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        " --match='License'",
        'assert-retc': STATE_CRIT,
        'assert-in': ['License'],
        'assert-not-in': ['Disk Predicted'],
    },
    {
        'id': 'crit-no-match-severity',
        'test': 'stdout/alarms-critical,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin'
        " --match='nonexistent' --no-match-severity=crit",
        'assert-retc': STATE_CRIT,
        'assert-in': ['No alarms matched `nonexistent`.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-pacific-alarm'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
