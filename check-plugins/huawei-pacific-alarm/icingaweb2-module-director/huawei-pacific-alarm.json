            "uuid": "acfd84eb-c72e-4902-9a19-24e1c928a536"
        },
        "3": {
            "varname": "huawei_pacific_alarm_ignore",
            "caption": "Huawei Pacific Alarm: Ignore",
            "description": "Skip alarms. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `alarm_id`, `alarm_name`, `description`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ed6b2be1-8347-4c8d-8631-69f6d8565c70"
        },
        "4": {
            "varname": "huawei_pacific_alarm_insecure",
            "caption": "Huawei Pacific Alarm: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f09b3f8d-7529-431d-9730-d9ad3ceaa6b1"
        },
        "5": {
            "varname": "huawei_pacific_alarm_no_insecure",
            "caption": "Huawei Pacific Alarm: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0b00fef8-bc79-4b32-aca6-f354f3fec0cb"
        },
        "6": {
            "varname": "huawei_pacific_alarm_match",
            "caption": "Huawei Pacific Alarm: Match",
            "description": "Limit to alarms. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `alarm_id`, `alarm_name`, `description`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d858f31c-b4b2-4aca-90ee-438ac15bb957"
        },
        "7": {
            "varname": "huawei_pacific_alarm_no_match_severity",
            "caption": "Huawei Pacific Alarm: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_alarm_no_match_severity_list"
            },
            "uuid": "2b3abfd8-6f44-4b7d-b4a6-2de37ad41666"
        },
        "8": {
            "varname": "huawei_pacific_alarm_no_perfdata",
            "caption": "Huawei Pacific Alarm: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "685c3a69-8776-4bc1-b19a-ad8e9f83a793"
        },
        "9": {
            "varname": "huawei_pacific_alarm_no_proxy",
