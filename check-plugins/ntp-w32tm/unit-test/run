    {
        # Captured on Windows 11 as a standard user over SSH: w32tm refuses the query
        # with E_ACCESSDENIED, in German.
        'id': 'unknown-access-denied',
        'test': 'stdout/de-access-denied,,2147942405',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Access denied while querying the Windows Time service'],
        'assert-not-in': ['Zugriff verweigert', 'Traceback'],
    },
    {
        # Synthetic: a known label whose value lacks the number in front, derived from
        # de-stratum-5-synced. Must not end in a Python stack trace.
        'id': 'unknown-label-without-number',
        'test': 'stdout/de-stratum-without-number,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['carries no number'],
        'assert-not-in': ['Traceback'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../ntp-w32tm'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
