        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['core version is outdated', "'hardening_findings'=1"],
    },
    # The vulnerability database qualifies the state with a suffix where it has one to
    # add. That says how it knows, not something different, so the core still has to be
    # reported as outdated rather than falling through unreported.
    {
        'id': 'warn-core-outdated-qualified-status',
        'test': 'stdout/core-outdated-qualified-status,,0',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['core version is outdated', "'hardening_findings'=1"],
    },
    # The scan seeing a different core version than the one installed means it did not
    # look at this installation.
    {
        'id': 'warn-version-mismatch-local-vs-remote',
        'test': 'stdout/version-mismatch,,0',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['scan sees v6.4.1, installed is v7.0.2'],
    },
    {
        'id': 'warn-users-enumerable',
