        'assert-retc': STATE_WARN,
        'assert-in': ['the vulnerability database was unreachable'],
    },
    # A site with real findings must still report that the vulnerability class was never
    # examined, otherwise "0 vulnerabilities" reads as a verified zero. The `no-api-token`
    # fixture has no findings at all, so it only covers the empty summary; the fixture
    # below is the one that has something to report and therefore takes the other branch.
    {
        'id': 'ok-no-api-token-keeps-counting-other-findings',
        'test': 'stdout/no-api-token,,0',
        'params': f'{BASE_PARAMS} --no-vuln-data-severity=ok',
        'assert-retc': STATE_OK,
        'assert-in': ["'vuln_data_available'=0"],
    },
    {
        'id': 'warn-findings-without-vuln-data-claim-no-vulnerability-count',
        'test': 'stdout/core-outdated-no-api-token,,0',
        # WARNING comes from the outdated core, not from the missing database, which
        # `--no-vuln-data-severity=ok` takes out of the picture on purpose here
        'params': f'{BASE_PARAMS} --no-vuln-data-severity=ok',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'vulnerabilities not checked, 0 exposures, 1 hardening finding',
            "'vuln_data_available'=0",
        ],
        # the summary is what a notification carries, so the count must not appear
        # there at all rather than appear as a zero
        'assert-not-in': ['0 vulnerabilities'],
    },
    {
        # the counterpart: with the database consulted, a zero is a verified zero and
        # stays in the summary
        'id': 'ok-findings-with-vuln-data-keep-the-count',
        'test': 'stdout/many-findings,,0',
        'params': BASE_PARAMS,
        'assert-in': [
            '0 vulnerabilities (0 critical)',
            "'vuln_data_available'=1",
        ],
        'assert-not-in': ['vulnerabilities not checked'],
    },
    # A working token is reported only under --lengthy, so the default output of a clean
    # site stays a single verdict line.
    {
        'id': 'ok-token-quota-shown-with-lengthy',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            # "daily" matters: the quota refills, so a low number is a reason to wait
            # rather than to buy a plan.
            'Vulnerability database queried (free plan, 22 of the daily requests left)',
            "'vuln_data_available'=1",
        ],
    },
    {
        'id': 'ok-token-quota-hidden-by-default',
        'test': 'stdout/clean-site,,0',
        'params': BASE_PARAMS,
        'assert-retc': STATE_OK,
        'assert-not-in': ['requests left'],
    },
    # A backup folder wpscan could read entries out of is a leak; one it only saw the
    # outside of is not the same situation and must not page at night.
    {
        'id': 'warn-backup-folder-without-readable-entries',
        'test': 'stdout/backup-folder-unlisted,,5',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-regex': r'backup-db.*\[WARNING\]',
    },
    # That rating belongs to the backup folders alone. A readable wp-config backup hands
    # over the database credentials whatever rating a future release might attach to it,
    # so a severity turning up in that section must not soften the finding.
    {
        'id': 'crit-config-backup-ignores-a-severity',
        'test': 'stdout/config-backup-rated,,5',
        'params': BASE_PARAMS,
        'assert-retc': STATE_CRIT,
        'assert-regex': r'wp-config\.php\.bak.*\[CRITICAL\]',
    },
    # Exactly at the threshold the vulnerability is critical, because the comparison is
    # "at or above".
    {
        'id': 'crit-cvss-exactly-at-threshold',
        'test': 'stdout/vuln-low-cvss,,5',
        'params': f'{BASE_PARAMS} --critical-cvss=5.4',
        'assert-retc': STATE_CRIT,
    },
    {
        'id': 'warn-cvss-just-below-threshold',
        'test': 'stdout/vuln-low-cvss,,5',
        'params': f'{BASE_PARAMS} --critical-cvss=5.5',
        'assert-retc': STATE_WARN,
    },
    {
        'id': 'unknown-no-match-severity-unknown',
        'test': 'stdout/full-site,,5',
        'params': f'{BASE_PARAMS} --match=does-not-exist --no-match-severity=unknown',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Nothing checked.'],
    },
    # A JSON document that is not an object carries no scan result, whatever else it is.
    {
        'id': 'unknown-json-array',
        'test': 'stdout/json-array,,0',
        'params': NO_PATH_PARAMS,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['the scan output is not a JSON object'],
    },
    # The site URL is not given and has to come out of wp-config.php.
    {
        'id': 'ok-url-derived-from-wp-config',
        'test': 'stdout/clean-site,,0',
        'params': DERIVED_URL_PARAMS,
        'assert-retc': STATE_OK,
        'assert-in': ['https://www.example.com'],
    },
    # Neither given nor derivable: the message has to name both the parameter and the
    # usual reason, since wp-config.php is normally unreadable for the monitoring user.
    {
        'id': 'unknown-url-neither-given-nor-derivable',
        'test': 'stdout/clean-site,,0',
        'params': '--path=/nonexistent',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No --url given', 'WP_HOME', 'wp-config.php'],
    },
    # --verbose prints the command the check assembled, which is the only place the
    # enumeration adjustments become visible. Without vulnerability data the vulnerable-
    # plugins and vulnerable-themes choices are downgraded, because wpscan refuses to
    # start with them.
    {
        'id': 'ok-verbose-shows-downgraded-enumeration',
        'test': 'stdout/no-api-token,,0',
        'params': f'{BASE_PARAMS} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Executed command:',
            '--enumerate=p,t,tt,cb,dbe,bf,u',
            '--format=json',
            '--no-banner',
            '--max-scan-duration=1770',
        ],
        'assert-not-in': ['--enumerate=vp,vt'],
    },
    # The raw pass-through and the switches land in the command unchanged.
    {
        'id': 'ok-verbose-shows-passed-through-options',
        'test': 'stdout/clean-site,,0',
        'params': (
            f'{BASE_PARAMS} --verbose --insecure --wpscan-no-update '
            '--wpscan-option=--plugins-detection=aggressive --total-timeout=120'
