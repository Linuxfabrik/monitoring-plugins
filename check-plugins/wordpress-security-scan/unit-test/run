        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Nothing checked.'],
    },
    # A JSON document that is not an object carries no scan result, whatever else it is.
    {
        'id': 'unknown-json-array',
        'test': 'stdout/json-array,,0',
        'params': NO_PATH_PARAMS,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['the scan output is not a JSON object'],
    },
    # The site URL is not given and has to come out of wp-config.php.
    {
        'id': 'ok-url-derived-from-wp-config',
        'test': 'stdout/clean-site,,0',
        'params': DERIVED_URL_PARAMS,
        'assert-retc': STATE_OK,
        'assert-in': ['https://www.example.com'],
    },
    # Neither given nor derivable: the message has to name both the parameter and the
    # usual reason, since wp-config.php is normally unreadable for the monitoring user.
    {
        'id': 'unknown-url-neither-given-nor-derivable',
        'test': 'stdout/clean-site,,0',
        'params': '--path=/nonexistent',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No --url given', 'WP_HOME', 'wp-config.php'],
    },
    # --verbose prints the command the check assembled, which is the only place the
    # enumeration adjustments become visible. Without vulnerability data the vulnerable-
    # plugins and vulnerable-themes choices are downgraded, because wpscan refuses to
    # start with them.
    {
        'id': 'ok-verbose-shows-downgraded-enumeration',
        'test': 'stdout/no-api-token,,0',
        'params': f'{BASE_PARAMS} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Executed command:',
            '--enumerate=p,t,tt,cb,dbe,bf,u',
            '--format=json',
            '--no-banner',
            '--max-scan-duration=1770',
        ],
        'assert-not-in': ['--enumerate=vp,vt'],
    },
    # The raw pass-through and the switches land in the command unchanged.
    {
        'id': 'ok-verbose-shows-passed-through-options',
        'test': 'stdout/clean-site,,0',
        'params': (
            f'{BASE_PARAMS} --verbose --insecure --wpscan-no-update '
            '--wpscan-option=--plugins-detection=aggressive --scan-timeout=120'
        ),
        'assert-retc': STATE_OK,
        'assert-in': [
            '--disable-tls-checks',
            '--no-update',
            '--plugins-detection=aggressive',
            '--max-scan-duration=90',
        ],
    },
    # A bare host is completed to HTTPS, not left to the scanner's HTTP default. That
    # also keeps a www-to-apex redirect from changing the scheme at the same time, which
    # the scanner does not follow even when asked to.
    {
        'id': 'ok-bare-host-becomes-https',
        'test': 'stdout/clean-site,,0',
        'params': '--url=www.example.com --path=wordpress --verbose',
        'assert-retc': STATE_OK,
        'assert-in': ['--url=https://www.example.com'],
    },
    {
        'id': 'ok-explicit-scheme-is-kept',
        'test': 'stdout/clean-site,,0',
        'params': '--url=http://www.example.com --path=wordpress --verbose',
        'assert-retc': STATE_OK,
        'assert-in': ['--url=http://www.example.com'],
    },
    # The printed command is quoted the way a shell needs it, so it can be pasted into a
    # terminal. The user agent carries spaces and would otherwise read as several
    # arguments. The command itself never goes through a shell.
    {
        'id': 'ok-verbose-command-is-shell-safe',
        'test': 'stdout/clean-site,,0',
        'params': BASE_PARAMS + ' --verbose',
        'assert-retc': STATE_OK,
        'assert-in': ["'--user-agent=Linuxfabrik Monitoring Plugins'"],
    },
    # The two redirect switches wpscan names in its own error message are parameters of
    # this check, so an admin can copy them straight from that message.
    {
        'id': 'ok-verbose-shows-wpscan-follow-redirect',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --verbose --wpscan-follow-redirect',
        'assert-retc': STATE_OK,
        'assert-in': ['--follow-redirect'],
        'assert-not-in': ['--ignore-main-redirect'],
    },
    {
        'id': 'ok-verbose-shows-wpscan-ignore-main-redirect',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --verbose --wpscan-ignore-main-redirect',
        'assert-retc': STATE_OK,
        'assert-in': ['--ignore-main-redirect'],
    },
    # An enterprise database supplies vulnerability data without an API token, so the
    # enumeration must keep its vulnerable-plugins and vulnerable-themes choices.
    {
        'id': 'ok-enterprise-db-keeps-enumeration',
        'test': 'stdout/clean-site,,0',
        'params': (
            f'{BASE_PARAMS} --verbose '
            '--wpscan-option=--enterprise-db-token=linuxfabrik'
        ),
        'assert-retc': STATE_OK,
        'assert-in': ['--enumerate=vp,vt,tt,cb,dbe,bf,u'],
    },
    # An API token keeps the vulnerable-plugins and vulnerable-themes choices too.
    {
        'id': 'ok-api-token-keeps-enumeration',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --verbose --api-token=linuxfabrik',
        'assert-retc': STATE_OK,
        'assert-in': ['--enumerate=vp,vt,tt,cb,dbe,bf,u'],
    },
    # The token is handed over through the environment, so it must never show up in the
    # command the check prints.
    {
        'id': 'ok-api-token-not-in-printed-command',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --verbose --api-token=linuxfabrik',
        'assert-retc': STATE_OK,
        'assert-not-in': ['linuxfabrik'],
    },
    # An unreadable or empty token file is a configuration error and stops the check,
    # rather than silently scanning without vulnerability data.
    {
        'id': 'unknown-token-file-missing',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --api-token-file=/nonexistent/token',
        'assert-retc': STATE_UNKNOWN,
    },
    {
        'id': 'unknown-token-file-empty',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --api-token-file=stdin/empty-token',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['is empty'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../wordpress-security-scan'


def load_check():
    """Import the check as a module, so the helpers can be exercised directly."""
    loader = importlib.machinery.SourceFileLoader(
        'wordpress_security_scan', '../wordpress-security-scan'
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class TestRedirectTarget(unittest.TestCase):
    """The redirect destination is read out of the scanner's own message, because the
    scanner names it but will not go there itself. The fixture-driven tests above cannot
    cover the retry, which by design only runs when a real scan is performed.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def test_reads_the_destination(self):
        self.assertEqual(
            self.check.get_redirect_target(
                'The URL supplied redirects to https://example.com/. Use the '
                '--follow-redirect option to automatically scan the redirected URL.'
            ),
            'https://example.com/',
        )

    def test_keeps_a_path(self):
        self.assertEqual(
            self.check.get_redirect_target(
                'The URL supplied redirects to https://example.com/blog/. Use the '
                '--follow-redirect option.'
            ),
            'https://example.com/blog/',
        )

    def test_ignores_an_unrelated_message(self):
        self.assertEqual(
            self.check.get_redirect_target(
                'The remote website is up, but does not seem to be running WordPress.'
            ),
            '',
        )

    def test_ignores_an_empty_message(self):
        self.assertEqual(self.check.get_redirect_target(''), '')


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
