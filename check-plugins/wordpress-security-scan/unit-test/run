            '--max-scan-duration=90',
        ],
    },
    # The scan itself never refreshes the vulnerability database. wpscan counts its own
    # download against --max-scan-duration, so refreshing inside the scan would spend
    # the site's time budget on it; the refresh is a call of its own before the scan.
    {
        'id': 'ok-the-scan-itself-never-updates',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': ['--no-update'],
    },
    # The detection mode, the proxy and the throttle reach the scanner under its own
    # option names, which differ from the ones this check offers.
    {
        'id': 'ok-verbose-shows-detection-mode-proxy-and-throttle',
        'test': 'stdout/clean-site,,0',
        'params': (
            f'{BASE_PARAMS} --verbose --wpscan-detection-mode=aggressive '
            '--wpscan-proxy=http://192.0.2.1:3128 --wpscan-throttle=200'
        ),
        'assert-retc': STATE_OK,
        'assert-in': [
            '--detection-mode=aggressive',
            '--proxy=http://192.0.2.1:3128',
            '--throttle=200',
        ],
    },
    # An explicit enumeration is passed through as given, minus the choices the check
    # adjusts for. `bf` survives here because the test path assumes a recent scanner.
    {
        'id': 'ok-explicit-enumerate-is-passed-through',
        'test': 'stdout/clean-site,,0',
        'params': f'{BASE_PARAMS} --verbose --wpscan-enumerate=cb,dbe,bf,u',
        'assert-retc': STATE_OK,
