        'assert-in': ['site is in install mode, anyone can create the admin user'],
    },
    # Hardening findings.
    {
        'id': 'warn-outdated-plugin',
        'test': 'stdout/full-site,,5',
        'params': f'{BASE_PARAMS} --ignore=wp-config|wordpress.sql|debug.log',
