            'Output from wpscan: ',
            'Run without --wpscan-no-update',
        ],
        'assert-not-in': ['Run without --no-update'],
    },
    {
        'id': 'unknown-malformed-json',
        'test': 'stdout/malformed-json,,0',
        'params': NO_PATH_PARAMS,
        'assert-retc': STATE_UNKNOWN,
        # wpscan reports a run it aborted before writing its document in plain text. That
        # text is the only explanation there is and must reach the output.
        'assert-in': [
            'Output from wpscan: ',
            'The remote website is up, but does not seem to be running',
            'the scan output is not valid JSON',
        ],
    },
    {
        'id': 'unknown-empty-response',
        'test': 'stdout/empty-response,,0',
        'params': NO_PATH_PARAMS,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['The scan returned no output.'],
    },
    # A scanner that aborts before writing its document reports in plain text, on stdout
    # as well as on stderr depending on what went wrong. Either way the text is the only
    # explanation there is.
    {
        'id': 'unknown-error-on-stderr-only',
        'test': 'stdout/empty-response,stderr/ruby-crash,1',
        'params': NO_PATH_PARAMS,
