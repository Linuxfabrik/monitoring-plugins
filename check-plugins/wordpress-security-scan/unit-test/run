        'params': NO_PATH_PARAMS,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Output from wpscan: ',
            'The remote website is up, but does not seem to be running WordPress.',
        ],
    },
    # A site that does not serve itself under the address given in --url. The scanner
    # names the two switches that resolve it, and both are parameters of this check, so
    # the message has to reach the output verbatim and labelled as the scanner's.
    {
        'id': 'unknown-redirect-not-followed',
        'test': 'stdout/redirect-not-followed,,4',
        'params': NO_PATH_PARAMS,
