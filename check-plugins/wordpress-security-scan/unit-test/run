        'params': f'{BASE_PARAMS} --verbose --wpscan-ignore-main-redirect',
        'assert-retc': STATE_OK,
        'assert-in': ['--ignore-main-redirect'],
    },
    # An enterprise database supplies vulnerability data without an API token, so the
    # enumeration must keep its vulnerable-plugins and vulnerable-themes choices.
    {
        'id': 'ok-enterprise-db-keeps-enumeration',
        'test': 'stdout/clean-site,,0',
        'params': (f'{BASE_PARAMS} --verbose --enterprise-db-token=linuxfabrik'),
        'assert-retc': STATE_OK,
        # The exact choices depend on whether a local database is there to widen the
        # scan, which the union scenarios at the bottom cover with a fixture of
        # their own. What matters here is that the enumeration survives at all.
        'assert-in': ['--enumerate=', 'cb,dbe'],
    },
    # Configuring it as a raw option predates the parameter of its own and has to keep
    # working, down to the spelling that puts the value in the next element.
    {
        'id': 'ok-enterprise-db-raw-option-keeps-enumeration',
        'test': 'stdout/clean-site,,0',
        'params': (
            f'{BASE_PARAMS} --verbose '
            '--wpscan-option=--enterprise-db-token --wpscan-option=linuxfabrik'
        ),
        'assert-retc': STATE_OK,
        # The exact choices depend on whether a local database is there to widen the
        # scan, which the union scenarios at the bottom cover with a fixture of
        # their own. What matters here is that the enumeration survives at all.
        'assert-in': ['--enumerate=', 'cb,dbe'],
    },
    # Like the API token, it travels through the environment, so neither the parameter
    # nor the raw option may leave it in the command the check prints. Only the `=` form
