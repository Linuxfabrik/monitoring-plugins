            'Nothing checked.',
            'Installed locally: 3 plugins',
            "'exposures'=0",
            "'vuln_data_available'=1",
            "'scan_duration'=",
        ],
    },
    # A scan that never consulted the vulnerability database still alerts through its own
    # parameter, even where the filters removed every finding. The two reasons to alert
    # are independent, so the one must not swallow the other.
    {
        'id': 'crit-filtered-run-still-reports-missing-vuln-data',
        'test': 'stdout/core-outdated-no-api-token,,5',
        'params': f'{BASE_PARAMS} --match=does-not-exist --no-vuln-data-severity=crit',
