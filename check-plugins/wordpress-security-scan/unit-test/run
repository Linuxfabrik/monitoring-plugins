        ),
        'assert-retc': STATE_OK,
        'assert-in': ['--http-auth=******'],
        'assert-not-in': ['linuxfabrik', 'ignored-plaintext'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../wordpress-security-scan'


def load_check():
    """Import the check as a module, so the helpers can be exercised directly."""
    loader = importlib.machinery.SourceFileLoader(
        'wordpress_security_scan', '../wordpress-security-scan'
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class TestRedirectTarget(unittest.TestCase):
    """The redirect destination is read out of the scanner's own message, because the
    scanner names it but will not go there itself. The fixture-driven tests above cannot
    cover the retry, which by design only runs when a real scan is performed.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def test_reads_the_destination(self):
        self.assertEqual(
            self.check.get_redirect_target(
                'The URL supplied redirects to https://example.com/. Use the '
                '--follow-redirect option to automatically scan the redirected URL.'
            ),
            'https://example.com/',
        )

    def test_keeps_a_path(self):
        self.assertEqual(
            self.check.get_redirect_target(
                'The URL supplied redirects to https://example.com/blog/. Use the '
                '--follow-redirect option.'
            ),
            'https://example.com/blog/',
        )

    def test_ignores_an_unrelated_message(self):
        self.assertEqual(
            self.check.get_redirect_target(
                'The remote website is up, but does not seem to be running WordPress.'
            ),
            '',
        )

    def test_ignores_an_empty_message(self):
        self.assertEqual(self.check.get_redirect_target(''), '')


class TestAbortReason(unittest.TestCase):
    """The scanner reports an aborted run under one of two keys, picking the second one
    while it is refreshing its vulnerability database. Reading only the first one leaves
    the admin without an explanation for the one failure the check can recover from.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def test_reads_a_scan_abort(self):
        self.assertEqual(
            self.check.get_abort_reason({'scan_aborted': 'Not running WordPress.'}),
            'Not running WordPress.',
        )

    def test_reads_an_update_abort(self):
        self.assertEqual(
            self.check.get_abort_reason({'update_aborted': 'Unable to get ...'}),
            'Unable to get ...',
        )

    def test_no_abort_at_all(self):
        self.assertEqual(self.check.get_abort_reason({'version': {}}), '')


# Three refusals are about the vulnerability lookup and say nothing about the site, so the
# scan is worth repeating without the token. Everything else is about the target, and
# repeating it would only scan a site that already refused once. One test method per
# reason, so `./run -v` names the one that broke.
VULN_API_REFUSALS = [
    ('invalid-token', 'The API token provided is invalid'),
    ('quota-exhausted', 'Your API limit has been reached'),
    (
        'api-unreachable',
        'Unable to connect to the WPScan API: HTTP Error: ... (status: 401). '
        'Please check https://status.wpscan.com/ for service status.',
    ),
]

TARGET_PROBLEMS = [
    (
        'not-wordpress',
        'The remote website is up, but does not seem to be running WordPress.',
    ),
    ('redirect', 'The URL supplied redirects to https://example.com/.'),
    ('scan-timeout', 'Max Scan Duration Reached'),
    ('no-abort-at-all', ''),
]


class TestVulnApiFailure(unittest.TestCase):
    """Telling a refused vulnerability lookup from a problem with the target is what
    decides whether the scan is repeated without the token. The retry itself only happens
    against a real scanner, so it is the decision that is covered here.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()


def _is_a_lookup_problem(test, item):
    test.assertTrue(test.check.is_vuln_api_failure(item[1]))


def _is_not_a_lookup_problem(test, item):
    test.assertFalse(test.check.is_vuln_api_failure(item[1]))


class TestTokenEnvironment(unittest.TestCase):
    """Both credentials reach the scanner through the environment, never through its
    command line. What matters just as much is the opposite case: a run the check makes
    deliberately without one has to run without the one the monitoring user may have
    exported, or the retry after a rejected token repeats the very failure it exists to
    get past, and a locally held database aborts over an API token nobody configured.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def _env_of_a_run(self, token, enterprise_token=''):
        with mock.patch.object(
            self.check.lib.shell, 'shell_exec', return_value=(True, ('', '', 0))
        ) as fake:
            self.check.run_wpscan(['wpscan'], token, enterprise_token, 60)
        return fake.call_args.kwargs['env']

    def test_a_token_is_handed_over_through_the_environment(self):
        env = self._env_of_a_run('linuxfabrik')
        self.assertEqual(env[self.check.API_TOKEN_ENV], 'linuxfabrik')

    def test_an_enterprise_token_is_handed_over_through_the_environment(self):
        env = self._env_of_a_run('', 'linuxfabrik')
        self.assertEqual(env[self.check.ENTERPRISE_TOKEN_ENV], 'linuxfabrik')

    def test_no_token_removes_an_exported_one(self):
        # None is what lib.shell.shell_exec() reads as "remove this variable". An empty
        # string would not do: the scanner reads the variable itself and takes an empty
        # value for a rejected token rather than for no token at all.
        env = self._env_of_a_run('')
        self.assertIsNone(env[self.check.API_TOKEN_ENV])
        self.assertIsNone(env[self.check.ENTERPRISE_TOKEN_ENV])

    def test_the_token_never_reaches_the_command_line(self):
        with mock.patch.object(
            sys,
            'argv',
            [
                'wordpress-security-scan',
                '--url=https://www.example.com',
                '--api-token=linuxfabrik',
            ],
        ):
            args = self.check.parse_args()
        args.WPSCAN_OPTION = []
        self.assertNotIn(
            'linuxfabrik', ' '.join(self.check.build_wpscan_command(args, 'u'))
        )


class TestEnterpriseDbToken(unittest.TestCase):
    """A locally held copy of the vulnerability database is downloaded by the refresh call
    and used by the scan, and the scanner decides both times from the same token. It also
    refuses to run at all when an API token is set beside it, and it reads either of them
    from the environment on its own. Neither the refresh nor the mutual exclusion is
    reachable from the fixture-driven tests above, because both only happen on a real scan.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def _resolve(self, argv):
        """Return (token, enterprise_token, remaining raw options) the way main() works
        them out from the command line.
        """
        with mock.patch.object(sys, 'argv', ['wordpress-security-scan', *argv]):
            args = self.check.parse_args()
        if args.WPSCAN_OPTION is None:
            args.WPSCAN_OPTION = []
        # An exported credential would otherwise decide the outcome of these tests on the
        # machine running them, which is the very fallback under test here.
        with mock.patch.dict(os.environ, {}, clear=True):
            enterprise_token = self.check.resolve_enterprise_token(
                args, self.check.take_enterprise_token_option(args)
            )
            token = self.check.resolve_api_token(args)
        if enterprise_token and token:
            token = ''
        return token, enterprise_token, args.WPSCAN_OPTION

    def _refresh_env(self, token, enterprise_token):
        with mock.patch.object(
            self.check.lib.shell, 'shell_exec', return_value=(True, ('', '', 0))
        ) as fake:
            self.check.refresh_vulndb(token, enterprise_token, 60)
        return fake.call_args.kwargs['env']

    def test_the_parameter_reaches_the_refresh(self):
        _, enterprise_token, _ = self._resolve(
            ['--url=https://www.example.com', '--enterprise-db-token=linuxfabrik']
        )
        env = self._refresh_env('', enterprise_token)
        self.assertEqual(env[self.check.ENTERPRISE_TOKEN_ENV], 'linuxfabrik')

    def test_the_raw_option_still_reaches_the_refresh(self):
        # The spelling that predates the parameter of its own has to keep working.
        _, enterprise_token, _ = self._resolve(
            [
                '--url=https://www.example.com',
                '--wpscan-option=--enterprise-db-token=linuxfabrik',
            ]
        )
        env = self._refresh_env('', enterprise_token)
        self.assertEqual(env[self.check.ENTERPRISE_TOKEN_ENV], 'linuxfabrik')

    def test_the_raw_option_still_reaches_it_when_spelled_with_a_space(self):
        _, enterprise_token, _ = self._resolve(
            [
                '--url=https://www.example.com',
                '--wpscan-option=--enterprise-db-token',
                '--wpscan-option=linuxfabrik',
            ]
        )
        env = self._refresh_env('', enterprise_token)
        self.assertEqual(env[self.check.ENTERPRISE_TOKEN_ENV], 'linuxfabrik')

    def test_the_raw_option_leaves_the_command_line(self):
        # Either spelling: an argument is readable by every user on the host while the
        # scan runs, and only the `=` form is redacted in what --verbose prints.
        for argv in (
            ['--wpscan-option=--enterprise-db-token=linuxfabrik'],
            ['--wpscan-option=--enterprise-db-token', '--wpscan-option=linuxfabrik'],
        ):
            with self.subTest(argv=argv):
                _, _, remaining = self._resolve(
                    ['--url=https://www.example.com', *argv]
                )
                self.assertEqual(remaining, [])

    def test_an_unrelated_option_survives_the_strip(self):
        _, _, remaining = self._resolve(
            [
                '--url=https://www.example.com',
                '--wpscan-option=--enterprise-db-token=linuxfabrik',
                '--wpscan-option=--plugins-detection=aggressive',
            ]
        )
        self.assertEqual(remaining, ['--plugins-detection=aggressive'])

    def test_an_unrelated_option_stays_out_of_the_refresh(self):
        # The refresh has no target, so a scan option would only make it fail.
        with mock.patch.object(
            self.check.lib.shell, 'shell_exec', return_value=(True, ('', '', 0))
        ) as fake:
            self.check.refresh_vulndb('', 'linuxfabrik', 60)
        self.assertNotIn('--plugins-detection=aggressive', fake.call_args.args[0])

    def test_an_api_token_is_dropped_beside_a_local_database(self):
        # The scanner raises ConflictingApiTokens and gives up before it looks at the
        # site, a plain `--update` included. The local copy supplies the data anyway.
        token, enterprise_token, _ = self._resolve(
            [
                '--url=https://www.example.com',
                '--api-token=linuxfabrik',
                '--enterprise-db-token=linuxfabrik',
            ]
        )
        self.assertEqual(token, '')
        self.assertEqual(enterprise_token, 'linuxfabrik')


def run_without_test_mode(params, path=None):
    """Run the check for real, without `--test`, and return (retc, output).

    Everything the check does before it would talk to the scanner sits behind
    `if args.TEST is None:` and is therefore unreachable from the fixture-driven tests
    above. `path` replaces PATH for the run, so an empty one makes the scanner
    genuinely absent no matter what is installed on the machine running the tests.
    """
    env = dict(os.environ)
    if path is not None:
        env['PATH'] = path
    # A token in the environment of the developer running the tests would otherwise
    # change which branch the check takes.
    env.pop('WPSCAN_API_TOKEN', None)
    env.pop('WPSCAN_ENTERPRISE_DB_TOKEN', None)
    result = subprocess.run(
        [sys.executable, '../wordpress-security-scan', *params],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    return (result.returncode, result.stdout + result.stderr)


class TestScannerMissing(unittest.TestCase):
    """A missing `wpscan` is WARNING, not UNKNOWN: WordPress is a preferred target, so
    the scanner belongs on a host serving it, and its absence is a state the
    administrator has to fix. CONTRIBUTING cites this check as the reference
    implementation for that exception, so the behaviour is worth pinning down.
    """

    def test_warns_instead_of_going_unknown(self):
        retc, output = run_without_test_mode(
            ['--url=https://www.example.com', '--path=wordpress'], path=''
        )
        self.assertEqual(retc, STATE_WARN)
        self.assertIn('was not found', output)

    def test_names_the_searched_path(self):
        # The searched PATH is the one thing an admin cannot guess from the outside,
        # which is why the message carries it.
        _, output = run_without_test_mode(
            ['--url=https://www.example.com', '--path=wordpress'], path='/nonexistent'
        )
        self.assertIn('Searched in: /nonexistent', output)

    def test_always_ok_still_applies(self):
        retc, _ = run_without_test_mode(
            ['--url=https://www.example.com', '--path=wordpress', '--always-ok'],
            path='',
        )
        self.assertEqual(retc, STATE_OK)


class TestUrlOptionInjection(unittest.TestCase):
    """A URL that starts with `-` would be picked up by the scanner as one of its own
    options rather than as its target. The guard runs before the scanner is even looked
    for, so it holds whether or not `wpscan` is installed.
    """

    def test_refuses_an_option_style_url(self):
        retc, output = run_without_test_mode(
            ['--url=-oProxyCommand://evil', '--path=wordpress'], path=''
        )
        self.assertEqual(retc, STATE_UNKNOWN)
        self.assertIn('--url', output)
        self.assertIn('starts with', output)

    def test_a_scheme_less_url_is_completed_and_passes(self):
        # Completed to https://, so it no longer looks like an option and the run gets
        # as far as looking for the scanner.
        retc, output = run_without_test_mode(
            ['--url=www.example.com', '--path=wordpress'], path=''
        )
        self.assertEqual(retc, STATE_WARN)
        self.assertIn('was not found', output)


lib.lftest.attach_tests(TestCheck, TESTS)
lib.lftest.attach_each(
    TestVulnApiFailure,
    VULN_API_REFUSALS,
    _is_a_lookup_problem,
    id_func=lambda it: f'lookup-refused-{it[0]}',
)
lib.lftest.attach_each(
    TestVulnApiFailure,
    TARGET_PROBLEMS,
    _is_not_a_lookup_problem,
    id_func=lambda it: f'target-problem-{it[0]}',
)


# The union of wpscan's popular and vulnerable slugs is read from its own database, so
# these run against a miniature of it rather than against whatever the developer's
# machine happens to hold. No hook is added for it: `XDG_CACHE_HOME` is how wpscan
# itself finds the file (`DB_DIR` in `lib/wpscan.rb`), and `HOME` is redirected
# alongside it because the legacy `~/.wpscan/db` would win over it where it exists.
#
# The fixture deliberately does not sit under a `.cache` directory. The repository
# ignores that name, so a tree below it would never reach git and these tests would
# fail for everyone but the person who wrote them.
WPSCAN_DB_FIXTURE = os.path.abspath('fixtures/wpscan-db')
WPSCAN_DB_FIXTURE_HOME = os.path.abspath('fixtures/wpscan-db/no-legacy-db')

# (id, extra params, expected substrings, forbidden substrings)
UNION_SCENARIOS = [
    (
        # A locally held database answers every lookup for free, so the scan looks for
        # everything wpscan knows rather than for the vulnerable slugs alone.
        'enterprise-db-widens-the-scan',
        '--enterprise-db-token=linuxfabrik',
        [
            '--plugins-list=',
            '--themes-list=',
            '--enumerate=tt,cb,dbe,bf,u',
            'popular or vulnerable (3 plugins, 2 themes)',
        ],
        ['--enumerate=vp,vt'],
    ),
    (
        # Against the API each detected component costs a request out of a daily
        # allowance, so the scan stays narrow.
        'api-token-keeps-the-scan-narrow',
        '--api-token=linuxfabrik',
        ['--enumerate=vp,vt,tt,cb,dbe,bf,u'],
        ['--plugins-list=', 'Widened the scan'],
    ),
    (
        'no-token-keeps-the-downgrade',
        '',
        ['--enumerate=p,t,tt,cb,dbe,bf,u'],
        ['--plugins-list=', 'Widened the scan'],
    ),
    (
        # An explicit choice is an instruction, not a default to improve upon.
        'explicit-enumeration-is-left-alone',
        '--enterprise-db-token=linuxfabrik --wpscan-enumerate=vp,vt,u',
        ['--enumerate=vp,vt,u'],
        ['--plugins-list=', 'Widened the scan'],
    ),
]


def _run_union_scenario(test, scenario):
    scenario_id, extra, expected, forbidden = scenario
    env = dict(
        os.environ,
        HOME=WPSCAN_DB_FIXTURE_HOME,
        XDG_CACHE_HOME=WPSCAN_DB_FIXTURE,
    )
    result = subprocess.run(
        [
            'python3',
            '../wordpress-security-scan',
            '--url=https://www.example.com',
            '--path=wordpress',
            '--verbose',
            '--test=stdout/clean-site,,0',
            *extra.split(),
        ],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    out = result.stdout + result.stderr
    for text in expected:
        test.assertIn(text, out, f'{scenario_id}: missing {text!r}')
    for text in forbidden:
        test.assertNotIn(text, out, f'{scenario_id}: unexpected {text!r}')


def _no_leftover_temp_directory(test, scenario):
    """The slug lists live in a temporary directory that has to be gone afterwards."""
    scenario_id, extra, _, _ = scenario
    env = dict(
        os.environ,
        HOME=WPSCAN_DB_FIXTURE_HOME,
        XDG_CACHE_HOME=WPSCAN_DB_FIXTURE,
    )
    result = subprocess.run(
        [
            'python3',
            '../wordpress-security-scan',
            '--url=https://www.example.com',
            '--path=wordpress',
            '--verbose',
            '--test=stdout/clean-site,,0',
            *extra.split(),
        ],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    for line in (result.stdout + result.stderr).splitlines():
        for token in line.split():
            if token.startswith('--plugins-list=') or token.startswith(
                '--themes-list='
            ):
                path = token.split('=', 1)[1]
                test.assertFalse(
                    os.path.exists(os.path.dirname(path)),
                    f'{scenario_id}: {path} survived the run',
                )


lib.lftest.attach_each(
    TestCheck, UNION_SCENARIOS, _run_union_scenario, id_func=lambda it: f'union-{it[0]}'
)
lib.lftest.attach_each(
    TestCheck,
    [UNION_SCENARIOS[0]],
    _no_leftover_temp_directory,
    id_func=lambda it: f'union-{it[0]}-cleans-up',
)


if __name__ == '__main__':
    unittest.main()
