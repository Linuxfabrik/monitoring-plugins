        'assert-retc': STATE_OK,
        'assert-in': ['--random-user-agent'],
        'assert-not-in': ['--user-agent='],
    },
    # HTTP credentials reach the scanner on its command line, because it accepts them
    # nowhere else. They must never reach the check's own output, which is mailed and
    # stored: the printed command shows the option with its value redacted.
    {
        'id': 'ok-http-auth-is-redacted-in-the-printed-command',
