    # The file wins over the command line, the way --password-file wins over --password
    # everywhere else. Where both are configured, an unreadable file therefore stops the
    # check instead of quietly falling back to the token in the process list.
    {
        'id': 'unknown-token-file-wins-over-token',
        'test': 'stdout/clean-site,,0',
