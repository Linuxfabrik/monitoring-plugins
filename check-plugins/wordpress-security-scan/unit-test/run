    },
    # Perfdata can be suppressed without touching the verdict.
    {
        'id': 'crit-no-perfdata',
        'test': 'stdout/vuln-high-cvss,,5',
        'params': f'{BASE_PARAMS} --no-perfdata',
        'assert-retc': STATE_CRIT,
        'assert-not-in': ["'vulnerabilities'="],
    },
    # wpscan running out of its own time budget is a timeout, not a broken run, so it
    # ends in the same state as the hard subprocess timeout.
    {
        'id': 'warn-total-timeout',
        'test': 'stdout/scan-timeout,,4',
        'params': f'{BASE_PARAMS} --total-timeout=120',
        'assert-retc': STATE_WARN,
