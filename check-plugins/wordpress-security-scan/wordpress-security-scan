DESCRIPTION = """Runs a WordPress security scan against a site and reports what an attacker can see
from the outside. Combines the black box scan with the inventory read from the local installation
directory, so plugins and themes the scanner cannot fingerprint remotely are still listed with their
installed version. Findings are split into three classes: known vulnerabilities from the scanner's
vulnerability database, exposures that hand an attacker credentials, the database or an account
(a readable wp-config backup, an SQL dump, a listable backup folder), and hardening findings such as
outdated components or a reachable readme. Alerts CRITICAL on an exposure and on a vulnerability whose
CVSS base score reaches the critical threshold, because both mean the site can be taken over right now
and someone has to react immediately. Everything else alerts WARNING. Supports extended reporting via
--lengthy. Requires the command-line tool wpscan."""

# CVSS v3 base score at or above which a vulnerability is treated as critical. 7.0 is
# the lower bound of the "High" severity band and matches how wpscan itself maps scores
# to levels in its SARIF output.
DEFAULT_CRITICAL_CVSS = 7.0
DEFAULT_INSECURE = False
DEFAULT_LENGTHY = False
DEFAULT_NO_MATCH_SEVERITY = 'ok'
DEFAULT_PATH = '/var/www/html/wordpress'
DEFAULT_SCAN_TIMEOUT = 600
DEFAULT_UNSCORED_SEVERITY = 'warn'
DEFAULT_VERBOSE = False
DEFAULT_WPSCAN_ENUMERATE = 'vp,vt,tt,cb,dbe,bf,u'

# Name of the environment variable wpscan reads its API token from. The token is handed
# over this way instead of on the command line so it never shows up in the process list.
API_TOKEN_ENV = 'WPSCAN_API_TOKEN'  # nosec B105

# Seconds subtracted from --scan-timeout to get wpscan's own --max-scan-duration, so
# wpscan aborts itself and still writes a valid JSON document. Only if that fails does
# the hard subprocess timeout hit, which leaves us without any output at all.
SCAN_TIMEOUT_HEADROOM = 30

# What wpscan puts into `scan_aborted` when it runs out of its own time budget
# (WPScan::Error::MaxScanDurationReached). Reported as a timeout rather than as a broken
# run, so both timeout paths of this check end in the same state.
SCAN_TIMEOUT_MARKER = 'Max Scan Duration Reached'

# Top level JSON sections whose mere presence is an exposure: each entry is a file or
# directory reachable over HTTP that leaks credentials, the database, or both.
EXPOSURE_SECTIONS = {
    'backup_folders': 'Backup folder with directory listing',
    'config_backups': 'Readable wp-config backup',
    'db_exports': 'Readable database export',
}

# `interesting_findings[].type` values that are exposures. The type is the wpscan model
# class name in snake_case (see app/models/interesting_finding.rb).
EXPOSURE_FINDING_TYPES = (
    'backup_db',
    'debug_log',
    'duplicator_installer_log',
    'emergency_pwd_reset_script',
    'search_replace_db2',
    'tmm_db_migrate',
    'upload_sql_dump',
)

# `interesting_findings[].type` values that describe how the site is set up rather than
# a weakness. A multisite install or an enabled XML-RPC endpoint is the WordPress
# default, so alerting on them would leave the check permanently non-OK everywhere.
INFO_FINDING_TYPES = (
    'headers',
    'multisite',
    'mu_plugins',
    'php_disabled',
    'robots_txt',
    'xmlrpc',
)

# Core version states wpscan reports. Anything but `latest` means the installed core is
# behind; `insecure` additionally means the vulnerability database flags it.
CORE_STATUS_INSECURE = ('insecure', 'insecure-via-api')
CORE_STATUS_OUTDATED = ('outdated', 'outdated-via-api')


