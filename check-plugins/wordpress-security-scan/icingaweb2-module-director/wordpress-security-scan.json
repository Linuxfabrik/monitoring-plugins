    "ServiceTemplate": {
        "tpl-service-wordpress-security-scan": {
            "action_url": null,
            "apply_for": null,
            "assign_filter": null,
            "check_command": "cmd-check-wordpress-security-scan",
            "check_interval": 86400,
            "check_period": null,
            "check_timeout": null,
            "command_endpoint": null,
            "disabled": false,
            "display_name": null,
            "enable_active_checks": null,
            "enable_event_handler": null,
            "enable_flapping": null,
            "enable_notifications": true,
            "enable_passive_checks": null,
            "enable_perfdata": true,
            "event_command": null,
            "fields": [],
            "flapping_threshold_high": null,
            "flapping_threshold_low": null,
            "groups": [],
            "host": null,
            "icon_image": "wordpress-security-scan.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 1,
            "notes": "Runs a WordPress security scan against a site and reports what an attacker can see from the outside. Combines the black box scan with the inventory read from the local installation directory, so plugins and themes the scanner cannot fingerprint remotely are still listed with their installed version. Findings are split into three classes: known vulnerabilities from the scanner's vulnerability database, exposures that hand an attacker credentials, the database or an account (a readable wp-config backup, an SQL dump, a listable backup folder), and hardening findings such as outdated components or a reachable readme. Alerts CRITICAL on an exposure and on a vulnerability whose CVSS base score reaches the critical threshold, because both mean the site can be taken over right now and someone has to react immediately. Everything else alerts WARNING. The vulnerability database is only queried with an API token; without one the check says so instead of reporting a clean result it could not verify. Supports extended reporting via --lengthy. Requires the command-line tool wpscan, version 4.0.0 or newer for the backup folder enumeration.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/wordpress-security-scan/",
            "object_name": "tpl-service-wordpress-security-scan",
            "object_type": "template",
            "retry_interval": 3600,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "wordpress_security_scan_always_ok": false,
                "wordpress_security_scan_critical_cvss": 7.0,
                "wordpress_security_scan_ignore": [],
                "wordpress_security_scan_insecure": false,
                "wordpress_security_scan_lengthy": true,
                "wordpress_security_scan_match": [],
                "wordpress_security_scan_no_match_severity": "ok",
                "wordpress_security_scan_no_perfdata": false,
                "wordpress_security_scan_no_vuln_data_severity": "ok",
                "wordpress_security_scan_path": "/var/www/html/wordpress",
                "wordpress_security_scan_scan_timeout": 600,
                "wordpress_security_scan_unscored_severity": "warn",
                "wordpress_security_scan_verbose": false,
                "wordpress_security_scan_wpscan_enumerate": "vp,vt,tt,cb,dbe,bf,u",
                "wordpress_security_scan_wpscan_no_update": false,
                "wordpress_security_scan_wpscan_option": []
            },
            "volatile": null,
            "zone": null,
            "uuid": "0651b2db-0616-4e06-9cee-8b552ce802dc"
        }
    },
