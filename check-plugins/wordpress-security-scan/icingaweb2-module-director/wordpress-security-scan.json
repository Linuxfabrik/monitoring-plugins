    "Datafield": {
        "1": {
            "varname": "wordpress_security_scan_always_ok",
            "caption": "Wordpress Security Scan: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "b4cd2297-aa62-4f87-ae17-a183f1b995eb"
        },
        "2": {
            "varname": "wordpress_security_scan_api_token",
            "caption": "Wordpress Security Scan: Api Token",
            "description": "WPScan API token, used to look up known vulnerabilities. Without a token the scan still runs, but reports no vulnerability data at all; the check then says so and --no-vuln-data-severity decides whether it alerts. The token is handed to wpscan through the environment, never on the command line, so it does not show up in the process list. Takes precedence over --api-token-file and over a token already present in the WPSCAN_API_TOKEN environment variable.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "87d83b23-f778-4945-9ad2-cbe94b447209"
        },
        "3": {
            "varname": "wordpress_security_scan_api_token_file",
            "caption": "Wordpress Security Scan: Api Token File",
            "description": "Path to the file containing the WPScan API token. Use this instead of --api-token to keep the token out of the monitoring configuration. Only the first line is read, surrounding whitespace is stripped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "9484b1f8-021f-41c3-a623-11cb00e27280"
        },
        "4": {
            "varname": "wordpress_security_scan_critical_cvss",
            "caption": "Wordpress Security Scan: Critical Cvss",
            "description": "CVSS v3 base score at or above which a known vulnerability is reported as CRITICAL instead of WARNING. Vulnerabilities without a score are governed by --unscored-severity.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8aa1c6d6-822c-4ac9-a299-77c941663846"
        },
        "5": {
            "varname": "wordpress_security_scan_ignore",
            "caption": "Wordpress Security Scan: Ignore",
            "description": "Ignore findings whose component or title matches this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Example: `--ignore=\"^akismet$\"` to accept the risk of one component.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c6e8e672-6aac-4421-bfa8-21abf332950e"
        },
        "6": {
            "varname": "wordpress_security_scan_insecure",
            "caption": "Wordpress Security Scan: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "108274e0-c06f-4552-96c9-4659a3667fc7"
        },
        "7": {
            "varname": "wordpress_security_scan_lengthy",
            "caption": "Wordpress Security Scan: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "169d33e2-31e1-4f68-a1ce-578c8aafd8ed"
        },
        "8": {
            "varname": "wordpress_security_scan_match",
            "caption": "Wordpress Security Scan: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f385d4cc-30f1-4a8e-80a2-d1202909a00b"
        },
        "9": {
            "varname": "wordpress_security_scan_no_match_severity",
            "caption": "Wordpress Security Scan: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "wordpress_security_scan_no_match_severity_list"
            },
            "uuid": "d5f66a58-f8e6-404a-8579-e4a8f8b280af"
        },
        "10": {
            "varname": "wordpress_security_scan_no_perfdata",
            "caption": "Wordpress Security Scan: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "eaec6698-8749-46c4-b565-92fd66543319"
        },
        "11": {
            "varname": "wordpress_security_scan_no_vuln_data_severity",
            "caption": "Wordpress Security Scan: No Vuln Data Severity",
            "description": "State to report when the vulnerability database could not be queried and no vulnerability data is available. The check still reports everything it can determine without that data, but a clean result then only means nothing else was found, not that the target is free of known vulnerabilities.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "wordpress_security_scan_no_vuln_data_severity_list"
            },
            "uuid": "4b11d929-c48d-40b5-9f76-35315c23b59a"
        },
        "12": {
            "varname": "wordpress_security_scan_path",
            "caption": "Wordpress Security Scan: Path",
            "description": "Local path to your WordPress installation, typically within your Webserver's Document Root. Read to determine the installed core version and the installed plugins and themes, which the remote scan on its own cannot see completely, and to determine the site URL when --url is not given. A path that does not exist is not an error: the check then reports what the remote scan found and says so.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "50384668-fb06-4304-9fb6-3ff00a057882"
        },
        "13": {
            "varname": "wordpress_security_scan_scan_timeout",
            "caption": "Wordpress Security Scan: Scan Timeout",
            "description": "Seconds to wait for the scan to finish. A full scan of a site with many plugins takes minutes, so this is much higher than the network timeout of other checks.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "89c19269-ebc2-425d-b1ec-41664be96245"
        },
        "14": {
            "varname": "wordpress_security_scan_unscored_severity",
            "caption": "Wordpress Security Scan: Unscored Severity",
            "description": "State to report for a known vulnerability that carries no CVSS score. The vulnerability database has no score for a large share of its entries, so treating them all as critical would page for every one of them.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "wordpress_security_scan_unscored_severity_list"
            },
            "uuid": "5e42290b-45a5-4f7e-b72c-dd7ac6cdfe8a"
        },
        "15": {
            "varname": "wordpress_security_scan_url",
            "caption": "Wordpress Security Scan: URL",
            "description": "URL of the WordPress site to scan. If not specified, it is taken from the `WP_HOME` or `WP_SITEURL` constant of the installation below --path, which only works where the installation pins them and the configuration file is readable. Example: `--url=https://www.example.com`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ace917b6-185b-4f2f-a854-a0381cf3f007"
        },
        "16": {
            "varname": "wordpress_security_scan_verbose",
            "caption": "Wordpress Security Scan: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "404345b3-f30f-406b-992f-1958a35d7e30"
        },
        "17": {
            "varname": "wordpress_security_scan_wpscan_enumerate",
            "caption": "Wordpress Security Scan: Wpscan Enumerate",
            "description": "Enumeration options passed to wpscan (its `--enumerate`). Comma-separated. `vp`/`vt` (vulnerable plugins/themes) need vulnerability data and are downgraded to `p`/`t` automatically when none is available, because wpscan aborts otherwise. `bf` (backup folders) needs wpscan 4.0.0 or newer and is dropped automatically on older releases, which reject it as an unknown choice.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b034ccd0-3653-4ee5-aea9-d483969578cf"
        },
        "18": {
            "varname": "wordpress_security_scan_wpscan_no_update",
            "caption": "Wordpress Security Scan: Wpscan No Update?",
            "description": "Skip the update of the local vulnerability database before scanning. Speeds up the check, at the price of scanning against possibly stale vulnerability data.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "35889eb8-6903-46ec-983b-98bb39f50033"
        },
        "19": {
            "varname": "wordpress_security_scan_wpscan_option",
            "caption": "Wordpress Security Scan: Wpscan Option",
            "description": "Additional raw option to pass to the wpscan call, for options that have no dedicated parameter here. Can be specified multiple times. Example: `--wpscan-option=--plugins-detection=aggressive`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "84ee7d12-7c4d-4fab-8b90-78e5e678baec"
        }
    }
