import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# The task paths are quoted, as the params are split like a shell command line.
# de-lf-test-tasks is the task list the check reads, captured through the Icinga 2
# agent (LocalSystem) on Windows Server 2025 with the de-DE display language. Next to
# the tasks Windows ships, it holds test tasks below \LF\ that were brought into each
# state for real: run with exit code 0 and 1, never run, disabled, still running,
# stopped by the execution time limit, pointing to a missing program, and one with an
# umlaut in its name.
FIXTURE = 'stdout/de-lf-test-tasks,,0'

TESTS = [
    {
        'id': 'ok-last-run-succeeded',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-OK'",
        'assert-retc': STATE_OK,
        'assert-in': [r'\LF\LF-OK is Ready, last run 2026-09-27 02:53:12 succeeded'],
    },
    {
        'id': 'warn-last-run-exit-code-1',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Fail'",
        'assert-retc': STATE_WARN,
        'assert-in': [
            r'\LF\LF-Fail is Ready, last run 2026-09-27 02:53:12 returned 0x1 [WARNING]'
        ],
    },
    {
        'id': 'crit-last-run-exit-code-1-severity-crit',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Fail' --severity=crit",
        'assert-retc': STATE_CRIT,
        'assert-in': ['returned 0x1 [CRITICAL]'],
    },
    {
        # the COM object reports 0x80070002 as a negative number
        'id': 'warn-program-missing',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Missing'",
        'assert-retc': STATE_WARN,
        'assert-in': ['returned 0x80070002 [WARNING]'],
    },
    {
        'id': 'warn-stopped-by-execution-time-limit',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Timeout'",
        'assert-retc': STATE_WARN,
        'assert-in': ['returned 0x41306 [WARNING]'],
    },
    {
        'id': 'ok-has-not-run-yet',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Never'",
        'assert-retc': STATE_OK,
        'assert-in': [r'\LF\LF-Never is Ready, has not run yet'],
    },
    {
        'id': 'ok-running',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Running'",
        'assert-retc': STATE_OK,
        'assert-in': [r'\LF\LF-Running is Running, running since 2026-09-27 02:53:12'],
    },
    {
        'id': 'warn-disabled-by-default',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Disabled'",
        'assert-retc': STATE_WARN,
        'assert-in': [
            r'\LF\LF-Disabled is Disabled [WARNING], but supposed to be Ready or Running'
        ],
    },
    {
        # --status replaces the default instead of adding to it
        'id': 'ok-disabled-expected',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Disabled' --status=Disabled",
        'assert-retc': STATE_OK,
        'assert-in': [r'\LF\LF-Disabled is Disabled'],
        'assert-not-in': ['has not run yet', 'supposed to be'],
    },
    {
        'id': 'warn-ready-but-disabled-expected',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-OK' --status=Disabled",
        'assert-retc': STATE_WARN,
        'assert-in': [r'\LF\LF-OK is Ready [WARNING], but supposed to be Disabled'],
    },
    {
        'id': 'ok-running-expected-only',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Running' --status=Running",
        'assert-retc': STATE_OK,
    },
    {
        'id': 'ok-case-insensitive-without-leading-backslash',
        'test': FIXTURE,
        'params': r"--task='lf\lf-ok'",
        'assert-retc': STATE_OK,
        'assert-in': [r'\LF\LF-OK is Ready'],
    },
    {
        'id': 'ok-umlaut-in-task-name',
        'test': FIXTURE,
        'params': r"--task='\LF\Sub\LF-Prüfung'",
        'assert-retc': STATE_OK,
        'assert-in': [r'\LF\Sub\LF-Prüfung is Ready'],
    },
    {
        'id': 'ok-windows-task',
        'test': FIXTURE,
        'params': r"--task='\Microsoft\Windows\Defrag\ScheduledDefrag'",
        'assert-retc': STATE_OK,
        'assert-in': [r'\Microsoft\Windows\Defrag\ScheduledDefrag is Ready'],
    },
    {
        'id': 'ok-always-ok-masks-warn',
        'test': FIXTURE,
        'params': r"--task='\LF\LF-Fail' --always-ok",
        'assert-retc': STATE_OK,
        'assert-in': ['returned 0x1 [WARNING]'],
    },
    {
        'id': 'unknown-task-not-found',
        'test': FIXTURE,
        'params': r"--task='\LF\does-not-exist'",
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [r'Scheduled task `\LF\does-not-exist` not found.'],
        'assert-not-in': ['Traceback'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../scheduled-task'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
