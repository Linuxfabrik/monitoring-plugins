    {
        'id': 'ok-parses-status-version-1',
        'test': 'stdout/openvpn27-v1-ipv4-and-ipv6-client,,0',
        'assert-retc': STATE_OK,
        'assert-regex': r'client01 +! 192\.168\.100\.157 +! 192\.168\.42\.3 ',
