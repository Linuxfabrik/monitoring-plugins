import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        # A charging backup battery unit (RUNNINGSTATUS 48) is a normal
        # operating state and must not raise a warning. Regression guard for
        # the running-status translation, which previously returned 'Unknown'
        # for code 48 and therefore flagged charging BBUs as WARN.
        'id': 'ok-bbu-charging',
        'test': 'stdout/bbu-charging,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.'],
    },
    {
        'id': 'warn-psu-running-warning',
        'test': 'stdout/psu-running-warning,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings.',
            'UUID       ! Location   ! Produced   ! ControllerID ! #Discharged ! Remain '
            '! Volt ! Health     ! Running          ! State',
            '-----------+------------+------------+--------------+-------------+--------'
            '+------+------------+------------------+----------',
            # The voltage is documented as tenths of a volt, so 161 reads as 16.1.
            '210:0.0A.0 ! CTE0.PSU 0 ! 2014-3-25  ! 0A           ! 7           ! 5Y 4M  '
            '! 16.1 ! Normal (1) ! Discharging (50) ! [WARNING]',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the inventory ones out.
        'id': 'warn-psu-running-warning-core-columns',
        'test': 'stdout/psu-running-warning,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'UUID       ! Location   ! Remain ! Volt ! Health     ! Running          ! State',
            '210:0.0A.0 ! CTE0.PSU 0 ! 5Y 4M  ! 16.1 ! Normal (1) ! Discharging (50) ! [WARNING]',
        ],
        'assert-not-in': ['ControllerID', '#Discharged'],
    },
    {
        # Real-shape BBUs (V700R001C10SPH128, Dorado 6000 V6) with REMAINLIFEDAYS
        # lowered to 100 and 20 days. The threshold that fired has to show up on the
        # Remain value and in the row's State, not only in the overall state above a
        # table of [OK] rows. A module reporting -1 keeps its dash and stays OK.
        'id': 'crit-bbu-remaining-life-marks-row',
        'test': 'stdout/bbu-remaining-life-low,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            '210:0.0A.0 ! CTE0.BBU0 ! 3M 1W [WARNING]  ! 15.9 ! Normal (1) '
            '! Online (27) ! [WARNING]',
            '210:0.0B.0 ! CTE0.BBU1 ! 2W 6D [CRITICAL] ! 15.9 ! Normal (1) '
            '! Online (27) ! [CRITICAL]',
            '210:1.1A.0 ! CTE1.BBU0 ! --               ! 15.9 ! Normal (1) '
            '! Online (27) ! [OK]',
        ],
    },
    {
        # A voltage threshold that fired decides the row's State as well.
        'id': 'warn-bbu-voltage-marks-row',
        'test': 'stdout/bbu-remaining-life-low,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost '
        '--username=admin --critical=10: --warning=10: --warning-voltage=16:',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '210:1.1A.0 ! CTE1.BBU0 ! --     ! 15.9 [WARNING] ! Normal (1) '
            '! Online (27) ! [WARNING]',
        ],
    },
    {
        # An appliance always has backup power modules. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-backup-power-modules',
        'test': 'stdout/no-backup-power-modules,,0',
        'params': '--device-id=1 --password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no backup power modules.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-backup-power'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
