"""Unit tests for the wordpress-checksums check.

Two fixtures drive every testcase. `wordpress/` holds small WordPress trees the check reads
from disk, and `stdout/` holds what wordpress.org would have answered for them, in the
shape the check's own fetchers return. Pairing one tree with a different answer is what
produces a modified, an added or a missing file without any tree having to be tampered
with, and the network is never touched.

`--test` injects behind the fetch, so no fixture reaches the layer that builds a request,
reads the cache and decides what a refusal or an outage means. That layer is exercised
directly further down, by importing the check as a module and standing in for the network
and the cache, which is also where a damaged answer from wordpress.org is covered.
"""

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.lftest
import lib.time
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

SITE = '--path=wordpress/site'
EXTRAS = '--path=wordpress/site-extras'
DE = '--path=wordpress/site-de'
# An installation carrying a plugin in `wp-content/plugins/core/`, which is a legal
# directory name and must not be mistaken for the WordPress core.
CORE_PLUGIN = '--path=wordpress/site-core-plugin'
# An installation whose plugin ships its readme as `README.txt`, which the plugin
# directory reads just as it reads the lowercase spelling.
UPPERCASE_README = '--path=wordpress/site-uppercase-readme'

TESTS = [
    # Everything matches. Five files are verified: three below wp-admin/ and
    # wp-includes/, one root file, and the plugin's own. `index.php`, `readme.html` and
    # the plugin's `readme.txt` are outside the scope on purpose and must not turn up.
    {
        'id': 'ok-clean-installation',
        'test': 'stdout/clean,,0',
        'params': f'{SITE}',
        'assert-retc': STATE_OK,
        'assert-in': [
            'WordPress v6.8.2 (en_US)',
            '2 of 2 components',
            'No checksum violations found.',
            "'files_checked'=5",
        ],
        'assert-not-in': ['index.php', 'readme.html', '[WARNING]'],
    },
    # A core file whose content no longer matches what wordpress.org published.
    {
        'id': 'warn-core-file-modified',
        'test': 'stdout/modified,,0',
        'params': f'{SITE}',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 modified', 'wp-includes/version.php', 'modified'],
        'assert-regex': r'wp-includes/version\.php.*modified.*\[WARNING\]',
