class TestCheck(unittest.TestCase):
    check = '../wordpress-checksums'


class TestTotalTimeout(unittest.TestCase):
    """The whole run shares one network budget, not one per component. Without it a host
    that cannot reach wordpress.org waits --timeout seconds per component and is killed
    by the monitoring agent before it prints anything.

    Run without `--test`, because the fixtures are injected behind the fetch and the
    budget is what decides whether that fetch happens at all. A budget of zero leaves no
    room for a single request, so nothing is asked and the network stays untouched. The
    run gets a temporary directory of its own, because the cache would otherwise answer
    out of whatever a real run on this machine left behind.
    """

    def test_a_spent_budget_asks_for_nothing_and_says_so(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            env = dict(os.environ, TMPDIR=tmpdir)
            result = subprocess.run(
                [
                    sys.executable,
                    '../wordpress-checksums',
                    '--path=wordpress/site',
                    '--total-timeout=0',
                ],
                capture_output=True,
                text=True,
                env=env,
                check=False,
            )
        output = result.stdout + result.stderr
        self.assertEqual(result.returncode, STATE_UNKNOWN)
        self.assertIn('Could not obtain any checksums', output)
        self.assertIn('--total-timeout', output)


def load_check():
    """Import the check as a module, so the helpers can be exercised directly."""
    loader = importlib.machinery.SourceFileLoader(
        'wordpress_checksums', '../wordpress-checksums'
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class FetchArgs:
    """The handful of parsed options the fetch layer reads."""

    ALWAYS_OK = False
    CACHE_EXPIRE = 1440
    INSECURE = False
    NO_PROXY = False
    PROXY = None
    TIMEOUT = 8
    TOTAL_TIMEOUT = 45


class TestUrlComponent(unittest.TestCase):
    """A slug and a version are read off the filesystem below a tree the web server can
    usually write to, so both are attacker-controlled wherever it is, and both end up as
    a path segment of a request. The fixture-driven tests above cannot reach this: they
    are injected behind the fetch, where no URL is built any more.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def test_keeps_an_ordinary_value(self):
        self.assertEqual(self.check.url_component('contact-form-7'), 'contact-form-7')

    def test_encodes_the_separator(self):
        # The whole point: a traversal stays inside its own path segment instead of
        # climbing out of it.
        self.assertEqual(self.check.url_component('../../etc'), '..%2F..%2Fetc')

    def test_encodes_whitespace_and_query_characters(self):
        self.assertEqual(self.check.url_component('a b?c#d'), 'a%20b%3Fc%23d')

    def test_refuses_an_empty_value(self):
        self.assertEqual(self.check.url_component(''), '')

    def test_refuses_an_overlong_value(self):
        long_value = 'a' * (self.check.MAX_URL_COMPONENT + 1)
        self.assertEqual(self.check.url_component(long_value), '')

    def test_accepts_a_value_at_the_limit(self):
        limit_value = 'a' * self.check.MAX_URL_COMPONENT
        self.assertEqual(self.check.url_component(limit_value), limit_value)


class TestRemainingTimeout(unittest.TestCase):
    """What is left of the run's shared budget, which is what stops the check from
    spending --timeout seconds per component on a host that cannot reach wordpress.org.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def test_a_wide_budget_leaves_the_single_request_timeout(self):
        deadline = lib.time.now() + 300
        self.assertEqual(
            self.check.remaining_timeout(FetchArgs, deadline), FetchArgs.TIMEOUT
        )

    def test_a_narrow_budget_wins_over_the_single_request_timeout(self):
        deadline = lib.time.now() + 3
        self.assertLessEqual(self.check.remaining_timeout(FetchArgs, deadline), 3)

    def test_a_spent_budget_is_zero_rather_than_negative(self):
        deadline = lib.time.now() - 60
        self.assertEqual(self.check.remaining_timeout(FetchArgs, deadline), 0)


class TestCoreChecksumShape(unittest.TestCase):
    """The core endpoint answers with a flat map of paths to digests, but it wraps that
    map in another layer keyed by the version when it answers for a whole release rather
    than for the request. WordPress carries the same unwrapping in its own updater.

    Without it the version number itself reads as a file the release shipped and is
    reported as missing, while every real file of the installation is reported as one
    the release never shipped - thousands of findings on an untouched installation.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def test_a_flat_map_is_passed_through(self):
        flat = {'wp-admin/about.php': 'd41d8cd98f00b204e9800998ecf8427e'}
        self.assertEqual(self.check.unwrap_core_checksums(flat, '6.8.2'), flat)

    def test_a_map_wrapped_in_the_version_is_unwrapped(self):
        inner = {'wp-admin/about.php': 'd41d8cd98f00b204e9800998ecf8427e'}
        self.assertEqual(
            self.check.unwrap_core_checksums({'6.8.2': inner}, '6.8.2'), inner
        )

    def test_a_path_that_looks_like_a_version_is_not_unwrapped(self):
        # The wrapper is keyed by the version that was asked for, so a map that happens
        # to hold a different key of that shape stays what it is.
        flat = {'6.8.1': 'd41d8cd98f00b204e9800998ecf8427e'}
        self.assertEqual(self.check.unwrap_core_checksums(flat, '6.8.2'), flat)

    def test_nothing_published_stays_nothing_published(self):
        for answer in (False, None, {}, [], 'no'):
            self.assertIsNone(self.check.unwrap_core_checksums(answer, '6.8.2'))


class TestGetChecksums(unittest.TestCase):
    """The layer between the two endpoints and the comparison: what a refusal, an outage
    and a still-valid cache entry each turn into. The fixtures above stand in for its
    result, so nothing here is covered by them.
    """

    @classmethod
    def setUpClass(cls):
        cls.check = load_check()

    def _get(self, timeout=8):
        return self.check.get_checksums(
            FetchArgs,
            key='plugin:acme:1.0',
            endpoint='https://downloads.example/acme/1.0.json',
            extract=lambda data: data.get('files') or None,
            algorithm='sha256',
            timeout=timeout,
        )

    def test_a_spent_budget_asks_nothing_and_names_the_parameter(self):
        with (
            mock.patch('lib.cache.get', return_value=None),
            mock.patch('lib.url.fetch') as fetch,
        ):
            result = self._get(timeout=0)
        fetch.assert_not_called()
        self.assertEqual(result['checksums'], {})
        self.assertTrue(result['published'])
        self.assertIn('--total-timeout', result['error'])

    def test_a_404_means_nothing_is_published_rather_than_an_error(self):
        # The plugin endpoint says "I have nothing for this" with a 404, where the core
        # endpoint answers 200 with a falsy payload. Both have to arrive as the same
        # thing, because neither is a problem the administrator can fix on this host.
        with (
            mock.patch('lib.cache.get', return_value=None),
            mock.patch('lib.url.fetch', return_value=(False, {'status_code': 404})),
        ):
            result = self._get()
        self.assertFalse(result['published'])
        self.assertEqual(result['error'], '')

    def test_an_empty_payload_means_nothing_is_published(self):
        answer = (True, {'response': json.dumps({'files': {}}), 'status_code': 200})
        with (
            mock.patch('lib.cache.get', return_value=None),
            mock.patch('lib.url.fetch', return_value=answer),
        ):
            result = self._get()
        self.assertFalse(result['published'])

    def test_a_fresh_cache_entry_is_served_without_asking(self):
        entry = {
            'value': json.dumps({'acme.php': 'aa'}),
            'timestamp': lib.time.now() + 600,
        }
        with (
            mock.patch('lib.cache.get', return_value=entry),
            mock.patch('lib.url.fetch') as fetch,
        ):
            result = self._get()
        fetch.assert_not_called()
        self.assertEqual(result['checksums'], {'acme.php': 'aa'})
        self.assertFalse(result['stale'])

    def test_an_answer_is_cached_and_the_predecessors_are_pruned(self):
        # The key carries the version, so every release would otherwise leave its
        # predecessor behind unasked for and the database would grow without end.
        answer = (
            True,
            {'response': json.dumps({'files': {'acme.php': 'bb'}}), 'status_code': 200},
        )
        with (
            mock.patch('lib.cache.get', return_value=None),
            mock.patch('lib.url.fetch', return_value=answer),
            mock.patch('lib.cache.set') as cache_set,
            mock.patch('lib.cache.prune') as prune,
        ):
            result = self._get()
        self.assertEqual(result['checksums'], {'acme.php': 'bb'})
        cache_set.assert_called_once()
        prune.assert_called_once()

    def test_an_expired_entry_carries_a_failed_refresh(self):
        # The digests of a released version never change, so an outdated copy verifies
        # exactly as well as a current one. The caller is told, so the output can say
        # that a component released since the outage began is not covered.
        expired = lib.time.now() - 3600
        entry = {'value': json.dumps({'acme.php': 'cc'}), 'timestamp': expired}
        with (
            mock.patch('lib.cache.get', return_value=entry),
            mock.patch('lib.url.fetch', return_value=(False, 'connection refused')),
        ):
            result = self._get()
        self.assertEqual(result['checksums'], {'acme.php': 'cc'})
        self.assertTrue(result['stale'])
        self.assertEqual(result['expired'], expired)
        self.assertEqual(result['error'], 'connection refused')

    def test_a_damaged_entry_is_worth_no_more_than_a_missing_one(self):
        entry = {'value': 'not json at all', 'timestamp': lib.time.now() + 600}
        answer = (
            True,
            {'response': json.dumps({'files': {'acme.php': 'dd'}}), 'status_code': 200},
        )
        with (
            mock.patch('lib.cache.get', return_value=entry),
            mock.patch('lib.url.fetch', return_value=answer),
            mock.patch('lib.cache.set'),
            mock.patch('lib.cache.prune'),
        ):
            result = self._get()
        self.assertEqual(result['checksums'], {'acme.php': 'dd'})
        self.assertFalse(result['stale'])


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
