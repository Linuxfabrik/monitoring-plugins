                "wordpress_checksums_always_ok": false,
                "wordpress_checksums_cache_expire": 1440,
                "wordpress_checksums_ignore": [],
                "wordpress_checksums_insecure": false,
                "wordpress_checksums_lengthy": true,
                "wordpress_checksums_match": [],
                "wordpress_checksums_no_checksum_data_severity": "ok",
                "wordpress_checksums_no_match_severity": "ok",
                "wordpress_checksums_no_perfdata": false,
                "wordpress_checksums_no_proxy": false,
                "wordpress_checksums_path": "/var/www/html/wordpress",
                "wordpress_checksums_severity": "warn",
                "wordpress_checksums_timeout": 8,
                "wordpress_checksums_total_timeout": 45,
                "wordpress_checksums_unreachable_severity": "ok"
