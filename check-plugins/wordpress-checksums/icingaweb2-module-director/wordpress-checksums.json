            "max_check_attempts": 5,
            "notes": "Verifies the files of a local WordPress installation against the checksums wordpress.org publishes for the installed release, and reports every file that was modified, added or removed since. Covers the core and every plugin from the plugin directory. Alerts when a file does not match, which on a server nobody has hand-patched means the installation was tampered with. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/wordpress-checksums/",
            "object_name": "tpl-service-wordpress-checksums",
            "object_type": "template",
            "retry_interval": 3600,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
