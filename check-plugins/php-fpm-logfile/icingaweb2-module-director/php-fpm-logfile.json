        "8": {
            "varname": "php_fpm_logfile_ignore",
            "caption": "PHP-FPM Logfile: Ignore",
            "description": "Ignore a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. Example: `--ignore='(?i)linuxfabrik'`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "852f3fa7-35ea-4cff-b733-f7653a21804a"
        },
        "9": {
            "varname": "php_fpm_logfile_insecure",
            "caption": "PHP-FPM Logfile: Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3fb00ec2-cccd-4861-a6ec-a387b2610222"
        },
        "10": {
            "varname": "php_fpm_logfile_lookback",
            "caption": "PHP-FPM Logfile: Lookback",
            "description": "Request timeouts, slow requests and spawn pressure are counted within this window rather than reported one by one. Time window in seconds to look back over, ending at the moment of the run. Only what falls within it is counted, so what is reported is how often something happened lately rather than a total that keeps growing for as long as the source is kept. Example: `--lookback=3600`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a2f18994-f646-49fa-b70b-6384491fb069"
        },
        "11": {
            "varname": "php_fpm_logfile_match",
            "caption": "PHP-FPM Logfile: Match",
            "description": "Only consider a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Example: `--match='\\[pool www\\]'`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "669df737-c49f-47a1-9a31-1050d1eac8e6"
        },
        "12": {
            "varname": "php_fpm_logfile_no_insecure",
            "caption": "PHP-FPM Logfile: No Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5e2c3abc-120b-409a-9952-e031345721b2"
        },
        "13": {
            "varname": "php_fpm_logfile_no_match_severity",
            "caption": "PHP-FPM Logfile: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "php_fpm_logfile_no_match_severity_list"
            },
            "uuid": "cfd11895-68fb-4f1f-85ba-186115c62fdb"
        },
        "14": {
            "varname": "php_fpm_logfile_no_perfdata",
            "caption": "PHP-FPM Logfile: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6d4cfd28-89fc-4cb8-85d3-57156201c84f"
        },
        "15": {
            "varname": "php_fpm_logfile_no_proxy",
            "caption": "PHP-FPM Logfile: No Proxy?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0a201557-781e-42f0-8809-415d074d10ba"
        },
        "16": {
            "varname": "php_fpm_logfile_proxy",
            "caption": "PHP-FPM Logfile: Proxy",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bbf103ec-87ac-4af6-8031-58b4dba5fbf2"
        },
        "17": {
            "varname": "php_fpm_logfile_request_timeouts_critical",
            "caption": "PHP-FPM Logfile: Request Timeouts Critical",
            "description": "Number of terminated requests within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--request-timeouts-critical=20`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b1f6a8ad-a732-4381-816e-580df256aeca"
        },
        "18": {
            "varname": "php_fpm_logfile_request_timeouts_warning",
            "caption": "PHP-FPM Logfile: Request Timeouts Warning",
            "description": "Number of terminated requests within `--lookback` that returns WARNING. 0 turns the threshold off. Example: `--request-timeouts-warning=1`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fdf1110d-3b6b-4cc1-a038-4c807f545b31"
        },
        "19": {
            "varname": "php_fpm_logfile_server_log",
            "caption": "PHP-FPM Logfile: Server Log",
            "description": "Log source to read from. Accepts a file path, `docker:CONTAINER`, `podman:CONTAINER`, `kubectl:CONTAINER` or `systemd:UNITNAME`. Can be specified multiple times, and everything named is then read as one window; a source named twice is read once. If omitted, the check reads the `error_log` directive of the PHP-FPM configuration, falls back to the common locations of the distributions, and reads the journal of the PHP-FPM unit along with it; what the two share is counted once. Example: `--server-log=systemd:php-fpm.service`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "99493e9f-8b56-4f77-9a04-b2c5960bd44f"
        },
        "20": {
            "varname": "php_fpm_logfile_slow_requests_critical",
            "caption": "PHP-FPM Logfile: Slow Requests Critical",
