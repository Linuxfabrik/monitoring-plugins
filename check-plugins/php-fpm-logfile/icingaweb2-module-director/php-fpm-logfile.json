                "php_fpm_logfile_request_timeouts_warning": 5,
                "php_fpm_logfile_server_log": [],
                "php_fpm_logfile_slow_requests_critical": 200,
                "php_fpm_logfile_slow_requests_warning": 20,
                "php_fpm_logfile_spawn_pressure_critical": 100,
                "php_fpm_logfile_spawn_pressure_warning": 10,
                "php_fpm_logfile_timeout": 8,
                "php_fpm_logfile_warning_level": "WARNING"
            },
            "volatile": null,
            "zone": null,
            "uuid": "c46c5a02-bca7-4491-a224-54dd3bdb1e5b"
        }
