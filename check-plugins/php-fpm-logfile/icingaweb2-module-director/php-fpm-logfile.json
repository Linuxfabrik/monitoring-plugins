        "2": {
            "varname": "php_fpm_logfile_critical_level",
            "caption": "PHP-FPM Logfile: Critical Level",
            "description": "Least severe PHP-FPM log level that returns CRITICAL. Each level includes everything more severe than itself, so `WARNING` covers `ERROR` and `ALERT` as well. Case-sensitive. `none` lets no level return CRITICAL, which leaves the events this check names as the only way to reach it. Example: `--critical-level=WARNING`.",
