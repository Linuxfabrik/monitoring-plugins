            f'--server-log={fixture("rocky9-busy-pool.txt")}',
            '--match=max_children',
        ],
        'assert-retc': STATE_CRIT,
        'assert-in': ['1 WARNING line found', '1 pool saturation'],
        'assert-not-in': ['slow request', 'worker crash'],
    },
    {
        'id': 'ok-match-drops-everything',
        'params': [
            f'--server-log={fixture("rocky9-busy-pool.txt")}',
