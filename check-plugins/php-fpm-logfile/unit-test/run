"""Unit tests for the php-fpm-logfile check plugin.

Every fixture under `fixtures/` was written by a real PHP-FPM (8.0.30 on Rocky 9,
driven through a FastCGI client until it logged the situation the file is named
after), and the trees under `config/` mirror what the RHEL and the Debian family
install. That keeps the tests honest about the log format instead of confirming
the plugin's own reading of it.

Reading a systemd unit or a container log is left to the library and is not
covered here.
"""

import os
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN = os.path.join(HERE, '..', 'php-fpm-logfile')


def fixture(name):
    return os.path.join(HERE, 'fixtures', name)


def config_root(name):
    return os.path.join(HERE, 'config', name)


CASES = [
