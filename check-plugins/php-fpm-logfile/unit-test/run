    {
        'id': 'unknown-source-is-not-a-php-fpm-log',
        'params': [f'--server-log={fixture("php-application-error-log.txt")}'],
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['does not look like a PHP-FPM error log'],
    },
    {
        'id': 'ok-application-lines-in-the-same-file',
        'params': [f'--server-log={fixture("rocky9-mixed-application-log.txt")}'],
        'assert-retc': STATE_OK,
        'assert-in': [
            '1 startup detected',
            '6 lines without a PHP-FPM log level',
            'Most lines carry no PHP-FPM log level',
        ],
    },
    {
        # Filtering the ptrace failures out takes the ERROR lines with them; the
        # saturated pool the same log holds is untouched and keeps the check red.
        'id': 'crit-ignore-drops-the-error-lines',
        'params': [
            f'--server-log={fixture("rocky9-busy-pool.txt")}',
            '--ignore=ptrace',
