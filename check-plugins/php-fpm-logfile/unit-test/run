        'id': 'unknown-error-log-goes-to-syslog',
        'params': [f'--config-root={config_root("syslog")}'],
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['is set to syslog', '--server-log=systemd:php-fpm.service'],
    },
    {
        'id': 'unknown-no-log-found-at-all',
        'params': [f'--config-root={config_root("no-such-tree")}'],
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Found no PHP-FPM error log'],
    },
    {
        'id': 'warn-source-is-a-directory',
        'params': [f'--server-log={os.path.join(HERE, "fixtures")}'],
        'assert-retc': STATE_WARN,
        'assert-in': ['does not seem to be an existing regular file'],
    },
    {
        'id': 'unknown-callback-without-credentials',
        'params': [
            f'--server-log={fixture("rocky9-clean-start.txt")}',
            '--icinga-callback',
        ],
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['`--icinga-callback` requires'],
    },
    {
        # Nothing to acknowledge means no call to the monitoring server, so an
        # unreachable one must not turn a healthy check into a failure.
        'id': 'ok-callback-is-not-reached-on-a-clean-log',
        'params': [
            f'--server-log={fixture("rocky9-clean-start.txt")}',
            '--icinga-callback',
            '--icinga-url=https://monitoring.example.invalid:5665',
            '--icinga-username=username',
            '--icinga-password=linuxfabrik',
            '--icinga-service-name=host!service',
            '--timeout=1',
        ],
        'assert-retc': STATE_OK,
        'assert-not-in': ['acknowledgement'],
    },
]


class TestCheck(unittest.TestCase):
    pass


def _check_case(test, case):
    result = subprocess.run(
        [PLUGIN, *case['params']],
        capture_output=True,
        text=True,
        check=False,
    )
    combined = result.stdout + result.stderr
    test.assertEqual(
        result.returncode,
        case['assert-retc'],
        f'expected retc {case["assert-retc"]}, got {result.returncode}.'
        f'\nOutput: {combined}',
    )
    for needle in case.get('assert-in', []):
        test.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
    for needle in case.get('assert-not-in', []):
        test.assertNotIn(
            needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
        )


lib.lftest.attach_each(TestCheck, CASES, _check_case, id_func=lambda it: it['id'])


class TestPathConfinement(unittest.TestCase):
    """A `--server-log` that resolves outside /var/log (here a scratch file in
    the temp directory) is refused, so a plugin running under sudo cannot be
    turned into an arbitrary file read (GHSA-f54c-p5vg-mr5c)."""

    def setUp(self):
        self.scratch_dir = tempfile.mkdtemp(prefix='php-fpm-logfile-confine-')
        self.scratch_file = os.path.join(self.scratch_dir, 'error.log')
        with open(self.scratch_file, 'w', encoding='utf-8') as handle:
            handle.write('[28-Aug-2026 15:08:23] NOTICE: secret\n')

    def tearDown(self):
        shutil.rmtree(self.scratch_dir, ignore_errors=True)

    def test_server_log_outside_allowed_roots_is_refused(self):
        result = subprocess.run(
            [PLUGIN, f'--server-log={self.scratch_file}'],
            capture_output=True,
            text=True,
            check=False,
        )
        combined = result.stdout + result.stderr
        self.assertEqual(result.returncode, STATE_UNKNOWN, combined)
        self.assertIn('Refusing to read', combined)
        self.assertNotIn('secret', combined)


if __name__ == '__main__':
    unittest.main()
