        # Nothing to acknowledge means no call to the monitoring server, so an
        # unreachable one must not turn a healthy check into a failure.
        'id': 'ok-callback-is-not-reached-on-a-clean-log',
        'params': [
            f'--server-log={fixture("rocky9-clean-start.txt")}',
            '--icinga-callback',
            '--icinga-url=https://monitoring.example.invalid:5665',
            '--icinga-username=username',
            '--icinga-password=linuxfabrik',
            '--icinga-service-name=host!service',
            '--timeout=1',
        ],
        'assert-retc': STATE_OK,
        'assert-not-in': ['acknowledgement'],
    },
