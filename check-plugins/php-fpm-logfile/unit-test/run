"""Unit tests for the php-fpm-logfile check plugin.

Every fixture under `fixtures/` was written by a real PHP-FPM (8.0.30 on Rocky 9,
driven through a FastCGI client until it logged the situation the file is named
after), and the trees under `config/` mirror what the RHEL and the Debian family
install. That keeps the tests honest about the log format instead of confirming
the plugin's own reading of it.

Reading a systemd unit or a container log is left to the library and is not
covered here.
"""

import os
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN = os.path.join(HERE, '..', 'php-fpm-logfile')


def fixture(name):
    return os.path.join(HERE, 'fixtures', name)


def config_root(name):
    return os.path.join(HERE, 'config', name)


CASES = [
    {
        'id': 'ok-clean-start',
        'params': [f'--server-log={fixture("rocky9-clean-start.txt")}'],
        'assert-retc': STATE_OK,
        'assert-in': [
            'No errors or warnings found',
            '1 startup detected',
            'No reloads detected',
            'No shutdowns detected',
        ],
        'assert-not-in': ['Recommendations:', '[WARNING]', '[CRITICAL]'],
    },
    {
        'id': 'ok-empty-log-assumes-rotation',
        'params': [f'--server-log={fixture("empty.txt")}'],
        'assert-retc': STATE_OK,
        'assert-in': ['is empty. Assuming log-rotation.'],
    },
    {
        # What the check sees for the rest of the day after the nightly
        # logrotate: PHP-FPM re-opened the file and wrote one line into it. Every
        # counter reads zero, and the window says why.
        'id': 'ok-just-rotated',
        'params': [f'--server-log={fixture("rocky9-just-rotated.txt")}'],
        'assert-retc': STATE_OK,
        'assert-in': [
            '1 line',
            'No startups detected',
            "'php_fpm_log_rotations'=1",
        ],
    },
    {
        # The rotated predecessor holds the two errors and the live file holds
        # only the re-opened marker, so a check reading the live file alone
        # would report a healthy PHP-FPM an hour after it failed to start.
        # Exactly one predecessor on purpose: git stores no modification times,
        # so a fresh clone stamps every fixture with the checkout time and the
        # order of several of them would be whatever the filesystem said.
        'id': 'crit-reads-across-the-rotation',
        'params': [f'--config-root={config_root("just-rotated")}'],
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Read 3 lines from ',
            # the predecessor is named, so the fact says where they came from
            'error.log.1`',
            '2 ERROR lines found',
            'FPM initialization failed',
        ],
    },
    {
        'id': 'crit-configuration-rejected',
        'params': [f'--server-log={fixture("rocky9-config-rejected.txt")}'],
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '1 ALERT line found',
            '2 ERROR lines found',
            '[CRITICAL]',
            'Alert lines:',
            'Error lines:',
            'user has not been defined',
        ],
    },
    {
        'id': 'crit-busy-pool-names-every-event',
        'params': [f'--server-log={fixture("rocky9-busy-pool.txt")}'],
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '2 worker crashes',
            '1 pool saturation',
            # A request that ran long is judged by how many of them arrived, and
            # these are hours old by now.
            '0 request timeouts in the last 10m (2 in the window read)',
            '0 slow requests in the last 10m (3 in the window read)',
            '2 startups detected',
            '1 reload detected',
            '1 shutdown detected',
            'Recommendations:',
        ],
        # The two workers PHP-FPM terminated itself after
        # `request_terminate_timeout` also exit on a signal, but they are not
        # crashes; counting them would make four out of two.
        'assert-not-in': ['4 worker crashes'],
    },
    {
        # PHP-FPM has not reworded any of these messages between the oldest PHP
        # an enterprise distribution still ships and the current one, so the
        # same fixture taken from php-fpm 7.2.24 has to yield the same counts.
        'id': 'crit-busy-pool-on-php72',
        'params': [f'--server-log={fixture("rocky8-php72-busy-pool.txt")}'],
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '2 worker crashes',
            '1 pool saturation',
            '0 request timeouts in the last 10m (2 in the window read)',
            '0 slow requests in the last 10m (3 in the window read)',
            '2 startups detected',
            '1 reload detected',
            '1 shutdown detected',
        ],
    },
    {
        'id': 'crit-emergency-restart',
        'params': [f'--server-log={fixture("rocky9-emergency-restart.txt")}'],
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '2 worker crashes',
            '1 emergency restart',
            # PHP-FPM reloads itself here without writing the line a SIGUSR2
            # produces, so the reload is counted off the exec instead.
            '1 reload detected',
            'reloaded itself because too many workers failed',
        ],
    },
    {
        # A pool logs one of these per second while it spawns in bursts, so a
        # traffic peak leaves a run of them behind and then silence. Nine of them
        # hours ago are a peak that is over, not something to wake up for - which
        # is why they are counted rather than filtered away.
        'id': 'ok-spawn-pressure-that-is-over',
        'params': [f'--server-log={fixture("rocky9-spawn-pressure.txt")}'],
        'assert-retc': STATE_OK,
        'assert-in': [
            '0 spawn pressure warnings in the last 10m (9 in the window read)'
        ],
        'assert-not-in': ['pool saturation', 'Recommendations:'],
    },
    {
        'id': 'warn-spawn-pressure-inside-the-window',
        'params': [
            f'--server-log={fixture("rocky9-spawn-pressure.txt")}',
            '--lookback=31536000',
            '--spawn-pressure-warning=9',
        ],
        'assert-retc': STATE_WARN,
        'assert-in': [
            '9 spawn pressure warnings in the last',
            'raise `pm.start_servers`',
        ],
    },
    {
        # The levels are the operator's call, and the named events are not.
        'id': 'crit-events-survive-levels-turned-off',
        'params': [
            f'--server-log={fixture("rocky9-emergency-restart.txt")}',
            '--critical-level=none',
            '--warning-level=none',
        ],
        'assert-retc': STATE_CRIT,
        'assert-in': ['1 emergency restart'],
