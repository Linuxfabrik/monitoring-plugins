        'params': [f'--server-log={fixture("rocky9-busy-pool.txt")}'],
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '1 worker crash',
            '1 killed worker',
            '1 pool saturation',
            # A request that ran long is judged by how many of them arrived, and
            # these are hours old by now.
            '0 request timeouts in the last 10m (2 in the window read)',
            '0 slow requests in the last 10m (3 in the window read)',
            '2 startups detected',
            '1 reload detected',
            '1 shutdown detected',
            # A named event is kept out of the per-level counts, so its own
            # section is the only place its lines appear. Without them the
            # summary says a pool saturated without saying when or which one,
            # and the access log cannot be read for the same minute.
            'Pool saturation:\n* [28-Aug-2026 15:20:09] WARNING: [pool www] server'
            ' reached pm.max_children setting (2), consider raising it',
            'Worker crash:\n* [28-Aug-2026 15:20:17] WARNING: [pool www] child 178'
            ' exited on signal 11 (SIGSEGV - core dumped)',
            # PHP-FPM sends SIGKILL itself to a worker that does not end in time,
            # and so does the OOM killer, so it is no crash; the recommendation
            # names both.
            'Killed worker:\n* [28-Aug-2026 15:20:19] WARNING: [pool www] child 179'
            ' exited on signal 9 (SIGKILL)',
            'look for `Out of memory` in the kernel log',
            'Recommendations:',
            # Raising the cap is the wrong lever to reach for first, because
            # stuck workers or a crawler fill a pool the way real traffic does.
            'before raising `pm.max_children` (or `process.max`), check whether'
            ' workers were stuck',
            # A pool that ran full once is a queue of a few seconds; this one
            # is hours old and alone.
            '1 pool saturation [WARNING]',
        ],
        # The two workers PHP-FPM terminated itself after
        # `request_terminate_timeout` also exit on a signal, but they are not
        # crashes, and neither is the one it killed; counting them would make
        # several out of one.
        'assert-not-in': ['worker crashes'],
    },
    {
        # PHP-FPM logs the worker it terminated after `request_terminate_timeout`
        # a second time, as an exit on SIGTERM at WARNING. The timeout is judged
        # by its rate, so the exit line must not turn it into a warning of its own.
        'id': 'ok-request-timeouts-are-not-warning-lines',
