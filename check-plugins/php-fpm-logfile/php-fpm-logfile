__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026100901'

DESCRIPTION = """Scans the PHP-FPM error log for the events an administrator has to act
on: rejected configurations, worker crashes, workers killed with SIGKILL, requests that
ran into `request_terminate_timeout` or `request_slowlog_timeout`, workers that hang after
the SIGTERM such a timeout sent, workers that waited on a connection the web server never
sent a request over, pools that hit `pm.max_children`, PHP fatal errors, and the
emergency reload PHP-FPM performs after repeated worker failures. Startups, reloads and shutdowns are counted alongside them, so a pool that
keeps restarting is visible.
Alerts when one of those events shows up, when the lines a slow site provokes cross
the rates the thresholds set, and when a line arrives at a level `--critical-level`
or `--warning-level` covers.
Requests that ran long, a pool spawning workers in bursts and PHP fatal errors are
counted within
`--lookback` and judged by how many of them arrived, not by the fact that they did: one
slow page is nobody's night, dozens within ten minutes say the pool is mis-sized. Those
lines are counted there and nowhere else, so a site with one heavy report page does not
leave the check permanently yellow.
What is left is counted by the level PHP-FPM writes at the head of the line: `ALERT` and
`ERROR` return CRITICAL and `WARNING` returns WARNING, which `--critical-level` and
`--warning-level` move. The events named above carry their own state and are counted there
and nowhere else, because the level says nothing about what happened. A
message that merely contains the word "error" never counts.
The log is read either from a file, from a systemd unit (`systemd:`) or from a
container (`docker:`/`podman:`/`kubectl:`). `--server-log` may be given several times,
and everything named is then read as one window. Without it the file path is taken from
the `error_log` directive of the PHP-FPM configuration, with the common locations of the
distributions probed when that yields nothing, and the journal of the PHP-FPM unit is read
along with it, because a master that fails to start writes why to its standard error and
never reaches the error log. What both hold is counted once. The most recent
rotated file is read along with the live one, so the window does not end where
logrotate last ran. PHP's own messages go to the `error_log` file each pool names, which
is read along with it; only its fatal errors are counted there.
Requires root or sudo."""

# What `--critical-level` and `--warning-level` accept on top of the levels
# themselves: no level at all raises that state, which leaves the named events as
# the only way to reach it.
LEVEL_NONE = 'none'

DEFAULT_CRITICAL_LEVEL = 'ERROR'
DEFAULT_FATAL_ERRORS_CRITICAL = 100
DEFAULT_FATAL_ERRORS_WARNING = 10
DEFAULT_ICINGA_CALLBACK = False
DEFAULT_INSECURE = True
DEFAULT_LOOKBACK = 600  # seconds
DEFAULT_NO_MATCH_SEVERITY = 'ok'
DEFAULT_NO_PROXY = False
DEFAULT_REQUEST_TIMEOUTS_CRITICAL = 50
DEFAULT_REQUEST_TIMEOUTS_WARNING = 5
DEFAULT_SLOW_REQUESTS_CRITICAL = 200
DEFAULT_SLOW_REQUESTS_WARNING = 20
DEFAULT_SPAWN_PRESSURE_CRITICAL = 100
DEFAULT_SPAWN_PRESSURE_WARNING = 10
DEFAULT_TIMEOUT = 8
DEFAULT_WARNING_LEVEL = 'WARNING'

ACK_RETENTION_DAYS = 30
MAXLINES = 30000  # maximum log lines to consider from the end of the source
# Rotated predecessors of the log file to read along with it. The distributions
# rotate this log daily, so without one the window would end at the last
# rotation and an event from before it would stop being reported the moment
# logrotate runs. One covers a daily rotation with room to spare.
ROTATED_FILES = 1

# The unit the distributions run PHP-FPM as. Only the fixed locations systemd
# reads unit files from are looked at, and only for the names the distributions
# use, so nothing a log or a configuration file holds can point the check at
# another unit.
UNIT_CANDIDATES = ('php-fpm.service', 'php*-fpm.service')
UNIT_DIRECTORIES = (
    '/etc/systemd/system',
    '/usr/lib/systemd/system',
    '/lib/systemd/system',
)

# How long a path may be in the summary before it is abbreviated for display.
# The paths the distributions use fit within it untouched; a host serving a
# dozen sites names a dozen logs in one directory, and there the directory is
# the part that says nothing.
SOURCE_PATH_MAX_LEN = 32

# PHP-FPM configuration files that carry the global `error_log` directive. The
# directive is global-only, so the pool files in `php-fpm.d/` never override it
# and are not read. The Debian family installs one tree per PHP version, hence
# the glob; the last match wins, which is the highest version installed.
CONFIG_FILES = (
    '/etc/php-fpm.conf',
    '/etc/php/*/fpm/php-fpm.conf',
    '/usr/local/etc/php-fpm.conf',
)
ERROR_LOG_REGEX = re.compile(r'^\s*error_log\s*=\s*(\S+)', re.MULTILINE)

# The pool files, where every pool names the file PHP writes its own errors to
# (`php_admin_value[error_log]`, which the RHEL family sets by default). That
# file is where a PHP fatal error lands; the PHP-FPM error log above never sees
# it. `$pool` in the value is replaced by the name of the pool, as PHP-FPM does
# (`fpm_conf_expand_pool_name()` in php-src).
POOL_CONFIG_FILES = (
    '/etc/php-fpm.d/*.conf',
    '/etc/php/*/fpm/pool.d/*.conf',
    '/usr/local/etc/php-fpm.d/*.conf',
)
POOL_SECTION_REGEX = re.compile(r'^\s*\[([^\]]+)\]')
POOL_ERROR_LOG_REGEX = re.compile(r'^\s*php(?:_admin)?_value\[error_log\]\s*=\s*(\S+)')

# What PHP-FPM accepts instead of a path, matched case-insensitively the way
# PHP-FPM itself compares it.
SYSLOG_TARGET = 'syslog'

# Where the distributions keep the error log when the configuration does not say.
# The last entry is the path a source build compiles in (`log/php-fpm.log`
# relative to the local state directory).
LOG_FILE_CANDIDATES = (
    '/var/log/php-fpm/error.log',
    '/var/log/php-fpm.log',
    '/var/log/php*-fpm.log',
    '/usr/local/var/log/php-fpm.log',
)

# The master writes `[28-Aug-2026 15:08:23] NOTICE: message`. A worker that logs
# without going through the master writes the same line without the timestamp,
# because PHP-FPM prints the time only in the master process. Both shapes carry
# the level, so both are recognized (verified against php-fpm 8.0.30 on Rocky 9).
# What the journal calls PHP-FPM, for telling its own lines from the ones
# something else logged into the same place. The Debian family carries the
# version in the name (`php8.2-fpm`), the RHEL family does not.
IDENTIFIER_REGEX = re.compile(r'^php[\d.]*-?fpm$', re.IGNORECASE)

LEVEL_REGEX = re.compile(
    r'\b(ALERT|ERROR|WARNING|NOTICE|DEBUG):\s*(.*)$',
)

# The timestamp PHP-FPM writes in front of a master line, `[28-Aug-2026
# 15:21:20]`, in the local time of the host and in English regardless of the
# locale, because PHP-FPM formats it in the C locale. Python parses it in the C
# locale as well, as nothing here calls `setlocale()`. A worker line and a line
# a transport prefixed carry none; `lib.logsource.timestamp()` falls back to the
# transport's.
TIMESTAMP_REGEX = re.compile(r'\[(\d{2}-\w{3}-\d{4} \d{2}:\d{2}:\d{2})\]')
TIMESTAMP_FORMAT = '%d-%b-%Y %H:%M:%S'

# What PHP itself writes into the `error_log` of a pool: `[05-Oct-2026 04:03:05
# Europe/Zurich] PHP Fatal error:  Uncaught ...`, and the same prefix in front of
# what an application hands to `error_log()`. The time is in the zone of
# `date.timezone`, which PHP names behind it (`php_log_err_with_severity()`,
# format `d-M-Y H:i:s e`), so it is converted rather than read as local time.
# A message that spans several lines - the stack trace of an uncaught exception -
# continues on lines that carry no prefix at all.
PHP_LINE_REGEX = re.compile(r'^\[(\d{2}-\w{3}-\d{4} \d{2}:\d{2}:\d{2}) ([^\]\s]+)\] ')
# The error types PHP calls fatal (`php_error_cb()`): `Fatal error` covers
# E_ERROR, E_CORE_ERROR, E_COMPILE_ERROR and E_USER_ERROR, and an uncaught
# exception arrives as one too.
PHP_FATAL_REGEX = re.compile(
    r'\] PHP (?:Fatal error|Parse error|Recoverable fatal error):'
)

# A request timeout names the pool and the worker, and so does the exit of that
# worker. A worker that is reported as timed out a second time without having
# exited in between survived the SIGTERM `request_terminate_timeout` sent it.
TIMEOUT_WORKER_REGEX = re.compile(
    r'\[pool ([^\]]+)\] child (\d+), script .* execution timed out'
)
EXIT_WORKER_REGEX = re.compile(r'\[pool ([^\]]+)\] child (\d+) exited')

# The levels that say something is wrong, worst first. Which of them raise which
# state is left to `--critical-level` and `--warning-level`: a pool that logs one
# `WARNING` about a single slow request is not a reason to get anybody out of
# bed, and what genuinely is arrives as one of the named events below.
LEVELS = (
    {'level': 'ALERT', 'perfdata': 'php_fpm_alert_lines'},
    {'level': 'ERROR', 'perfdata': 'php_fpm_error_lines'},
    {'level': 'WARNING', 'perfdata': 'php_fpm_warning_lines'},
)
LEVEL_CHOICES = [item['level'] for item in LEVELS] + [LEVEL_NONE]

# The events worth naming on their own, because the level alone does not say what
# happened. Everything else PHP-FPM logs is covered by the per-level counts. The
# message texts are taken from php-src `sapi/fpm/fpm/` and reproduced on
# php-fpm 8.0.30; a pattern therefore matches the whole message, not a keyword.
EVENTS = (
    {
        'key': 'worker_crashes',
        'label': 'worker crash',
        'suffix': 'es',
        'perfdata': 'php_fpm_worker_crashes',
        # `SIGQUIT` is how PHP-FPM ends a worker gracefully and `SIGTERM` is how
        # it terminates one that ran over `request_terminate_timeout` (which logs
        # a line of its own), so both are ordinary. `SIGKILL` is counted as a
        # killed worker below, because PHP-FPM sends it itself. Every other
        # signal is one PHP-FPM never sends its workers, so the worker died on a
        # fault. The lookahead also lets the line through when PHP-FPM has no
        # name for the signal and prints an empty pair of brackets.
        'regex': re.compile(r'exited on signal \d+ \((?!SIGKILL|SIGQUIT|SIGTERM)'),
        'state': STATE_WARN,
        'recommendation': (
            'Workers died on a fault; look for a core dump or a faulty PHP extension'
        ),
    },
    {
        'key': 'worker_kills',
        'label': 'killed worker',
        'perfdata': 'php_fpm_worker_kills',
        # PHP-FPM sends `SIGKILL` itself to an idle worker that is still alive
        # one maintenance tick (a second) after the `SIGQUIT` that was to shrink
        # the pool (`fpm_pctl_kill_idle_child()` in php-src): the worker did not
        # end when told to, which is what a host short of memory looks like. The
        # `SIGKILL` that ends a reload or stop never shows up here, because
        # `fpm_children_bury()` logs every exit at `DEBUG` while the master is not
        # in its normal state. The kernel's OOM killer sends the same signal, and
        # the log line cannot tell the two apart (verified against php-8.3.31).
        'regex': re.compile(r'exited on signal 9 \(SIGKILL'),
        'state': STATE_WARN,
        'recommendation': (
            'Workers were killed with SIGKILL, either by PHP-FPM because they did'
            ' not end when the pool shrank or by the kernel when memory ran out;'
            ' look for `Out of memory` in the kernel log around the timestamps'
            ' above'
        ),
    },
    {
        'key': 'idle_connection_timeouts',
        'label': 'idle connection timeout',
        'perfdata': 'php_fpm_idle_connection_timeouts',
        # A worker that kept a connection open for the web server to reuse
        # (FastCGI `FCGI_KEEP_CONN`) does not go back to `accept()`; it marks
        # itself as reading headers and waits on that connection for the next
        # request (`fcgi_accept_request()` in php-src). If none arrives,
        # `request_terminate_timeout` ends it like a request that ran too long,
        # with no script and no request line. A real request always names its
        # script, so this is never load. Apache's `mod_proxy_fcgi` with
        # `enablereuse=on` produced them for weeks (php-fpm 8.3 and httpd 2.4.37
        # on Rocky 8): one every 12 minutes on a quiet host, below any rate
        # threshold, and up to 282 within ten minutes on a busy one. A pinned
        # worker is not idle to PHP-FPM either (`fpm_request_is_idle()`), so the
        # pool spawns more of them, runs into `pm.max_children`, and measures
        # the wait into the slowlog and the access log durations. The slowlog
        # itself never names the idle connection, because PHP-FPM only traces a
        # worker that is executing.
        'regex': re.compile(r'script \'\' \(request: " "\) execution timed out'),
        'state': STATE_WARN,
        'recommendation': (
            'Workers waited on a FastCGI connection the web server keeps open for'
            ' reuse (`enablereuse=on` in Apache `mod_proxy_fcgi`) until'
            ' `request_terminate_timeout` ended them; every such connection pins'
            ' a worker, which inflates busy workers, slow requests and timeouts and'
            ' can fill the pool, so remove `enablereuse=on` for this backend'
        ),
    },
    {
        'key': 'hung_workers',
        'label': 'hung worker',
        'perfdata': 'php_fpm_hung_workers',
        # PHP-FPM checks for timed-out requests on every heartbeat (a third of
        # the smallest timeout, `fpm_conf.c`) and sends SIGTERM again each time
        # (`fpm_request_check_timed_out()`). A worker keeps the default action
        # for SIGTERM (`fpm_signals_init_child()`), so the second report about
        # the same worker means the kernel could not deliver it: the process is
        # in uninterruptible sleep, which is what a hung NFS or storage mount
        # does to every process touching it. Seen with php-fpm 8.5 on Rocky 9
        # behind a hung NFS server: 50 workers reported every 21 minutes for 17
        # hours. Not matched by a pattern but by pairing lines, see main().
        'regex': None,
        'state': STATE_CRIT,
        'recommendation': (
            'Workers outlived the SIGTERM that `request_terminate_timeout` sent'
            ' and are stuck, almost always in uninterruptible I/O on a hung NFS'
            ' or storage mount; look for PHP-FPM workers in state `D` in'
            ' `ps -eo pid,stat,wchan:32,args` and for `nfs: server ... not'
            ' responding` in the kernel log'
        ),
    },
    {
        'key': 'pool_saturations',
        'label': 'pool saturation',
        'perfdata': 'php_fpm_pool_saturations',
        'regex': re.compile(
            r'server reached (?:pm\.)?max_children setting'
            r'|the maximum number of processes has been reached',
            re.IGNORECASE,
        ),
        # A pool that ran full once and recovered is a queue of a few seconds:
        # an editor's backend page firing a dozen parallel requests at a pool
        # of five does it. PHP-FPM logs the line once and only again after the
        # pool has spawned a worker in between (`warn_max_children` in
        # `fpm_process_ctl.c`), so a second one within `--lookback`, or one
        # next to requests that timed out or workers that hang, is a pool that
        # stays full, and that is CRITICAL (see main()).
        'state': STATE_WARN,
        # Raising the cap is the obvious lever and the wrong one to reach for
        # first. Workers that hang or wait on a stalled backend keep the pool
        # full however large it is, and a crawler or a scanner walking a few
        # hundred 404s fills it exactly the way real traffic does. A higher cap
        # then multiplies the memory the pool can claim and hands the next
        # burst more of it.
        'recommendation': (
            'A pool ran out of workers and clients waited in the listen queue;'
            ' before raising `pm.max_children` (or `process.max`), check whether'
            ' workers were stuck (request timeouts or hung workers above, a'
            ' stalled database or NFS mount) or a crawler drove the load (web'
            ' server access log at that time), because a higher cap only lets'
            ' either claim more memory'
        ),
    },
    {
        'key': 'emergency_restarts',
        'label': 'emergency restart',
        'perfdata': 'php_fpm_emergency_restarts',
        'regex': re.compile(
            r'failed processes threshold \(\d+ in \d+ sec\) is reached,'
            r' initiating reload',
        ),
        'state': STATE_CRIT,
        'recommendation': (
            'PHP-FPM reloaded itself because too many workers failed in a row;'
            ' treat this as a crashing application until proven otherwise'
        ),
    },
)

# What PHP-FPM writes once per request or once per maintenance tick rather than
# once per problem. One of these is a traffic peak or a single slow page and no
# reason to get anybody out of bed; dozens of them within ten minutes say the
# pool is mis-sized. They are therefore counted against a rate over `--lookback`,
# and they are kept out of the per-level counts above, so a site with one slow
# report page does not leave the check permanently yellow.
RATE_EVENTS = (
    {
        'key': 'request_timeouts',
        'label': 'request timeout',
        'perfdata': 'php_fpm_request_timeouts',
        # PHP-FPM kills the worker and the client gets nothing, so the threshold
        # is the lowest of the three: a handful of these is already a bad
        # afternoon for somebody.
        # A timeout without a script is no request at all and is named as an
        # idle connection timeout above, so the lookbehind leaves it out here.
        'regex': re.compile(
            r'(?<!script \'\' \(request: " "\) )'
            r'execution timed out \([\d.]+ sec\), terminating'
        ),
        'critical': 'REQUEST_TIMEOUTS_CRITICAL',
        'warning': 'REQUEST_TIMEOUTS_WARNING',
        'recommendation': (
            'Requests were killed after `request_terminate_timeout`; when many'
            ' different scripts timed out at once a backend (database, NFS,'
            ' remote API) stalled, otherwise profile the scripts listed above'
        ),
    },
    {
        'key': 'slow_requests',
        'label': 'slow request',
        'perfdata': 'php_fpm_slow_requests',
        # The request still finishes; PHP-FPM only writes a backtrace. A site
        # with one heavy report page produces these all day.
        'regex': re.compile(r'executing too slow \([\d.]+ sec\), logging'),
        'critical': 'SLOW_REQUESTS_CRITICAL',
        'warning': 'SLOW_REQUESTS_WARNING',
        'recommendation': (
            'Requests ran longer than `request_slowlog_timeout`; the backtrace of'
            ' each one is in the pool `slowlog`'
        ),
    },
    {
        'key': 'spawn_pressure',
        'label': 'spawn pressure warning',
        'perfdata': 'php_fpm_spawn_pressure',
        # Only `pm = dynamic` writes this, and only once the spawn rate has
        # doubled its way to 8, which takes several seconds of sustained
        # pressure. Unlike `server reached pm.max_children`, which PHP-FPM guards
        # with a flag and logs once, this one has no guard at all: it is written
        # on every maintenance tick, so roughly once a second, for as long as the
        # pressure lasts. A traffic peak therefore leaves a burst of them behind
        # and then silence, which is a rate and not an event (verified against
        # `fpm_pctl_perform_idle_server_maintenance()` in php-src).
        'regex': re.compile(r'seems busy \(you may need to increase'),
        'critical': 'SPAWN_PRESSURE_CRITICAL',
        'warning': 'SPAWN_PRESSURE_WARNING',
        'recommendation': (
            'A pool had to spawn workers in bursts; raise `pm.start_servers` and'
            ' `pm.min_spare_servers` so requests do not wait for a fork'
        ),
    },
    {
        'key': 'fatal_errors',
        'label': 'PHP fatal error',
        'perfdata': 'php_fpm_fatal_errors',
        # From the `error_log` files of the pools, not from PHP-FPM. One fatal
        # error is one broken page for one visitor and happens on every site
        # now and then; dozens within minutes are a deployment that went wrong
        # or a database that went away. Warnings, notices and deprecations
        # are left out: a busy application writes thousands of them a day.
        'regex': PHP_FATAL_REGEX,
        'critical': 'FATAL_ERRORS_CRITICAL',
        'warning': 'FATAL_ERRORS_WARNING',
        'recommendation': (
            'PHP scripts died with fatal errors, so pages failed for their'
            ' visitors; many of them at once follow a deployment or a backend'
            ' that went away, otherwise fix the code the lines above name'
        ),
    },
)

# A worker PHP-FPM ended with `SIGTERM` after `request_terminate_timeout`, which
# the `execution timed out` line just before it already counts. PHP-FPM writes
# every exit on a signal other than `SIGQUIT` at `WARNING` (`fpm_children_bury()`
# in php-src), so counting this line by its level as well turned every timeout
# into a second warning that no rate threshold holds back (seen with php-fpm 8.3
# on Rocky 8, one exit line per timeout line). The `SIGTERM` of a stop or reload
# does not get here: while the master is not in its normal state the same
# function logs the exit at `DEBUG`. What is left is somebody else's `kill`.
TERMINATED_EXIT_REGEX = re.compile(r'exited on signal 15 \(SIGTERM\)')

# PHP-FPM writes this once into the fresh file when logrotate has moved the old
# one away and signalled it with SIGUSR1, so the window of a just-rotated log
# holds exactly this line. Counted, and named next to the window size, which
# turns "no startup, no reload, no shutdown" from a puzzle into a sentence.
ROTATION_REGEX = re.compile(r'^error log file re-opened')

# Lifecycle markers, counted but never alerting on. A reload re-executes the
# master, so it shows up as a reload and as a startup. The reload is recognized
# by the line the exec itself writes, because the `Reloading in progress ...`
# that a `SIGUSR2` triggers is missing when PHP-FPM reloads itself after too many
# worker failures.
LIFECYCLE = (
    {
        'key': 'startups',
        'label': 'startup',
        'perfdata': 'php_fpm_startups',
        'regex': re.compile(r'^fpm is running, pid \d+'),
        'verb': 'detected',
    },
    {
        'key': 'reloads',
        'label': 'reload',
        'perfdata': 'php_fpm_reloads',
        'regex': re.compile(r'^reloading: execvp\('),
        'verb': 'detected',
    },
    {
        'key': 'shutdowns',
        'label': 'shutdown',
        'perfdata': 'php_fpm_shutdowns',
        'regex': re.compile(r'^exiting, bye-bye!'),
        'verb': 'detected',
    },
)


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    # Developer-only hook, like `--test` on the plugins that inject command
    # output: it prefixes every path the check opens, so the fixture tests can
    # stand a directory tree in for the host's file system. Deliberately not
    # named `--test-...`, because argparse would then resolve a bare `--test`
    # into it.
    parser.add_argument(
        '--config-root',
        help=argparse.SUPPRESS,
        dest='CONFIG_ROOT',
        default='',
    )

    parser.add_argument(
        '--critical-level',
        help='Least severe PHP-FPM log level that returns CRITICAL. '
        'Each level includes everything more severe than itself, so `WARNING` '
        'covers `ERROR` and `ALERT` as well. '
        'Case-sensitive. '
        '`none` lets no level return CRITICAL, which leaves the events this '
        'check names as the only way to reach it. '
        'Example: `--critical-level=WARNING`. '
        'Default: %(default)s',
        dest='CRITICAL_LEVEL',
        choices=LEVEL_CHOICES,
        default=DEFAULT_CRITICAL_LEVEL,
    )

    parser.add_argument(
        '--fatal-errors-critical',
        help='Number of PHP fatal errors in the `error_log` of the pools within '
        '`--lookback` that returns CRITICAL. '
        '0 turns the threshold off. '
        'Example: `--fatal-errors-critical=50`. '
        'Default: %(default)s',
        dest='FATAL_ERRORS_CRITICAL',
        type=int,
        default=DEFAULT_FATAL_ERRORS_CRITICAL,
    )

    parser.add_argument(
        '--fatal-errors-warning',
        help='Number of PHP fatal errors in the `error_log` of the pools within '
        '`--lookback` that returns WARNING. '
        '0 turns the threshold off. '
        'Example: `--fatal-errors-warning=1`. '
        'Default: %(default)s',
        dest='FATAL_ERRORS_WARNING',
        type=int,
        default=DEFAULT_FATAL_ERRORS_WARNING,
    )

    parser.add_argument(
        '--icinga-callback',
        help=lib.args.help('--icinga-callback'),
        dest='ICINGA_CALLBACK',
        action='store_true',
        default=DEFAULT_ICINGA_CALLBACK,
    )

    parser.add_argument(
