            "uuid": "bafb634c-fcca-42ef-a57d-4f0c4dcc79b6"
        },
        "3": {
            "varname": "huawei_pacific_storagepool_critical",
            "caption": "Huawei Pacific Storagepool: Critical",
            "description": "CRIT threshold for the used capacity of a pool, as a Nagios range in percent.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d8628c7e-0fac-487c-bfd8-97d975eeea05"
        },
        "4": {
            "varname": "huawei_pacific_storagepool_ignore",
            "caption": "Huawei Pacific Storagepool: Ignore",
            "description": "Skip storage pools. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the pool identifier and the pool name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "224a1103-eecb-4fc5-9ffa-3d49ebbe26e2"
        },
        "5": {
            "varname": "huawei_pacific_storagepool_insecure",
            "caption": "Huawei Pacific Storagepool: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "889445d8-9bba-4348-aafd-4b6c327c423c"
        },
        "6": {
            "varname": "huawei_pacific_storagepool_lengthy",
            "caption": "Huawei Pacific Storagepool: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0214932e-02ea-4009-97d0-1b5470f156dc"
        },
        "7": {
            "varname": "huawei_pacific_storagepool_match",
            "caption": "Huawei Pacific Storagepool: Match",
            "description": "Limit to storage pools. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the pool identifier and the pool name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c8901c77-2a26-4639-abc2-227ae1b9b881"
        },
        "8": {
            "varname": "huawei_pacific_storagepool_no_insecure",
            "caption": "Huawei Pacific Storagepool: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "797b30a3-b142-40fc-ac0e-2219f7096fe1"
        },
        "9": {
            "varname": "huawei_pacific_storagepool_no_match_severity",
            "caption": "Huawei Pacific Storagepool: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_storagepool_no_match_severity_list"
            },
            "uuid": "22e41725-4269-41d5-866e-1db57b506c4d"
        },
        "10": {
            "varname": "huawei_pacific_storagepool_no_perfdata",
            "caption": "Huawei Pacific Storagepool: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5557b734-77f8-403c-9ae9-3cd3edf4b204"
        },
        "11": {
            "varname": "huawei_pacific_storagepool_no_proxy",
            "caption": "Huawei Pacific Storagepool: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "45bc56f8-93e3-4a00-9267-fd74f99e5207"
        },
        "12": {
            "varname": "huawei_pacific_storagepool_password",
            "caption": "Huawei Pacific Storagepool: Password",
            "description": "Huawei OceanStor Pacific API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "3b58aaa1-5ced-4dc4-8068-5712fd2eb0b6"
        },
        "13": {
            "varname": "huawei_pacific_storagepool_password_file",
            "caption": "Huawei Pacific Storagepool: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "55a1c6e0-0809-4bb2-9308-5cd0b91e91a8"
        },
        "14": {
            "varname": "huawei_pacific_storagepool_scope",
            "caption": "Huawei Pacific Storagepool: Scope",
            "description": "Huawei OceanStor Pacific API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d49a3629-0631-4f10-a22a-29d14aa384cb"
        },
        "15": {
            "varname": "huawei_pacific_storagepool_timeout",
            "caption": "Huawei Pacific Storagepool: Timeout",
            "description": "Network timeout in seconds.",
