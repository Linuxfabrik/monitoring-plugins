import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        'id': 'ok-pairs-in-sync',
        'test': 'stdout/pairs-in-sync,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost '
        '--username=admin --lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            # Column widths follow the widest value, and the "Last Sync" column
            # renders a relative "(N ago)" age that drifts over time, so the header
            # is asserted per column rather than as one fixed-width line.
            'UUID',
            'Last Sync',
            'Duration',
            'LocalJob',
            'RemoteJob',
            'Link',
            'Local Data',
            'Remote Data',
            'Health',
            'Running',
            '15361:2100f4b78d046ec60000000000000000 ! 2021-08-18 10:39:47',
            '15361:2100f4b78d046ec60000000000000001 ! 2021-08-18 10:39:50',
            # The appliance's own code stays readable next to the check's verdict.
            'Connected (1)',
            'Consistent (1)',
        ],
    },
    {
        # Without --lengthy the table keeps the columns that decide the state and
        # leaves the detail ones out.
        'id': 'ok-pairs-in-sync-core-columns',
        'test': 'stdout/pairs-in-sync,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'UUID',
            'Last Sync',
            'LocalJob',
            'RemoteJob',
            'Link',
            'Health',
            'Running',
            'Connected (1)',
        ],
        'assert-not-in': ['Duration', 'Local Data', 'Remote Data'],
    },
    {
        # A link the appliance reports as disconnected is a pair that no longer
        # mirrors, so it warns - and the table still names the code, not just the
        # verdict.
        'id': 'warn-link-disconnected',
        'test': 'stdout/pair-link-disconnected,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are warnings.',
            'Disconnected (2)',
            '[WARNING]',
        ],
    },
    {
        # Same code sent as a number instead of as a string. A firmware doing that
        # used to turn every healthy pair into a warning.
        'id': 'ok-numeric-status-codes',
        'test': 'stdout/pair-numeric-codes,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'Connected (1)',
        ],
    },
    {
        # A pair that has never finished a synchronization reports no end time.
        # Subtracting it used to end the check in a traceback.
        'id': 'ok-pair-never-synchronized',
        'test': 'stdout/pair-never-synchronized,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'never',
        ],
    },
    {
        # The REST Interface Reference documents `-1` for a pair that has never
        # synchronized. Read as an epoch it renders as 1970 and a ~56-year age.
        'id': 'ok-never-synchronized-reported-as-minus-one',
        'test': 'stdout/pair-never-synchronized-minus-one,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['never'],
        'assert-not-in': ['1970-01-01', 'sync_progress'],
    },
    {
        # Firmware in the field also answers with a plain zero, which means the same.
        'id': 'ok-never-synchronized-reported-as-zero',
        'test': 'stdout/pair-never-synchronized-zero,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['never'],
        'assert-not-in': ['1970-01-01'],
    },
    {
        # A file system pair (HCRESOURCETYPE 2) next to a block pair. The file system
        # pair answers with 255 for both host access states, which is not an access
        # state but "does not apply". It must neither read as "Unknown" nor be graphed
        # above the metric's maximum of 3. Verified against V700R001C10SPH128 on a
        # Dorado 6000 V6.
        'id': 'ok-file-system-pair-without-access-state',
        'test': 'stdout/pairs-block-and-file-system,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin '
        '--lengthy',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            '! LUN01    ! Read/write ! LUN01     ! Read/write !',
            '! FS01     ! --         ! FS01      ! --         !',
            "'15361_2100f4b78d046ec60000000000000000_local_host_access_state'=3;;;0;3",
            "'15361_2100f4b78d046ec60000000000000000_remote_host_access_state'=3;;;0;3",
            "'15361_2100f4b78d046ec600000000000001a8_local_data_state'=1;;;0;2",
        ],
        'assert-not-in': [
            'Unknown',
            '15361_2100f4b78d046ec600000000000001a8_local_host_access_state',
            '15361_2100f4b78d046ec600000000000001a8_remote_host_access_state',
        ],
    },
    {
        'id': 'ok-no-pairs-configured',
        'test': 'stdout/no-pairs,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': ['No HyperMetro pairs configured.'],
    },
    {
        'id': 'warn-no-match',
        'test': 'stdout/pairs-in-sync,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin '
        '--match=NOSUCHLUN --no-match-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['No HyperMetro pairs matched `NOSUCHLUN`.'],
    },
    {
        # The appliance reports success as the string '0' on some endpoints. Reading
        # that as an error used to take the whole check to UNKNOWN.
        'id': 'ok-success-code-as-string',
        'test': 'stdout/pairs-success-code-as-string,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
    },
    {
        'id': 'unknown-api-error',
        'test': 'stdout/api-error,,0',
        'params': '--device-id=1 --password=pass --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['the HyperMetro pairs', '-401'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-dorado-hypermetropair'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
