import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# Each fixture in stdout/ is the output of a `--verbose` run: one `### GET <path>` block per
# Redfish response the plugin evaluated. lib.redfish.replay() answers every request of the
# walk from these blocks, so a scenario is a single file, it may hold any number of members,
# and the output a user attaches to a bug report can be used as a fixture as it is.
COMMON = '--url=https://example.com'

TESTS = [
    {
        'id': 'ok-healthy-chassis',
        'test': 'stdout/healthy-chassis,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked sensors on 1 member.',
        ],
    },
    {
        # A sensor whose firmware reports a zero-width min/max range
        # (identical min and max, here 255 as a "not available"/"no limit"
        # placeholder) must not raise a false warning for an in-spec reading.
        # Fixture taken from issue #1211.
        'id': 'ok-zero-width-range',
        'test': 'stdout/zero-range-chassis,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked sensors on 1 member.',
            'CPU Utilization',
        ],
    },
    {
        # A chassis without a modern Sensors collection must fall back to the
        # legacy Thermal (Temperatures, Fans) and Power (Voltages, power
        # supplies) endpoints and still report readings.
        'id': 'ok-legacy-thermal-fallback',
        'test': 'stdout/legacy-thermal,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked sensors on 1 member.',
            'Cel',
            'RPM',
        ],
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    {
        # In the legacy fallback, a temperature above its UpperThresholdFatal
        # must escalate to CRITICAL. This proves the legacy threshold fields are
        # mapped onto the modern sensor-state logic.
        'id': 'crit-legacy-temp-threshold',
        'test': 'stdout/legacy-temp-crit,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            '[CRITICAL]',
        ],
    },
    {
        # Cisco returns the legacy Power "PowerControl" as a single object
        # instead of a list. The plugin must normalize it to a list and report
        # the chassis-wide power consumption rather than crash.
        'id': 'ok-cisco-powercontrol-dict',
        'test': 'stdout/cisco-powercontrol,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked sensors on 1 member.',
            'System Power Control',
            '287',
        ],
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    {
        # --inventory emits the parsed components as JSON (one object keyed by
        # component type) and exits OK, so several Redfish checks can be merged
        # with `jq --slurp`.
        'id': 'ok-inventory-json',
        'test': 'stdout/healthy-chassis,,0',
        'params': f'{COMMON} --inventory',
        'assert-retc': STATE_OK,
        'assert-in': ['"sensor":', '"chassi_ids":'],
    },
    {
        # The controller advertises its $expand support in the service root. Every
        # collection has to be requested with it, not just the entry point (#1507).
        'id': 'ok-expand-on-every-collection',
        'test': 'stdout/expand-two-levels,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': [
            '### GET /redfish/v1/Chassis/1U/Sensors?$expand=*($levels=1)',
        ],
    },
    {
        # Two chassis, the second with an inlet sensor between its caution and
        # critical threshold. The replay has to follow both members to see it.
        'id': 'warn-inlet-caution-on-second-chassis',
        'test': 'stdout/two-chassis,,0',
        'params': COMMON,
        'assert-retc': STATE_WARN,
        'assert-in': [
            'Checked sensors on 2 members. There are warnings.',
            'SerNo: 437XR1138R3',
        ],
        'assert-regex': r'Inlet Temperature.*\[WARNING\]',
    },
    {
        # The controller honoured $expand and inlined the chassis into the collection.
        # The check has to take it from there instead of requesting it again (#1507);
        # the fixture holds no separate chassis response, so a second request would
        # be answered with a 404.
        'id': 'ok-chassis-inlined-by-expand',
        'test': 'stdout/chassis-inlined,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked sensors on 1 member.',
            'Ambient Temperature',
        ],
    },
    {
        # --verbose appends every Redfish response the check evaluated, in the form a
        # fixture takes, so the output of a reported run can be replayed as a test.
        'id': 'ok-verbose-appends-responses',
        'test': 'stdout/healthy-chassis,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': ['### GET /redfish/v1/Chassis/1U/Sensors'],
    },
    # HPE ProLiant DL365 Gen11 with iLO 6 1.77, from a customer's --verbose run
    # (serial numbers, UUIDs and the host name replaced). The /Chassis/1/Power block
    # is the /Chassis/DE00B000/Power answer under its own path: iLO serves the server's
    # Power resource there, and the customer's run never requested the original.
    {
        # iLO reports an unset user threshold as `UpperCautionUser.Reading: 0`, which
        # must not turn an inlet at 21 C into a warning.
        'id': 'ok-ilo6-user-threshold-zero',
        'test': 'stdout/ilo6-backplane-user-threshold-zero,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked sensors on 2 members.'],
        'assert-regex': r'01-Inlet Ambient +! Intake +! 21\.0 +! Cel +! \[OK\]',
    },
    {
        # The storage backplane advertises no Thermal or Power resource. iLO answers
        # both paths with the server's data anyway, so requesting them would list every
        # sensor twice, under the same perfdata label.
        'id': 'ok-ilo6-backplane-mirror-not-requested',
        'test': 'stdout/ilo6-backplane-user-threshold-zero,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_OK,
        'assert-not-in': [
            '### GET /redfish/v1/Chassis/DE00B000/Power',
            '### GET /redfish/v1/Chassis/DE00B000/Thermal',
        ],
        'assert-regex': r'\A(?![\s\S]*01-Inlet Ambient [\s\S]*01-Inlet Ambient )',
    },
    {
        # iLO 6 lists temperatures only in its Sensors collection. Fans and power
        # supplies come from the legacy Thermal and Power resources, and two identical
        # power supplies keep apart by their member id.
        'id': 'ok-ilo6-fans-and-power-supplies-from-legacy',
        'test': 'stdout/ilo6-backplane-user-threshold-zero,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            "'SystemBoard_Fan_7'=25%",
            "'PowerSupply_Power_Supply_0_P03178-B21'=107",
            "'PowerSupply_Power_Supply_1_P03178-B21'=98",
        ],
    },
    {
        # Dell iDRAC names the sensors of every power supply alike and tells them
        # apart only by Id. The Id takes the place of a name that occurs twice, so
        # the rows and the perfdata labels stay apart.
        'id': 'ok-identical-sensor-names-use-id',
        'test': 'stdout/sensors-with-identical-names,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': [
            "'PowerSupply_PSU.Slot.1_InputPower'=416.0",
            "'PowerSupply_PSU.Slot.2_InputPower'=5.0",
        ],
        'assert-not-in': ['InputPowerSensor'],
    },
    # The dmtf-dsp2043-* fixtures are taken from DMTF DSP2043 2026.2 (Redfish Resource
    # and Schema Guide mockups, Copyright 2015-2026 DMTF), trimmed to the responses the
    # check requests.
    {
        # public-tower: a Sensors collection with caution, critical, fatal and
        # user-defined thresholds. The CPU power readings of 90 W exceed their
        # UpperCautionUser of 82 W, and the perfdata carry caution as warn and fatal as
        # crit.
        'id': 'warn-dmtf-tower-user-caution',
        'test': 'stdout/dmtf-dsp2043-tower,,0',
        'params': COMMON,
        'assert-retc': STATE_WARN,
        'assert-in': [
            "'CPU_CPU_#1_Temperature'=37;42;50;;75",
            "'Memory_DIMM_#1_Temperature'=44;55;75;;75",
        ],
        'assert-regex': r'Power reading for CPU #1 +! CPU +! 90 +! W +! \[WARNING\]',
    },
    {
        # public-bladed: an enclosure and four blades, which expose only the legacy
        # Thermal resource. A stopped fan the controller rates Critical makes the check
        # critical, a hot CPU on one blade only warns. The blades name their sensors
        # alike, so the chassis id goes in front of those perfdata labels, while the
        # enclosure's unique labels keep their form.
        'id': 'crit-dmtf-bladed-failed-fan',
        'test': 'stdout/dmtf-dsp2043-bladed,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Checked sensors on 5 members. There are critical errors.',
            "'Blade1_CPU_CPU_Temp'=62;75;95",
            "'Blade3_CPU_CPU_Temp'=77;75;95",
        ],
        'assert-not-in': ["'CPU_CPU_Temp'="],
        'assert-regex': r'System Fan 2 +! Front +! 0 +! RPM +! \[CRITICAL\]'
        r'[\s\S]*CPU Temp +! CPU +! 77 +! Cel +! \[WARNING\]',
    },
    {
        # public-nvmeof-jbof: a storage enclosure that advertises its Thermal and Power
        # resources. Unlike the iLO backplane above, they are read.
        'id': 'ok-dmtf-storage-enclosure-with-advertised-links',
        'test': 'stdout/dmtf-dsp2043-nvmeof-jbof,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked sensors on 1 member.',
            '### GET /redfish/v1/Chassis/1/Thermal',
            '### GET /redfish/v1/Chassis/1/Power',
            'Power Supply 1 PS2000',
        ],
    },
    {
        # A missing fixture must surface as STATE_UNKNOWN with a
        # readable message, not as a Python traceback.
        'id': 'unknown-missing-fixture',
        'test': 'stdout/does-not-exist,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Found no recorded Redfish responses to replay.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../redfish-sensors'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
