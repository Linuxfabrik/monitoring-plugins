    "Datafield": {
        "1": {
            "varname": "openstack_cinder_list_always_ok",
            "caption": "Openstack Cinder List: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ed299159-3db4-4b96-a0f1-40b918955ec8"
        },
        "2": {
            "varname": "openstack_cinder_list_brief",
            "caption": "Openstack Cinder List: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "139c008e-0f07-4503-b27c-79fa2c2e4b52"
        },
        "3": {
            "varname": "openstack_cinder_list_cache_expire",
            "caption": "Openstack Cinder List: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8d25b427-803a-4352-9d81-85f5f8b13c8c"
        },
        "4": {
            "varname": "openstack_cinder_list_ignore",
            "caption": "Openstack Cinder List: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the volume name.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "912a911e-d18e-4a01-99dc-0d8a05ec655c"
        },
        "5": {
            "varname": "openstack_cinder_list_ignore_type",
            "caption": "Openstack Cinder List: Ignore Type",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the volume type, for example `ssd`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "51405f5f-b571-4472-9520-81c0e1ad7078"
        },
        "6": {
            "varname": "openstack_cinder_list_ignore_zone",
            "caption": "Openstack Cinder List: Ignore Zone",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. Matched against the availability zone of the volume.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "42699e0d-fe10-44f7-b1bd-7c6f795b2e69"
        },
        "7": {
            "varname": "openstack_cinder_list_insecure",
            "caption": "Openstack Cinder List: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "23bc92ef-a932-4a16-aa9c-9bb9cc12a1ab"
        },
        "8": {
            "varname": "openstack_cinder_list_lengthy",
            "caption": "Openstack Cinder List: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "45c39fd7-6269-4387-81d6-61b0e5b7818b"
        },
        "9": {
            "varname": "openstack_cinder_list_match",
            "caption": "Openstack Cinder List: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the volume name.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e6faf1df-74d3-4cc4-bccd-0ae09fc9addc"
        },
        "10": {
            "varname": "openstack_cinder_list_match_type",
            "caption": "Openstack Cinder List: Match Type",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the volume type, for example `ssd`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ba141007-9bc7-46da-a10c-a0944fd353c8"
        },
        "11": {
            "varname": "openstack_cinder_list_match_zone",
            "caption": "Openstack Cinder List: Match Zone",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). Matched against the availability zone of the volume.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ab2cce1c-d4eb-4810-91fd-5e92086a8376"
        },
        "12": {
            "varname": "openstack_cinder_list_no_match_severity",
            "caption": "Openstack Cinder List: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "openstack_cinder_list_no_match_severity_list"
            },
            "uuid": "22e098cb-54a1-4aee-99c5-b25697fe335e"
        },
        "13": {
            "varname": "openstack_cinder_list_no_perfdata",
            "caption": "Openstack Cinder List: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d0444b2a-89ea-4ff5-9dee-1ad34366d8ec"
        },
        "14": {
            "varname": "openstack_cinder_list_no_proxy",
            "caption": "Openstack Cinder List: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f19ba4c3-36a2-4180-b265-815fd18f8da6"
        },
        "15": {
            "varname": "openstack_cinder_list_proxy",
            "caption": "Openstack Cinder List: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "95287b07-4e08-463a-acdc-bda230d17700"
        },
        "16": {
            "varname": "openstack_cinder_list_rc_file",
            "caption": "Openstack Cinder List: Rc File",
            "description": "Path to a rc file containing OpenStack connection parameters like OS_USERNAME (instead of specifying them on the command line). Example: `--rc-file=/var/spool/icinga2/.openstack.cnf`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "88901604-45ab-449f-8422-b02857060c1a"
        },
        "17": {
            "varname": "openstack_cinder_list_severity",
            "caption": "Openstack Cinder List: Severity",
            "description": "State to report for volumes in a given status, as `STATUS,STATE`. STATUS is a Cinder volume status such as `available`, case-insensitive. STATE is one of `ok`, `warn`, `crit` or `unknown`. Overrides the built-in state for that status only, every other status keeps its default. Can be specified multiple times. Example: `--severity=available,warn --severity=maintenance,crit`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f529f7e9-6288-4435-82a1-71353531825e"
        },
        "18": {
            "varname": "openstack_cinder_list_timeout",
            "caption": "Openstack Cinder List: Timeout",
            "description": "Network timeout in seconds. Applies to the whole run, not to a single request.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9782a76a-38ca-46e8-ba6d-bd955cf56d3f"
        }
    }
