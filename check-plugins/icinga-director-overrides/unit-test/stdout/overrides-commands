{
    "cmd-check-apache-httpd-security": {
        "object_name": "cmd-check-apache-httpd-security",
        "object_type": "object",
        "command": "/usr/lib64/nagios/plugins/apache-httpd-security",
        "arguments": {
            "--ignore": {
                "repeat_key": true,
                "value": "$apache_httpd_security_ignore$"
            }
        }
    },
    "cmd-check-apache-httpd-security-sudo": {
        "object_name": "cmd-check-apache-httpd-security-sudo",
        "object_type": "object",
        "command": "/usr/bin/sudo /usr/lib64/nagios/plugins/apache-httpd-security",
        "imports": [
            "cmd-check-apache-httpd-security"
        ]
    },
    "cmd-check-cpu-usage": {
        "object_name": "cmd-check-cpu-usage",
        "object_type": "object",
        "command": "/usr/lib64/nagios/plugins/cpu-usage",
        "arguments": {
            "--critical": "$cpu_usage_critical$",
            "--warning": "$cpu_usage_warning$"
        }
    },
    "cmd-check-disk-usage": {
        "object_name": "cmd-check-disk-usage",
        "object_type": "object",
        "command": "/usr/lib64/nagios/plugins/disk-usage",
        "arguments": {
            "--ignore": {
                "repeat_key": true,
                "value": "$disk_usage_ignore$"
            }
        }
    },
    "cmd-check-nextcloud-stats": {
        "object_name": "cmd-check-nextcloud-stats",
        "object_type": "object",
        "command": "/usr/lib64/nagios/plugins/nextcloud-stats",
        "arguments": {
            "--password": "$service.vars.nextcloud_stats_password$",
            "--url": "$nextcloud_stats_url$",
            "--username": "$nextcloud_stats_login$"
        }
    },
    "cmd-check-snmp-uptime": {
        "object_name": "cmd-check-snmp-uptime",
        "object_type": "object",
        "command": "/usr/lib64/nagios/plugins/snmp-uptime",
        "arguments": {
            "--auth": "$snmp_v3.phrase$",
            "--hostname": "$host.address$",
            "--user": "$snmp_v3.user$"
        }
    },
    "cmd-check-swap-usage": {
        "object_name": "cmd-check-swap-usage",
        "object_type": "object",
        "command": "/usr/lib64/nagios/plugins/swap-usage",
        "arguments": {
            "--critical": "$swap_usage_critical$",
            "--warning": "$swap_usage_warning$"
        }
    }
}
