__version__ = '2026110302'

DESCRIPTION = """Lists the service variables that were deliberately overridden for a single host in
the Icinga Director, for example a threshold changed with "Modify" on a service that comes
from a Service Set or an apply rule. For each override, the plugin shows the value the
service would have without it, as configured in its templates, Service Sets and host
templates, so the deviation from the configured default is visible at a glance. Overrides that no longer have an effect are listed separately: those for
services that no longer exist on the host, for variables that the check command does not
use (for example after a variable was renamed), and those that merely repeat the default.
Values of hidden or sensitive variables are masked. Always returns OK, as this is an
inventory and not an alert. Supports extended reporting via --lengthy."""

DEFAULT_LENGTHY = False
DEFAULT_MAX_WORKERS = 4
DEFAULT_OVERRIDE_VARNAME = '_override_servicevars'
# `icingacli director host show --all-services` takes 0.5 to 0.7 seconds per host
# (Director 1.12.1 on Rocky 10, 130 services per host), the exports of all hosts,
# commands and datafields up to 0.8 seconds. 8 seconds per call leaves room for
# hosts with many more services.
DEFAULT_TIMEOUT = 8

# Variable names whose values are masked even if the Director does not mark them as
# hidden or sensitive.
SENSITIVE_NAME = re.compile(
    r'(api.?key|community|credential|pass|private.?key|secret|token)', re.IGNORECASE
)
MASK = '******'

# A runtime macro such as `$cpu_usage_warning$` or `$service.vars.cpu_usage_warning$`.
# `$$` is an escaped dollar sign and does not match.
MACRO = re.compile(r'\$([A-Za-z0-9_.\-]+)\$')
# Macros starting with one of these name an object attribute, not a service variable.
MACRO_OBJECTS = ('command', 'host', 'icinga', 'notification', 'service', 'user')

# Director keeps this key inside the vars of services generated by "apply for" rules.
# It is internal bookkeeping, not a variable anybody overrides.
HANDOFF_PREFIX = '__director'

MAX_VALUE_LEN = 40


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--lengthy',
        help=lib.args.help('--lengthy')
        + ' Adds the Service Set of each service and does not shorten long values.',
        dest='LENGTHY',
        action='store_true',
        default=DEFAULT_LENGTHY,
    )

    parser.add_argument(
        '--max-workers',
        help='Maximum number of hosts whose services are read from the Icinga Director '
        'in parallel. '
        'Default: %(default)s',
        dest='MAX_WORKERS',
        type=int,
        default=DEFAULT_MAX_WORKERS,
    )

    parser.add_argument(
        '--override-varname',
        help='Name of the host variable in which the Icinga Director stores the '
        'per-host overrides of service variables. Only needs to be changed if the '
        'Director setting "override_services_varname" was changed. '
        'Case-sensitive. '
        'Default: %(default)s',
        dest='OVERRIDE_VARNAME',
        default=DEFAULT_OVERRIDE_VARNAME,
    )

    parser.add_argument(
        '--test',
        help=lib.args.help('--test'),
        dest='TEST',
        type=lib.args.csv,
    )

    parser.add_argument(
        '--timeout',
        help='Timeout for each call of `icingacli`, in seconds. '
        'Default: %(default)s (seconds)',
        dest='TIMEOUT',
        type=int,
        default=DEFAULT_TIMEOUT,
    )

    args, _ = parser.parse_known_args()
    return args


def icingacli(args, *argv):
    """Run `icingacli director <argv>` and return its parsed JSON output as a
    `(success, result)` tuple.

    The output carries the variables of the Icinga configuration, credentials
    included, so nothing of stdout goes into an error message. Of stderr only the
    first line is passed on, with anything that looks like a credential masked.
    """
    cmd = ['icingacli', 'director', *argv]
    what = f'`icingacli director {" ".join(argv[:2])}`'
    success, result = lib.shell.shell_exec(cmd, timeout=args.TIMEOUT)
    if not success:
        return (False, f'{what} failed: {result}')
    stdout, stderr, retc = result
    if retc != 0:
        first_line = next((line for line in stderr.splitlines() if line.strip()), '')
        msg = f'{what} failed with exit code {retc}'
        if first_line:
            msg += f': {lib.txt.sanitize_sensitive_data(first_line.strip())[:200]}'
        msg += (
            '. The account running this check has to be able to read the Icinga Web 2'
            ' configuration, for example as a member of the group `icingaweb2`.'
        )
        return (False, msg)
    try:
        return (True, json.loads(stdout))
    except ValueError:
        return (False, f'{what} did not return valid JSON.')


def fetch(args, kind, *argv):
    """Read one export from the Icinga Director, or from the fixture
    `<test>-<kind>` under `--test`.
    """
    if args.TEST is not None:
        return (True, lib.lftest.test_json(args.TEST, f'{args.TEST[0]}-{kind}'))
    return icingacli(args, *argv)


def fetch_host_services(args, host):
    """Return the services of a host with their resolved variables, as Icinga
    Director computes them: the services of Service Sets (also those assigned by
    filter), of apply rules, of host templates and of the host itself, with their
    templates resolved, but without the per-host overrides.
    """
    success, host = lib.shell.safe_cli_value(host, 'host name')
    if not success:
        return (False, host)
    success, result = fetch(
        args,
        f'host-{host}',
        'host',
        'show',
        host,
        '--json',
        '--resolved',
        '--with-services',
        '--all-services',
        '--no-defaults',
        '--no-pretty',
    )
    if not success:
        return (False, result)
    services = result.get('services') if isinstance(result, dict) else None
    if not isinstance(services, list):
        return (False, f'The Icinga Director returned no services for host "{host}".')
    return (True, services)


def get_own_overrides(obj, varname):
    """Return the overrides stored on the host or host template `obj` itself, as a
    dict `{service name: vars}`.
    """
    own = ((obj.get('vars') or {}) if isinstance(obj, dict) else {}).get(varname)
    if not isinstance(own, dict):
        return {}
    return {
        service: service_vars
        for service, service_vars in own.items()
        if isinstance(service_vars, dict)
    }


def get_inherited_overrides(hosts, name, varname, seen=()):
    """Return the overrides a host inherits from its host templates, as a dict
    `{service name: vars}`. `name` is the host, its own overrides are left out.

    Icinga Director renders the override variable with `+=`, so Icinga 2 adds the
    entries of every imported host template in import order, and those of the host
    itself last. An entry for a service name replaces the one inherited for the
    same name as a whole, it is not merged with it.
    """
    obj = hosts.get(name)
    if not isinstance(obj, dict) or name in seen:
        return {}
    seen = (*seen, name)
    overrides = {}
    for parent in obj.get('imports') or []:
        overrides.update(get_inherited_overrides(hosts, parent, varname, seen))
        overrides.update(get_own_overrides(hosts.get(parent), varname))
    return overrides


def macro_vars(value):
    """Return the names of the service variables that the macros in `value`
    refer to. `value` may be any JSON-serializable structure.
    """
    names = set()
    for macro in MACRO.findall(json.dumps(value, ensure_ascii=False)):
        if macro.startswith('service.vars.'):
            macro = macro[len('service.vars.') :]
        elif macro.split('.')[0] in MACRO_OBJECTS:
            continue
        # a dictionary member such as `$disks.root$` belongs to the variable `disks`
        names.add(macro.split('.')[0])
    return names


def get_command_vars(commands, name, seen=()):
    """Return the names of the variables that the check command `name` uses in its
    command line, arguments and variables, including those of the commands it
    imports. Returns None for an unknown command.

    `icingacli director commands fetch --resolved` does not resolve the arguments of
    imported commands (Director 1.12.1), so the imports are followed here.
    """
    obj = commands.get(name)
    if not isinstance(obj, dict) or name in seen:
        return None
    seen = (*seen, name)
    names = macro_vars(
        {key: obj.get(key) for key in ('arguments', 'command', 'env', 'vars')}
    )
    for parent in obj.get('imports') or []:
        names |= get_command_vars(commands, parent, seen) or set()
    return names


def get_used_vars(command_vars, service_vars):
    """Extend the variables the check command uses by those that the values of
    used variables refer to, for example a variable whose default is
    `$other_variable$`.
    """
    used = set(command_vars)
    todo = list(used)
    while todo:
        name = todo.pop()
        for ref in macro_vars(service_vars.get(name)) - used:
            used.add(ref)
            todo.append(ref)
    return used


def get_sensitive_vars(datafields, customproperties):
    """Return the names of the variables whose values must not be shown: data
    fields with the visibility "hidden", and custom variables of the type
    "sensitive" or with a sensitive member.
    """
    names = set()
    for field in datafields if isinstance(datafields, list) else []:
        if not isinstance(field, dict):
            continue
        settings = field.get('settings') or {}
        if isinstance(settings, dict) and settings.get('visibility') == 'hidden':
            names.add(field.get('varname'))

    def is_sensitive(prop):
        if not isinstance(prop, dict):
            return False
        if prop.get('value_type') == 'sensitive':
            return True
        items = prop.get('items') or {}
        return isinstance(items, dict) and any(map(is_sensitive, items.values()))

    for prop in customproperties if isinstance(customproperties, list) else []:
        if is_sensitive(prop):
            names.add(prop.get('key_name'))
    return names


def is_nullish(value):
    """An unset and an empty value have the same effect on a check command."""
    return value is None or value in ('', [], {})


def same_value(a, b):
    """Compare two variable values the way they reach the check plugin.

    The Icinga Director stores the same number once as a number and once as a
    string (`25` vs `"25"`), so scalars are compared by their text and as numbers.
    Booleans never equal numbers. Lists are compared by their members, so a
    reordered ignore list is not a change. Dictionaries are compared key by key.
    """
    if is_nullish(a) and is_nullish(b):
        return True
    if isinstance(a, bool) or isinstance(b, bool):
        return a is b
    if isinstance(a, (int, float, str)) and isinstance(b, (int, float, str)):
        if str(a) == str(b):
            return True
        try:
            return float(a) == float(b)
        except ValueError:
            return False
    if isinstance(a, list) and isinstance(b, list):
        return (
            len(a) == len(b)
            and all(any(same_value(x, y) for y in b) for x in a)
            and all(any(same_value(x, y) for x in a) for y in b)
        )
    if isinstance(a, dict) and isinstance(b, dict):
        keys = {k for k, v in a.items() if not is_nullish(v)}
        keys |= {k for k, v in b.items() if not is_nullish(v)}
        return all(same_value(a.get(k), b.get(k)) for k in keys)
    return False


def format_value(value, sensitive, lengthy):
    """Render a variable value for the table."""
    if is_nullish(value):
        return '(not set)'
    if sensitive:
        return MASK
    if isinstance(value, bool):
        text = 'true' if value else 'false'
    elif isinstance(value, (dict, list)):
        text = json.dumps(value, ensure_ascii=False)
    else:
        text = str(value)
    if not lengthy and len(text) > MAX_VALUE_LEN:
        text = text[: MAX_VALUE_LEN - 3] + '...'
    return text


def get_short_names(host_names):
    """Map every host name to its short name, the part before the first dot. A host
    keeps its full name if its short name is not unique, or if it is an IP address.
    """
    short = {}
    for name in host_names:
        try:
            ipaddress.ip_address(name)
            short[name] = name
        except ValueError:
            short[name] = name.split('.')[0]
    counts = collections.Counter(short.values())
    return {name: s if counts[s] == 1 else name for name, s in short.items()}


def strip_service_prefix(service, variable):
    """Drop the service name from the start of the variable name, as in
    `cpu_usage_warning` of the service "CPU Usage", which becomes `warning`.
    """
    prefix = service.lower().replace(' ', '_') + '_'
    if variable.startswith(prefix) and len(variable) > len(prefix):
        return variable[len(prefix) :]
    return variable


def main():
    """The main function. This is where the magic happens."""

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)
    if args.MAX_WORKERS < 1:
        lib.base.cu('`--max-workers` has to be 1 or more.')

    # fetch data
    hosts = lib.base.coe(
        fetch(args, 'hosts', 'hosts', 'fetch', '--json', '--no-defaults', '--no-pretty')
    )
    if not isinstance(hosts, dict):
        lib.base.cu('The Icinga Director returned no hosts.')
    host_names = sorted(
        name
        for name, obj in hosts.items()
        if isinstance(obj, dict)
        and obj.get('object_type') == 'object'
        and not obj.get('disabled')
    )
    # The overrides of host templates belong to the configured defaults. Only the
    # overrides on the host itself are deviations.
    overrides = {}
    for name in host_names:
        own = get_own_overrides(hosts[name], args.OVERRIDE_VARNAME)
        if own:
            overrides[name] = (
                own,
                get_inherited_overrides(hosts, name, args.OVERRIDE_VARNAME),
            )
    if not overrides:
        lib.base.oao(
            f'No overridden service variables on {len(host_names)}'
            f' {lib.txt.pluralize("host", len(host_names))}.',
            STATE_OK,
        )

    commands = lib.base.coe(
        fetch(
            args,
            'commands',
            'commands',
            'fetch',
            '--json',
            '--no-defaults',
            '--no-pretty',
        )
    )
    if not isinstance(commands, dict):
        commands = {}
    datafields = lib.base.coe(
        fetch(args, 'datafields', 'export', 'datafields', '--no-pretty')
    )
    # Custom variables replace data fields since Director 1.12. An older Director
    # does not know the export, which is the same as having none.
    success, customproperties = fetch(
        args, 'customproperties', 'export', 'customproperties', '--no-pretty'
    )
    if not success:
        customproperties = []

    # Reading the services is the expensive part. map() keeps the order of the
    # hosts, so the output does not depend on which call finishes first.
    workers = max(1, min(args.MAX_WORKERS, len(overrides)))
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        services = dict(
            zip(
                overrides,
                pool.map(lambda host: fetch_host_services(args, host), overrides),
            )
        )

    # init some vars
    state = STATE_OK
    sensitive_vars = get_sensitive_vars(datafields, customproperties)
    effective = []
    without_effect = []
    errors = []

    # analyze data
    for host, (own, inherited) in overrides.items():
        success, host_services = services[host]
        if not success:
            errors.append({'host': host, 'error': host_services})
            state = STATE_UNKNOWN
            continue
        by_name = {}
        for service in host_services:
            if isinstance(service, dict):
                by_name.setdefault(service.get('object_name'), service)

        for service_name, own_vars in sorted(own.items()):
            service = by_name.get(service_name)
            service_vars = (service.get('vars') or {}) if service else {}
            inherited_vars = inherited.get(service_name, {})
            # what the service gets without and with the override of the host. The
            # entry of the host replaces the one of the host templates as a whole.
            default_vars = {**service_vars, **inherited_vars}
            host_vars = {**service_vars, **own_vars}
            used_vars = None
            if service:
                command_vars = get_command_vars(commands, service.get('check_command'))
                if command_vars is not None:
                    used_vars = get_used_vars(command_vars, host_vars)
            for name in sorted(set(own_vars) | set(inherited_vars)):
                if name.startswith(HANDOFF_PREFIX):
                    continue
                on_host = name in own_vars
                if on_host and own_vars[name] is None:
                    continue
                row = {
                    'host': host,
                    'service': service_name,
                    'set': (service or {}).get('service_set') or '',
                    'variable': name,
                }
                if not service:
                    row['reason'] = 'service does not exist on the host'
                elif used_vars is not None and name not in used_vars:
                    row['reason'] = 'not used by the check command'
                elif same_value(host_vars.get(name), default_vars.get(name)):
                    row['reason'] = 'same as the default'
                else:
                    # a variable that only the host templates override is back at the
                    # value of the service once the host has an entry of its own
                    sensitive = name in sensitive_vars or bool(
                        SENSITIVE_NAME.search(name)
                    )
                    row['default'] = format_value(
                        default_vars.get(name), sensitive, args.LENGTHY
                    )
                    row['override'] = format_value(
                        host_vars.get(name), sensitive, args.LENGTHY
                    )
                    effective.append(row)
                    continue
                if on_host:
                    without_effect.append(row)

    # shorten what the tables show
    short_names = get_short_names(host_names)
    for row in effective + without_effect + errors:
        row['host'] = short_names.get(row['host'], row['host'])
        if 'variable' in row:
            row['variable'] = strip_service_prefix(row['service'], row['variable'])
    effective.sort(key=lambda row: (row['host'], row['service'], row['variable']))
    without_effect.sort(key=lambda row: (row['host'], row['service'], row['variable']))
    errors.sort(key=lambda row: row['host'])

    # build the message
    affected_hosts = {row['host'] for row in effective}
    msg = (
        f'{len(effective)} overridden service'
        f' {lib.txt.pluralize("variable", len(effective))}'
        f' on {len(affected_hosts)} of {len(host_names)}'
        f' {lib.txt.pluralize("host", len(host_names))}'
    )
    if without_effect:
        msg += (
            f', {len(without_effect)}'
            f' {lib.txt.pluralize("override", len(without_effect))} without effect'
        )
    if errors:
        msg += (
            f', services of {len(errors)} {lib.txt.pluralize("host", len(errors))}'
            ' could not be read'
        )
    msg += '.'

    # build table output
    tables = []
    if effective:
        keys = ['host', 'service', 'variable', 'default', 'override']
        headers = ['Host', 'Service', 'Variable', 'Default', 'Override']
        if args.LENGTHY:
            keys.append('set')
            headers.append('Service Set')
        tables.append(lib.base.get_table(effective, keys, header=headers))
    if without_effect:
        tables.append(
            lib.base.get_table(
                without_effect,
                ['host', 'service', 'variable', 'reason'],
                header=['Host', 'Service', 'Variable', 'Without effect'],
            )
        )
    if errors:
        tables.append(
            lib.base.get_table(errors, ['host', 'error'], header=['Host', 'Error'])
        )
    if tables:
        # every table ends with a newline, which separates it from the next one
        msg += '\n\n' + '\n'.join(tables)

    # over and out
    lib.base.oao(msg, state)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
