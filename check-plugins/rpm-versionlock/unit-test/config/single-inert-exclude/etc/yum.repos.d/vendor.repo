# Switched off, and the only exclusion on the host. dnf walks the enabled repositories
# only, so this one is applied by nothing, and the summary has to say so in the
# singular. A mirror host carries exactly this shape: the repository is defined for
# `reposync --repoid=...` to enable per run, and is off for everything else.
[off-repo]
name=Off
baseurl=https://packages.example/9/off/$basearch/
enabled=0
excludepkgs=off-repo-package
