# Switched on and not named by `disable_excludes`, so this is the one exclusion dnf 4
# really applies.
[live-repo]
name=Live
baseurl=https://packages.example/9/$basearch/
enabled=1
excludepkgs=live-repo-package

# Named by `disable_excludes`, so dnf 4 skips this repository's exclusions.
[named-repo]
name=Named
baseurl=https://packages.example/9/named/$basearch/
enabled=1
excludepkgs=named-repo-package

# Switched off. dnf walks the enabled repositories only, so this exclusion is applied by
# nothing on either generation.
[off-repo]
name=Off
baseurl=https://packages.example/9/off/$basearch/
enabled=0
excludepkgs=off-repo-package
