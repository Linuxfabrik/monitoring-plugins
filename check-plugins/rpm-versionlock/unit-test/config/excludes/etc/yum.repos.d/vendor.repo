# A section named like the one Python treats as a template for all others. The package
# manager has no such concept, so this is an ordinary repository to it.
[DEFAULT]
excludepkgs=default-section-package

# The main configuration is read from one file only, so this section configures nothing.
[main]
excludepkgs=must-not-be-read-from-a-repo-file

[vendor]
name=Vendor packages
baseurl=https://packages.example/9/$basearch/
enabled=1
excludepkgs=vendor-100%-agent, vendor-tools

[vendor-debuginfo]
name=Vendor packages - Debuginfo
baseurl=https://packages.example/9/$basearch/debug/
enabled=0
