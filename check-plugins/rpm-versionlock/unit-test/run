# https://github.com/Linuxfabrik/monitoring-plugins/blob/main/CONTRIBUTING.md

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# rpm-versionlock reads the package manager's configuration, so its fixtures are
# directory trees under `config/` that stand in for the host's /etc, selected with
# `--config-root`. The lock lists below were captured from `ubi8`, `ubi9` and
# `ubi10` containers after `yum versionlock add bash glibc` and
# `yum versionlock exclude curl`.
#
# dnf 5 (Fedora) is the one generation whose locks are not plain text. Its TOML
# fixture was captured from a `fedora:44` container after `dnf versionlock add bash
# glibc` and `dnf versionlock exclude curl`.
TESTS = [
    # A host with no locks at all, with and without the versionlock plugin installed.
    {
        'id': 'ok-no-locks',
        'test': '',
        'params': '--config-root=config/no-locks',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.', "'locks'=0"],
    },
    {
        'id': 'ok-no-versionlock-plugin',
        'test': '',
        'params': '--config-root=config/no-versionlock-plugin',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
    },
    # One testcase per supported RHEL release, so a changed lock list format fails here.
    {
        'id': 'warn-rhel8-locks-present',
        'test': '',
        'params': '--config-root=config/rhel8-two-locks-one-exclude',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 version locks and 1 exclusion in place.',
            'bash',
            '0:4.4.20-6.el8_10.*',
            'glibc',
            'curl',
            'exclude',
            "'locks'=3",
        ],
    },
    {
        'id': 'warn-rhel9-locks-present',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 version locks and 1 exclusion in place.',
            '0:5.1.8-9.el9.*',
            'versionlock',
        ],
    },
    {
        'id': 'warn-rhel10-locks-present',
        'test': '',
        'params': '--config-root=config/rhel10-two-locks-two-excludes',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 version locks and 2 exclusions in place.',
            '0:5.2.26-6.el10.*',
            '0:8.12.1-4.el10.*',
        ],
    },
    # The yum layout is a set of symlinks into the dnf one, so the same lock list is
    # reachable under two paths and must still be reported once.
    {
        'id': 'warn-yum-symlinks-not-counted-twice',
        'test': '',
        'params': '--config-root=config/rhel9-yum-symlinks',
        'assert-retc': STATE_WARN,
        'assert-in': ['2 version locks and 1 exclusion in place.', "'locks'=3"],
    },
    # Thresholds are Nagios ranges over the number of locks.
    {
        'id': 'ok-warning-raised',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude --warning 5',
        'assert-retc': STATE_OK,
        'assert-in': ['2 version locks and 1 exclusion in place.'],
    },
    {
        'id': 'crit-above-critical',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude '
        '--warning 1 --critical 2',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'2 version locks and 1 exclusion in place\.\s*\[CRITICAL\]',
    },
    # Filtering by package name.
    {
        'id': 'warn-match-single-package',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude --match=^bash$',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 version lock in place.', 'bash'],
        'assert-not-in': ['glibc'],
    },
    {
        'id': 'warn-ignore-single-package',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude --ignore=^curl$',
        'assert-retc': STATE_WARN,
        'assert-in': ['2 version locks in place.'],
        'assert-not-in': ['curl'],
    },
    {
        'id': 'ok-nothing-checked',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude '
        '--match=^nothing-here$',
        'assert-retc': STATE_OK,
        'assert-in': ['Nothing checked.', "'locks'=0"],
    },
    {
        'id': 'warn-nothing-checked',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude '
        '--match=^nothing-here$ --no-match-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['Nothing checked.'],
    },
    # Extended reporting adds the file a lock has to be removed from.
    {
        'id': 'warn-lengthy-shows-origin',
        'test': '',
        'params': '--config-root=config/rhel9-two-locks-one-exclude --lengthy',
        'assert-retc': STATE_WARN,
        'assert-in': ['Configured in', 'versionlock.list'],
    },
    # Package exclusions, off unless asked for.
    {
        'id': 'ok-excludes-not-checked',
        'test': '',
        'params': '--config-root=config/excludes',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
    },
    {
        'id': 'warn-excludes-checked',
        'test': '',
        'params': '--config-root=config/excludes --check-excludes',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '6 exclusions in place.',
            'kernel*',
            'redis',
            'nagios*',
            'icinga2',
            # a repository section named like Python's template section is an
            # ordinary repository to the package manager, so it is read once and
            # its value is not inherited by the sections that follow
            'default-section-package',
            # a value carrying a `%` used to abort the whole check
            'vendor-tools',
        ],
        'assert-not-in': [
            # the main configuration comes from one file only, so a `main` section
            # in a repository file configures nothing
            'must-not-be-read-from-a-repo-file',
        ],
    },
    # Repository files are read from where `reposdir` points, not from a fixed path.
    {
        'id': 'warn-custom-reposdir',
        'test': '',
        'params': '--config-root=config/custom-reposdir --check-excludes',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 exclusion in place.', 'vendor-agent'],
        # the default directory is not read once `reposdir` names another one
        'assert-not-in': ['must-not-be-read'],
    },
    # A lock list moved elsewhere by the plugin configuration.
    {
        'id': 'warn-custom-locklist',
        'test': '',
        'params': '--config-root=config/custom-locklist',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 version lock in place.', 'httpd'],
    },
    # Hand-written entries, which carry no epoch.
    {
        'id': 'warn-lock-without-epoch',
        'test': '',
        'params': '--config-root=config/kernel-lock-without-epoch',
        'assert-retc': STATE_WARN,
        'assert-in': ['2 version locks in place.', 'kernel', 'kernel-core'],
    },
    # A name may be a glob, and a glob carrying a dash must not be read as a version.
    {
        'id': 'warn-glob-lock',
        'test': '',
        'params': '--config-root=config/glob-lock',
        'assert-retc': STATE_WARN,
        'assert-in': ['2 version locks in place.', 'kernel*', 'kernel-devel-*'],
    },
    # The spellings a hand-written list carries. `java-1.8.0-openjdk` and
    # `java-17-openjdk` are package names whose second-to-last dash-separated field
    # starts with a digit and must stay whole, and an entry may put its epoch in front
    # of the whole spec instead of behind the name.
    {
        'id': 'warn-hand-written-specs',
        'test': '',
        'params': '--config-root=config/hand-written-specs --lengthy',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '5 version locks in place.',
            'java-1.8.0-openjdk',
            'java-17-openjdk',
            'python3-foo',
        ],
        # The epoch reads the same whichever notation the entry used.
        'assert-regex': r'glibc\s+!\s+0:2\.28-251\.el8_10\.\*',
    },
    # A name that was cut in half would report a package that does not exist, and a
    # filter written for the real name would then never fire.
    {
        'id': 'warn-hand-written-specs-not-cut-in-half',
        'test': '',
        'params': '--config-root=config/hand-written-specs --match=^java-1\\.8\\.0-openjdk$',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 version lock in place.', 'java-1.8.0-openjdk'],
    },
    # A lock list dnf 4 does not apply holds nothing back, whether the plugin is
    # switched off, plugins are switched off wholesale, or no lock list is named at
    # all. The last one even makes the package manager refuse to transact.
    {
        'id': 'ok-versionlock-disabled',
        'test': '',
        'params': '--config-root=config/versionlock-disabled',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
        'assert-not-in': ['bash', 'glibc'],
    },
    {
        'id': 'ok-plugins-disabled',
        'test': '',
        'params': '--config-root=config/plugins-disabled',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
        'assert-not-in': ['bash', 'glibc'],
    },
    {
        'id': 'ok-locklist-not-set',
        'test': '',
        'params': '--config-root=config/locklist-not-set',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
        'assert-not-in': ['bash', 'glibc'],
    },
    # Rubbish in the lock list is skipped instead of being reported as a package.
    {
        'id': 'ok-malformed-locklist',
        'test': '',
        'params': '--config-root=config/malformed',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
    },
    # dnf 5 keeps its locks in a TOML file. An entry whose conditions are all `!=` is
    # an exclude, which is how `versionlock exclude` records one.
    {
        'id': 'warn-dnf5-locks-present',
        'test': '',
        'params': '--config-root=config/fedora-dnf5',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 version locks and 1 exclusion in place.',
            'bash',
            '= 5.3.9-3.fc44',
            'curl',
            '!= 8.18.0-4.fc44, != 8.18.0-8.fc44',
            'exclude',
        ],
    },
    {
        'id': 'ok-dnf5-no-locks',
        'test': '',
        'params': '--config-root=config/fedora-dnf5-no-locks',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
    },
    # dnf 5 locks without a plugin, so the switch that takes dnf 4 locking out of
    # service leaves these in force and they have to be reported all the same.
    {
        'id': 'warn-dnf5-locks-survive-disabled-plugins',
        'test': '',
        'params': '--config-root=config/dnf5-plugins-disabled',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 version locks and 1 exclusion in place.',
            'bash',
            '= 5.3.9-3.fc44',
        ],
    },
    # dnf 5 also looks for repository files in a directory dnf 4 does not know.
    {
        'id': 'warn-dnf5-excludes-checked',
        'test': '',
        'params': '--config-root=config/fedora-dnf5 --check-excludes',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 version locks and 2 exclusions in place.',
            'kernel-experimental',
        ],
    },
    {
        'id': 'ok-dnf5-broken-toml',
        'test': '',
        'params': '--config-root=config/fedora-dnf5-broken-toml',
        'assert-retc': STATE_OK,
        'assert-in': ['No version locks in place.'],
    },
    # Deployed on a host that does not use RPM packages at all.
    {
        'id': 'unknown-not-rpm-based',
        'test': '',
        'params': '--config-root=config/not-rpm-based',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No RPM package manager configuration found.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../rpm-versionlock'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
