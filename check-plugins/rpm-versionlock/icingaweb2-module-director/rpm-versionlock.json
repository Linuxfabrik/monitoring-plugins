    "Datafield": {
        "1": {
            "varname": "rpm_versionlock_always_ok",
            "caption": "RPM Versionlock: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "9561fba1-0a66-4265-b374-f0d34c82840a"
        },
        "2": {
            "varname": "rpm_versionlock_check_excludes",
            "caption": "RPM Versionlock: Check Excludes?",
            "description": "Additionally report the packages excluded in the package manager configuration. An exclusion keeps a package off the host just as effectively as a version lock, but it is also used legitimately to keep two repositories apart, which is why it is not reported by default.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fdde4e35-4c3a-43de-8b6b-13f73fff32d8"
        },
        "3": {
            "varname": "rpm_versionlock_critical",
            "caption": "RPM Versionlock: Critical",
            "description": "CRIT threshold for the number of version locks. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "067b81d7-29fe-40f2-b505-e701211bdc86"
        },
        "4": {
            "varname": "rpm_versionlock_ignore",
            "caption": "RPM Versionlock: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "66e63a9a-fc90-48d6-a2c8-6de7207354a3"
        },
        "5": {
            "varname": "rpm_versionlock_lengthy",
            "caption": "RPM Versionlock: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "55103115-13b5-42a4-ad83-173bea281b7f"
        },
        "6": {
            "varname": "rpm_versionlock_match",
            "caption": "RPM Versionlock: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6e7dd6f3-b52b-43bb-8465-12a22aff45ab"
        },
        "7": {
            "varname": "rpm_versionlock_no_match_severity",
            "caption": "RPM Versionlock: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "rpm_versionlock_no_match_severity_list"
            },
            "uuid": "f1512803-c279-49c0-9834-92991a7eba87"
        },
        "8": {
            "varname": "rpm_versionlock_no_perfdata",
            "caption": "RPM Versionlock: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "27c5e88b-a5f5-467e-8fad-cca97179b132"
        },
        "9": {
            "varname": "rpm_versionlock_warning",
            "caption": "RPM Versionlock: Warning",
            "description": "WARN threshold for the number of version locks. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b5249fb3-176f-4a8e-84df-a8562bef8350"
        }
    }
