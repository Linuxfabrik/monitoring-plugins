    "Datafield": {
        "1": {
            "varname": "nextcloud_enterprise_always_ok",
            "caption": "Nextcloud Enterprise: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "20844aae-aba5-498b-b7c8-fb743327efc0"
        },
        "2": {
            "varname": "nextcloud_enterprise_critical",
            "caption": "Nextcloud Enterprise: Critical",
            "description": "CRIT threshold for the number of accounts the subscription has to cover. Supports Nagios ranges. Evaluated whenever it is given. When omitted, it is evaluated only on an instance that declares no account limit of its own, because a declared limit is compared against the account count anyway. Default: empty, no CRIT threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5128fdf4-a049-4f0b-8805-a33ebaf93304"
        },
        "3": {
            "varname": "nextcloud_enterprise_grace_wait",
            "caption": "Nextcloud Enterprise: Grace Wait",
            "description": "How long an account count above its limit is tolerated before it counts towards the state. Set this to cover the time a directory synchronisation needs to settle, so an import that briefly overshoots stays quiet until it has had its chance. Starts when the count first goes over and starts over once it is back within the limit. A duration such as `12h`, `8D` or `2W`; `0D` disables the grace period.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "5559f2c4-a0c2-4fe8-bbe9-61ba2f301aa7"
        },
        "4": {
            "varname": "nextcloud_enterprise_no_perfdata",
            "caption": "Nextcloud Enterprise: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f715aafc-a5aa-4912-b270-60e8dd86d0c9"
        },
        "5": {
            "varname": "nextcloud_enterprise_path",
            "caption": "Nextcloud Enterprise: Path",
            "description": "Local path to the Nextcloud installation, typically the web server document root.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "424ef281-469f-4ab9-bc57-993c2ac193c8"
        },
        "6": {
            "varname": "nextcloud_enterprise_timeout",
            "caption": "Nextcloud Enterprise: Timeout",
            "description": "Timeout in seconds for a single Nextcloud command.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1cf60361-d881-40b0-8f66-93f99a32f890"
        },
        "7": {
            "varname": "nextcloud_enterprise_warning",
            "caption": "Nextcloud Enterprise: Warning",
            "description": "WARN threshold for the number of accounts the subscription has to cover. Supports Nagios ranges. Evaluated whenever it is given. When omitted, it is evaluated only on an instance that declares no account limit of its own, because a declared limit is compared against the account count anyway. The default covers the smallest Nextcloud subscription, which stops short of 150 accounts. Default: @150:",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "aed8f76e-c2bd-4e07-a7f0-1729fd50f447"
        }
    }
