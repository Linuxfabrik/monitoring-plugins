            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "nextcloud_enterprise_always_ok": false,
                "nextcloud_enterprise_grace_wait": "3D",
                "nextcloud_enterprise_no_perfdata": false,
                "nextcloud_enterprise_path": "/var/www/html/nextcloud",
                "nextcloud_enterprise_timeout": 8
            },
            "volatile": null,
            "zone": null,
