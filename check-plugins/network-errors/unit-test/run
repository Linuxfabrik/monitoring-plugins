import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    # A clean interface table never alerts.
    {
        'id': 'ok-no-errors',
        'test': 'stdout/no-errors,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.', 'eth0'],
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    # --ignore excludes interfaces by regex.
    {
        'id': 'ok-ignore-excludes-lo',
        'test': 'stdout/no-errors,,0',
        'params': '--ignore=^lo$',
        'assert-retc': STATE_OK,
        'assert-not-in': ['lo '],
    },
    # --match keeps only interfaces whose name matches the regex.
    {
        'id': 'ok-match-only-eth',
        'test': 'stdout/no-errors,,0',
        'params': '--match=^eth',
        'assert-retc': STATE_OK,
        'assert-in': ['eth0'],
        'assert-not-in': ['lo '],
    },
    # Same fixture (7 rx errors), three threshold combinations on the error total.
    {
        'id': 'warn-rx-errs-default',
        'test': 'stdout/rx-errs-eth0,,0',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-regex': r'eth0.*7\.0.*\[WARNING\]',
    },
    {
        'id': 'ok-rx-errs-below-warning',
        'test': 'stdout/rx-errs-eth0,,0',
        'params': '--warning 10',
        'assert-retc': STATE_OK,
        'assert-not-in': ['[WARNING]', '[CRITICAL]'],
    },
    {
        'id': 'crit-rx-errs-above-critical',
        'test': 'stdout/rx-errs-eth0,,0',
        'params': '--warning 1 --critical 5',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'eth0.*7\.0.*\[CRITICAL\]',
    },
    # rx_errs=5 + tx_errs=4 -> error total 9; the fifo/frame/carrier breakdown
    # (subsets of those totals) is always shown but never summed into the total.
    {
        'id': 'warn-rx-tx-errors-total',
        'test': 'stdout/rx-tx-errors,,0',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ['Tx Carrier/s', 'Rx Frame/s'],
        'assert-regex': r'eth0.*9\.0.*\[WARNING\]',
    },
    {
        'id': 'crit-rx-tx-errors-total',
        'test': 'stdout/rx-tx-errors,,0',
        'params': '--warning 1 --critical 5',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'eth0.*9\.0.*\[CRITICAL\]',
    },
    # A container host: veth pairs and the bridge sit next to the real NIC, and
    # the interface name is longer than the "%6s" the kernel formats it with, so
    # the name column is not padded. Names cannot carry a colon themselves
    # (dev_valid_name() rejects it), which is what makes splitting the line at
    # the first colon safe.
    {
        'id': 'ok-container-host-many-interfaces',
        'test': 'stdout/container-host-veth-docker0,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.', 'vethf345468', 'docker0', 'eth0'],
    },
    # The usual way to keep container noise out of the graphs.
    {
        'id': 'ok-ignore-excludes-container-interfaces',
        'test': 'stdout/container-host-veth-docker0,,0',
        'params': '--ignore=^veth --ignore=^docker',
        'assert-retc': STATE_OK,
        'assert-in': ['eth0'],
        'assert-not-in': ['vethf345468', 'docker0'],
    },
    # A line that carries fewer counters than the kernel layout defines is
    # dropped instead of shifting every column by one; the healthy interfaces
    # in the same table are still reported.
    {
        'id': 'warn-truncated-line-is-skipped',
        'test': 'stdout/truncated-interface-line,,0',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ['lo', 'eth1'],
        'assert-not-in': ['eth0'],
    },
    # #1308: a filter that matches no interface yields "Nothing checked.";
    # --no-match-severity controls the resulting state (default OK).
    {
        'id': 'ok-no-match-default-stays-ok',
        'test': 'stdout/no-errors,,0',
        'params': '--match=ZZZNONE',
        'assert-retc': STATE_OK,
        'assert-in': ['Nothing checked.'],
    },
    {
        'id': 'unknown-no-match-severity-maps-empty-to-unknown',
        'test': 'stdout/no-errors,,0',
        'params': '--match=ZZZNONE --no-match-severity=unknown',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Nothing checked.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../network-errors'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
