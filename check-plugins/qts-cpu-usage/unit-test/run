        'id': 'ok-ts-451-4-2-2',
        'test': 'stdout/qnapstats-ts-451-4-2-2-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            '2.3%',
        ],
    },
    {
        'id': 'ok-ts-639-4-2-3',
        'test': 'stdout/qnapstats-ts-639-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            '8.0%',
        ],
    },
    {
        'id': 'ok-ts-ec1280u-4-5-2',
        'test': 'stdout/qnapstats-ts-ec1280u-4-5-2-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            '1.2%',
        ],
    },
    {
        # a single run cannot fill five consecutive runs of the (in-memory) history
        'id': 'ok-count-not-reached',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com --warning=40 --critical=45',
        'assert-retc': STATE_OK,
        'assert-in': [
            '48.5%',
        ],
    },
    {
        'id': 'warn-count-1',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com --count=1 --warning=40 --critical=60',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '48.5%',
        ],
    },
    {
        'id': 'crit-count-1',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com --count=1 --warning=40 --critical=45',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '48.5%',
        ],
    },
    {
        # a lower bound: 48.5% is below 50
        'id': 'crit-range-lower-bound',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com --count=1 --warning=60: --critical=50:',
        'assert-retc': STATE_CRIT,
        'assert-in': ['48.5%'],
    },
    {
        'id': 'warn-range-inside',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com --count=1 --warning=@40:50 --critical=95',
        'assert-retc': STATE_WARN,
        'assert-in': ['48.5%'],
    },
    {
        'id': 'ok-always-ok-masks-crit',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com --count=1 --warning=40 --critical=45 --always-ok',
        'assert-retc': STATE_OK,
        'assert-in': [
            '48.5%',
        ],
    },
]


class TestCheck(unittest.TestCase):
    check = '../qts-cpu-usage'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
