    "Datafield": {
        "1": {
            "varname": "multipath_always_ok",
            "caption": "Multipath: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3571e54e-d282-46e3-8c15-369423b0dcca"
        },
        "2": {
            "varname": "multipath_critical",
            "caption": "Multipath: Critical",
            "description": "CRIT threshold for the percentage of the expected paths that are usable, compared as a Nagios range. Supports Nagios ranges. Example: `--critical=1:` alerts only once a map has no usable path left.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "00b34d13-a0da-4537-9daa-6d27905b6f79"
        },
        "3": {
            "varname": "multipath_expected_paths",
            "caption": "Multipath: Expected Paths",
            "description": "Expected number of paths per multipath map. A LUN in a fabric normally has the same number of paths as every other one, so one value covers the whole host and catches a path that disappeared from a map entirely, which comparing a map against itself cannot. `--map` pins a single map that has a different number. Example: `--expected-paths=4` on a host with two HBAs and two controllers.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "622510c3-82fb-485a-b09c-5dadf457a53e"
        },
        "4": {
            "varname": "multipath_ignore",
            "caption": "Multipath: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "cb099638-d3b5-4bfe-9441-d8c6c85adda5"
        },
        "5": {
            "varname": "multipath_lengthy",
            "caption": "Multipath: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "bb0d2e64-f976-45e0-8def-501eeacce7ec"
        },
        "6": {
            "varname": "multipath_map",
            "caption": "Multipath: Map",
            "description": "Check this multipath map and, optionally, the number of paths it is expected to have, written as `name=count`. The name is the alias where the host uses one, and the WWID otherwise. Without `=count` the map is graded against `--expected-paths`, and against its own number of paths where that is not given either. Can be specified multiple times; if given at least once, only the named maps are checked. Example: `--map=mpatha=4` alerts when the `mpatha` map does not have its four paths, even after one of them disappeared from the map entirely. Example: `--map=mpathb` checks `mpathb` against the paths it currently has.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8527a1fa-fc4e-4d60-9a66-57375c946384"
        },
        "7": {
            "varname": "multipath_marginal_severity",
            "caption": "Multipath: Marginal Severity",
            "description": "State to report for a path multipathd has declared marginal, which means it went up and down often enough that the daemon keeps it out of the normal path groups.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "multipath_marginal_severity_list"
            },
            "uuid": "43e58710-b6da-4048-b191-9dee87fbed7b"
        },
        "8": {
            "varname": "multipath_no_maps_severity",
            "caption": "Multipath: No Maps Severity",
            "description": "State to report when multipathd holds no map at all. A map whose last path disappears is flushed rather than kept with zero paths, so this is not necessarily a host without multipathed storage.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "multipath_no_maps_severity_list"
            },
            "uuid": "02b2c7a7-40f9-4319-b921-2b809c41495e"
        },
        "9": {
            "varname": "multipath_no_match_severity",
            "caption": "Multipath: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "multipath_no_match_severity_list"
            },
            "uuid": "dc78a708-2fdf-4645-a79d-a1dde107d9db"
        },
        "10": {
            "varname": "multipath_no_perfdata",
            "caption": "Multipath: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f277612b-aba4-4450-912e-c8f9d6787255"
        },
        "11": {
            "varname": "multipath_timeout",
            "caption": "Multipath: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0b796a7f-e570-429c-8d59-ba054984fbe5"
        },
        "12": {
            "varname": "multipath_warning",
            "caption": "Multipath: Warning",
            "description": "WARN threshold for the percentage of the expected paths that are usable, compared as a Nagios range. Supports Nagios ranges. Example: `--warning=60:` tolerates losing up to 40% of the paths before warning.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "aa3941e9-83ff-4917-8708-69819756a833"
        }
    }
