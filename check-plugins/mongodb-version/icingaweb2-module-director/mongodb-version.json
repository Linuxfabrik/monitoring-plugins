            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "eb9e9c6a-011c-4948-90f3-9662da5e406f"
        },
        "4": {
            "varname": "mongodb_version_check_patch",
