            "format": null,
            "settings": {},
            "uuid": "116efb40-0c25-4198-aaa6-3d967f26aa23"
        },
        "8": {
            "varname": "mongodb_version_offset_eol",
            "caption": "Mongodb Version: Offset Eol",
            "description": "Alert n days before (\"-30\") or after an EOL date (\"30\" or \"+30\").",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8b20c282-818a-457f-b7c2-5dbb0be79982"
        },
        "9": {
            "varname": "mongodb_version_path",
            "caption": "Mongodb Version: Path",
