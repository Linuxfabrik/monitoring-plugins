            ],
            "max_check_attempts": 5,
            "notes": "Sends ICMP ECHO_REQUEST packets to a network host using the system's built-in ping command and reports round-trip time, round-trip variability and packet loss. By default it reports CRITICAL only when the host is unreachable (no packet returns), so even high packet loss stays OK as long as one reply arrives. The optional --rta-warning/--rta-critical (round-trip average), --rtt-mdev-warning/--rtt-mdev-critical (round-trip variability, a jitter measure) and --packet-loss-warning/--packet-loss-critical thresholds additionally alert on latency, jitter and packet loss.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/ping/",
            "object_name": "tpl-service-ping",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "A",
                "ping_always_ok": false,
                "ping_count": 5,
                "ping_hostname": "127.0.0.1",
                "ping_interval": 0.2,
                "ping_no_perfdata": false,
                "ping_timeout": 5
            },
            "volatile": null,
            "zone": null,
            "uuid": "b716f127-2e5d-44bb-b480-09e9bb7bd9ec"
        }
