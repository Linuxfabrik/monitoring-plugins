        "1": {
            "varname": "huawei_dorado_alarm_always_ok",
            "caption": "Huawei Dorado Alarm: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "dcb3c551-c0f4-420c-be54-4c468180900f"
        },
        "2": {
            "varname": "huawei_dorado_alarm_cache_expire",
            "caption": "Huawei Dorado Alarm: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6d4e6d8a-cba0-426f-ba62-5bc75fb829d7"
        },
        "3": {
            "varname": "huawei_dorado_alarm_device_id",
            "caption": "Huawei Dorado Alarm: Device ID",
            "description": "Huawei OceanStor Dorado API device ID. Optional: the appliance reports its own at login, so this is only needed to override that answer.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "50cec285-02e7-419f-b93a-1322bb5fe191"
        },
        "4": {
            "varname": "huawei_dorado_alarm_ignore",
            "caption": "Huawei Dorado Alarm: Ignore",
            "description": "Skip alarms. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the alarm name, its description and the module it occurred on, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "57ee6402-af10-4fda-9fd4-a8492c01b729"
        },
        "5": {
            "varname": "huawei_dorado_alarm_insecure",
            "caption": "Huawei Dorado Alarm: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ad4a2eea-c862-440a-b38b-33e9bed0f8f5"
        },
        "6": {
            "varname": "huawei_dorado_alarm_match",
            "caption": "Huawei Dorado Alarm: Match",
            "description": "Limit to alarms. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the alarm name, its description and the module it occurred on, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "63353a95-78f8-483b-a650-5784df552cac"
        },
        "7": {
            "varname": "huawei_dorado_alarm_no_insecure",
            "caption": "Huawei Dorado Alarm: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "ae3489e4-6310-48fa-8d9b-38d1971568ec"
        },
        "8": {
            "varname": "huawei_dorado_alarm_no_match_severity",
            "caption": "Huawei Dorado Alarm: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_dorado_alarm_no_match_severity_list"
            },
            "uuid": "15a02739-fefd-4b40-b8b2-b0705c5905d9"
        },
        "9": {
            "varname": "huawei_dorado_alarm_no_perfdata",
            "caption": "Huawei Dorado Alarm: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "987d4f3d-bfa6-47ef-8179-811f1bcaafd8"
        },
        "10": {
            "varname": "huawei_dorado_alarm_no_proxy",
            "caption": "Huawei Dorado Alarm: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6e6f048f-530b-40d0-b852-b7dfa1421caa"
        },
        "11": {
            "varname": "huawei_dorado_alarm_password",
            "caption": "Huawei Dorado Alarm: Password",
            "description": "Huawei OceanStor Dorado API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "f76c64dd-9090-49b6-9b6b-31d80555591f"
        },
        "12": {
            "varname": "huawei_dorado_alarm_password_file",
            "caption": "Huawei Dorado Alarm: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "542817b4-1c39-4577-a25e-5da53883563b"
        },
        "13": {
            "varname": "huawei_dorado_alarm_proxy",
            "caption": "Huawei Dorado Alarm: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ac951edd-7726-43e2-a29d-ff4ea48d63d1"
        },
        "14": {
            "varname": "huawei_dorado_alarm_scope",
            "caption": "Huawei Dorado Alarm: Scope",
            "description": "Huawei OceanStor Dorado API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "555465b0-037c-4283-9a26-fe5f38c0045a"
        },
        "15": {
            "varname": "huawei_dorado_alarm_timeout",
            "caption": "Huawei Dorado Alarm: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2dc91205-0430-47d2-b3d8-275d097a6a28"
        },
        "16": {
            "varname": "huawei_dorado_alarm_url",
            "caption": "Huawei Dorado Alarm: URL",
            "description": "Huawei OceanStor Dorado API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ee7ce688-f563-4917-9e61-6feb663dd970"
        },
        "17": {
            "varname": "huawei_dorado_alarm_username",
            "caption": "Huawei Dorado Alarm: Username",
            "description": "Huawei OceanStor Dorado API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b080fcf3-f1b9-4bf1-a76f-b69f0cb8346f"
        },
        "18": {
            "varname": "huawei_dorado_alarm_verbose",
            "caption": "Huawei Dorado Alarm: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3215f1a2-480c-4fdf-88a2-15e9662e2a25"
        }
    }
