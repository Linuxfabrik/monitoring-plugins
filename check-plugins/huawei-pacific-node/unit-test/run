import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN

TESTS = [
    {
        'id': 'ok-nodes-healthy',
        'test': 'stdout/nodes-healthy,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok.',
            'FSM01',
            'Pacific (STL6SPCM)',
            'online',
        ],
    },
    {
        # A node that left the cluster took its share of the storage with it,
        # so an offline node has to reach CRITICAL. Its OAM agent reporting
        # faulty stays a warning: that is the management path, not the data one.
        'id': 'crit-node-offline-and-oam-faulty',
        'test': 'stdout/nodes-one-faulty,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_CRIT,
        'assert-regex': r'offline.*\[CRITICAL\]',
    },
    {
        # An appliance always has cluster nodes. An empty list means the query
        # never reached them, which must not read as a healthy inventory.
        'id': 'unknown-no-cluster-nodes',
        'test': 'stdout/no-cluster-nodes,,0',
        'params': '--password=linuxfabrik --url=https://localhost --username=admin',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['reported no cluster nodes.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../huawei-pacific-node'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
