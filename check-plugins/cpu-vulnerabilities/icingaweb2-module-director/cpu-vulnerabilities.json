    "Datafield": {
        "1": {
            "varname": "cpu_vulnerabilities_always_ok",
            "caption": "CPU Vulnerabilities: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "72e305e6-7306-4fbd-b6c5-6edd135c24f2"
        },
        "2": {
            "varname": "cpu_vulnerabilities_ignore",
            "caption": "CPU Vulnerabilities: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1c3826a8-bfc7-43e2-9b98-85e9218f1af2"
        },
        "3": {
            "varname": "cpu_vulnerabilities_match",
            "caption": "CPU Vulnerabilities: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "cc1134c8-bcee-46e9-9542-6846e5183bf2"
        },
        "4": {
            "varname": "cpu_vulnerabilities_no_match_severity",
            "caption": "CPU Vulnerabilities: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "cpu_vulnerabilities_no_match_severity_list"
            },
            "uuid": "adf0487f-f37d-43c4-944c-2976bc6bdeae"
        },
        "5": {
            "varname": "cpu_vulnerabilities_no_perfdata",
            "caption": "CPU Vulnerabilities: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5646146f-6deb-404e-bfa4-f443dd7ddcc3"
        },
        "6": {
            "varname": "cpu_vulnerabilities_severity",
            "caption": "CPU Vulnerabilities: Severity",
            "description": "Severity for alerting. Applies to a vulnerability the CPU is affected by that has no mitigation in effect.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "cpu_vulnerabilities_severity_list"
            },
            "uuid": "c6bcc898-43ce-45a8-93ae-4688fe37a831"
        },
        "7": {
            "varname": "cpu_vulnerabilities_unknown_severity",
            "caption": "CPU Vulnerabilities: Unknown Severity",
            "description": "State to report for a vulnerability whose state cannot be determined, and for a kernel that publishes no vulnerability information at all. A guest sees only what its hypervisor hands through and regularly cannot decide, which is why this defaults to not alerting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
