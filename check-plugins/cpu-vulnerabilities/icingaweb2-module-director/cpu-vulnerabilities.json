                "cpu_vulnerabilities_always_ok": false,
                "cpu_vulnerabilities_ignore": [],
                "cpu_vulnerabilities_match": [],
                "cpu_vulnerabilities_no_match_severity": "ok",
                "cpu_vulnerabilities_no_perfdata": false,
                "cpu_vulnerabilities_severity": "warn",
                "cpu_vulnerabilities_unknown_severity": "ok"
            },
            "volatile": null,
