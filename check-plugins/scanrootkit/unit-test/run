import fcntl
import os
import shutil
import socket
import sys
import tempfile

sys.path.insert(0, '..')  # Adds higher directory to python modules path.


import unittest

import lib.base
import lib.shell
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN

# The plugin reads its signatures from the assets/ directory next to itself.
# Each run therefore works on a private copy of the plugin and its assets/ in a
# temporary directory, drops its tiny test signatures into that copy, and puts
# the trigger files (or directories) there too. Two runs at the same time, for
# example tox environments in parallel, then never see each other's signatures,
# and a run never writes into the repository.
#
# The shipped CiNIK signature can only be triggered through the real
# /tmp/.cinik, which every run on the host shares, and which would make the
# baseline of a concurrent run report a rootkit. The whole class therefore holds
# an exclusive lock on a fixed file for as long as it runs.
#
# setUp/tearDown make sure the per-test artifacts are always removed, even if an
# assertion fails mid-test, so a failed test never poisons the next one.

LOCK_FILE = '/tmp/.scanrootkit-utest.lock'


class TestCheck(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls._lock = open(LOCK_FILE, 'a', encoding='utf-8')  # noqa: SIM115
        fcntl.flock(cls._lock, fcntl.LOCK_EX)
        cls.workdir = tempfile.mkdtemp(prefix='scanrootkit-utest-')
        cls.check = os.path.join(cls.workdir, 'scanrootkit')
        shutil.copy2('../scanrootkit', cls.check)
        cls.assets_dir = os.path.join(cls.workdir, 'assets')
        shutil.copytree('../assets', cls.assets_dir)
        os.symlink(os.path.realpath('../lib'), os.path.join(cls.workdir, 'lib'))
        cls.trigger_prefix = os.path.join(cls.workdir, 'trigger-')

    @classmethod
    def tearDownClass(cls):
        shutil.rmtree(cls.workdir, ignore_errors=True)
        fcntl.flock(cls._lock, fcntl.LOCK_UN)
        cls._lock.close()

    def setUp(self):
        self._tmp_paths = []  # trigger files / dirs to clean up
        self._tmp_signatures = []  # YAMLs we dropped into the assets/ copy

    def tearDown(self):
        for path in self._tmp_paths:
            if os.path.isdir(path) and not os.path.islink(path):
                try:
                    shutil.rmtree(path)
                except OSError:
                    pass
            elif os.path.lexists(path):
                # regular files, symlinks, sockets and FIFOs
                try:
                    os.remove(path)
                except OSError:
                    pass
        for sig in self._tmp_signatures:
            try:
                os.remove(sig)
            except OSError:
                pass

    def _add_signature(self, slug, content):
        path = os.path.join(self.assets_dir, f'scanrootkit-utest-{slug}.yml')
        with open(path, 'w', encoding='utf-8') as fh:
            fh.write(content)
        self._tmp_signatures.append(path)
        return path

    def _touch(self, path):
        with open(path, 'w', encoding='utf-8') as fh:
            fh.write('')
        self._tmp_paths.append(path)
        return path

    def _mkfifo(self, path):
        os.mkfifo(path)
        self._tmp_paths.append(path)
        return path

    def _mksocket(self, path):
        # binding a UNIX socket creates the socket file; it stays on disk after
        # the socket is closed
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.bind(path)
        self._tmp_paths.append(path)
        return path

    def _mkdir(self, path):
        os.makedirs(path, exist_ok=True)
        self._tmp_paths.append(path)
        return path

    # --------------------------------------------------------------------
    # Existing baseline tests (kept, just renamed)
    # --------------------------------------------------------------------

    def test_baseline_clean_system_is_ok(self):
        stdout, stderr, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Everything is ok. Scanned for ', stdout)
        self.assertEqual(stderr, '')
        self.assertEqual(retc, STATE_OK)

    def test_real_cinik_signature_default_severity_is_crit(self):
        # /tmp/.cinik matches both the CiNIK Worm and Slapper Worm rkhunter
        # signatures shipped in assets/, so a single trigger file produces
        # two distinct rootkit findings.
        self._touch('/tmp/.cinik')
        stdout, stderr, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn(
            'Found 2 rootkits. 0 possible rootkits found. [CRITICAL]',
            stdout,
        )
        self.assertIn('Rootkits:', stdout)
        self.assertIn('CiNIK Worm (Slapper.B variant)', stdout)
        self.assertIn('Slapper Worm', stdout)
        self.assertIn('/tmp/.cinik (File)', stdout)
        self.assertEqual(stderr, '')
        self.assertEqual(retc, STATE_CRIT)

    def test_real_cinik_signature_with_warn_severity(self):
        self._touch('/tmp/.cinik')
        stdout, stderr, retc = lib.base.coe(
            lib.shell.shell_exec([self.check, '--severity=warn'])
        )
        self.assertIn(
            'Found 2 rootkits. 0 possible rootkits found. [WARNING]',
            stdout,
        )
        self.assertIn('Rootkits:', stdout)
        self.assertIn('CiNIK Worm (Slapper.B variant)', stdout)
        self.assertIn('/tmp/.cinik (File)', stdout)
        self.assertEqual(stderr, '')
        self.assertEqual(retc, STATE_WARN)

    # --------------------------------------------------------------------
    # New tests covering features that were not exercised before
    # --------------------------------------------------------------------

    def test_directory_indicator_is_detected(self):
        target_dir = self.trigger_prefix + 'dir'
        self._mkdir(target_dir)
        self._add_signature(
            'dir',
            (
                "name: 'Test Directory Rootkit'\n"
                'files: []\n'
                f"dirs:\n  - '{target_dir}'\n"
                'ksyms: []\n'
                'cl: 100\n'
            ),
        )
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Test Directory Rootkit', stdout)
        self.assertIn(f'{target_dir} (Dir)', stdout)
        self.assertEqual(retc, STATE_CRIT)

    def test_socket_and_fifo_indicators_are_detected(self):
        socket_target = self._mksocket(self.trigger_prefix + 'socket')
        fifo_target = self._mkfifo(self.trigger_prefix + 'fifo')
        self._add_signature(
            'socket-fifo',
            (
                "name: 'Test Socket Rootkit'\n"
                f"files:\n  - '{socket_target}'\n  - '{fifo_target}'\n"
                'dirs: []\n'
                'ksyms: []\n'
                'cl: 100\n'
            ),
        )
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Found 1 rootkit.', stdout)
        self.assertIn(f'{socket_target} (Socket)', stdout)
        self.assertIn(f'{fifo_target} (FIFO)', stdout)
        self.assertEqual(retc, STATE_CRIT)

    def test_device_node_is_not_a_file_indicator(self):
        # several historic signatures name paths under /dev; a device node
        # there belongs to udev and must not count as a rootkit file
        self._add_signature(
            'device-node',
            (
                "name: 'Test Device Node Rootkit'\n"
                "files:\n  - '/dev/null'\n"
                'dirs: []\n'
                'ksyms: []\n'
                'cl: 100\n'
            ),
        )
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertNotIn('Test Device Node Rootkit', stdout)
        self.assertEqual(retc, STATE_OK)

    def test_kernel_symbol_indicator_is_detected(self):
        # Pick any real, exported symbol from /proc/kallsyms so the test does
        # not depend on a particular kernel version naming convention. We try
        # a few well-known candidates and fall back to the first symbol the
        # parser finds.
        if not os.path.isfile('/proc/kallsyms'):
            self.skipTest('no /proc/kallsyms on this host')
        candidates = {'_printk', 'printk', 'init_task', 'system_state', 'jiffies'}
        real_sym = None
        first_seen = None
        with open('/proc/kallsyms', encoding='utf-8') as fh:
            for line in fh:
                parts = line.split()
                if len(parts) < 3:
                    continue
                if first_seen is None:
                    first_seen = parts[2]
                if parts[2] in candidates:
                    real_sym = parts[2]
                    break
        if real_sym is None:
            real_sym = first_seen
        if real_sym is None:
            self.skipTest('no symbols exported in /proc/kallsyms')
        self._add_signature(
            'ksym',
            (
                "name: 'Test Kernel Symbol Rootkit'\n"
                'files: []\n'
                'dirs: []\n'
                f"ksyms:\n  - '{real_sym}'\n"
                'cl: 100\n'
            ),
        )
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Test Kernel Symbol Rootkit', stdout)
        self.assertIn(f'{real_sym} (Kernel Symbol)', stdout)
        self.assertEqual(retc, STATE_CRIT)

    def test_kernel_symbol_match_is_exact_no_substring(self):
        # The pre-fix plugin used `item in ksyms_file`, which would match `prin`
        # against the full kallsyms text (because `printk` contains `prin`).
        # The fixed plugin does exact set membership against parsed symbol
        # names, so a substring of a real symbol must NOT trigger a finding.
        self._add_signature(
            'ksym-substr',
            (
                "name: 'Test Substring Should Not Match'\n"
                'files: []\n'
                'dirs: []\n'
                "ksyms:\n  - 'prin'\n"
                'cl: 100\n'
            ),
        )
        stdout, _, _ = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertNotIn('Test Substring Should Not Match', stdout)

    def test_low_confidence_signature_reports_as_possible_warn(self):
        target = self.trigger_prefix + 'possible'
        self._touch(target)
        self._add_signature(
            'possible',
            (
                "name: 'Test Possible Rootkit'\n"
                f"files:\n  - '{target}'\n"
                'dirs: []\n'
                'ksyms: []\n'
                'cl: 50\n'
            ),
        )
        # Even with --severity=crit (the default), a cl<100 hit is only WARN.
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Possible Rootkits:', stdout)
        self.assertIn('Test Possible Rootkit', stdout)
        self.assertEqual(retc, STATE_WARN)

    def test_discovered_field_renders_in_output(self):
        target = self.trigger_prefix + 'discovered'
        self._touch(target)
        self._add_signature(
            'discovered',
            (
                "name: 'Test Dated Rootkit'\n"
                f"files:\n  - '{target}'\n"
                'dirs: []\n'
                'ksyms: []\n'
                "discovered: '2099'\n"
                'cl: 100\n'
            ),
        )
        stdout, _, _ = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Test Dated Rootkit (2099)', stdout)
        self.assertIn(f'{target} (File)', stdout)

    def test_signature_without_discovered_field_renders_plain_name(self):
        target = self.trigger_prefix + 'undated'
        self._touch(target)
        self._add_signature(
            'undated',
            (
                "name: 'Test Undated Rootkit'\n"
                f"files:\n  - '{target}'\n"
                'dirs: []\n'
                'ksyms: []\n'
                'cl: 100\n'
            ),
        )
        stdout, _, _ = lib.base.coe(lib.shell.shell_exec([self.check]))
        # No parenthesized year suffix on the name.
        self.assertIn('Test Undated Rootkit:', stdout)
        self.assertNotIn('Test Undated Rootkit (', stdout)

    def test_broken_yaml_signature_is_reported_and_check_continues(self):
        # Drop a deliberately broken signature file into assets/. The plugin
        # should report it under "Scanfile Errors" but still scan everything
        # else and return a baseline OK on a clean system.
        path = os.path.join(self.assets_dir, 'scanrootkit-utest-broken.yml')
        with open(path, 'w', encoding='utf-8') as fh:
            fh.write('name: [unterminated\n')
        self._tmp_signatures.append(path)
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Scanfile Errors:', stdout)
        self.assertIn('scanrootkit-utest-broken.yml', stdout)
        # baseline check still completes
        self.assertIn('Everything is ok. Scanned for ', stdout)
        self.assertEqual(retc, STATE_OK)

    def test_signature_missing_required_key_is_reported(self):
        # A YAML without the mandatory `files` key must be reported as a
        # KeyError scanfile error, but the rest of the scan must still run.
        self._add_signature(
            'missing-key',
            ("name: 'Test Missing Key'\ndirs: []\nksyms: []\ncl: 100\n"),
        )
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Scanfile Errors:', stdout)
        self.assertIn('scanrootkit-utest-missing-key.yml', stdout)
        self.assertIn('Key Error', stdout)
        self.assertEqual(retc, STATE_OK)

    def test_perfdata_max_carries_signature_count(self):
        # The total number of rootkit signatures in assets/ has to surface as the
        # `max` field of both `rootkit_items` and `rootkit_possible`. This is
        # what admins use to graph signature-database growth, and it doubles as
        # the upper bound of the metric range for visualization tools.
        sig_count = len([f for f in os.listdir(self.assets_dir) if f.endswith('.yml')])
        stdout, _, _ = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn(f"'rootkit_items'=0;;;0;{sig_count}", stdout)
        self.assertIn(f"'rootkit_possible'=0;;;0;{sig_count}", stdout)

    def test_confirmed_and_possible_in_one_run_is_crit(self):
        confirmed_target = self.trigger_prefix + 'mix-confirmed'
        possible_target = self.trigger_prefix + 'mix-possible'
        self._touch(confirmed_target)
        self._touch(possible_target)
        self._add_signature(
            'mix-confirmed',
            (
                "name: 'Test Mix Confirmed'\n"
                f"files:\n  - '{confirmed_target}'\n"
                'dirs: []\n'
                'ksyms: []\n'
                'cl: 100\n'
            ),
        )
        self._add_signature(
            'mix-possible',
            (
                "name: 'Test Mix Possible'\n"
                f"files:\n  - '{possible_target}'\n"
                'dirs: []\n'
                'ksyms: []\n'
                'cl: 50\n'
            ),
        )
        stdout, _, retc = lib.base.coe(lib.shell.shell_exec([self.check]))
        self.assertIn('Found 1 rootkit.', stdout)
        self.assertIn('1 possible rootkit found.', stdout)
        self.assertIn('Rootkits:', stdout)
        self.assertIn('Possible Rootkits:', stdout)
        # Confirmed wins over possible: state must be CRIT, not WARN.
        self.assertEqual(retc, STATE_CRIT)


if __name__ == '__main__':
    unittest.main()
