        "17": {
            "varname": "postfix_logfile_insecure",
            "caption": "Postfix Logfile: Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "005f371c-d3d7-4362-969f-382c6c0ab23a"
        },
        "18": {
            "varname": "postfix_logfile_lookback",
            "caption": "Postfix Logfile: Lookback",
            "description": "Failed logins, rejected messages, aborted connections, deferred and bounced deliveries are counted within this window rather than reported one by one. Time window in seconds to look back over, ending at the moment of the run. Only what falls within it is counted, so what is reported is how often something happened lately rather than a total that keeps growing for as long as the source is kept. Example: `--lookback=3600`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e5566f18-9f61-4baa-860f-4b90a8aa7565"
        },
        "19": {
            "varname": "postfix_logfile_match",
            "caption": "Postfix Logfile: Match",
            "description": "Only consider a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Example: `--match='postfix/smtpd'`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "6a11a263-9dce-4268-b96a-a50a1878ff02"
        },
        "20": {
            "varname": "postfix_logfile_no_insecure",
            "caption": "Postfix Logfile: No Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7a7fc621-7955-4d00-bade-86c7a6e8dffc"
        },
        "21": {
            "varname": "postfix_logfile_no_match_severity",
            "caption": "Postfix Logfile: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "postfix_logfile_no_match_severity_list"
            },
            "uuid": "e62f91e0-abed-41bd-8455-8bbbbc730991"
        },
        "22": {
            "varname": "postfix_logfile_no_per_source",
            "caption": "Postfix Logfile: No Per Source?",
            "description": "Judge a rate by everything that arrived within the window, whatever source the lines name. Use this where the log reaches this check through something that rewrites or drops the address of the peer, or where every source is as interesting as the next.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "224b8f8e-99d5-43fb-823a-cb82f9f4a9e4"
        },
        "23": {
            "varname": "postfix_logfile_no_perfdata",
            "caption": "Postfix Logfile: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "58c1a824-7950-4c2c-aeb7-ff879952618a"
        },
        "24": {
            "varname": "postfix_logfile_no_proxy",
            "caption": "Postfix Logfile: No Proxy?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "10208ff0-d89a-4125-a8f8-a71dd5148ec1"
        },
        "25": {
            "varname": "postfix_logfile_per_source",
            "caption": "Postfix Logfile: Per Source?",
            "description": "Judge a rate by the busiest single source address rather than by everything that arrived. A handful of failures from one address within the window is somebody working on this host; the same number spread over as many addresses is the background of an open network going past, and only the first is worth reporting. Lines that name no source are counted together as one, so a burst of those still reports.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "fdd5fdb8-8c8f-41eb-a799-9da0deeb859f"
        },
        "26": {
            "varname": "postfix_logfile_proxy",
            "caption": "Postfix Logfile: Proxy",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "01603acf-a313-40cb-a091-88ee3e02f1d6"
        },
        "27": {
            "varname": "postfix_logfile_relay_failures_critical",
            "caption": "Postfix Logfile: Relay Failures Critical",
            "description": "Number of failed connections to the next hop within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--relay-failures-critical=500`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7678c3e6-ae35-4748-a495-6a4b74509405"
        },
        "28": {
            "varname": "postfix_logfile_relay_failures_warning",
            "caption": "Postfix Logfile: Relay Failures Warning",
            "description": "Number of failed connections to the next hop within `--lookback` that returns WARNING. A host without an IPv6 route logs one for the AAAA record of its relay and delivers over IPv4 in the same second, so a single one is not a failure; a relay that is really down produces them by the dozen. 0 turns the threshold off. Example: `--relay-failures-warning=5`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "cf23623d-6a8f-4bd0-9563-10d468346600"
        },
        "29": {
            "varname": "postfix_logfile_rejects_critical",
            "caption": "Postfix Logfile: Rejects Critical",
            "description": "Number of messages the server turned away within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--rejects-critical=200`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "09888df9-73e8-439d-ac12-607c84ebd680"
        },
        "30": {
            "varname": "postfix_logfile_rejects_warning",
            "caption": "Postfix Logfile: Rejects Warning",
            "description": "Number of messages the server turned away within `--lookback` that returns WARNING. Counted per source address. A server that answers the internet turns mail away all day and wants this raised. 0 turns the threshold off. Example: `--rejects-warning=50`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e03f28ac-155b-4d15-888f-3d9fabf511a3"
        },
        "31": {
            "varname": "postfix_logfile_server_log",
            "caption": "Postfix Logfile: Server Log",
            "description": "Log source to read from. Accepts a file path, `docker:CONTAINER`, `podman:CONTAINER`, `kubectl:CONTAINER` or `systemd:UNITNAME`. Can be specified multiple times, and everything named is then read as one window; a source named twice is read once. If omitted, the check takes `maillog_file` from the Postfix configuration where it is set, falls back to the mail log of the distribution, and reads the journal of the Postfix unit along with it; what the two share is counted once. Example: `--server-log=systemd:postfix.service`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b1cc71a8-88dc-40b3-91ff-8e7eced8e781"
        },
        "32": {
            "varname": "postfix_logfile_tls_failures_critical",
            "caption": "Postfix Logfile: Tls Failures Critical",
            "description": "Number of TLS connections that did not come off within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--tls-failures-critical=500`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2c1ba4f1-c10a-4db4-aaf2-579a95071a0e"
        },
        "33": {
            "varname": "postfix_logfile_tls_failures_warning",
            "caption": "Postfix Logfile: Tls Failures Warning",
            "description": "Number of TLS connections that did not come off within `--lookback` that returns WARNING. A single one is one remote server having a bad day; a server that answers the internet collects those all day. 0 turns the threshold off. Example: `--tls-failures-warning=5`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f32c4265-4fb4-4288-bb2e-7a626aec2032"
        },
        "34": {
            "varname": "postfix_logfile_timeout",
            "caption": "Postfix Logfile: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c29642b0-620f-44f5-a63f-7da491ddc190"
        },
        "35": {
            "varname": "postfix_logfile_warning_level",
            "caption": "Postfix Logfile: Warning Level",
            "description": "Level from which a line returns WARNING, up to the level `--critical-level` names. `none` turns the level counts off and leaves the named events. Example: `--warning-level=error`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "postfix_logfile_warning_level_list"
            },
            "uuid": "eab3e90e-7dff-48b2-95d4-c4cf3099afeb"
        }
    }
}
