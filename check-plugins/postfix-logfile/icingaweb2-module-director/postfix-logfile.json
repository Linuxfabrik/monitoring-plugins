    "Datafield": {
        "1": {
            "varname": "postfix_logfile_aborted_connections_critical",
            "caption": "Postfix Logfile: Aborted Connections Critical",
            "description": "Number of conversations that ended before a message was handed over within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--aborted-connections-critical=5000`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3b9e7bcb-ce75-469f-b194-2700fce1e646"
        },
        "2": {
            "varname": "postfix_logfile_aborted_connections_warning",
            "caption": "Postfix Logfile: Aborted Connections Warning",
            "description": "Number of conversations that ended before a message was handed over within `--lookback` that returns WARNING. Every server answering on port 25 collects these all day, so this is meant to catch a scan starting and not the background noise. 0 turns the threshold off. Example: `--aborted-connections-warning=500`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2f6384c1-092b-4d7a-9926-3a7d47f75a96"
        },
        "3": {
            "varname": "postfix_logfile_always_ok",
            "caption": "Postfix Logfile: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "45523d0e-363f-42e8-9977-9e9ed8799b1d"
        },
        "4": {
            "varname": "postfix_logfile_auth_failures_critical",
            "caption": "Postfix Logfile: Auth Failures Critical",
            "description": "Number of failed SMTP logins within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--auth-failures-critical=200`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3d05d03c-7faf-4060-b03a-24e22fbac103"
        },
        "5": {
            "varname": "postfix_logfile_auth_failures_warning",
            "caption": "Postfix Logfile: Auth Failures Warning",
            "description": "Number of failed SMTP logins within `--lookback` that returns WARNING. Counted per source address, so a run against one mailbox from one host reaches it while the same number of typos across a fleet does not. 0 turns the threshold off. Example: `--auth-failures-warning=5`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "010effb4-b602-45a1-ab72-7b295b5d4dba"
        },
        "6": {
            "varname": "postfix_logfile_bounced_critical",
            "caption": "Postfix Logfile: Bounced Critical",
            "description": "Number of deliveries given up on within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--bounced-critical=500`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "69763c9f-862c-4ec4-bfe9-2c4e5931529a"
        },
        "7": {
            "varname": "postfix_logfile_bounced_warning",
            "caption": "Postfix Logfile: Bounced Warning",
            "description": "Number of deliveries given up on within `--lookback` that returns WARNING. On a host that only sends its own mail, every one of them is a message nobody will read; a server receiving from the internet bounces all day and wants this raised. 0 turns the threshold off. Example: `--bounced-warning=1`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4343a86a-7e5c-4249-a2bd-0454da5c4c9a"
        },
        "8": {
            "varname": "postfix_logfile_critical_level",
            "caption": "Postfix Logfile: Critical Level",
            "description": "Level from which a line returns CRITICAL, the levels above it included. `none` turns the level counts off and leaves the named events. Example: `--critical-level=error`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "postfix_logfile_critical_level_list"
            },
            "uuid": "44d62534-f972-44cf-96de-57ec292f9b5e"
        },
        "9": {
            "varname": "postfix_logfile_deferred_critical",
            "caption": "Postfix Logfile: Deferred Critical",
            "description": "Number of deliveries put back into the queue within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--deferred-critical=500`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0b333d14-db99-494f-98af-4e59b98096b9"
        },
        "10": {
            "varname": "postfix_logfile_deferred_warning",
            "caption": "Postfix Logfile: Deferred Warning",
            "description": "Number of deliveries put back into the queue within `--lookback` that returns WARNING. A single one is a mailbox that is full; a burst of them is the next hop being down. 0 turns the threshold off. Example: `--deferred-warning=5`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d3eebb9f-a113-48e4-9bcb-c36fffcbba6a"
        },
