    {
        # One source of two could not be read at all. The run goes on with what
        # it has and says that the other one is a hole in the window.
        'id': 'warn-a-source-that-could-not-be-read',
        'params': [
            f'--server-log={aged("rocky9-inbound-attack.txt")}',
            '--server-log=/var/log/there-is-no-such-file.log',
        ],
        'assert-retc': STATE_WARN,
        'assert-in': ['there-is-no-such-file.log'],
    },
    {
        'id': 'unknown-callback-without-its-companions',
        'params': [
            f'--server-log={aged("rocky9-busy-server.txt")}',
            '--icinga-callback',
