class TestCheck(unittest.TestCase):
    pass


def _run(params):
    result = subprocess.run(
        [PLUGIN, *params],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode, result.stdout + result.stderr


def _check_case(test, case):
    returncode, combined = _run(case['params'])
    test.assertEqual(
        returncode,
        case['assert-retc'],
        f'expected retc {case["assert-retc"]}, got {returncode}.\nOutput: {combined}',
    )
    for needle in case.get('assert-in', []):
        test.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
    for needle in case.get('assert-not-in', []):
        test.assertNotIn(
            needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
        )


lib.lftest.attach_each(TestCheck, CASES, _check_case, id_func=lambda it: it['id'])


class TestArrivalRate(unittest.TestCase):
    """A burst of failed logins alerts, the same burst an hour ago does not."""

    def _write(self, name, moments, peer='198.51.100.7'):
        path = os.path.join(SCRATCH, name)
        with open(path, 'w', encoding='utf-8') as handle:
            for moment in moments:
                handle.write(
                    FAILURE_LINE.format(timestamp=_stamp(moment), peer=peer) + '\n'
                )
        return path

    def test_a_burst_inside_the_window_alerts(self):
        now = datetime.datetime.now()
        moments = [now - datetime.timedelta(seconds=30 * i) for i in range(6)]
        returncode, combined = _run(
            [f'--server-log={self._write("burst.log", moments)}']
        )
        self.assertEqual(returncode, STATE_WARN, combined)
        self.assertIn('6 failed logins from 198.51.100.7', combined)

    def test_the_same_burst_an_hour_ago_does_not(self):
        now = datetime.datetime.now() - datetime.timedelta(hours=1)
        moments = [now - datetime.timedelta(seconds=30 * i) for i in range(6)]
        returncode, combined = _run([f'--server-log={self._write("old.log", moments)}'])
        self.assertEqual(returncode, STATE_OK, combined)
        self.assertIn(
            '0 failed logins in the last 10m (6 in the window read)', combined
        )

    def test_the_same_burst_spread_over_six_addresses_does_not(self):
        # Six failures from six addresses is the open network going past, and
        # this is the difference `--per-source` makes.
        now = datetime.datetime.now()
        path = os.path.join(SCRATCH, 'spread.log')
        with open(path, 'w', encoding='utf-8') as handle:
            for index in range(6):
                handle.write(
                    FAILURE_LINE.format(
                        timestamp=_stamp(now - datetime.timedelta(seconds=30 * index)),
                        peer=f'198.51.100.{index + 10}',
                    )
                    + '\n'
                )
        returncode, combined = _run([f'--server-log={path}'])
        self.assertEqual(returncode, STATE_OK, combined)
        self.assertIn('6 in total from 6 addresses', combined)


class TestSourceExtraction(unittest.TestCase):
    """Which address a line names, which is what a rate is counted per."""

    def test_the_peer_of_a_failed_login(self):
        # Postfix opens that message with the client it resolved, without a
        # `from` in front of it.
        self.assertEqual(
            postfix_logfile.get_source(
                'Aug 29 09:12:03 mail postfix/smtpd[2201]: warning:'
                ' unknown[198.51.100.7]: SASL LOGIN authentication failed: Password:'
            ),
            '198.51.100.7',
        )

    def test_the_peer_of_a_rejected_recipient(self):
        self.assertEqual(
            postfix_logfile.get_source(
                'Aug 29 09:13:00 mail postfix/smtpd[2204]: NOQUEUE: reject: RCPT'
                ' from unknown[198.51.100.9]: 554 5.7.1 <victim@elsewhere.example>:'
                ' Relay access denied'
            ),
            '198.51.100.9',
        )

    def test_the_host_we_delivered_to_is_not_a_peer(self):
        # `relay=` names where the message went, not where it came from.
        self.assertIsNone(
            postfix_logfile.get_source(
                'Aug 29 09:15:00 mail postfix/smtp[2220]: 3F2A14804001:'
                ' to=<user@example.org>, relay=mail.example.org[198.51.100.20]:25,'
                ' delay=0.4, dsn=2.0.0, status=sent (250 2.0.0 Ok: queued)'
            )
        )

    def test_postscreen_names_the_peer_without_a_name(self):
        self.assertEqual(
            postfix_logfile.get_source(
                'Aug 29 09:14:10 mail postfix/postscreen[2210]: PREGREET 14 after'
                ' 0.08 from [198.51.100.11]:59415: EHLO ylmf-pc'
            ),
            '198.51.100.11',
        )


class TestLevelStates(unittest.TestCase):
    """What `--critical-level` and `--warning-level` do to the level counts."""

    def test_the_defaults(self):
        states = postfix_logfile.get_level_states('fatal', 'warning')
        self.assertEqual(states['panic'], STATE_CRIT)
        self.assertEqual(states['fatal'], STATE_CRIT)
        self.assertEqual(states['error'], STATE_WARN)
        self.assertEqual(states['warning'], STATE_WARN)

    def test_turning_the_levels_off_leaves_the_named_events(self):
        states = postfix_logfile.get_level_states('none', 'none')
        self.assertEqual(set(states.values()), {STATE_OK})


if __name__ == '__main__':
    unittest.main()
