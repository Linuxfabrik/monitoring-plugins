    },
    {
        'id': 'unknown-systemd-without-blocky-unit',
        'params': [f'--config-root={config_root("systemd-without-blocky")}'],
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Found no `blocky.service` unit'],
    },
    {
        # a unit file on a host that systemd does not run has no journal
        'id': 'unknown-blocky-unit-without-systemd',
        'params': [f'--config-root={config_root("blocky-without-systemd")}'],
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Found no `blocky.service` unit'],
    },
]


class TestCheck(unittest.TestCase):
    pass


def _assert_sources_last(test, combined):
    """What was read is the last section, after the recommendations."""
    # `oao()` turns every `|` of the message into `!`, so the first one starts the
    # performance data.
    output = combined.split('|', 1)[0].rstrip('\n')
    sources_at = output.rfind('\n\nRead ')
    if sources_at == -1:
        return
    test.assertNotIn(
        '\n\n', output[sources_at + 2 :], f'a section follows the sources:\n{combined}'
    )
    if 'Recommendations:' in output:
        test.assertLess(
            output.index('Recommendations:'),
            sources_at,
            f'the sources come before the recommendations:\n{combined}',
        )


def _check_case(test, case):
    result = subprocess.run(  # nosec B603 - argv list, no shell
        [PLUGIN, *case['params']],
        capture_output=True,
        text=True,
        check=False,
    )
    combined = result.stdout + result.stderr
    test.assertEqual(
        result.returncode,
        case['assert-retc'],
        f'expected retc {case["assert-retc"]}, got {result.returncode}.\n'
        f'Output: {combined}',
    )
    for needle in case.get('assert-in', []):
        test.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
    for needle in case.get('assert-not-in', []):
        test.assertNotIn(
            needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
        )
    _assert_sources_last(test, combined)


IMAGES = [
    'ghcr.io/0xerr0r/blocky:v0.25',
    'ghcr.io/0xerr0r/blocky:v0.26',
    'ghcr.io/0xerr0r/blocky:v0.29.0',
    'ghcr.io/0xerr0r/blocky:v0.30.0',
    'ghcr.io/0xerr0r/blocky:v0.32.0',
    'ghcr.io/0xerr0r/blocky:v0.35.0',
    'ghcr.io/0xerr0r/blocky:v0.36.0',
]


def _check_image(test, image):
    lib.lftest.require_container_runtime()
    version = image.rsplit(':', 1)[1]
    with lib.lftest.run_container(
        image,
        volumes=[(fixture('blocky.yml'), '/app/config.yml')],
        wait_log='http server is up and running',
    ) as container:
        result = subprocess.run(  # nosec B603 - argv list, no shell
            [PLUGIN, f'--server-log=podman:{container.get_wrapped_container().name}'],
            capture_output=True,
            text=True,
            check=False,
        )
    combined = result.stdout + result.stderr
    test.assertEqual(result.returncode, STATE_OK, combined)
    test.assertIn('No errors or warnings found. 1 startup detected', combined)
    test.assertIn(f'blocky {version}.', combined)
    test.assertIn("'blocky_startups'=1;;;0", combined)
    _assert_sources_last(test, combined)


lib.lftest.attach_each(TestCheck, CASES, _check_case, id_func=lambda it: it['id'])
lib.lftest.attach_each(
    TestCheck,
    IMAGES,
    _check_image,
    id_func=lambda image: 'ok_container_' + image.rsplit(':', 1)[1].replace('.', '_'),
)


if __name__ == '__main__':
    unittest.main()
