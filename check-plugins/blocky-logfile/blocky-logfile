def parse_line(log_line):
    """
    Take a line apart into its level, its message and the time blocky stamped it
    with.

    Returns `(level, message, written_at)`, with `level` None for a line blocky
    wrote without one (the error of a failed start, the continuation of a message
    that spans several lines) and `written_at` None where blocky stamped no time.
    The message of a JSON line is rebuilt the way the text format writes it, so the
    patterns below match both.
    """
    message = lib.logsource.strip_syslog_prefix(log_line)
    if message.lstrip().startswith('{'):
        try:
            record = json.loads(message)
        except ValueError:
            record = None
        if isinstance(record, dict) and 'level' in record:
            level = JSON_LEVELS.get(str(record.get('level')).lower())
            text = str(record.get('msg', ''))
            if record.get('prefix'):
                text = f'{record["prefix"]}: {text}'
            fields = sorted(key for key in record if key not in JSON_META_KEYS)
            for key in fields:
                text += f' {key}={record[key]}'
            return level, text, _parse_iso(record.get('time'))
    match = TEXT_LINE_REGEX.match(message)
    if not match:
        return None, message.strip(), None
    written_at = None
    if match.group(1):
        try:
            written_at = datetime.datetime.strptime(match.group(1), TIMESTAMP_FORMAT)
        except ValueError:
            written_at = None
    return match.group(2), match.group(3), written_at


def _parse_iso(value):
    """Read the RFC 3339 time of a JSON line into local time, or None."""
    if not isinstance(value, str):
        return None
    try:
        written_at = datetime.datetime.fromisoformat(value.replace('Z', '+00:00'))
    except ValueError:
        return None
    if written_at.tzinfo is None:
        return written_at
    try:
        return lib.time.datetime2local(written_at)
    except ValueError:
        return None


def parse_timestamp(log_line):
    """Return the moment blocky stamped a line with, or None; `lib.logsource.timestamp()`
    falls back to the one the transport prefixed."""
    return parse_line(log_line)[2]


def get_message(log_line):
    """Return what a line says, with everything that differs between two lines
    saying the same thing masked, see MESSAGE_MASKS."""
    _, message, _ = parse_line(log_line)
    for regex, replacement in MESSAGE_MASKS:
        message = regex.sub(replacement, message)
    return lib.txt.shorten(message, MESSAGE_MAX_LEN)


def get_list_message(log_line):
    """Return the source of a failed list download and the last, most specific part
    of the reason, which is what tells a moved list from a network problem."""
    _, message, _ = parse_line(log_line)
    match = LIST_FAILURE_REGEX.match(message)
    if not match:
        return get_message(log_line)
    reason = re.sub(r' count=\d+ source=.+$', '', message)
    reason = reason.rsplit(': ', 1)[-1]
    return lib.txt.shorten(f'{match.group(1).strip()}: {reason}', MESSAGE_MAX_LEN)


def join_continuations(lines):
    """
    Put the lines of a message that spans several lines back together.

    The journal stores a message with a line break as one entry per line, and blocky
    writes those: an error that wraps the errors of several upstreams, and the error
    a failed start prints. Only the first line carries the level, and the fields
    blocky appends, `req_id` among them, sit on the last one. Joined, the whole
    message is judged as one.
    """
    joined = []
    for line in lines:
        identifier = lib.logsource.syslog_identifier(line)
        level, message, _ = parse_line(line)
        if (
            joined
            and level is None
            and not STARTUP_FAILURE_REGEX.search(message)
            and identifier == lib.logsource.syslog_identifier(joined[-1])
            and identifier == IDENTIFIER
        ):
            joined[-1] = f'{joined[-1]} {message}'
            continue
        joined.append(line)
    return joined


def get_level_states(critical_level, warning_level):
    """Map every counted level to the state it raises."""
    ranks = {item['level']: rank for rank, item in enumerate(LEVELS)}
    states = {}
    for level, rank in ranks.items():
        if critical_level != LEVEL_NONE and rank <= ranks[critical_level]:
            states[level] = STATE_CRIT
        elif warning_level != LEVEL_NONE and rank <= ranks[warning_level]:
            states[level] = STATE_WARN
        else:
            states[level] = STATE_OK
    return states


def get_units(config_root=''):
    """Return the blocky units this host has a unit file for."""
    # A unit file says only that a package shipped one: hosts with another init
    # system carry them too, and have no journal to read.
    if not lib.logsource.systemd_booted(config_root):
        return []
    found = []
    seen = set()
    for candidate in UNIT_CANDIDATES:
        for directory in UNIT_DIRECTORIES:
            for filename in lib.disk.glob(f'{config_root}{directory}/{candidate}'):
                if not lib.disk.file_exists(filename, allow_empty=True):
                    continue
                identity = os.path.realpath(filename)
                if identity in seen:
                    continue
                seen.add(identity)
                found.append(os.path.basename(filename))
    return found


def main():
    """The main function. This is where the magic happens."""

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)
    # The hidden --config-root points the unit tests at a fixture tree. This check
    # runs as root, so only a tree inside its own unit-test/ directory counts.
    if args.CONFIG_ROOT:
        args.CONFIG_ROOT = lib.base.coe(lib.lftest.fixture_root(args.CONFIG_ROOT))

    # set default values for append parameters that were not specified
    if args.IGNORE is None:
        args.IGNORE = []
    if args.MATCH is None:
        args.MATCH = []
    if args.SERVER_LOG is None:
        args.SERVER_LOG = []

    if args.ICINGA_CALLBACK and not all(
        (
            args.ICINGA_URL,
            args.ICINGA_PASSWORD,
            args.ICINGA_USERNAME,
            args.ICINGA_SERVICE_NAME,
        )
    ):
        lib.base.cu(
            '`--icinga-callback` requires `--icinga-url`, `--icinga-password`, '
            '`--icinga-username` and `--icinga-service-name`.'
        )

    # fetch data
    # The plugin runs as root via sudo, so restrict an on-disk log to the system log
    # directory. The plugin's own unit-test/ directory is allowed so the fixture
    # tests work; it does not exist next to the flat, root-owned plugin in
    # production.
    allowed_roots = [
        '/var/log',
        os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), 'unit-test'),
    ]
    server_logs = args.SERVER_LOG or [
        f'systemd:{unit}' for unit in get_units(args.CONFIG_ROOT)
    ]
    if not server_logs:
        lib.base.cu(
            'Found no `blocky.service` unit. Name the log blocky writes to with '
            "the check's `--server-log` parameter."
        )

    # No position is kept on purpose: this check reports on a window of the log,
    # counting startups and shutdowns next to the problems, so every run has to see
    # the whole window rather than only what is new.
    success, result = lib.logsource.read_many(
        server_logs,
        allowed_roots=allowed_roots,
        max_lines=MAXLINES,
        rotated=ROTATED_FILES,
        timeout=args.TIMEOUT,
    )
    if not success:
        lib.base.cu(result)
    sizes = {
        item['label']: item['size'] for item in result['sources'] if 'size' in item
    }
    source_label = (
        '`'
        + lib.disk.shorten_path(
            result['sources'][0]['label'], max_len=SOURCE_PATH_MAX_LEN, truncate=False
        )
        + '`'
        if len(result['sources']) == 1
        else f'the {len(result["sources"])} sources read'
    )

    # init some vars
    state = STATE_OK
    sections = []
    facts = []
    recommendations = []
    level_states = get_level_states(args.CRITICAL_LEVEL, args.WARNING_LEVEL)
    levels = {item['level']: [] for item in LEVELS}
    found = {item['key']: [] for item in EVENTS}
    found.update({item['key']: [] for item in RATE_EVENTS})
    found.update({item['key']: [] for item in LIFECYCLE})
    # the last line per list source, which says whether its last download worked
    list_outcomes = {}
    rate_since = datetime.datetime.now() - datetime.timedelta(seconds=args.LOOKBACK)
    considered_cnt = 0
    recognized_cnt = 0
    unrecognized_cnt = 0
    suppressed_cnt = 0
    query_log_cnt = 0
    # whether the running process still writes the query log, see the recommendation
    query_log_current = False
    version = ''
    compiled_ignore = [
        lib.base.coe(item) for item in lib.txt.compile_regex(args.IGNORE, '--ignore')
    ]
    compiled_match = [
        lib.base.coe(item) for item in lib.txt.compile_regex(args.MATCH, '--match')
    ]

    acked_fingerprints = set()
    ack_conn = None
    if args.ICINGA_CALLBACK:
        instance_payload = {}
        for name, value in (
            ('ignore_regex', args.IGNORE),
            ('match', args.MATCH),
            ('server_log', args.SERVER_LOG),
        ):
            if value:
                instance_payload[name] = value
        ack_conn = lib.base.coe(
            lib.logmatch.connect(
                'blocky-logfile', lib.logmatch.instance_id(instance_payload)
            )
        )
        lib.base.coe(lib.logmatch.prune(ack_conn, retention=ACK_RETENTION_DAYS))
        acked_fingerprints = lib.base.coe(lib.logmatch.suppressed(ack_conn))

    # analyze data
    lines = join_continuations(result['lines'])
    # Only what the current process wrote is judged by level and by event: a restart
    # reads the configuration and the lists again, so what an earlier process
    # complained about says nothing about the one running now. The window holds the
    # lines up to the last startup as history, counted among the lifecycle markers.
    # A start that failed before it got to its banner belongs to the attempt after
    # the last banner, and so does the line that says so.
    current_from = 0
    for index, log_line in enumerate(lines):
        if lib.logsource.syslog_identifier(log_line) not in (None, IDENTIFIER):
            continue
        if STARTUP_REGEX.search(parse_line(log_line)[1]):
            current_from = index
    earlier_failures = []
    for index, log_line in enumerate(lines):
        haystack = log_line.lower()
        if any(item.search(haystack) for item in compiled_ignore):
            continue
        if compiled_match and not any(item.search(haystack) for item in compiled_match):
            continue
        considered_cnt += 1
        if acked_fingerprints and lib.logmatch.key(log_line) in acked_fingerprints:
            suppressed_cnt += 1
            continue
        identifier = lib.logsource.syslog_identifier(log_line)
        if identifier is not None and identifier != IDENTIFIER:
            # systemd's own lines about the unit ("Started blocky Service.")
            continue
        level, message, _ = parse_line(log_line)
        current = index >= current_from
        for item in LIFECYCLE:
            if item['regex'].search(message):
                found[item['key']].append(log_line)
        startup = STARTUP_REGEX.search(message)
        if startup:
            version = startup.group(1)
        if STARTUP_FAILURE_REGEX.search(message):
            recognized_cnt += 1
            if current:
                found['startup_failures'].append(log_line)
            else:
                earlier_failures.append(log_line)
            continue
        if level is None:
            unrecognized_cnt += 1
            continue
        recognized_cnt += 1
        if message.startswith(QUERY_LOG_PREFIX):
            query_log_cnt += 1
            if current:
                query_log_current = True
            continue
        # A list source is judged by its last outcome in the current process. blocky
        # logs its banner before `server.NewServer()` builds the list caches
        # (`cmd/serve.go`), so every download of the running process follows the last
        # banner, and a source removed from the configuration is not read again.
        # Verified against blocky v0.35.0 on RHEL 9.
        success_match = LIST_SUCCESS_REGEX.match(message)
        failure_match = LIST_FAILURE_REGEX.match(message)
        if success_match or failure_match:
            if current:
                source = (success_match or failure_match).group(1).strip()
                list_outcomes[source] = None if success_match else log_line
            continue
        if message.startswith(LIST_PREFIX):
            # the download attempts and the summary of a group, see LIST_PREFIX
            continue
        rate_hits = [
            event
            for event in RATE_EVENTS
            if event['regex'] is not None and event['regex'].search(message)
        ]
        if not rate_hits and level in levels and REQUEST_SCOPE_REGEX.search(message):
            rate_hits = [RATE_EVENTS[1]]
        for event in rate_hits:
            found[event['key']].append(log_line)
        if rate_hits:
            continue
        if START_FAILED_REGEX.search(message) or DEPRECATED_SUMMARY_REGEX.search(
            message
        ):
            continue
        hits = [
            event
            for event in EVENTS
            if event['regex'] is not None and event['regex'].search(message)
        ]
        if hits:
            if current:
                for event in hits:
                    found[event['key']].append(log_line)
            continue
        if current and level in levels:
            levels[level].append(log_line)
    found['list_failures'] = [line for line in list_outcomes.values() if line]
    for key, item_lines in found.items():
        found[key] = lib.logsource.sort_by_time(item_lines, parse_timestamp)

    if compiled_match and result['lines'] and not considered_cnt:
        if ack_conn is not None:
            lib.db_sqlite.close(ack_conn)
        lib.base.oao(
            f'Nothing checked: `--match` dropped all {len(result["lines"])} '
            f'{lib.txt.pluralize("line", len(result["lines"]))} of '
            f'{source_label}.',
            lib.base.str2state(args.NO_MATCH_SEVERITY),
            always_ok=args.ALWAYS_OK,
        )

    # Every line blocky writes carries its level, apart from the error of a start
    # that failed, so a window without a single one is not a quiet blocky but a
    # source that holds something else.
    if unrecognized_cnt and not recognized_cnt:
        if ack_conn is not None:
            lib.db_sqlite.close(ack_conn)
        lib.base.oao(
            f'None of the {unrecognized_cnt} '
            f'{lib.txt.pluralize("line", unrecognized_cnt)} read from '
            f'{source_label} carries a blocky log level, so this does not look '
            f'like the log of blocky. Check `--server-log`.',
            STATE_UNKNOWN,
        )

    # build the message
    covered = ''
    window_from, window_to = lib.logsource.covered_window(
        [item['lines'] for item in result['sources']], parse_timestamp
    )
    if window_from is not None and window_to is not None:
        span = int((window_to - window_from).total_seconds())
        covered = (
            f'{window_from:%Y-%m-%d %H:%M} .. {window_to:%Y-%m-%d %H:%M}'
            f' ({lib.human.seconds2human(span)}): '
        )
    line_cnt = len(result['lines'])
    lines_read = (
        f'{lib.human.number2human(line_cnt)} {lib.txt.pluralize("line", line_cnt)}'
    )
    if result['truncated']:
        lines_read = f'the most recent {lines_read}'
    # A directory holding more than a handful of logs is folded into one entry.
    described = lib.base.coe(lib.logsource.describe_sources(result['sources'], sizes))
    source_cnt = len(result['sources'])
    sources = f'{source_cnt} {lib.txt.pluralize("source", source_cnt)}'
    source_heading = f'Read {lines_read} from {sources}:'

    rate_counts = {}
    rate_states = {}
    rate_facts = []
    for event in RATE_EVENTS:
        window = lib.logsource.count_within(
            found[event['key']], rate_since, parse_line=parse_timestamp
        )
        rate_counts[event['key']] = window['count']
        rate_states[event['key']] = STATE_OK
        if not window['total'] and not window['undated']:
            continue
        rate_state = lib.base.get_state(
            window['count'],
            getattr(args, event['warning']) or None,
            getattr(args, event['critical']) or None,
        )
        rate_states[event['key']] = rate_state
        state = lib.base.get_worst(state, rate_state)
        # what arrived before the rate window is history the perfdata trends
        if not window['count'] and not window['undated']:
            continue
        fact = (
            f'{window["count"]} '
            f'{lib.txt.pluralize(event["label"], window["count"])} in the last'
            f' {lib.human.seconds2human(args.LOOKBACK)}'
            f'{lib.base.state2str(rate_state, prefix=" ")}'
        )
        if window['undated']:
            fact += (
                f', {window["undated"]} of them without a timestamp and therefore'
                f' not counted'
            )
        rate_facts.append(fact)
        if rate_state != STATE_OK:
            recommendations.append(event['recommendation'])

    counts = {}
    for item in LEVELS:
        item_lines = levels[item['level']]
        counts[item['level']] = len(item_lines)
        if not item_lines:
            continue
        level_state = level_states[item['level']]
        state = lib.base.get_worst(state, level_state)
        facts.append(
            f'{len(item_lines)} {item["level"]} '
            f'{lib.txt.pluralize("line", len(item_lines))} found'
            f'{lib.base.state2str(level_state, prefix=" ")}'
        )
    if (
        not any(counts.values())
        and not rate_facts
        and not any(found[event['key']] for event in EVENTS)
    ):
        facts.append('No errors or warnings found')

    named = []
    for event in EVENTS:
        hits = found[event['key']]
        if not hits:
            continue
        state = lib.base.get_worst(state, event['state'])
        named.append(
            f'{len(hits)} '
            f'{lib.txt.pluralize(event["label"], len(hits))}'
            f'{lib.base.state2str(event["state"], prefix=" ")}'
        )
        recommendations.append(event['recommendation'])
    if named:
        facts.append('Found ' + ', '.join(named))

    facts.extend(rate_facts)

    for item in LIFECYCLE:
        item_lines = found[item['key']]
        if item_lines:
            fact = (
                f'{len(item_lines)} {lib.txt.pluralize(item["label"], len(item_lines))}'
                f' {item["verb"]}'
            )
            last = lib.logsource.timestamp(item_lines[-1], parse_timestamp)
            if last is not None:
                fact += f' (last: {last:%Y-%m-%d %H:%M:%S})'
            facts.append(fact)
    if earlier_failures:
        # history: a start that worked followed them
        fact = (
            f'{len(earlier_failures)} earlier '
            f'{lib.txt.pluralize("failed start", len(earlier_failures))}'
        )
        last = lib.logsource.timestamp(earlier_failures[-1], parse_timestamp)
        if last is not None:
            fact += f' (last: {last:%Y-%m-%d %H:%M:%S})'
        facts.append(fact)
    if version:
        facts.append(f'blocky {version}')

    if unrecognized_cnt:
        facts.append(
            f'{unrecognized_cnt} {lib.txt.pluralize("line", unrecognized_cnt)}'
            f' without a blocky log level'
        )

    if result['notice']:
        facts.append(result['notice'].rstrip('.'))

    if result['failed']:
        state = lib.base.get_worst(state, STATE_WARN)
        facts.append(
            '; '.join(item.rstrip('.') for item in result['failed'])
            + lib.base.state2str(STATE_WARN, prefix=' ')
        )
        recommendations.append(
            'Check the log sources this check was told to read; '
            'one of them could not be read at all'
        )

    # The query log pushes everything else out of the window this check reads, and
    # keeps every client and the name it asked for in the journal. Said without a
    # state, because blocky itself is fine.
    # `truncated` cannot be relied on here: journalctl is asked for the last
    # MAXLINES entries and never says whether there were more. Lines of an earlier
    # process only age out of the window, so the advice needs the running one to
    # still write the query log.
    if (
        query_log_current
        and line_cnt >= MAXLINES
        and query_log_cnt > QUERY_LOG_SHARE * line_cnt
    ):
        recommendations.append(
            f'{lib.human.number2human(query_log_cnt)} of the lines read are the'
            ' query log, so the window reaches back only as far as shown above;'
            ' set `queryLog.type: none` (or write it to a file or database) in'
            ' `/etc/blocky/config.yml` to keep it out of the journal'
        )

    sections.append(covered + '. '.join(facts) + '.')

    for item in LEVELS:
        item_lines = levels[item['level']]
        if item_lines:
            groups = lib.logsource.group_lines(
                item_lines, parse_line=parse_timestamp, group=get_message
            )
            sections.append(
                f'{item["level"].capitalize()} lines:\n'
                + '\n'.join(
                    f'* {text}'
                    for text in lib.logsource.describe_groups(groups, last=True)
                )
            )

    for event in EVENTS:
        item_lines = found[event['key']]
        if item_lines:
            groups = lib.logsource.group_lines(
                item_lines,
                parse_line=parse_timestamp,
                group=get_list_message
                if event['key'] == 'list_failures'
                else get_message,
            )
            label = lib.txt.pluralize(event['label'], 2)
            sections.append(
                f'{label[:1].upper()}{label[1:]}:\n'
                + '\n'.join(
                    f'* {text}'
                    for text in lib.logsource.describe_groups(groups, last=True)
                )
            )

    for event in RATE_EVENTS:
        if rate_states[event['key']] == STATE_OK:
            continue
        groups = lib.logsource.group_lines(
            found[event['key']],
            since=rate_since,
            parse_line=parse_timestamp,
            group=get_message,
        )
        if groups:
            label = lib.txt.pluralize(event['label'], 2)
            sections.append(
                f'{label[:1].upper()}{label[1:]} in the last'
                f' {lib.human.seconds2human(args.LOOKBACK)}:\n'
                + '\n'.join(
                    f'* {text}' for text in lib.logsource.describe_groups(groups)
                )
            )

    if recommendations:
        sections.append(
            'Recommendations:\n' + '\n'.join(f'* {item}' for item in recommendations)
        )

    msg = '\n\n'.join(sections)

    perfdata = ''
    if sizes:
        perfdata += lib.base.get_perfdata(
            'blocky_logfile_size',
            sum(sizes.values()),
            uom='B',
            _min=0,
        )
    # The problem counters alert from their first hit on, hence `warn='0'`
    # ("outside 0..0") rather than `warn=1`.
    for item in LEVELS:
        level_state = level_states[item['level']]
        perfdata += lib.base.get_perfdata(
            item['perfdata'],
            counts[item['level']],
            uom=None,
            warn='0' if level_state == STATE_WARN else None,
            crit='0' if level_state == STATE_CRIT else None,
            _min=0,
        )
    for event in EVENTS:
        perfdata += lib.base.get_perfdata(
            event['perfdata'],
            len(found[event['key']]),
            uom=None,
            warn='0' if event['state'] == STATE_WARN else None,
            crit='0' if event['state'] == STATE_CRIT else None,
            _min=0,
        )
    for event in RATE_EVENTS:
        perfdata += lib.base.get_perfdata(
            event['perfdata'],
            rate_counts[event['key']],
            uom=None,
            warn=getattr(args, event['warning']) or None,
            crit=getattr(args, event['critical']) or None,
            _min=0,
        )
    for item in LIFECYCLE:
        perfdata += lib.base.get_perfdata(
            item['perfdata'], len(found[item['key']]), uom=None, _min=0
        )

    if args.ICINGA_CALLBACK and state != STATE_OK:
        acknowledged, note = lib.base.coe(
            lib.logmatch.service_acknowledged(
                args.ICINGA_URL,
                args.ICINGA_USERNAME,
                args.ICINGA_PASSWORD,
                args.ICINGA_SERVICE_NAME,
                insecure=args.INSECURE,
                no_proxy=args.NO_PROXY,
                proxy=args.PROXY,
                timeout=args.TIMEOUT,
            )
        )
        if acknowledged:
            # The rate events stay out: what alerts there is the arrival rate and
            # not one line.
            reported = {}
            for item in LEVELS:
                reported.update(dict.fromkeys(levels[item['level']]))
            for event in EVENTS:
                reported.update(dict.fromkeys(found[event['key']]))
            lib.base.coe(
                lib.logmatch.acknowledge(
                    ack_conn,
                    [
                        {'key': lib.logmatch.key(line), 'line': line}
                        for line in reported
                    ],
                )
            )
            state = STATE_OK
        if note:
            msg += f'\n\n{note}'
    if suppressed_cnt:
        msg += (
            f'\n\n{suppressed_cnt} acknowledged'
            f' {lib.txt.pluralize("line", suppressed_cnt)} suppressed.'
        )
    if ack_conn is not None:
        lib.db_sqlite.close(ack_conn)

    # What was read comes last: the verdict and the lines behind it come first, the
    # provenance after them.
    msg += f'\n\n{source_heading}\n' + '\n'.join(f'* {item}' for item in described)

    # over and out
    lib.base.oao(
        msg, state, perfdata, always_ok=args.ALWAYS_OK, no_perfdata=args.NO_PERFDATA
    )


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
