# blocky logs through logrus with the `prefixed` text formatter: an optional
# `[2026-11-20 15:00:06]` (`log.timestamp`, on by default), the level padded to five
# characters, an optional `prefix: ` naming the component, the message, and the
# fields sorted by name (`key=value`). The formatter spells `warning` as `WARN`;
# the other levels are upper-cased as logrus names them. The JSON format
# (`log.format: json`) carries the same as `level`, `prefix`, `msg`, `time` and
# the fields. Verified against blocky v0.24, v0.35.0 and v0.36.0.
TEXT_LINE_REGEX = re.compile(
    r'^\s*(?:\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]\s+)?'
    r'(TRACE|DEBUG|INFO|WARN|ERROR|FATAL|PANIC) (.*)$'
)
JSON_LEVELS = {
    'debug': 'DEBUG',
    'error': 'ERROR',
    'fatal': 'FATAL',
    'info': 'INFO',
    'panic': 'PANIC',
    'trace': 'TRACE',
    'warning': 'WARN',
}
TIMESTAMP_FORMAT = '%Y-%m-%d %H:%M:%S'
# The keys of a JSON line that are not fields of the message.
JSON_META_KEYS = ('level', 'msg', 'prefix', 'time')

# blocky gives every DNS request a logger of its own carrying `req_id`, `client_ip`
# and `question` (`newRequest()` in `server/server.go`), so a line with a `req_id`
# is about one request and nothing else. That is the same border Apache draws with
# `[client ...]`, and the reason these lines count as a rate rather than by level.
REQUEST_SCOPE_REGEX = re.compile(r'(?:^| )req_id=')

# A start that failed before blocky could log anything: the command line framework
# prints the error blocky returned to standard error, without a level, and blocky
# exits 1 (`Execute()` in `cmd/root.go`). Seen for an unreadable configuration, a
# port in use and lists that `loading.strategy: failOnError` could not load.
STARTUP_FAILURE_REGEX = re.compile(r'^Error: ')

# The middle line of the banner blocky logs at every start (`printBanner()` in
# `cmd/serve.go`), after the configuration was read and before anything else runs.
# Everything a process logs lies between its banner and the next one.
STARTUP_REGEX = re.compile(r'^_/\s+Version: (\S+)')

# What blocky writes about one list source. A source is a URL, a file or an inline
# block (`item #2 of group ads: ...`), named in the `source` field, which the
# formatter sorts after `count`, so it is the last field on the line. Each download
# is tried `loading.downloads.attempts` times (3) and every failed attempt logs a
# warning of its own before `cannot open source` closes it (`lists/downloader.go`,
# `lists/list_cache.go`). Those attempts, and the summary per group, are part of the
# same outcome and are not counted by their level.
LIST_PREFIX = 'list_cache: '
LIST_SUCCESS_REGEX = re.compile(r'^list_cache: import succeeded .* source=(.+)$')
LIST_FAILURE_REGEX = re.compile(r'^list_cache: cannot open source: .* source=(.+)$')

# The line that closes the warnings about deprecated options, one per option. It
# is the same finding again, so it is neither counted as an option nor by its
# level (ERROR).
DEPRECATED_SUMMARY_REGEX = re.compile(r'^configuration uses deprecated options')

# A port in use or a failed list load ends the process with this line and the
# `Error:` line after it, which the failed start owns.
START_FAILED_REGEX = re.compile(r'^server start failed:')

# The part of the line blocky closes the run with, so that a run that keeps going
# reports what this process does.
SHUTDOWN_REGEX = re.compile(r'^Terminating\.\.\.')

# What differs between two lines saying the same thing, for grouping them in a
# listing: the numbers of an attempt and a port, request ids and addresses.
MESSAGE_MASKS = (
    (re.compile(r'\breq_id=\S+'), 'req_id=*'),
    (re.compile(r'\bclient_ip=\S+'), 'client_ip=*'),
    (re.compile(r'\bquestion=\S+ \([^)]*\)'), 'question=*'),
    (re.compile(r'(\d{1,3}(?:\.\d{1,3}){3}):\d+->'), r'\1:*->'),
    (re.compile(r'\battempt=\d+/\d+'), 'attempt=*'),
    (re.compile(r'\bretry attempt \d+/\d+'), 'retry attempt *'),
)
