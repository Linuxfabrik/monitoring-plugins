            "uuid": "062a20c4-4829-4260-b3f1-12a479229229"
        },
        "8": {
            "varname": "blocky_logfile_ignore",
            "caption": "Blocky Logfile: Ignore",
            "description": "Ignore a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. Example: `--ignore='(?i)linuxfabrik'`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "18f85db7-7249-4719-8e8a-a7910323b806"
        },
        "9": {
            "varname": "blocky_logfile_insecure",
            "caption": "Blocky Logfile: Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "64867aff-e797-4f85-8d6c-5c56f262355f"
        },
        "10": {
            "varname": "blocky_logfile_lookback",
            "caption": "Blocky Logfile: Lookback",
            "description": "Failed queries and other request errors are counted within this window rather than reported one by one. Time window in seconds to look back over, ending at the moment of the run. Only what falls within it is counted, so what is reported is how often something happened lately rather than a total that keeps growing for as long as the source is kept. Example: `--lookback=3600`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "61e0c910-f23b-4341-a438-783700bc9649"
        },
        "11": {
            "varname": "blocky_logfile_match",
            "caption": "Blocky Logfile: Match",
            "description": "Only consider a log line matching this Python regular expression. The log line is lowercased before matching, so write the pattern in lowercase (or use the `(?i)` flag). Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Example: `--match='list_cache'`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "15953bd2-4b9c-4340-9339-f11ed6230fcd"
        },
        "12": {
            "varname": "blocky_logfile_no_insecure",
            "caption": "Blocky Logfile: No Insecure?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c37cf340-53f8-42c5-a9f6-03fb350800d4"
        },
        "13": {
            "varname": "blocky_logfile_no_match_severity",
            "caption": "Blocky Logfile: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "blocky_logfile_no_match_severity_list"
            },
            "uuid": "44c125c8-68cb-4f38-b936-7c5272f51a3b"
        },
        "14": {
            "varname": "blocky_logfile_no_perfdata",
            "caption": "Blocky Logfile: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2ada2322-ca75-4dc6-bc97-9563e08c39aa"
        },
        "15": {
            "varname": "blocky_logfile_no_proxy",
            "caption": "Blocky Logfile: No Proxy?",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6d44ed8d-7536-41ae-9eb6-7eabf64944cd"
        },
        "16": {
            "varname": "blocky_logfile_proxy",
            "caption": "Blocky Logfile: Proxy",
            "description": "Applies to the connection to the monitoring server that `--icinga-callback` makes, which is the only network connection this check opens. Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "65cf8eb2-29f9-48eb-814b-d061c6075eaf"
        },
        "17": {
            "varname": "blocky_logfile_request_errors_critical",
            "caption": "Blocky Logfile: Request Errors Critical",
            "description": "Number of request errors other than failed queries within `--lookback` that returns CRITICAL. 0 turns the threshold off. Example: `--request-errors-critical=100`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "addf0d6d-a052-48e5-9006-1f61b41c4676"
        },
        "18": {
            "varname": "blocky_logfile_request_errors_warning",
            "caption": "Blocky Logfile: Request Errors Warning",
            "description": "Number of request errors other than failed queries within `--lookback` that returns WARNING. 0 turns the threshold off. Example: `--request-errors-warning=50`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "facbb41a-9b35-4c8b-9b11-ef34ae16abcf"
        },
        "19": {
            "varname": "blocky_logfile_server_log",
            "caption": "Blocky Logfile: Server Log",
            "description": "Log source to read from. Accepts a file path, `docker:CONTAINER`, `podman:CONTAINER`, `kubectl:CONTAINER` or `systemd:UNITNAME`. Can be specified multiple times, and everything named is then read as one window; a source named twice is read once. If omitted, the check reads the journal of `blocky.service`. Example: `--server-log=podman:blocky`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "94808581-9371-4af7-a7b8-e76af886e092"
