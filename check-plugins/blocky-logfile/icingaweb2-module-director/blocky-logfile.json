            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Scans the log of the blocky DNS proxy and ad-blocker for the events an administrator has to act on: a start that failed, deprecated configuration options, list sources that could not be downloaded at their last attempt, and queries the upstream resolvers did not answer. Startups, shutdowns and the times blocking was disabled are counted alongside them. Alerts when one of those events shows up, when failed queries and other errors about single requests cross the rates the thresholds set within `--lookback`, and when a line arrives at a level `--critical-level` or `--warning-level` covers. Request errors are judged by how many of them arrived, not by the fact that they did, because a client asking for a broken domain produces them on every DNS server. Lines about the current blocky process count; what a process before the last startup wrote is history, because a restart reads the configuration and the lists again. A list source counts as failed only while its last download failed, so a source that is back clears the alert on its own. The log is read from the journal of the blocky unit by default, or from a file (`/var/log` only) or a container (`docker:`/`podman:`/`kubectl:`) named with `--server-log`. Reads the text and the JSON log format. Requires root or sudo.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/blocky-logfile/",
            "object_name": "tpl-service-blocky-logfile",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "blocky_logfile_always_ok": false,
                "blocky_logfile_critical_level": "FATAL",
                "blocky_logfile_icinga_callback": false,
                "blocky_logfile_ignore": [],
                "blocky_logfile_insecure": true,
                "blocky_logfile_lookback": 600,
                "blocky_logfile_match": [],
                "blocky_logfile_no_match_severity": "ok",
                "blocky_logfile_no_perfdata": false,
                "blocky_logfile_no_proxy": false,
                "blocky_logfile_request_errors_critical": 500,
                "blocky_logfile_request_errors_warning": 10,
                "blocky_logfile_server_log": [],
                "blocky_logfile_timeout": 8,
                "blocky_logfile_upstream_failures_critical": 500,
                "blocky_logfile_upstream_failures_warning": 10,
                "blocky_logfile_warning_level": "ERROR"
            },
            "volatile": null,
            "zone": null,
            "uuid": "79b3145b-c31d-4716-9ab6-3dd91fafe6f5"
        }
    },
