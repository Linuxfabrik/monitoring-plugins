            "uuid": "d7371184-47ec-4f08-839b-4f1c4579d4f0"
        },
        "2": {
            "varname": "lvm_volumes_brief",
            "caption": "Lvm Volumes: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "d5f18157-c7b5-4158-9a12-34635bd8e436"
        },
        "3": {
            "varname": "lvm_volumes_ignore",
            "caption": "Lvm Volumes: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "27d2bbb0-14d6-4b36-bb2e-f6fbe79c120a"
        },
        "4": {
            "varname": "lvm_volumes_inactive_severity",
            "caption": "Lvm Volumes: Inactive Severity",
            "description": "State to report for a volume that is not active. A volume is deliberately left inactive often enough that this does not alert by default: one that belongs to a machine that is switched off, and one created with activation skipped, are both inactive and both perfectly fine. Raise it on a host where every volume is supposed to be up, and an activation that silently did not happen at boot becomes visible.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "lvm_volumes_inactive_severity_list"
            },
            "uuid": "96ff0a61-5b11-4d6a-8a6f-ba8e822f2c47"
        },
        "5": {
            "varname": "lvm_volumes_match",
            "caption": "Lvm Volumes: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a8fb8c9d-02bd-4929-81ce-6451e2a03623"
        },
        "6": {
            "varname": "lvm_volumes_no_match_severity",
            "caption": "Lvm Volumes: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "lvm_volumes_no_match_severity_list"
            },
            "uuid": "f77a289e-321a-470c-b578-31fa6fcf3fc2"
        },
        "7": {
            "varname": "lvm_volumes_no_perfdata",
            "caption": "Lvm Volumes: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
