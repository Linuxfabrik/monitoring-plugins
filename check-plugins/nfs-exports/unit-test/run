import atexit
import os
import shutil
import sys
import tempfile

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# nfs-exports reads files and runs no command, so its fixtures are directory trees under
# `config/` that stand in for the host's filesystem, selected with the hidden
# `--config-root` hook. Each tree holds an `etc/exports`, a `var/lib/nfs/etab` and the
# directories the exports point at, because whether those exist is part of the finding.
# A tree that also holds `etc/fstab` and `proc/self/mountinfo` stands in for what is
# expected to be mounted and what is.


def build_mp_option_root():
    """Copy `config/mp-option` to a throwaway directory and add `mnt/disk` there, a
    symlink into procfs, so that it and its parent sit on different devices on any host
    and the NFS server's own mount point test takes it for one.

    The symlink is not part of the repository: editors, indexers and `grep -R` follow
    it into `/proc/self/cwd` and from there back to itself, without end.
    """
    tmpdir = tempfile.mkdtemp(prefix='nfs-exports-')
    atexit.register(shutil.rmtree, tmpdir, ignore_errors=True)
    root = os.path.join(tmpdir, 'mp-option')
    shutil.copytree('config/mp-option', root, symlinks=True)
    os.makedirs(os.path.join(root, 'mnt'), exist_ok=True)
    os.symlink('/proc/self', os.path.join(root, 'mnt', 'disk'))
    return root


MP_OPTION_ROOT = build_mp_option_root()

TESTS = [
