    "Datafield": {
        "1": {
            "varname": "nfs_exports_always_ok",
            "caption": "Nfs Exports: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "c040b9b5-7618-4641-bfab-e2e41826e437"
        },
        "2": {
            "varname": "nfs_exports_brief",
            "caption": "Nfs Exports: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "98046199-1982-4aef-9caf-ece0b9060248"
        },
        "3": {
            "varname": "nfs_exports_etab",
            "caption": "Nfs Exports: Etab",
            "description": "Path to the export table the server serves, which is where the state directory of the NFS utilities was moved to if it was moved at all.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "415b3f80-78c2-4267-a138-f4a2e3d30e6a"
        },
        "4": {
            "varname": "nfs_exports_ignore",
            "caption": "Nfs Exports: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "58ccd156-57f6-46b2-9216-c8e60f41485c"
        },
        "5": {
            "varname": "nfs_exports_match",
            "caption": "Nfs Exports: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7e121c43-1d91-49ab-ab51-fec0d3ffeca2"
        },
        "6": {
            "varname": "nfs_exports_missing_path_severity",
            "caption": "Nfs Exports: Missing Path Severity",
            "description": "State to report for an export whose path does not exist. The server keeps serving it, and a client that has it mounted gets a stale file handle.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "nfs_exports_missing_path_severity_list"
            },
            "uuid": "781d0829-1d6b-463a-85a3-81cdaab7d883"
        },
        "7": {
            "varname": "nfs_exports_no_match_severity",
            "caption": "Nfs Exports: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "nfs_exports_no_match_severity_list"
            },
            "uuid": "b7f9ebf9-b269-4b9d-993d-f5c5af94b591"
        },
        "8": {
            "varname": "nfs_exports_no_perfdata",
            "caption": "Nfs Exports: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "44c55fcc-7267-4cf5-b5c1-ce3530b73718"
        },
        "9": {
            "varname": "nfs_exports_not_exported_severity",
            "caption": "Nfs Exports: Not Exported Severity",
            "description": "State to report for an export the configuration asks for and the server does not serve. Usually `exportfs -ra` has not been run since the entry was added, or it refused the entry; a client cannot mount such a share at all.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "nfs_exports_not_exported_severity_list"
            },
            "uuid": "61c90430-dbf9-4cda-b58c-dfab2cd385f5"
        },
        "10": {
            "varname": "nfs_exports_timeout",
            "caption": "Nfs Exports: Timeout",
            "description": "How long the export paths get to answer before they are reported as unreachable. Only a path on a network filesystem ever needs it: one whose server has stopped answering does not fail, it blocks. Every path is looked at at the same time and they share one deadline, so this is the runtime of the whole check and not a budget per path.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2ce5dff9-8bbc-4f77-994e-1a6b544b9b0c"
        },
        "11": {
            "varname": "nfs_exports_unconfigured_severity",
            "caption": "Nfs Exports: Unconfigured Severity",
            "description": "State to report for an export the server serves and the configuration does not ask for. Cluster software that creates its exports at runtime looks exactly like this, which is why it does not alert by default.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "nfs_exports_unconfigured_severity_list"
            },
            "uuid": "ad088e36-0805-4532-94ff-ede8ce412542"
        }
    }
