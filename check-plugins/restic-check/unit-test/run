import os
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

BASE_PARAMS = '--repo=test --password-file=test'


# restic prints plain text for `check` before v0.18 and a JSON summary since
# v0.18. The fixtures are real output captured from restic 0.16.5 (text) and
# 0.18.1 (json), on a healthy and on a damaged repository.
TESTS = [
    {
        'id': 'ok-text-no-errors',
        'test': 'stdout/text-no-errors,,0',
        'params': BASE_PARAMS,
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok'],
    },
    {
        'id': 'warn-text-damaged',
        'test': 'stdout/text-damaged,stderr/text-damaged,1',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['There are errors', 'does not exist'],
    },
    {
        'id': 'ok-json-no-errors',
        'test': 'stdout/json-no-errors,,0',
        'params': BASE_PARAMS,
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok'],
    },
    {
        'id': 'warn-json-damaged',
        'test': 'stdout/json-damaged,stderr/json-damaged,1',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['There are errors', 'does not exist'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../restic-check'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestRepositorySafety(unittest.TestCase):
    """This check runs as root via sudo, so the caller must not be able to make
    restic run a program of their choosing or read a file only root should.
    """

    check = '../restic-check'

    def run_check(self, *params):
        result = subprocess.run(
            [sys.executable, self.check, '--password-file=/etc/hostname', *params],
            capture_output=True,
            text=True,
            timeout=30,
        )
        return result.returncode, result.stdout

    def test_rclone_repository_is_refused(self):
        retc, stdout = self.run_check('--repo=rclone:remote:backups')
        self.assertEqual(retc, STATE_UNKNOWN)
        self.assertIn('rclone', stdout)

    def test_repository_file_anybody_can_change_is_refused(self):
        work = tempfile.mkdtemp(prefix='lftest-restic-repo-')
        try:
            os.chmod(work, 0o777)
            repofile = os.path.join(work, 'repo')
            with open(repofile, 'w') as handle:
                handle.write('rclone:remote:backups\n')
            retc, stdout = self.run_check(f'--repository-file={repofile}')
            self.assertEqual(retc, STATE_UNKNOWN)
            self.assertNotIn('Created', stdout)
        finally:
            shutil.rmtree(work, ignore_errors=True)


if __name__ == '__main__':
    unittest.main()
