            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0cc1dc89-3093-447a-b05b-ef04c8cd3cd9"
        },
        "7": {
            "varname": "windows_version_windows_proxy",
            "caption": "Windows Version: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c3af60b5-731d-4ffd-a658-324d3194e8fc"
        },
        "8": {
            "varname": "windows_version_windows_timeout",
            "caption": "Windows Version: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0ec60154-a8e0-43a3-9011-27f25a75927f"
        },
        "9": {
            "varname": "windows_version_windows_unreachable_severity",
            "caption": "Windows Version: Unreachable Severity",
            "description": "State to report when the online source is unreachable. What is used instead - bundled offline data, a cached copy, or nothing at all - is named in the output, and a clean result then only covers what that fallback could confirm.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
