        "2": {
            "varname": "metabase_version_check_major",
            "caption": "Metabase Version: Check Major?",
            "description": "Alert when a new major release is available, even if the current version is not yet EOL. Example: running v26 (not yet EOL) and v27 is available.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "1cd5524c-e833-44c9-89a2-1623626f98c6"
        },
        "3": {
            "varname": "metabase_version_check_minor",
            "caption": "Metabase Version: Check Minor?",
            "description": "Alert when a new major.minor release is available, even if the current version is not yet EOL. Example: running v26.2 (not yet EOL) and v26.3 is available.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5d525d39-9f55-4a94-bc2a-87dec0a1ab56"
        },
        "4": {
            "varname": "metabase_version_check_patch",
            "caption": "Metabase Version: Check Patch?",
            "description": "Alert when a new major.minor.patch release is available, even if the current version is not yet EOL. Example: running v26.2.7 (not yet EOL) and v26.2.8 is available.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7df49825-42e3-4764-ad26-c046277abcf1"
        },
        "5": {
            "varname": "metabase_version_insecure",
            "caption": "Metabase Version: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "96a152c1-7ceb-49a8-b489-201b46a0eeba"
        },
        "6": {
            "varname": "metabase_version_no_perfdata",
            "caption": "Metabase Version: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5091ec19-963b-4120-967d-208ce85df967"
        },
        "7": {
            "varname": "metabase_version_no_proxy",
            "caption": "Metabase Version: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "bcf568eb-63b9-430a-b245-dd819a303e3c"
        },
        "8": {
            "varname": "metabase_version_offset_eol",
            "caption": "Metabase Version: Offset Eol",
            "description": "Alert n days before (\"-30\") or after an EOL date (\"30\" or \"+30\").",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "df0022fd-21c5-4c4f-860d-2ab13e2b8503"
        },
        "9": {
            "varname": "metabase_version_path",
            "caption": "Metabase Version: Path",
            "description": "Full path to Metabase's `metabase.jar`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9fe03ff7-f769-4767-af1d-da176f9b7c6a"
        },
        "10": {
            "varname": "metabase_version_proxy",
            "caption": "Metabase Version: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8a5de346-02c8-437c-8407-b505741b31db"
        },
        "11": {
            "varname": "metabase_version_timeout",
            "caption": "Metabase Version: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e5a601c1-b43f-41e2-b561-1fa7502ef9ed"
        },
        "12": {
            "varname": "metabase_version_unreachable_severity",
            "caption": "Metabase Version: Unreachable Severity",
            "description": "State to report when the online source is unreachable. What is used instead - bundled offline data, a cached copy, or nothing at all - is named in the output, and a clean result then only covers what that fallback could confirm.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "metabase_version_unreachable_severity_list"
            },
            "uuid": "72002b8e-4c81-46ac-a07a-512dd2f96614"
        }
