"""Unit tests for the postfix-version check plugin.

The fixtures in `stdout/` are the raw `postconf -d mail_version`
outputs captured from official Red Hat family base images
(`registry.access.redhat.com/ubi{8,9,10}` and
`registry.fedoraproject.org/fedora:43`) after a fresh
`dnf install postfix`. The `*-snapshot-*`, `*-rc-*`, `*-nonprod-*` and
`mail-release-date-and-version` fixtures follow the `name = value` format
of `src/postconf/postconf_print.c` and the version strings that
`src/global/mail_version.h` builds for snapshots, release candidates and
non-production builds, since no distribution ships such a build.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-rhel8-postfix-3-5-8',
        'test': 'stdout/postconf-mail-version-rhel8,,0',
        'assert-in': ['Postfix v3.5.8'],
    },
    {
        'id': 'parses-rhel9-postfix-3-5-25',
        'test': 'stdout/postconf-mail-version-rhel9,,0',
        'assert-in': ['Postfix v3.5.25'],
    },
    {
        'id': 'parses-rhel10-postfix-3-8-5',
        'test': 'stdout/postconf-mail-version-rhel10,,0',
        'assert-in': ['Postfix v3.8.5'],
    },
    {
        'id': 'parses-fedora43-postfix-3-10-3',
        'test': 'stdout/postconf-mail-version-fedora43,,0',
        'assert-in': ['Postfix v3.10.3'],
    },
    {
        'id': 'parses-snapshot-3-12',
        'test': 'stdout/postconf-mail-version-snapshot-3.12,,0',
        'assert-in': ['Postfix v3.12-20260925 ', "'postfix-version'=3.012;"],
    },
    {
        'id': 'parses-rc-3-11-0',
        'test': 'stdout/postconf-mail-version-rc-3.11,,0',
        'assert-in': ['Postfix v3.11.0-RC1 ', "'postfix-version'=3.011;"],
    },
    {
        'id': 'parses-nonprod-2-11',
        'test': 'stdout/postconf-mail-version-nonprod-2.11,,0',
        'assert-in': ['Postfix v2.11-20131216-nonprod ', "'postfix-version'=2.011;"],
    },
    {
        # only the `mail_version` line counts, not another parameter's value
        'id': 'parses-mail-version-after-mail-release-date',
        'test': 'stdout/postconf-mail-release-date-and-version,,0',
        'assert-in': ['Postfix v3.12-20260925 ', "'postfix-version'=3.012;"],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Postfix not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../postfix-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
