    "Datafield": {
        "1": {
            "varname": "huawei_pacific_namespace_always_ok",
            "caption": "Huawei Pacific Namespace: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "5dccfc6d-58a2-4c44-a818-e837906dd7d6"
        },
        "2": {
            "varname": "huawei_pacific_namespace_cache_expire",
            "caption": "Huawei Pacific Namespace: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "77960420-330f-4518-b8df-5e2b92700765"
        },
        "3": {
            "varname": "huawei_pacific_namespace_ignore",
            "caption": "Huawei Pacific Namespace: Ignore",
            "description": "Skip namespaces. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the namespace identifier and its name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f1e5a196-f26b-4fc2-be0d-67978ad67d41"
        },
        "4": {
            "varname": "huawei_pacific_namespace_insecure",
            "caption": "Huawei Pacific Namespace: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "4c609a12-9621-41a1-89d7-19825d9ad29b"
        },
        "5": {
            "varname": "huawei_pacific_namespace_lengthy",
            "caption": "Huawei Pacific Namespace: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f861ecc2-3a1b-4583-b486-7d7f8d2e76ac"
        },
        "6": {
            "varname": "huawei_pacific_namespace_match",
            "caption": "Huawei Pacific Namespace: Match",
            "description": "Limit to namespaces. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the namespace identifier and its name, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "fb50e08c-a93d-4738-82b0-c31e854418c0"
        },
        "7": {
            "varname": "huawei_pacific_namespace_no_insecure",
            "caption": "Huawei Pacific Namespace: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "dd2d7132-fc47-4889-8bea-fa7dabd65050"
        },
        "8": {
            "varname": "huawei_pacific_namespace_no_match_severity",
            "caption": "Huawei Pacific Namespace: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_namespace_no_match_severity_list"
            },
            "uuid": "03888a5e-e59b-4f8f-a54d-4dca0e1b43a8"
        },
        "9": {
            "varname": "huawei_pacific_namespace_no_perfdata",
            "caption": "Huawei Pacific Namespace: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "28e18866-0b48-4156-a705-7fb5a26e897f"
        },
        "10": {
            "varname": "huawei_pacific_namespace_no_proxy",
            "caption": "Huawei Pacific Namespace: No Proxy?",
            "description": "Do not use a proxy.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "18fb9ec1-1ced-47e9-befe-20e33eabdfaa"
        },
        "11": {
            "varname": "huawei_pacific_namespace_password",
            "caption": "Huawei Pacific Namespace: Password",
            "description": "Huawei OceanStor Pacific API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "a92bd68f-9df2-405e-80ca-f445878f1a26"
        },
        "12": {
            "varname": "huawei_pacific_namespace_password_file",
            "caption": "Huawei Pacific Namespace: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "1a2aa140-bca5-4aa0-b16f-171b032399a3"
        },
        "13": {
            "varname": "huawei_pacific_namespace_read_only_severity",
            "caption": "Huawei Pacific Namespace: Read Only Severity",
            "description": "State to report for a namespace that is read-only. A namespace can be set read-only on purpose, which is what an archive that must not change any more looks like, so this is not a fault by itself.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_namespace_read_only_severity_list"
            },
            "uuid": "540d0853-c8d2-4c5f-b2d5-43439eb42cd9"
        },
        "14": {
            "varname": "huawei_pacific_namespace_scope",
            "caption": "Huawei Pacific Namespace: Scope",
            "description": "Huawei OceanStor Pacific API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a33af7ff-041e-4829-9dac-fa25f65e7b7f"
        },
        "15": {
            "varname": "huawei_pacific_namespace_timeout",
            "caption": "Huawei Pacific Namespace: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "216f7a74-cbf8-4627-9b9b-ec32777f8813"
        },
        "16": {
            "varname": "huawei_pacific_namespace_url",
            "caption": "Huawei Pacific Namespace: URL",
            "description": "Huawei OceanStor Pacific API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b9a2d00f-644e-439e-bfca-226547bbd76e"
        },
        "17": {
            "varname": "huawei_pacific_namespace_username",
            "caption": "Huawei Pacific Namespace: Username",
            "description": "Huawei OceanStor Pacific API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d697dcd3-1d8e-49cf-9bae-a8b6e3803bb5"
        },
        "18": {
            "varname": "huawei_pacific_namespace_verbose",
            "caption": "Huawei Pacific Namespace: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "353ace14-2658-4a74-a916-7e2d9c3e7d22"
        }
    }
