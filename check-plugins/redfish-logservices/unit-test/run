# https://github.com/Linuxfabrik/monitoring-plugins/blob/main/CONTRIBUTING.md

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# Each fixture in stdout/ is the output of a `--verbose` run: one `### GET <path>` block per
# Redfish response the plugin evaluated. lib.redfish.replay() answers every request of the
# walk from these blocks, so a scenario is a single file, it may hold any number of members,
# and the output a user attaches to a bug report can be used as a fixture as it is.
COMMON = '--url=https://example.com'

TESTS = [
    {
        'id': 'ok-empty-sel',
        'test': 'stdout/empty-sel,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked SEL on 1 member.'],
    },
    {
        # A SEL with a critical and a warning entry (and one OK entry that
        # is always skipped) escalates to CRITICAL and lists both.
        'id': 'crit-sel-entries',
        'test': 'stdout/sel-entries,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are critical errors.',
            'CPU temperature is critical',
            'Fan 3 redundancy lost',
            '[CRITICAL]',
        ],
    },
    {
        # --ignore drops the critical temperature entry by regex, leaving only
        # the fan warning, so the check de-escalates to WARNING.
        'id': 'warn-ignore-temperature',
        'test': 'stdout/sel-entries,,0',
        'params': f"{COMMON} --ignore='(?i)temperature'",
        'assert-retc': STATE_WARN,
        'assert-in': ['There are warnings.', 'Fan 3 redundancy lost'],
        'assert-not-in': ['[CRITICAL]', 'CPU temperature is critical'],
    },
    {
        # --match keeps only the temperature entry, so the fan warning is not
        # considered and the check is CRITICAL on the temperature alone.
        'id': 'crit-match-temperature',
        'test': 'stdout/sel-entries,,0',
        'params': f"{COMMON} --match='(?i)temperature'",
        'assert-retc': STATE_CRIT,
        'assert-in': ['CPU temperature is critical', '[CRITICAL]'],
        'assert-not-in': ['Fan 3 redundancy lost'],
    },
    {
        # --max-age ages out both non-OK entries (dated 2021), so nothing
        # drives the state and the summary reports how many aged out.
        'id': 'ok-max-age-ages-out',
        'test': 'stdout/sel-entries,,0',
        'params': f'{COMMON} --max-age=30',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked SEL on 1 member.', '2 aged out'],
        'assert-not-in': ['[CRITICAL]'],
    },
    {
        # A huge --max-age keeps even old entries within the window, so aging
        # does not suppress them and the check stays CRITICAL.
        'id': 'crit-max-age-keeps-entries',
        'test': 'stdout/sel-entries,,0',
        'params': f'{COMMON} --max-age=100000',
        'assert-retc': STATE_CRIT,
        'assert-in': ['CPU temperature is critical', '[CRITICAL]'],
        'assert-not-in': ['aged out'],
    },
    {
        # --log-type=mel reads only the management controller log, which here
        # holds a single warning, so the check is WARNING and labelled MEL.
        'id': 'warn-mel-only',
        'test': 'stdout/sel-entries,,0',
        'params': f'{COMMON} --log-type=mel',
        'assert-retc': STATE_WARN,
        'assert-in': ['Checked MEL on 1 member.', '(MEL)', 'BMC firmware was updated'],
        'assert-not-in': ['CPU temperature is critical'],
    },
    {
        # --log-type=both reads SEL and MEL; the critical SEL entry dominates,
        # and both logs are labelled in the output.
        'id': 'crit-both-logs',
        'test': 'stdout/sel-entries,,0',
        'params': f'{COMMON} --log-type=both',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Checked SEL and MEL on 1 member.',
            '(SEL)',
            '(MEL)',
            'CPU temperature is critical',
            'BMC firmware was updated',
        ],
    },
    {
        # The controller advertises its $expand support in the service root. Every
        # collection has to be requested with it, not just the entry point (#1507).
        'id': 'ok-expand-on-every-collection',
        'test': 'stdout/sel-entries,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            '### GET /redfish/v1/Managers/iDRAC.Embedded.1/LogServices/Sel/Entries?$expand=*($levels=1)',
        ],
    },
    {
        # --verbose appends every Redfish response the check evaluated, in the form a
        # fixture takes, so the output of a reported run can be replayed as a test.
        'id': 'ok-verbose-appends-responses',
        'test': 'stdout/empty-sel,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': [
            '### GET /redfish/v1/Managers/iDRAC.Embedded.1/LogServices/Sel/Entries'
        ],
    },
    {
        # HPE iLO keeps the SEL (IML) under Systems and the MEL (IEL) under Managers.
        # The check has to find the IML where the controller advertises it instead of
        # asking the manager for it and reading nothing.
        'id': 'crit-hpe-iml-under-systems',
        'test': 'stdout/hpe-iml-under-systems,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Checked SEL on 1 member. There are critical errors.',
            '/redfish/v1/Systems/1/LogServices/IML (SEL)',
            'Uncorrectable Memory Error',
        ],
    },
    {
        'id': 'ok-hpe-iel-under-managers',
        'test': 'stdout/hpe-iml-under-systems,,0',
        'params': f'{COMMON} --log-type=mel',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. Checked MEL on 1 member.'],
        'assert-not-in': ['Uncorrectable Memory Error'],
    },
    {
        'id': 'crit-hpe-both-logs-on-two-members',
        'test': 'stdout/hpe-iml-under-systems,,0',
        'params': f'{COMMON} --log-type=both',
        'assert-retc': STATE_CRIT,
        'assert-in': ['Checked SEL and MEL on 2 members. There are critical errors.'],
    },
    {
        # A controller that advertises no SEL must not pass as one without entries.
        'id': 'unknown-no-sel-advertised',
        'test': 'stdout/hpe-no-sel-advertised,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'The controller advertises no SEL.'
            ' Logs it offers: /redfish/v1/Managers/1/LogServices/IEL.',
        ],
    },
    {
        # --log-type=both on a controller that offers only one of the two logs reads
        # that one and says which is missing, instead of claiming to have read both.
        'id': 'ok-both-logs-one-missing',
        'test': 'stdout/hpe-no-sel-advertised,,0',
        'params': f'{COMMON} --log-type=both',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked MEL on 1 member.',
            'The controller advertises no SEL.',
        ],
        'assert-not-in': ['SEL and MEL'],
    },
    # The dmtf-dsp2043-* fixtures are taken from DMTF DSP2043 2026.2 (Redfish Resource
    # and Schema Guide mockups, Copyright 2015-2026 DMTF), trimmed to the responses the
    # check requests.
    {
        # public-catfish: the SEL sits below the system, named "SEL" and without a
        # LogEntryType, like the HPE IML. Reading the manager alone finds nothing.
        'id': 'crit-dmtf-catfish-sel-under-systems',
        'test': 'stdout/dmtf-dsp2043-catfish,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Checked SEL on 1 member. There are critical errors.',
            '/redfish/v1/Systems/1/LogServices/SEL (SEL)',
            'Temperature threshold exceeded [CRITICAL]',
        ],
    },
    {
        # public-bladed: five managers, one log each. A blade's warning and the
        # enclosure's critical entry are both reported, the worst decides.
        'id': 'crit-dmtf-bladed-five-managers',
        'test': 'stdout/dmtf-dsp2043-bladed,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Checked SEL on 5 members. There are critical errors.',
            'Fan 2 crossed Lower Fatal Threshold',
            '/redfish/v1/Managers/Blade3BMC/LogServices/Log (SEL)',
            'CPU temperature crossed Upper Non Critical Threshold [WARNING]',
        ],
    },
    {
        # public-telemetry: the manager names its SEL "Log1", and it is empty.
        'id': 'ok-dmtf-telemetry-empty-log1',
        'test': 'stdout/dmtf-dsp2043-telemetry,,0',
        'params': f'{COMMON} --verbose',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. Checked SEL on 1 member.',
            '### GET /redfish/v1/Managers/1/LogServices/Log1/Entries',
        ],
    },
    {
        # A missing fixture must surface as STATE_UNKNOWN with a
        # readable message, not as a Python traceback.
        'id': 'unknown-missing-fixture',
        'test': 'stdout/does-not-exist,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Found no recorded Redfish responses to replay.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../redfish-logservices'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
