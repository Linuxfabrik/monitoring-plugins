import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

COMMON = '--winrm-hostname=dummy --winrm-password=dummy'


TESTS = [
    {
        'id': 'crit-scope-above-critical-threshold',
        'test': 'stdout/three-scopes-two-high-usage,,0',
        'params': COMMON,
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are one or more criticals.',
            '* 192.0.2.120: 0% used',
            '* 192.0.2.121: 83% used [WARNING]',
            '* 192.0.2.122: 91% used [CRITICAL]',
        ],
    },
    {
        # output that is no scope list must never read as a healthy server
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Unable to read the scope statistics'],
        'assert-not-in': ['Everything is ok.', 'Traceback'],
    },
    {
        # What the former Format-Table command returned over PSRP, which lib.winrm
        # prefers: the type names of the objects, no table. It used to end in
        # "Everything is ok." without a single scope checked.
        'id': 'unknown-psrp-type-names-only',
        'test': 'stdout/psrp-type-names-only,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-not-in': ['Everything is ok.'],
    },
    {
        # Captured from Linux over PSRP against Windows Server 2025 with the DHCP role,
        # 2026-09-28: one scope with every address reserved but one.
        'id': 'warn-srv2025-two-scopes-psrp',
        'test': 'stdout/srv2025-two-scopes-psrp,,0',
        'params': COMMON,
        'assert-retc': STATE_WARN,
        'assert-in': [
            '* 10.98.0.0: 80% used [WARNING]',
            '* 10.99.0.0: 0% used',
            "'scope_10.99.0.0'=0%",
        ],
    },
    {
        # Captured from Linux over PSRP against Windows Server 2025 without the DHCP role.
        'id': 'unknown-no-dhcp-role',
        'test': 'stdout/no-dhcp-role,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Get-DhcpServerv4ScopeStatistics is not available on dummy'],
    },
    {
        # Captured from Linux over PSRP against Windows Server 2025 with the DHCP
        # Server service stopped. The server is down, which is not the same as knowing
        # nothing about it.
        'id': 'warn-dhcp-service-stopped',
        'test': 'stdout/dhcp-service-stopped,,0',
        'params': COMMON,
        'assert-retc': STATE_WARN,
        'assert-in': ['Failed to get server statistics from DHCP server localhost.'],
        'assert-not-in': ['Everything is ok.'],
    },
    {
        # Captured on Windows Server 2025 (German UI), run locally over SSH by a
        # standard user: the account may not open the CIM session, which says nothing
        # about the DHCP server.
        'id': 'unknown-access-denied-de',
        'test': 'stdout/access-denied-de,,0',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Unable to query the DHCP server localhost: Die Verbindung'],
        'assert-not-in': ['Everything is ok.'],
    },
    {
        # Captured from Linux over PSRP against Windows Server 2025 with a wrong
        # password: nothing ran, nothing is known about the scopes.
        'id': 'unknown-winrm-login-failed',
        'test': ',stderr/winrm-login-failed,1',
        'params': COMMON,
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Unable to run the command on dummy: AuthenticationError: Failed to'
            ' authenticate the user Administrator with ntlm',
        ],
    },
    {
        # the local mode runs without any --winrm parameter
        'id': 'ok-local-mode-without-winrm-parameters',
        'test': 'stdout/eight-scopes-all-healthy,,0',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.'],
    },
    {
        'id': 'ok-no-scopes',
        'test': 'stdout/no-scopes,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': ['No IPv4 scope configured.'],
    },
    {
        'id': 'ok-eight-scopes-all-healthy',
        'test': 'stdout/eight-scopes-all-healthy,,0',
        'params': COMMON,
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.'],
    },
    # #788: --brief hides scopes within the thresholds and only
    # renders rows in WARN/CRIT state. --brief is the row-level
    # counterpart of the column-level --lengthy switch: they are
    # orthogonal and can be combined. Alerting and perfdata are
    # unaffected: all scopes still drive the overall state and still
    # emit perfdata.
    {
        'id': 'crit-three-scopes-brief-hides-ok-row',
        'test': 'stdout/three-scopes-two-high-usage,,0',
        'params': f'{COMMON} --brief',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'There are one or more criticals.',
            '* 192.0.2.121: 83% used [WARNING]',
            '* 192.0.2.122: 91% used [CRITICAL]',
        ],
        # the OK-state scope must not appear in the human-readable
        # body. 192.0.2.120 still shows up in perfdata, but perfdata
        # uses the `scope_192.0.2.120=` syntax, not `* 192.0.2.120: `.
        'assert-not-in': ['* 192.0.2.120: '],
    },
    {
        'id': 'ok-eight-scopes-all-healthy-brief-header-only',
        'test': 'stdout/eight-scopes-all-healthy,,0',
        'params': f'{COMMON} --brief',
        # with --brief and zero WARN/CRIT rows, the plugin shows only
        # the "Everything is ok." header (no scope list).
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok.'],
        'assert-not-in': ['* 192.168.'],
    },
    {
        'id': 'warn-three-scopes-brief-lifted-crit-threshold',
        'test': 'stdout/three-scopes-two-high-usage,,0',
        # Lift the crit threshold so the 91%-scope drops from CRIT to
        # WARN. --brief continues to hide the 0%-scope but keeps the
        # two non-OK rows.
        'params': f'{COMMON} --brief --warning=80 --critical=99',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'There are one or more warnings.',
            '* 192.0.2.121: 83% used [WARNING]',
            '* 192.0.2.122: 91% used [WARNING]',
        ],
        'assert-not-in': ['* 192.0.2.120: '],
    },
    {
        # the value reaches a PowerShell script on the WinRM host
        'id': 'unknown-hostname-with-powershell-code',
        'test': 'stdout/three-scopes-two-high-usage,,0',
        'params': COMMON + ' --hostname=\'x"$(Remove-Item C:\\x)"\'',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['--hostname accepts a DNS name'],
    },
    {
        'id': 'ok-hostname-ipv6',
        'test': 'stdout/eight-scopes-all-healthy,,0',
        'params': COMMON + ' --hostname=2001:db8::1',
        'assert-retc': STATE_OK,
    },
]


class TestCheck(unittest.TestCase):
    check = '../dhcp-scope-usage'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
