# The `Explanation` lost its colon. APT looks for the colon that ends a field name in
# everything that follows, finds the one in `Package` below, and reads both lines as one
# field name. The stanza is left without a `Package` header, which APT refuses outright:
# it abandons the file and every command that works out package priorities fails.
Explanation hold nginx
Package: nginx
Pin: version 1.24.*
Pin-Priority: 1001

# APT never gets this far.
Package: after-the-error-package
Pin: version 7.1*
Pin-Priority: 1001
