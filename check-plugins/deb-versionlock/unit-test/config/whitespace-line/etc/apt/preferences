# The two stanzas are separated by a line carrying a single space, not by an empty one.
# APT reads that line as a continuation of the value above it, so both stanzas end up in
# one record, and a field the record holds twice keeps its last value. Only the second
# package is pinned, and it is pinned with the second version and priority.
Package: first-package
Pin: version 1.0*
Pin-Priority: 1001

Package: second-package
Pin: version 2.0*
Pin-Priority: 1002
