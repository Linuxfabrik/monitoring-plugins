    "Datafield": {
        "1": {
            "varname": "deb_versionlock_always_ok",
            "caption": "Deb Versionlock: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2ac8c9f3-c828-42a4-a033-055153757cba"
        },
        "2": {
            "varname": "deb_versionlock_check_pinning",
            "caption": "Deb Versionlock: Check Pinning?",
            "description": "Additionally report the packages pinned in the APT preferences. A pin keeps a package at a version just as effectively as a hold, but it is also used legitimately to give a repository like backports a priority of its own, which is why it is not reported by default.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "2574b61a-a322-47d7-a2ca-d3d4f3acc1fd"
        },
        "3": {
            "varname": "deb_versionlock_critical",
            "caption": "Deb Versionlock: Critical",
            "description": "CRIT threshold for the number of holds. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "76385ab8-4966-416e-b316-629836728bbb"
        },
        "4": {
            "varname": "deb_versionlock_ignore",
            "caption": "Deb Versionlock: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "790facb3-7a1f-4ac5-ac7e-87c2d75abe14"
        },
        "5": {
            "varname": "deb_versionlock_lengthy",
            "caption": "Deb Versionlock: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "9b4b08e6-7aa3-4045-b334-0cc940e9f675"
        },
        "6": {
            "varname": "deb_versionlock_match",
            "caption": "Deb Versionlock: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8f48a6bd-df4c-45f7-89f0-f784265d7567"
        },
        "7": {
            "varname": "deb_versionlock_no_match_severity",
            "caption": "Deb Versionlock: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "deb_versionlock_no_match_severity_list"
            },
            "uuid": "75195f0c-2f9c-43c7-876e-a6a68d1dfcc3"
        },
        "8": {
            "varname": "deb_versionlock_no_perfdata",
            "caption": "Deb Versionlock: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "cf134944-47d7-4a01-8f2e-65393ea73625"
        },
        "9": {
            "varname": "deb_versionlock_timeout",
            "caption": "Deb Versionlock: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
