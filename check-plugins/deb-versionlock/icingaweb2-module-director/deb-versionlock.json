            "icon_image": "deb-versionlock.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Reports the packages that APT holds back at their installed version. A hold set to work around a broken update and then forgotten keeps a host on an unpatched version for good, while the update check stays green because APT no longer offers the update. Alerts as soon as one hold is in place; raise --warning to tolerate a number of deliberate holds, or filter the ones you keep on purpose with --ignore. Optionally also reports the packages pinned in the APT preferences via --check-pinning, and then alerts as well on a preferences file APT refuses, which stops the host from installing or upgrading anything. Supports extended reporting via --lengthy.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/deb-versionlock/",
            "object_name": "tpl-service-deb-versionlock",
            "object_type": "template",
            "retry_interval": 300,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "deb_versionlock_always_ok": false,
                "deb_versionlock_check_pinning": false,
                "deb_versionlock_ignore": [],
                "deb_versionlock_lengthy": false,
                "deb_versionlock_match": [],
                "deb_versionlock_no_match_severity": "ok",
                "deb_versionlock_no_perfdata": false,
                "deb_versionlock_timeout": 8,
                "deb_versionlock_warning": "0"
