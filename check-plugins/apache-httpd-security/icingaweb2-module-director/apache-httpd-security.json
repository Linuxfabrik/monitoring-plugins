    "Datafield": {
        "1": {
            "varname": "apache_httpd_security_always_ok",
            "caption": "Apache httpd Security: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7136e7c4-e670-46c1-a5a1-a7198d4af039"
        },
        "2": {
            "varname": "apache_httpd_security_brief",
            "caption": "Apache httpd Security: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "0444e472-ab79-4091-9ef0-cd9b0749cff4"
        },
        "3": {
            "varname": "apache_httpd_security_command",
            "caption": "Apache httpd Security: Command",
            "description": "Path to the Apache httpd control binary. Probed automatically if not given: `httpd` first, then `apachectl`. Example: `--command=/usr/sbin/httpd`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "a19de564-0eba-485d-b5d7-817cb75e3198"
        },
        "4": {
            "varname": "apache_httpd_security_ignore",
            "caption": "Apache httpd Security: Ignore",
            "description": "Any check whose name matches this Python regex will be dropped from the report. Use it for a finding the site knowingly accepts, for example the status module on a host whose monitoring reads it. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Example: `--ignore=^Status module$`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bf95ab16-45b3-4af2-907d-c2b1a9684292"
        },
        "5": {
            "varname": "apache_httpd_security_match",
            "caption": "Apache httpd Security: Match",
            "description": "Only report the checks whose name matches this Python regex. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "962fb242-d87a-4865-82f1-2711b6952111"
        },
        "6": {
            "varname": "apache_httpd_security_no_match_severity",
            "caption": "Apache httpd Security: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "apache_httpd_security_no_match_severity_list"
            },
            "uuid": "93472aa7-f53c-4ba2-9ac8-a47760e5f8ef"
        },
        "7": {
            "varname": "apache_httpd_security_no_perfdata",
            "caption": "Apache httpd Security: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "f33483bf-b0d8-4403-be1d-026bf69e3f2a"
        },
        "8": {
            "varname": "apache_httpd_security_severity",
            "caption": "Apache httpd Security: Severity",
            "description": "State to report for a failed check. One of `warn` or `crit`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "apache_httpd_security_severity_list"
            },
            "uuid": "c637b661-047d-4b6b-8451-6246ed738b0d"
        },
        "9": {
            "varname": "apache_httpd_security_timeout",
            "caption": "Apache httpd Security: Timeout",
