    # An interactive shell and a usable password on the worker account, which
    # is what CIS asks about separately from the account being dedicated.
    {
        'id': 'warn-account-shell-and-password-usable',
        'test': 'stdout/stray-process',
        'params': '--match=^Account',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '2 of 2 checks failed.',
            '`/bin/bash`',
            'Not one of the shells that exit instead of opening a session.',
            'usable password',
            '`chsh -s /sbin/nologin nobody`',
            '`passwd -l nobody`',
