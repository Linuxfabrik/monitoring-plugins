class TestCheck(unittest.TestCase):
    check = '../apache-httpd-security'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestCheckNames(unittest.TestCase):
    """The `--ignore='<name>'` every recommendation prints carries no anchors,
    which is only correct while the names stay unambiguous as substrings and free
    of regular expression metacharacters. Both are properties of the names, so
    they are pinned here rather than left to whoever adds the next check."""

    def setUp(self):
        completed = subprocess.run(
            [sys.executable, '../apache-httpd-security', '--test=stdout/rhel-stock'],
            capture_output=True,
            text=True,
            check=False,
        )
        self.output = completed.stdout
        self.titles = [
            line.split(' ! ')[0].strip()
            for line in self.output.splitlines()
            if ' ! ' in line and not line.startswith('Check Name')
        ]

    def test_the_fixture_produced_names(self):
        self.assertGreater(len(self.titles), 10, self.output)

    def test_no_name_carries_a_regex_metacharacter(self):
        for title in self.titles:
            self.assertIsNone(
                re.search(r'[.^$*+?()\[\]{}|\\]', title),
                f'{title} would not survive being used as a pattern',
            )

    def test_no_name_is_a_substring_of_another(self):
        for title in self.titles:
            for other in self.titles:
                if title != other:
                    self.assertNotIn(
                        title,
                        other,
                        f'--ignore={title!r} would also drop {other!r}',
                    )


class TestSecurity(unittest.TestCase):
    """This check runs as root, so --command must not execute a binary the
    caller planted outside the standard binary directories.
    """

    check = '../apache-httpd-security'

    def test_unknown_command_outside_allowed_roots_is_refused(self):
        with tempfile.TemporaryDirectory() as base:
            evil = os.path.join(base, 'httpd')
            with open(evil, 'w') as handle:
                handle.write('#!/bin/sh\necho fake\n')
            os.chmod(evil, 0o755)
            result = subprocess.run(
                [sys.executable, self.check, f'--command={evil}'],
                capture_output=True,
                text=True,
            )
        self.assertEqual(result.returncode, STATE_UNKNOWN)
        self.assertIn('Refusing to run', result.stdout)


def _load_plugin_module():
    """Import the hyphen-named plugin as a Python module for direct function
    unit tests."""
    path = os.path.join(
        os.path.dirname(os.path.abspath(__file__)), '..', 'apache-httpd-security'
    )
    loader = importlib.machinery.SourceFileLoader('apache_httpd_security', path)
    spec = importlib.util.spec_from_loader('apache_httpd_security', loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


@unittest.skipUnless(os.name == 'posix', 'ownership is a POSIX concept here')
class TestTrustedBinary(unittest.TestCase):
    """The binary this check runs as root has to be one nobody but root can
    change, and the path that was checked is the one that runs.

    One test per way the binary could be somebody else's: a symlink that can be
    swapped after the check, a directory anybody can write to, a file that
    belongs to another account.
    """

    def setUp(self):
        self.plugin = _load_plugin_module()
        self.work = tempfile.mkdtemp(prefix='lftest-apache-httpd-security-')
        self.system_binary = shutil.which('env')

    def tearDown(self):
        shutil.rmtree(self.work, ignore_errors=True)

    def allow_work_dir(self):
        return unittest.mock.patch.object(
            self.plugin,
            'ALLOWED_BINARY_ROOTS',
            (*self.plugin.ALLOWED_BINARY_ROOTS, self.work),
        )

    def test_symlink_is_resolved_before_it_runs(self):
        # Returning the symlink would run whatever it points to by the time the
        # binary is started, not what was checked.
        link = os.path.join(self.work, 'binary')
        os.symlink(self.system_binary, link)
        self.assertEqual(
            self.plugin.find_binary(link),
            (True, os.path.realpath(self.system_binary)),
        )

    def test_binary_in_a_directory_anybody_can_write_is_refused(self):
        planted = os.path.join(self.work, 'binary')
        shutil.copy(self.system_binary, planted)
        os.chmod(self.work, 0o777)
        with self.allow_work_dir():
            success, result = self.plugin.find_binary(planted)
        self.assertFalse(success)
        self.assertIn('Refusing', result)

    def test_binary_of_another_account_is_refused(self):
        if os.getuid() == 0:
            self.skipTest('the test user is root')
        planted = os.path.join(self.work, 'binary')
        shutil.copy(self.system_binary, planted)
        with self.allow_work_dir():
            success, result = self.plugin.find_binary(planted)
        self.assertFalse(success)
        self.assertIn('Refusing', result)

    def test_probed_binary_is_resolved_and_trusted(self):
        with unittest.mock.patch.object(
            self.plugin.lib.shell, 'which', return_value=self.system_binary
        ):
            self.assertEqual(
                self.plugin.find_binary(None),
                (True, os.path.realpath(self.system_binary)),
            )


if __name__ == '__main__':
    unittest.main()
