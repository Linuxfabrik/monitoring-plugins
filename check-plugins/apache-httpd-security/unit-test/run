import re
import subprocess
import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    # Stock httpd 2.4.62 on Rocky 9. The distribution loads every module it
    # packages, so the whole section 2 fires while section 3 is clean.
    {
        'id': 'warn-rhel-stock-loads-every-module',
        'test': 'stdout/rhel-stock',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '8 of 22 checks failed.',
            'info_module',
            'status_module',
            "'apache_httpd_checks_failed'=8",
        ],
    },
    {
        'id': 'ok-rhel-stock-file-and-account-checks-are-clean',
        'test': 'stdout/rhel-stock',
        # lib.lftest.run() splits params on whitespace, so a regex passed here
        # must not contain spaces.
        'params': '--match=(ccount|Config|dump|Lock|Pid|ScoreBoard)',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. All 10 checks passed.',
            'apache:apache (uid 48)',
        ],
        'assert-not-in': ['info_module'],
    },
    # Stock apache2 2.4.68 on Debian 12, which ships a much smaller module set.
    {
        'id': 'warn-debian-stock-loads-fewer-modules',
        'test': 'stdout/debian-stock',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '4 of 22 checks failed.',
            'status_module',
            'www-data:www-data (uid 33)',
        ],
        'assert-not-in': ['info_module', 'dav_module'],
    },
    # Same host, the two runtime paths Debian resolves differently from RHEL.
    {
        'id': 'ok-debian-stock-runtime-paths',
        'test': 'stdout/debian-stock',
        'params': '--match=^Pid',
        'assert-retc': STATE_OK,
        'assert-in': ['/var/run/apache2', 'Root-owned'],
    },
    # Every module CIS asks about commented out, ownership untouched.
    {
        'id': 'ok-hardened',
        'test': 'stdout/hardened',
        'params': '',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Everything is ok. All 22 checks passed.',
            "'apache_httpd_checks_failed'=0",
        ],
        'assert-not-in': ['Recommendations:'],
    },
    # Shared "nobody" account, a file-based mutex in the world-writable /tmp, a
    # core dump directory inside the document root and a world-writable
    # configuration file.
    {
        'id': 'warn-shared-account-and-loose-paths',
        'test': 'stdout/shared-account',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '12 of 22 checks failed.',
            'nobody:nobody (uid 65534)',
            '`nobody` is a shared account',
            'uid 65534 >= UID_MIN 1000',
            '/etc/httpd/conf.d/zz-bad.conf',
            'writable beyond its owner (1777)',
            'inside the document root',
        ],
    },
    {
        'id': 'crit-shared-account-with-severity-crit',
        'test': 'stdout/shared-account',
        'params': '--severity=crit',
        'assert-retc': STATE_CRIT,
        'assert-in': ['[CRITICAL]'],
    },
    {
        'id': 'ok-shared-account-with-always-ok',
        'test': 'stdout/shared-account',
        'params': '--always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['12 of 22 checks failed.'],
    },
    # --brief drops the passing rows but must not change the counts, the
    # recommendations or the state.
    {
        'id': 'warn-brief-hides-passing-rows',
        'test': 'stdout/rhel-stock',
        'params': '--brief',
        'assert-retc': STATE_WARN,
        'assert-in': ['8 of 22 checks failed.', "'apache_httpd_checks_evaluated'=22"],
        'assert-not-in': ['[OK]'],
    },
    # A host whose monitoring reads mod_status knowingly accepts that finding.
    # An excluded check stops counting towards the verdict but keeps its row,
    # marked as overridden, so the decision stays visible.
    {
        'id': 'warn-ignore-status-module-anchored',
        'test': 'stdout/rhel-stock',
        'params': '--ignore=^Status',
        'assert-retc': STATE_WARN,
        'assert-in': ['7 of 21 checks failed, 1 overridden.', 'overridden [OK]'],
        'assert-not-in': ["Exclude it with --ignore='Status module'"],
    },
    # The same exclusion written as an unanchored substring.
    {
        'id': 'warn-ignore-status-module-by-substring',
        'test': 'stdout/rhel-stock',
        'params': '--ignore=Status',
        'assert-retc': STATE_WARN,
        'assert-in': ['7 of 21 checks failed, 1 overridden.', 'overridden [OK]'],
        'assert-not-in': ["Exclude it with --ignore='Status module'"],
    },
    # Everything filtered out: report the configured severity, not a pass.
    {
        'id': 'ok-nothing-checked',
        'test': 'stdout/rhel-stock',
        'params': '--ignore=.',
        'assert-retc': STATE_OK,
        'assert-in': ['Nothing checked.'],
    },
    {
        'id': 'warn-nothing-checked-with-severity',
        'test': 'stdout/rhel-stock',
        'params': '--ignore=. --no-match-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['Nothing checked.'],
    },
    # A worker running under an account other than the configured one means the
    # processes never dropped to it. The master staying root is expected and
    # must not be reported.
    {
        'id': 'warn-stray-worker-process',
        'test': 'stdout/stray-process',
        'params': '--match=^Worker',
        'assert-retc': STATE_WARN,
