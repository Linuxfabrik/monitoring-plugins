    {
        'id': 'ok-hardened-request-limits',
        'test': 'stdout/hardened',
        'params': '--match=^Request',
        'assert-retc': STATE_OK,
        'assert-in': ['Everything is ok. All 4 checks passed.', '102400'],
        'assert-not-in': ['(default)'],
    },
    # A zero, a value above the maximum, two values for the same directive, and
    # a value that is not a number at all, which cannot be judged.
    {
        'id': 'warn-loose-request-limits',
        'test': 'stdout/loose-limits',
        'params': '--match=^Request',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '3 of 3 checks failed.',
            '0 means the number of header fields is unlimited.',
            '0, 10485760',
            '`LimitRequestLine abc` is not a number.',
        ],
    },
    {
        # A filter given a module name instead of a check name matches nothing
        # and would otherwise leave a report that looks exactly like a run
        # without any filter at all.
        'id': 'warn-a-filter-that-matches-nothing-is-named',
        'test': 'stdout/rhel-stock',
        'params': "--ignore=status_module --ignore='Autoindex module'",
        'assert-retc': STATE_WARN,
        'assert-in': [
            '`status_module` matched no check',
            'take the name as it stands in the `Check Name` column',
        ],
        # the one that did match is not listed as unused
        'assert-not-in': ['`Autoindex module`'],
    },
    {
        # An ignored check keeps its row and says so, instead of vanishing. A
        # check that is simply gone is a check nobody revisits, and the row is
        # what shows the next reader that the site decided to live with it.
        'id': 'ok-an-ignored-check-is-reported-as-overridden',
        'test': 'stdout/rhel-stock',
        'params': "--ignore='Status module' --ignore='Autoindex module'",
        'assert-retc': STATE_WARN,
        'assert-in': [
            'overridden [OK]',
            '2 overridden.',
            # the row itself survives, with the finding it was overriding
            'Status module',
            'status_module',
            "'apache_httpd_checks_overridden'=2",
        ],
        # an overridden check drives neither the state nor the recommendations
        'assert-not-in': ["Exclude it with --ignore='Status module'"],
    },
    {
        # --brief hides what is within the thresholds, and an override is.
        'id': 'ok-brief-hides-an-overridden-check',
        'test': 'stdout/rhel-stock',
        'params': "--brief --ignore='Status module'",
        'assert-retc': STATE_WARN,
        'assert-in': ['1 overridden.', "'apache_httpd_checks_overridden'=1"],
        'assert-not-in': ['overridden [OK]'],
    },
    {
        # Every finding says how to switch it off, so a site that accepts one
        # does not have to look the parameter up.
        'id': 'warn-every-recommendation-says-how-to-exclude-it',
        'test': 'stdout/rhel-stock',
        'params': '',
        'assert-retc': STATE_WARN,
        'assert-in': ["Accepted here? Exclude it with --ignore='Status module'."],
    },
    {
        'id': 'unknown-missing-fixture',
        'test': 'stdout/does-not-exist',
        'params': '',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['not found'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../apache-httpd-security'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestCheckNames(unittest.TestCase):
    """The `--ignore='<name>'` every recommendation prints carries no anchors,
    which is only correct while the names stay unambiguous as substrings and free
    of regular expression metacharacters. Both are properties of the names, so
    they are pinned here rather than left to whoever adds the next check."""

    def setUp(self):
        completed = subprocess.run(
            [sys.executable, '../apache-httpd-security', '--test=stdout/rhel-stock'],
            capture_output=True,
            text=True,
            check=False,
        )
        self.output = completed.stdout
        self.titles = [
            line.split(' ! ')[0].strip()
            for line in self.output.splitlines()
            if ' ! ' in line and not line.startswith('Check Name')
        ]

    def test_the_fixture_produced_names(self):
        self.assertGreater(len(self.titles), 10, self.output)

    def test_no_name_carries_a_regex_metacharacter(self):
        for title in self.titles:
            self.assertIsNone(
                re.search(r'[.^$*+?()\[\]{}|\\]', title),
                f'{title} would not survive being used as a pattern',
            )

    def test_no_name_is_a_substring_of_another(self):
        for title in self.titles:
            for other in self.titles:
                if title != other:
                    self.assertNotIn(
                        title,
                        other,
                        f'--ignore={title!r} would also drop {other!r}',
                    )


if __name__ == '__main__':
    unittest.main()
