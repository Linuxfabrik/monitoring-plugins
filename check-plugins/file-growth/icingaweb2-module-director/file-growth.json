    "Datafield": {
        "1": {
            "varname": "file_growth_always_ok",
            "caption": "File Growth: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "089eec45-4565-4a50-966a-85e6c71b7b86"
        },
        "2": {
            "varname": "file_growth_brief",
            "caption": "File Growth: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "8ff72dea-03e4-4092-9a0a-2d6f31e6e0e8"
        },
        "3": {
            "varname": "file_growth_count",
            "caption": "File Growth: Count",
            "description": "Number of consecutive checks the threshold must be exceeded before alerting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d05c8ab6-f4a9-4541-8d99-99cec2a6940a"
        },
        "4": {
            "varname": "file_growth_critical",
            "caption": "File Growth: Critical",
            "description": "CRIT threshold for the rate of change per second, in human-readable format (base is always 1024; valid qualifiers are B, KiB, MiB, GiB etc., see UNITS.md; a value without a qualifier is a number of bytes). A negative bound catches a file that is shrinking. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ab88b70b-4aa0-4559-bbd6-6c9e800a2129"
        },
        "5": {
            "varname": "file_growth_filename",
            "caption": "File Growth: Filename",
            "description": "Path of the file to check. Supports glob patterns according to https://docs.python.org/3/library/glob.html. Recursive globs can cause high memory usage. Mutually exclusive with `-u` / `--url`. Example: `--filename /tmp/*.log`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "d20d146e-3c39-4b07-b47c-d7480cd8df09"
        },
        "6": {
            "varname": "file_growth_lengthy",
