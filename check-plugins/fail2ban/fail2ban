# fail2ban-client deserializes the reply it reads from its Unix socket, so a
# socket under an attacker-writable path would let a local user execute code in
# this root process. A custom socket has to live in the system runtime
# directories, and in addition nobody but root may be able to replace it: the
# prefix alone proves nothing, an unprivileged account can own a directory below
# /run (the Icinga agent's /run/icinga2, /run/user/<uid>).
ALLOWED_SOCKET_ROOTS = ('/run', '/var/run')

# The ban actions whose bans the check reads back from the firewall, recognized by
# the command fail2ban runs for a ban (`fail2ban-client get <jail> action <action>
# actionban`). Every action fail2ban 1.1.1 ships in config/action.d is either
# matched here or left unverified on purpose, see the README. Measured with
# fail2ban 1.1.1, nftables 1.0.9, iptables-nft 1.8.10, ipset 7.11 and firewalld
# 1.3.4 on Rocky 9.
BAN_STORES = (
    # nftables, nftables-allports, nftables-multiport
    (
        'nftables',
        re.compile(
            r'\bnft\b.*\badd element (?P<family>\S+) (?P<table>\S+) (?P<name>\S+) '
        ),
    ),
    # iptables, iptables-allports, iptables-multiport, iptables-multiport-log,
    # iptables-new
    (
        'iptables',
        re.compile(
            r'(?:<iptables>|\bip6?tables\b(?: -w)?) -I (?P<name>\S+) \d+ -s <ip> '
        ),
    ),
    # firewallcmd-allports, firewallcmd-multiport, firewallcmd-new: firewalld keeps
    # its direct rules in iptables
    (
        'iptables',
        re.compile(
            r'\bfirewall-cmd --direct --add-rule <family> filter (?P<name>\S+) \d+ -s <ip> '
        ),
    ),
    # firewallcmd-ipset (ipsetbackend = ipset), iptables-ipset, iptables-ipset-proto4,
    # iptables-ipset-proto6, iptables-ipset-proto6-allports, shorewall-ipset-proto6
    ('ipset', re.compile(r'\bipset (?:-exist )?(?:--)?add (?P<name>\S+) <ip>(?:\s|$)')),
    # firewallcmd-rich-logging, firewallcmd-rich-rules
    (
        'firewalld',
        re.compile(r'\bfirewall-cmd (?:--zone="?(?P<name>[^"\s]+)"? )?--add-rich-rule'),
    ),
)

DESCRIPTION = """Checks the number of currently banned IP addresses across all fail2ban jails.
Reports the total ban count and a per-jail breakdown. Jails can be excluded from the
check with a regular expression. Alerts when the number of banned IPs in any jail
exceeds the configured thresholds. Alerts as well when fail2ban bans an address that
must stay reachable, such as the reverse proxy in front of this host or the monitoring
server, so a lockout of everybody behind a proxy shows up at once, and when the
firewall does not hold a ban fail2ban lists, for example after a firewall reload
removed the rules of fail2ban. Requires root or sudo."""

DEFAULT_CRIT = '10000'
DEFAULT_NO_MATCH_SEVERITY = 'ok'
DEFAULT_TIMEOUT = 8
DEFAULT_WARN = '2500'

# How many missing bans to list per jail
MAX_MISSING_LISTED = 5

# How long to wait before reading the firewall a second time, for a ban that
# fail2ban lists while its action is still running
RECHECK_DELAY = 2

# A name fail2ban returns for a table, set, chain or zone. It ends up in an argv slot
# of nft, iptables-save, ipset or firewall-cmd, so it must not look like an option.
STORE_NAME_REGEX = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.:@-]*$')

TAG_REGEX = re.compile(r'<([A-Za-z0-9_?=/-]+)>')


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '-c',
        '--critical',
        help='CRIT threshold for the number of banned IPs per jail. '
        'Supports Nagios ranges. '
        'Default: %(default)s',
        dest='CRIT',
        default=DEFAULT_CRIT,
    )

    parser.add_argument(
        '--ignore',
        help='Exclude jails whose name matches this Python regular expression. '
        'Case-sensitive by default; use `(?i)` for case-insensitive matching. '
        'Can be specified multiple times. '
        'Example: `--ignore="^recidive$"`. '
        'Default: %(default)s',
        dest='IGNORE',
        action='append',
        default=None,
    )

    parser.add_argument(
        '--no-match-severity',
        help=lib.args.help('--no-match-severity') + ' Default: %(default)s',
        dest='NO_MATCH_SEVERITY',
        choices=['ok', 'warn', 'crit', 'unknown'],
        default=DEFAULT_NO_MATCH_SEVERITY,
    )

    parser.add_argument(
        '--no-perfdata',
        help=lib.args.help('--no-perfdata'),
        dest='NO_PERFDATA',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--socket',
        help='Path to the fail2ban server Unix socket. '
        'Passed to `fail2ban-client --socket`. '
        'Must resolve within /run or /var/run, and nobody but root may be able to '
        'replace it. '
        'Default: %(default)s',
        dest='SOCKET',
        default=None,
    )

    parser.add_argument(
        '--test',
        help=lib.args.help('--test'),
        dest='TEST',
        type=lib.args.csv,
    )

    parser.add_argument(
        '--timeout',
        help=lib.args.help('--timeout') + ' Default: %(default)s (seconds)',
        dest='TIMEOUT',
        type=int,
        default=DEFAULT_TIMEOUT,
    )

    parser.add_argument(
        '--trusted-ip',
        help='IP address or network that fail2ban must never ban, such as a reverse '
        'proxy in front of this host. '
        'Alerts with CRIT if a jail bans it. '
        'IPv4 or IPv6, a single address or a network in CIDR notation. '
        'Can be specified multiple times. '
        'Example: `--trusted-ip=192.0.2.10 --trusted-ip=2001:db8::/64`',
        dest='TRUSTED_IP',
        action='append',
        default=None,
    )

    parser.add_argument(
        '-w',
        '--warning',
        help='WARN threshold for the number of banned IPs per jail. '
        'Supports Nagios ranges. '
        'Default: %(default)s',
        dest='WARN',
        default=DEFAULT_WARN,
    )

    args, _ = parser.parse_known_args()
    return args


def run_client(cmd, args):
    """Run fail2ban-client and return `(stdout, stderr, retc)`. It waits for an
    unresponsive server for a long time of its own, so a hung server ends the check
    with a warning once `--timeout` has passed.
    """
    success, result = lib.shell.shell_exec(cmd, timeout=args.TIMEOUT)
    if not success and result.startswith('Timeout after'):
        lib.base.oao(
            f'Timeout after {args.TIMEOUT}s while running `{" ".join(cmd)}`.',
            STATE_WARN,
            always_ok=args.ALWAYS_OK,
        )
    return lib.base.coe((success, result))


def fixture_name(*parts):
    """Build the suffix of a `--test` fixture from a command, so a fixture name holds
    only characters every file system accepts.
    """
    return re.sub(r'[^A-Za-z0-9_.-]', '_', '-'.join(parts))


def run_command(cmd, args, fixture):
    """Run a command that reads the firewall and return `(success, stdout, stderr)`.

    Unlike `run_client()`, a command that is missing or fails does not end the check:
    it only means that the bans of this firewall cannot be verified.
    """
    if args.TEST is not None:
        stdout, stderr, retc = lib.lftest.test(
            [f'{args.TEST[0]}-{fixture}', f'{args.TEST[0]}-{fixture}-stderr', '']
        )
        if stderr.endswith(f'-{fixture}-stderr'):
            stderr = ''
        return retc == 0 and not stderr, stdout, stderr
    success, result = lib.shell.shell_exec(cmd, timeout=args.TIMEOUT)
    if not success:
        return False, '', result
    stdout, stderr, retc = result
    return retc == 0, stdout, stderr


def get_actions(client, args, jail):
    """Return the names of the actions of a jail."""
    if args.TEST is None:
        stdout, _stderr, retc = run_client([*client, 'get', jail, 'actions'], args)
    else:
        stdout, _stderr, retc = lib.lftest.test(
            [args.TEST[0] + '-' + fixture_name('actions', jail), '', '']
        )
    if retc != 0 or 'has the following actions:' not in stdout:
        return []
    actions = stdout.split('has the following actions:', 1)[1]
    return [action.strip() for action in actions.split(',') if action.strip()]


def get_action_property(client, args, jail, action, name, cache):
    """Return a property of an action as the fail2ban server resolved it, or None if
    the action has no such property.
    """
    key = (jail, action, name)
    if key not in cache:
        if args.TEST is None:
            stdout, _stderr, retc = run_client(
                [*client, 'get', jail, 'action', action, name], args
            )
        else:
            fixture = args.TEST[0] + '-' + fixture_name('get', jail, action, name)
            stdout, _stderr, retc = lib.lftest.test([fixture, '', ''])
            # a fixture that does not exist stands for a property that does not exist
            if stdout == fixture:
                retc = 1
        cache[key] = stdout.strip() if retc == 0 else None
    return cache[key]


def resolve_tags(client, args, jail, action, value, family, cache):
    """Replace the tags left in a value (`addr-set-<name>`) with the properties of the
    action, the IPv6 variant first for family 6, and return None if one stays unknown.
    """
    for _round in range(5):
        tags = [tag for tag in TAG_REGEX.findall(value) if tag != 'ip']
        if not tags:
            return value
        for tag in tags:
            resolved = None
            if family == 6:
                resolved = get_action_property(
                    client, args, jail, action, f'{tag}?family=inet6', cache
                )
            if resolved is None:
                resolved = get_action_property(client, args, jail, action, tag, cache)
            if resolved is None:
                return None
            value = value.replace(f'<{tag}>', resolved)
    return None


def get_ban_stores(client, args, jail, cache):
    """Return the firewall stores the actions of a jail put their bans into, as a list
    of `(action, family, kind, location)`, and the actions that put bans somewhere the
    check cannot read.
    """
    stores = []
    unverified = []
    for action in get_actions(client, args, jail):
        actionban = get_action_property(client, args, jail, action, 'actionban', cache)
        if not actionban:
            continue
        kind = None
        for candidate, regex in BAN_STORES:
            match = regex.search(actionban)
            if match:
                kind = candidate
                break
        if kind is None:
            unverified.append(action)
            continue
        for family in (4, 6):
            name = match.group('name') or ''
            if kind == 'firewalld' and not name:
                # firewallcmd-common.conf: zone = public
                name = 'public'
            name = resolve_tags(client, args, jail, action, name, family, cache)
            location = [name]
            if kind == 'nftables':
                location = [
                    resolve_tags(
                        client, args, jail, action, match.group(part), family, cache
                    )
                    for part in ('family', 'table')
                ] + location
            if not all(part and STORE_NAME_REGEX.match(part) for part in location):
                unverified.append(action)
                break
            stores.append((action, family, kind, tuple(location)))
    return stores, unverified


def to_network(value):
    """Return an address, a network or a range `a-b` of a firewall as a tuple of its
    first and last address, or None.
    """
    try:
        if isinstance(value, str) and '-' in value and '/' not in value:
            first, last = value.split('-', 1)
            return ipaddress.ip_address(first), ipaddress.ip_address(last)
        network = ipaddress.ip_network(value, strict=False)
    except ValueError:
        return None
    return network.network_address, network.broadcast_address


def parse_nft(stdout):
    """Return the elements of the sets of an `nft --json list table` as a dict."""
    sets = {}
    try:
        items = json.loads(stdout).get('nftables', [])
    except (ValueError, AttributeError):
        return sets
    for item in items:
        if not isinstance(item, dict) or 'set' not in item:
            continue
        elements = sets.setdefault(item['set'].get('name'), [])
        for elem in item['set'].get('elem', []):
            # an element with a timeout or a counter: {"elem": {"val": ..., ...}}
            if isinstance(elem, dict) and 'elem' in elem:
                elem = elem['elem'].get('val')
            if isinstance(elem, dict) and 'prefix' in elem:
                elem = f'{elem["prefix"].get("addr")}/{elem["prefix"].get("len")}'
            elif isinstance(elem, dict) and 'range' in elem:
                elem = '-'.join(str(part) for part in elem['range'])
            network = to_network(elem)
            if network:
                elements.append(network)
    return sets


def parse_iptables(stdout):
    """Return the source addresses of the rules of an `iptables-save` per chain."""
    chains = {}
    for match in re.finditer(r'^-A (\S+) -s (\S+) ', stdout, re.MULTILINE):
        network = to_network(match.group(2))
        if network:
            chains.setdefault(match.group(1), []).append(network)
    return chains


def parse_ipset(stdout):
    """Return the entries of an `ipset save` per set."""
    sets = {}
    for match in re.finditer(r'^add (\S+) (\S+)', stdout, re.MULTILINE):
        # hash:ip,port and the like: the address comes first
        network = to_network(match.group(2).split(',', 1)[0])
        if network:
            sets.setdefault(match.group(1), []).append(network)
    return sets


def parse_rich_rules(stdout):
    """Return the source addresses of the rich rules of a firewalld zone."""
    return [
        network
        for network in (
            to_network(address)
            for address in re.findall(r'source address="([^"]+)"', stdout)
        )
        if network
    ]


def read_store(args, store, readings):
    """Return the addresses a firewall store holds, or an error message. Every command
    runs once per check run, whatever number of jails reads from it.
    """
    _action, family, kind, location = store
    if kind == 'nftables':
        cmd = ['nft', '--json', 'list', 'table', location[0], location[1]]
    elif kind == 'iptables':
        cmd = [
            'iptables-save' if family == 4 else 'ip6tables-save',
            '--table',
            'filter',
        ]
    elif kind == 'ipset':
        cmd = ['ipset', 'save']
    else:
        cmd = ['firewall-cmd', f'--zone={location[0]}', '--list-rich-rules']
    key = tuple(cmd)
    if key not in readings:
        success, stdout, stderr = run_command(cmd, args, fixture_name(*cmd))
        if kind == 'nftables' and not success and 'No such file or directory' in stderr:
            # the table is gone, and with it every ban it held
            readings[key] = (True, {})
        elif not success:
            error = (stderr or stdout).strip().splitlines()
            readings[key] = (
                False,
                f'`{" ".join(cmd)}` failed: {error[0] if error else ""}',
            )
        elif kind == 'nftables':
            readings[key] = (True, parse_nft(stdout))
        elif kind == 'iptables':
            readings[key] = (True, parse_iptables(stdout))
        elif kind == 'ipset':
            readings[key] = (True, parse_ipset(stdout))
        else:
            readings[key] = (True, {location[0]: parse_rich_rules(stdout)})
    success, result = readings[key]
    if not success:
        return False, result
    return True, result.get(location[-1], [])


def describe_store(store):
    """Name the firewall store of an action in the words of its firewall."""
    action, _family, kind, location = store
    if kind == 'nftables':
        where = f'set {" ".join(location)}'
    elif kind == 'iptables':
        where = f'chain {location[0]}'
    elif kind == 'ipset':
        where = f'ipset {location[0]}'
    else:
        where = f'rich rules of firewalld zone {location[0]}'
    return f'{action}, {where}'


def find_missing(args, banned, stores, readings):
    """Return the banned addresses each store lacks, as a list of `(address, store)`,
    and the errors of the stores that could not be read.
    """
    missing = []
    errors = []
    for entry in banned:
        network = to_network(entry)
        if network is None:
            continue
        for store in stores:
            if store[1] != network[0].version:
                continue
            success, held = read_store(args, store, readings)
            if not success:
                errors.append(held)
                continue
            if not any(
                first.version == network[0].version
                and first <= network[0]
                and network[1] <= last
                for first, last in held
            ):
                missing.append((entry, store))
    return missing, errors


def get_banned(stdout):
    """Return the addresses `fail2ban-client status <jail>` lists as banned."""
    return lib.txt.extract_str(stdout, 'Banned IP list:', '\n').split()


def main():
    """The main function. This is where the magic happens."""

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)

    # Pad args.TEST to 3 elements so the per-command fixture
    # loads below that splice `args.TEST[1]` and `args.TEST[2]`
    # into custom lib.lftest.test() calls do not go out of range
    # when the user passes `--test=path` without trailing commas.
    if args.TEST is not None:
        while len(args.TEST) < 3:
            args.TEST.append('')

    # compile the ignore regexes early so an invalid pattern fails fast
    ignore_patterns = []
    if args.IGNORE:
        try:
            ignore_patterns = [re.compile(p) for p in args.IGNORE]
        except re.error as e:
            lib.base.cu(f'Invalid regular expression: {e}')

    # parse the trusted addresses early so an invalid one fails fast
    trusted_networks = []
    for value in args.TRUSTED_IP or []:
        try:
            network = ipaddress.ip_network(value.strip(), strict=False)
        except ValueError:
            network = None
        # outside the except block, so the message comes without a traceback
        if network is None:
            lib.base.cu(
                f'Invalid `--trusted-ip` "{value}": expected an IP address or a '
                'network in CIDR notation, for example `192.0.2.10` or `2001:db8::/64`.'
            )
        trusted_networks.append(network)

    # build the fail2ban-client command prefix, optionally pointing at a custom socket.
    # This plugin runs as root and fail2ban-client deserializes the reply it reads from
    # the socket, so a socket under an attacker-writable path is a root code-execution
    # primitive. Confine --socket to the system runtime directories, require that
    # nobody but root can replace it, and hand over the resolved path, so a symlink
    # swapped after the check changes nothing.
    client = ['fail2ban-client']
    if args.SOCKET:
        if not lib.disk.is_within(args.SOCKET, ALLOWED_SOCKET_ROOTS):
            lib.base.cu(
                f'Refusing to use socket "{args.SOCKET}": it resolves outside '
                f'{" and ".join(ALLOWED_SOCKET_ROOTS)}.'
            )
        success, result = lib.disk.resolve_trusted_path(args.SOCKET)
        if not success:
            lib.base.cu(result)
        # The first containment check looked at the path as it was named. What it
        # resolves to is what fail2ban-client connects to, so that has to lie in the
        # runtime directories as well.
        if not lib.disk.is_within(result, ALLOWED_SOCKET_ROOTS):
            lib.base.cu(
                f'Refusing to use socket "{args.SOCKET}": it resolves outside '
                f'{" and ".join(ALLOWED_SOCKET_ROOTS)}.'
            )
        client += ['--socket', result]

    # fetch data
    # fail2ban-client ping
    if args.TEST is None:
        stdout, _stderr, retc = run_client([*client, 'ping'], args)
    else:
        # do not call the command, put in test data
        stdout, _stderr, retc = lib.lftest.test(
            [args.TEST[0] + '-ping', args.TEST[1], args.TEST[2]]
        )
    if retc != 0:
        lib.base.cu('Problem while testing if the fail2ban server is alive.')

    # fail2ban-client status
    if args.TEST is None:
        stdout, _stderr, retc = run_client([*client, 'status'], args)
    else:
        # do not call the command, put in test data
        stdout, _stderr, retc = lib.lftest.test(
            [args.TEST[0] + '-status', args.TEST[1], args.TEST[2]]
        )
    if retc != 0:
        lib.base.cu('Problem while testing the status of the fail2ban server.')

    # extract the jail list
    jail_list = lib.txt.extract_str(stdout, 'Jail list:', '\n').strip()
    if not jail_list:
        lib.base.cu('No jails found.')
    jail_list = jail_list.split(', ')

    # init some vars
    perfdata = ''
    state = STATE_OK
    count = 0
    table_data = []
    trusted_banned = []
    banned_per_jail = {}
    property_cache = {}

    # analyze data
    #     for each jail_name:
    #         get status of jail_name
    for jail in jail_list:
        # skip jails matching one of the ignore regexes
        if any(pattern.search(jail) for pattern in ignore_patterns):
            continue

        if args.TEST is None:
            stdout, _stderr, retc = run_client([*client, 'status', jail], args)
        else:
            # do not call the command, put in test data
            stdout, _stderr, retc = lib.lftest.test(
                [args.TEST[0] + f'-status-{jail}', args.TEST[1], args.TEST[2]],
            )
        if retc != 0:
            lib.base.oao(
                f'Problem while testing the status of the jail "{jail}" on the fail2ban server.',
                STATE_UNKNOWN,
            )

        f2b_currently_banned = lib.txt.extract_str(stdout, 'Currently banned:\t', '\n')
        # important to convert the result to an integer for the comparison later on
        if f2b_currently_banned:
            f2b_currently_banned = int(f2b_currently_banned)
            count += f2b_currently_banned
        else:
            f2b_currently_banned = 0
        jail_state = lib.base.get_state(
            f2b_currently_banned, args.WARN, args.CRIT, _operator='range'
        )

        banned_per_jail[jail] = get_banned(stdout)

        # a banned address that has to stay reachable is critical, whatever the count
        if trusted_networks:
            for entry in banned_per_jail[jail]:
                try:
                    banned_ip = ipaddress.ip_address(entry)
                except ValueError:
                    continue
                if any(
                    banned_ip.version == network.version and banned_ip in network
                    for network in trusted_networks
                ):
                    trusted_banned.append((jail, str(banned_ip)))
                    jail_state = STATE_CRIT
        state = lib.base.get_worst(state, jail_state)

        table_data.append(
            {
                'jail': jail,
                'banned': f2b_currently_banned,
                'jail_state': jail_state,
            }
        )
        perfdata += lib.base.get_perfdata(
            jail,
            f2b_currently_banned,
            warn=args.WARN,
            crit=args.CRIT,
            _min=0,
        )

    # nothing left after applying the ignore filter
    if not table_data:
        lib.base.oao(
            'Nothing checked.',
            lib.base.str2state(args.NO_MATCH_SEVERITY),
            always_ok=args.ALWAYS_OK,
        )

    # compare the bans with the firewall, for the jails that ban anybody
    stores_per_jail = {}
    unverified_per_jail = {}
    for jail, banned in banned_per_jail.items():
        if banned:
            stores_per_jail[jail], unverified_per_jail[jail] = get_ban_stores(
                client, args, jail, property_cache
            )
    readings = {}
    missing_per_jail = {}
    errors_per_jail = {}
    for jail, stores in stores_per_jail.items():
        missing_per_jail[jail], errors_per_jail[jail] = find_missing(
            args, banned_per_jail[jail], stores, readings
        )
    # A ban fail2ban already lists may still be on its way into the firewall, and a
    # ban may have ended in between, so a missing ban only counts if it is missing
    # on a second look as well.
    if any(missing_per_jail.values()) and args.TEST is None:
        time.sleep(RECHECK_DELAY)
        readings = {}
        for jail, missing in missing_per_jail.items():
            if not missing:
                continue
            stdout, _stderr, retc = run_client([*client, 'status', jail], args)
            still_banned = get_banned(stdout) if retc == 0 else []
            again, _errors = find_missing(
                args, still_banned, stores_per_jail[jail], readings
            )
            missing_per_jail[jail] = [item for item in missing if item in again]
    read_errors = sorted(
        {error for errors in errors_per_jail.values() for error in errors}
    )
    # a ban is an address in a jail; an IPv4 and an IPv6 store of one action are two
    # places for the same kind of ban, so each banned address counts once per jail
    missing_count = sum(
        len({entry for entry, _store in missing})
        for missing in missing_per_jail.values()
    )
    for row in table_data:
        jail = row['jail']
        missing = len({entry for entry, _store in missing_per_jail.get(jail, [])})
        if not row['banned']:
            row['firewall'] = '-'
        elif missing or errors_per_jail.get(jail):
            row['firewall'] = f'{missing} missing' if missing else 'not readable'
            row['jail_state'] = lib.base.get_worst(row['jail_state'], STATE_WARN)
        elif not stores_per_jail.get(jail):
            row['firewall'] = 'not verified'
        else:
            row['firewall'] = 'ok'
        row['state'] = lib.base.state2str(row['jail_state'], empty_ok=False)
    if missing_count or read_errors:
        state = lib.base.get_worst(state, STATE_WARN)

    # build the message
    msg = f'{count} {lib.txt.pluralize("IP", count)} banned'
    sections = []
    if trusted_banned:
        trusted_count = len({banned_ip for _jail, banned_ip in trusted_banned})
        msg += (
            f', {trusted_count} trusted'
            f' {lib.txt.pluralize("address", trusted_count, "es")} among them'
            f' {lib.base.state2str(STATE_CRIT)}'
        )
        section = 'Trusted addresses banned:\n'
        for jail, banned_ip in sorted(trusted_banned):
            section += (
                f'* {banned_ip} in {jail}, lift the ban with'
                f' `sudo fail2ban-client set {jail} unbanip {banned_ip}`\n'
            )
        section += (
            '\nAdd the trusted addresses to `ignoreip` in fail2ban so they are not'
            ' banned again.'
        )
        sections.append(section)
    if missing_count:
        msg += (
            f', {missing_count} {lib.txt.pluralize("ban", missing_count)}'
            f' missing in the firewall {lib.base.state2str(STATE_WARN)}'
        )
        section = 'Bans missing in the firewall:\n'
        for jail in sorted(missing_per_jail):
            missing = missing_per_jail[jail]
            for entry, store in missing[:MAX_MISSING_LISTED]:
                section += f'* {entry} in {jail} ({describe_store(store)})\n'
            if len(missing) > MAX_MISSING_LISTED:
                section += f'* and {len(missing) - MAX_MISSING_LISTED} more in {jail}\n'
        section += (
            '\nfail2ban lists these addresses as banned, but the firewall does not block'
            ' them, typically because a firewall reload removed the rules of fail2ban,'
            ' or because the ban action failed (see the fail2ban log). Restart fail2ban'
            ' to set the bans again: `sudo systemctl restart fail2ban`.'
        )
        sections.append(section)
    if read_errors:
        section = 'The bans could not be compared with the firewall:\n'
        section += '\n'.join(
            f'* {error} {lib.base.state2str(STATE_WARN)}' for error in read_errors
        )
        sections.append(section)
    for section in sections:
        msg += f'\n\n{section.rstrip()}'
    msg += '\n\n'
    msg += lib.base.get_table(
        table_data,
        ['jail', 'banned', 'firewall', 'state'],
        header=['Jail', 'Banned', 'Firewall', 'Status'],
        sort_by_key='banned',
        sort_order_reverse=True,
    )

    # over and out
    lib.base.oao(
        msg, state, perfdata, always_ok=args.ALWAYS_OK, no_perfdata=args.NO_PERFDATA
    )


if __name__ == '__main__':
    try:
        main()
    except Exception:
        lib.base.cu()
