import os
import shutil
import socket
import subprocess
import sys
import tempfile

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

# fail2ban's `--test` argument takes a base path and the plugin looks up
# `<base>-ping`, `<base>-status`, and `<base>-status-<jail>` next to each
# other in stdout/.
TESTS = [
    {
        'id': 'unknown-fail2ban-client-ping-failed',
        'test': 'stdout/sshd-over-threshold,,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Problem while testing if the fail2ban server is alive.'],
    },
    {
        'id': 'warn-sshd-jail-over-threshold',
        'test': 'stdout/sshd-over-threshold,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '5434 IPs banned',
            'apache-dos',
            'portscan',
            'sshd',
        ],
        'assert-regex': r'sshd\s.*5432.*\[WARNING\]',
    },
    {
        'id': 'warn-ignore-sshd-drops-to-ok',
        'test': 'stdout/sshd-over-threshold,,0',
        'params': '--ignore="^sshd$"',
        'assert-retc': STATE_OK,
        'assert-in': ['2 IPs banned'],
        'assert-not-in': ['sshd', '5432'],
    },
    {
        'id': 'ok-ignore-everything-nothing-checked',
        'test': 'stdout/all-jails-empty,,0',
        'params': '--ignore=".*"',
        'assert-retc': STATE_OK,
        'assert-in': ['Nothing checked.'],
    },
    {
        # #1308: when the ignore filter drops every jail, --no-match-severity
        # turns the otherwise-OK "Nothing checked." into the configured state.
        'id': 'warn-no-match-severity-maps-empty-to-warn',
        'test': 'stdout/all-jails-empty,,0',
        'params': '--ignore=".*" --no-match-severity=warn',
        'assert-retc': STATE_WARN,
        'assert-in': ['Nothing checked.'],
    },
    {
        'id': 'unknown-no-match-severity-maps-empty-to-unknown',
        'test': 'stdout/all-jails-empty,,0',
        'params': '--ignore=".*" --no-match-severity=unknown',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Nothing checked.'],
    },
    {
        'id': 'unknown-invalid-ignore-regex',
        'test': 'stdout/all-jails-empty,,0',
        'params': '--ignore="["',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Invalid regular expression'],
    },
    {
        'id': 'ok-all-jails-empty',
        'test': 'stdout/all-jails-empty,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            '0 IPs banned',
            'apache-dos',
            'portscan',
            'sshd',
            '[OK]',
        ],
    },
    {
        'id': 'unknown-no-jails-configured',
        'test': 'stdout/no-jails-configured,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['No jails found.'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../fail2ban'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestSecurity(unittest.TestCase):
    """This check runs as root and fail2ban-client deserializes the reply it
    reads from its socket, so --socket must name a socket nobody but root can
    replace, and reject a path an unprivileged user could write to.
    """

    check = '../fail2ban'

    def test_unknown_socket_outside_run_is_refused(self):
        with tempfile.TemporaryDirectory() as base:
            evil = os.path.join(base, 'evil.sock')
            result = subprocess.run(
                [sys.executable, self.check, f'--socket={evil}'],
                capture_output=True,
                text=True,
            )
        self.assertEqual(result.returncode, STATE_UNKNOWN)
        self.assertIn('Refusing to use socket', result.stdout)

    def test_socket_in_a_run_directory_of_another_account_is_refused(self):
        # A directory below /run is not trusted because of its prefix: the
        # monitoring user owns one on every host that runs an Icinga agent
        # (/run/icinga2), and /run/user/<uid> exists for every session. A socket
        # planted there would feed the root process a reply of their choosing.
        run_dir = f'/run/user/{os.getuid()}'
        if os.getuid() == 0 or not os.path.isdir(run_dir):
            self.skipTest(f'{run_dir} does not exist for the test user')
        base = tempfile.mkdtemp(prefix='lftest-socket-', dir=run_dir)
        path = os.path.join(base, 'planted.sock')
        server = socket.socket(socket.AF_UNIX)
        try:
            server.bind(path)
            server.listen(1)
            try:
                result = subprocess.run(
                    [sys.executable, self.check, f'--socket={path}'],
                    capture_output=True,
                    text=True,
                    timeout=20,
                )
            except subprocess.TimeoutExpired:
                self.fail('the check connected to the planted socket and hung')
        finally:
            server.close()
            shutil.rmtree(base, ignore_errors=True)
        self.assertEqual(result.returncode, STATE_UNKNOWN)
        self.assertIn('Refusing', result.stdout)


if __name__ == '__main__':
    unittest.main()
