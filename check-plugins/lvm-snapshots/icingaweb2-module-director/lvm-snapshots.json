    "Datafield": {
        "1": {
            "varname": "lvm_snapshots_always_ok",
            "caption": "Lvm Snapshots: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "9154a2d0-cec8-474d-b801-dfdc67e968c2"
        },
        "2": {
            "varname": "lvm_snapshots_brief",
            "caption": "Lvm Snapshots: Brief?",
            "description": "Hide the rows that are within the thresholds and show only those in a WARN or CRIT state. Perfdata and alerting are unaffected: every item still emits performance data and still drives the overall check state, so this is safe to leave on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "77e60243-0cb0-4726-ab0b-042c659231e7"
        },
        "3": {
            "varname": "lvm_snapshots_critical",
            "caption": "Lvm Snapshots: Critical",
            "description": "CRIT threshold for how full the store of a classic snapshot is, in percent. Does not apply to thin snapshots, which have no store of their own. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c8be7668-cf3d-4e1d-bd7c-1c8b5683c059"
        },
        "4": {
            "varname": "lvm_snapshots_critical_age",
            "caption": "Lvm Snapshots: Critical Age",
            "description": "CRIT threshold for the age of a snapshot. A snapshot is meant to live for as long as something reads from it, and one that outlives its purpose keeps collecting the writes of its origin until its store is full. A duration such as `12h`, `8D` or `2W`; `0D` disables the age check. Example: `--critical-age=7D` alerts on a snapshot that has been around for a week.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "096a7467-00ba-45bf-8d6c-2efef80f0b7e"
        },
        "5": {
            "varname": "lvm_snapshots_ignore",
            "caption": "Lvm Snapshots: Ignore",
            "description": "Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "54693780-3f0e-48ba-b6ab-efa81b97d1d7"
        },
        "6": {
            "varname": "lvm_snapshots_match",
            "caption": "Lvm Snapshots: Match",
            "description": "Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead).",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f619d532-a4da-49aa-a7d0-27f350e9a351"
        },
        "7": {
            "varname": "lvm_snapshots_no_match_severity",
            "caption": "Lvm Snapshots: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "lvm_snapshots_no_match_severity_list"
            },
            "uuid": "243abd60-780e-4ff8-aef8-f08b5850f472"
        },
        "8": {
            "varname": "lvm_snapshots_no_perfdata",
            "caption": "Lvm Snapshots: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "15624542-ac71-421a-8c9d-fd9421c833a7"
        },
        "9": {
            "varname": "lvm_snapshots_timeout",
            "caption": "Lvm Snapshots: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "acb544e5-d128-440e-b692-35eaa50ff7e8"
        },
        "10": {
            "varname": "lvm_snapshots_warning",
            "caption": "Lvm Snapshots: Warning",
            "description": "WARN threshold for how full the store of a classic snapshot is, in percent. Does not apply to thin snapshots, which have no store of their own. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0f761a05-dfc3-4c01-b60f-42f2f0c499dc"
        },
        "11": {
            "varname": "lvm_snapshots_warning_age",
            "caption": "Lvm Snapshots: Warning Age",
            "description": "WARN threshold for the age of a snapshot. A snapshot is meant to live for as long as something reads from it, and one that outlives its purpose keeps collecting the writes of its origin until its store is full. A duration such as `12h`, `8D` or `2W`; `0D` disables the age check. Example: `--warning-age=2D` alerts on a snapshot that outlived the nightly job that took it.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "3bea9bb0-f437-4981-8739-8aa282c4e16f"
        }
