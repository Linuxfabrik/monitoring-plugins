import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

TESTS = [
    {
        # captured from `journalctl --disk-usage` as an account outside the systemd-journal
        # group, systemd 249 on openSUSE Leap 15.5
        'id': 'unknown-not-allowed-to-read-the-journal',
        'test': ',stderr/insufficient-permissions,1',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Not allowed to read the systemd journal. Run this plugin as root or via'
            ' sudo, or add the account running it to the `systemd-journal` group.'
        ],
        'assert-not-in': ['Hint:', 'failed (exit'],
    },
    {
        # captured from `journalctl --disk-usage` as an account outside the adm and
        # systemd-journal groups, systemd 252 on Debian 12: exit 0, the user's own
        # journal only, and a hint on stderr
        'id': 'unknown-only-part-of-the-journal-readable',
        'test': 'stdout/eight-mib-used,stderr/partial-access,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Not allowed to read the whole systemd journal, only the part that belongs'
            ' to the account running this plugin.'
        ],
        'assert-not-in': ['Hint:', '8.0MiB'],
    },
    {
        'id': 'warn-seven-gib-used',
        'test': 'stdout/seven-gib-used,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            '7.0GiB used [WARNING] (sum of all archived and active journal files; SystemMaxUse=4G SystemKeepFree=1M)',
        ],
    },
    {
        'id': 'ok-seven-gib-below-a-higher-warning',
        'test': 'stdout/seven-gib-used,,0',
        'params': '--warning=8',
        'assert-retc': STATE_OK,
        'assert-in': ["'journald-usage'=7516192768B;8589934592;;0"],
    },
    {
        # every bound of the range is a number of GiB, fractions included
        'id': 'warn-seven-gib-above-a-fractional-warning',
        'test': 'stdout/seven-gib-used,,0',
        'params': '--warning=6.5',
        'assert-retc': STATE_WARN,
        'assert-in': ["'journald-usage'=7516192768B;6979321856;;0"],
    },
    {
        'id': 'warn-seven-gib-inside-an-inverted-range',
        'test': 'stdout/seven-gib-used,,0',
        'params': '--warning=@6:8',
        'assert-retc': STATE_WARN,
        'assert-in': ["'journald-usage'=7516192768B;@6442450944:8589934592;;0"],
    },
    {
        'id': 'ok-three-kib-used',
        'test': 'stdout/three-kib-used,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            '3.2KiB used (sum of all archived and active journal files; SystemMaxUse=4G SystemKeepFree=1M)',
        ],
    },
    {
        'id': 'ok-twentysix-mib-used',
        'test': 'stdout/twentysix-mib-used,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            '26.6MiB used (sum of all archived and active journal files; SystemMaxUse=4G SystemKeepFree=1M)',
        ],
    },
    {
        'id': 'ok-zero-used',
        'test': 'stdout/zero-used,,0',
        'assert-retc': STATE_OK,
        'assert-in': [
            '0.0B used (sum of all archived and active journal files; SystemMaxUse=4G SystemKeepFree=1M)',
        ],
    },
]


class TestCheck(unittest.TestCase):
    check = '../journald-usage'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
