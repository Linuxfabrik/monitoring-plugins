import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

# The fixtures are `valkey-cli info default` from the official valkey/valkey:8.1
# image, started without a configuration file and later with `requirepass`. The
# kernel settings (overcommit, transparent huge pages, somaxconn) are read from the
# host running the test, so only the testcase that ignores them pins OK.
TESTS = [
    {
        'id': 'warn-valkey-8.1-standalone-maxmemory-unlimited',
        'test': 'stdout/valkey-8.1-standalone,,0',
        'assert-retc': STATE_WARN,
        'assert-in': [
            'Valkey v8.1.10 (based on Redis v7.2.4), standalone mode on 127.0.0.1:6379,'
            ' up 3s',
            'unlimited memory usage enabled [WARNING]',
            'hit rate 0% (0 hits, 0 misses)',
        ],
        'assert-not-in': [', ,'],
    },
    {
        'id': 'ok-valkey-8.1-standalone-ignore-all',
        'test': 'stdout/valkey-8.1-standalone,,0',
        'params': (
            '--warning=100 --critical=100 --ignore-maxmemory0 --ignore-overcommit '
            '--ignore-somaxconn --ignore-sync-partial-err --ignore-thp'
        ),
        'assert-retc': STATE_OK,
        'assert-in': [
            'unlimited memory usage enabled,',
            "'clients_connected_clients'=1.0;;;0",
        ],
        'assert-not-in': ['[WARNING]'],
    },
    {
        'id': 'unknown-valkey-8.1-noauth',
        'test': 'stdout/valkey-8.1-noauth,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Failed to authenticate: Valkey requires a password.',
            '`--password`',
        ],
    },
    {
        'id': 'unknown-valkey-8.1-wrongpass',
        'test': 'stdout/valkey-8.1-noauth,stderr/valkey-8.1-wrongpass,0',
        'params': '--password=linuxfabrik',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Failed to authenticate: Valkey rejected the username or password.',
        ],
        'assert-not-in': ['linuxfabrik'],
    },
    {
        'id': 'unknown-valkey-8.1-wrongpass-acl-user',
        'test': 'stdout/valkey-8.1-noauth,stderr/valkey-8.1-wrongpass,0',
        'params': '--username=monitor --password=linuxfabrik --timeout=3',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': [
            'Failed to authenticate: Valkey rejected the username or password.',
        ],
        'assert-not-in': ['linuxfabrik'],
    },
    # --verbose: the result stays the first line, the INFO answer follows it,
    # without the carriage returns of the protocol (this fixture keeps them).
    {
        'id': 'parses-valkey-8.1-verbose-follows-result',
        'test': 'stdout/valkey-8.1-standalone,,0',
        'params': '--verbose',
        'assert-regex': r'^Valkey v8\.1\.[^\n]*\n\n# Server\nredis_version:',
        'assert-not-in': ['\r', '\n\n\n'],
    },
    {
        'id': 'parses-valkey-8.1-perfdata',
        'test': 'stdout/valkey-8.1-standalone,,0',
        'assert-in': ["'persistence_rdb_current_bgsave_time_sec'=0s;;;0"],
        'assert-not-in': [
            'persistance',
            'stats_instantaneous',
            '_in_progress',
            'persistence_loading',
            "'stats_rejected_connections'",
            "'stats_sync_full'",
        ],
    },
    {
        'id': 'parses-valkey-8.1-two-dbs',
        'test': 'stdout/valkey-8.1-two-dbs,,0',
        'assert-in': [
            '2 DBs (db0 db1) with 200 keys',
            "'keyspace_db0_expires'=100;;;0",
            "'keyspace_db1_keys'=100;;;0",
        ],
    },
]


class TestCheck(unittest.TestCase):
    check = '../valkey-status'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
