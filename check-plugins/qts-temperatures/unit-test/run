    {
        'id': 'crit-sys-above-crit',
        'test': 'stdout/ts-451-sys-72-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_CRIT,
        'assert-in': [
            'Sys: 72°C (Thresholds: 60/70°C) [CRITICAL]',
        ],
    },
]


class TestCheck(unittest.TestCase):
    check = '../qts-temperatures'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
