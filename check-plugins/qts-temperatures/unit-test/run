        'assert-retc': STATE_OK,
        'assert-in': [
            'Sys: 0°C (Thresholds: 60/70°C), CPU: 0°C (Thresholds: 80/85°C)',
        ],
    },
    {
        'id': 'ok-qutscloud-c5-2-4-3041',
        'test': 'stdout/qutscloud-c5-2-4-3041-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Sys: 0°C (Thresholds: 60/70°C), CPU: 0°C (Thresholds: 80/85°C)',
        ],
    },
    {
        'id': 'ok-qutscloud-c5-2-9-3468',
        'test': 'stdout/qutscloud-c5-2-9-3468-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Sys: 0°C (Thresholds: 60/70°C), CPU: 0°C (Thresholds: 80/85°C)',
        ],
    },
    {
        'id': 'ok-ts-1677xu-rp-4-5-2',
        'test': 'stdout/qnapstats-ts-1677xu-rp-4-5-2-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Sys: 33°C (Thresholds: 60/70°C), CPU: 59°C (Thresholds: 75/80°C)',
        ],
    },
    {
        # no CPU temperature on this model
        'id': 'ok-ts-410-without-cpu-sensor',
        'test': 'stdout/qnapstats-ts-410-4-2-3-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            "Sys: 40°C (Thresholds: 57/70°C)|'systemp'=40;57;70;0\n",
        ],
    },
    {
        'id': 'ok-ts-451-4-2-2',
