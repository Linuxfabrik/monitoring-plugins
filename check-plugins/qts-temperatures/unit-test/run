import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_WARN

# Where the fixtures come from:
#
# * `qutscloud-*` are captured answers of QuTScloud c4.5.7.1864, c5.0.1.1949,
#   c5.1.0.2498, c5.2.4.3041 and c5.2.9.3468 on KVM, with IP, MAC and hostname
#   replaced by documentation values. QuTScloud has no sensors and reports its
#   temperatures as 0.
# * `qnapstats-*` are captured answers of real appliances, copied verbatim from
#   python-qnapstats (tests/responses, MIT License, Copyright (c) 2017 Colin O'Dell).
# * `ts-451-cpu-82-*` and `ts-451-sys-72-*` are the TS-451 answer with only the CPU
#   or the system temperature raised.
TESTS = [
    {
        'id': 'ok-qutscloud-c4-5-7-1864',
        'test': 'stdout/qutscloud-c4-5-7-1864-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Sys: 0°C (Thresholds: 60/70°C), CPU: 0°C (Thresholds: 80/85°C)',
        ],
    },
    {
        'id': 'ok-qutscloud-c5-0-1-1949',
        'test': 'stdout/qutscloud-c5-0-1-1949-sysinfo,,0',
        'params': '--password=linuxfabrik --url=https://qnap.example.com',
        'assert-retc': STATE_OK,
        'assert-in': [
            'Sys: 0°C (Thresholds: 60/70°C), CPU: 0°C (Thresholds: 80/85°C)',
        ],
    },
    {
        'id': 'ok-qutscloud-c5-1-0-2498',
        'test': 'stdout/qutscloud-c5-1-0-2498-sysinfo,,0',
