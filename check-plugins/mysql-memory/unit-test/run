# https://github.com/Linuxfabrik/monitoring-plugins/blob/main/CONTRIBUTING.md

"""Integration tests for the mysql-memory check plugin.

The plugin opens a real `pymysql` connection and reads buffer and
cache sizes from `SHOW VARIABLES` / `SHOW STATUS`, calculates the
worst-case memory footprint, and measures the RSS of the server
processes on the host. A static fixture cannot drive it - we spin up
an actual MariaDB server and let the plugin talk to it over TCP.

The thresholds on the measured RSS, and that the calculated worst case
does not alert, are driven by running the plugin through a small
wrapper that fakes the host's RAM and the processes' RSS.

Per CONTRIBUTING's "Combine container tests with fixtures" rule,
this file holds only the happy-path integration test. A freshly
booted, idle MariaDB with default buffer settings requests well
under the plugin's memory thresholds, which is STATE_OK.

The server runs with a 1 GiB `max_allowed_packet`, which must not
show up in the per-connection buffers, and with the Performance
Schema on, whose real footprint (several MiB, not a row size of a
few bytes) must be counted.

The test matrix is defined by the Containerfiles under
`containerfiles/`. Each file is a Containerfile (typically a
one-line `FROM`) and gets built once via testcontainers'
DockerImage (cached across runs). Add a new MariaDB LTS by
dropping in a new Containerfile; retire one by deleting the file.

Requirements:
- podman (or docker) with a reachable socket
- `pip install testcontainers`
- `tools/run-unit-tests` auto-sets `CONTAINER_HOST` and
  `TESTCONTAINERS_RYUK_DISABLED`
"""

import os
import re
import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import sys
import unittest

sys.path.insert(0, '..')

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
CONTAINERFILES_DIR = os.path.join(HERE, 'containerfiles')
CONTAINERFILES = sorted(
    name
    for name in os.listdir(CONTAINERFILES_DIR)
    if os.path.isfile(os.path.join(CONTAINERFILES_DIR, name))
)


# Runs the plugin with a fake host: `argv[1]` MiB of RAM, a `mariadbd`
# process with `argv[2]` MiB of RSS and one other process with 1 GiB.
WRAPPER = """
import os, runpy, sys, types
import psutil

sys.path.insert(0, '..')

ram_mib = int(sys.argv.pop(1))
db_mib = int(sys.argv.pop(1))
_sysconf = os.sysconf
os.sysconf = lambda name: (
    1048576 if name == 'SC_PAGE_SIZE' else ram_mib if name == 'SC_PHYS_PAGES'
    else _sysconf(name)
)


def proc(name, mib):
    return types.SimpleNamespace(
        info={'name': name, 'memory_info': types.SimpleNamespace(rss=mib * 1048576)}
    )


psutil.process_iter = lambda attrs=None: [proc('mariadbd', db_mib), proc('app', 1024)]
runpy.run_path('../mysql-memory', run_name='__main__')
"""


class TestCheck(unittest.TestCase):
    pass


def _check_image(test, containerfile):
    lib.lftest.require_container_runtime()
    path = os.path.join(CONTAINERFILES_DIR, containerfile)
    print(f'\n=== Testing {containerfile} ===', flush=True)
    # The plugin calculates the possible memory peak as
    # `server_buffers + per_thread_buffers * max_connections`. On
    # sclorg images the per-thread buffers are large enough that
    # max_connections=151 (the default) pushes the peak over 30 GiB,
    # which WARNs on any host with typical RAM. Pinning max_connections
    # to 5 removes the host-RAM dependency so the test is deterministic
    # across machines.
    with lib.lftest.run_mysql_compatible_from_containerfile(
        path,
        extra_args=(
            '--max-connections=5'
            ' --max-allowed-packet=1073741824'
            ' --performance-schema=ON'
        ),
    ) as (container, defaults_file):
        # `SHOW ENGINE PERFORMANCE_SCHEMA STATUS` needs PROCESS, as documented
        # for the shared monitoring user. lib.lftest only grants SELECT.
        container.exec(
            [
                'sh',
                '-c',
                'if command -v mariadb >/dev/null 2>&1; then C=mariadb; '
                'else C=mysql; fi; '
                'GRANTS="GRANT PROCESS ON *.* TO '
                "'test'@'%'"
                '"; '
                '"$C" -uroot -e "$GRANTS" 2>/dev/null '
                '|| "$C" -uroot -ptest -e "$GRANTS"',
            ]
        )
        cmd = [
            'python3',
            '../mysql-memory',
            f'--defaults-file={defaults_file}',
        ]
        print(f'Run plugin: {" ".join(cmd)}', flush=True)
        result = subprocess.run(  # nosec B603 - argv list, no shell
            cmd,
            cwd=os.path.dirname(os.path.abspath(__file__)),
            capture_output=True,
            text=True,
        )
        combined = result.stdout + result.stderr
        print(f'Script output:\n{combined.strip()}', flush=True)

        test.assertEqual(result.returncode, STATE_OK)
        test.assertIn("|'mysql_", combined)

        def perfdata(name):
            match = re.search(rf"'{name}'=(\d+)", combined)
            test.assertIsNotNone(match, name)
            return int(match.group(1))

        # The 1 GiB `max_allowed_packet` is no per-connection buffer.
        test.assertEqual(perfdata('mysql_max_allowed_packet'), 1024**3)
        test.assertLess(perfdata('mysql_per_thread_buffers'), 512 * 1024**2)
        # The Performance Schema footprint, not a row size.
        test.assertGreater(perfdata('mysql_pf_memory'), 1024**2)

        # The RSS of the container's server process, seen from the host.
        test.assertGreater(perfdata('mysql_rss'), 1024**2)

        def run_wrapped(ram_mib, db_mib, *extra, wrapper=WRAPPER):
            res = subprocess.run(  # nosec B603, B607 - test tool from PATH; argv list, no shell
                ['python3', '-c', wrapper, str(ram_mib), str(db_mib), *cmd[2:], *extra],
                cwd=os.path.dirname(os.path.abspath(__file__)),
                capture_output=True,
                text=True,
            )
            out = res.stdout + res.stderr
            print(
                f'Script output (RAM {ram_mib} MiB, server {db_mib} MiB):\n'
                f'{out.strip()}',
                flush=True,
            )
            return res.returncode, out

        # Thresholds apply to the measured RSS: 25%, 90% and 97.5% of 4 GiB.
        retc, out = run_wrapped(4096, 1024)
        test.assertEqual(retc, STATE_OK)
        test.assertNotIn('Recommendations', out)
        retc, out = run_wrapped(4096, 3686)
        test.assertEqual(retc, STATE_WARN)
        test.assertIn('innodb_buffer_pool_size', out)
        retc, out = run_wrapped(4096, 3994)
        test.assertEqual(retc, STATE_CRIT)

        # The calculated worst case is far above 100% of 64 MiB RAM, but it
        # is only reported. --lengthy adds its breakdown.
        retc, out = run_wrapped(64, 1, '--lengthy')
        test.assertEqual(retc, STATE_OK)
        test.assertRegex(out, r'Calculated worst case: \S+ \(\d{3,}\.\d% of RAM\)')
        test.assertIn('Total (max_peak_memory)', out)

        # Without a server process on the host the check cannot measure.
        retc, out = run_wrapped(
            4096, 0, wrapper=WRAPPER.replace("proc('mariadbd', db_mib), ", '')
        )
        test.assertEqual(retc, STATE_UNKNOWN)
        test.assertIn('No `mysqld` or `mariadbd` process', out)


lib.lftest.attach_each(TestCheck, CONTAINERFILES, _check_image)


if __name__ == '__main__':
    unittest.main()
