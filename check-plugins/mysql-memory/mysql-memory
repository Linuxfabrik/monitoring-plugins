import argparse
import os
import sys

import lib.args
import lib.base
import lib.db_mysql
import lib.human
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

try:
    import psutil
except ImportError:
    print('Python module "psutil" is not installed.')
    sys.exit(STATE_UNKNOWN)


__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026111302'

DESCRIPTION = """Measures the memory (RSS) of the MySQL/MariaDB server processes on the
host and compares it to the physical RAM. Also calculates the worst case from the configured
buffer sizes (server-wide buffers + per-connection buffers * `max_connections` + Performance
Schema memory), in which every connection fills all its buffers at once. The server allocates
none of these buffers in advance, a connection takes memory only while a query needs it, so
the worst case is reported, but does not alert. Alerts when the measured memory crosses
`--warning` / `--critical`, and when MySQL would allocate more than 2 GiB on a 32-bit system.
Supports extended reporting via --lengthy."""

DEFAULT_DEFAULTS_FILE = '/var/spool/icinga2/.my.cnf'
DEFAULT_DEFAULTS_GROUP = 'client'
DEFAULT_TIMEOUT = 3
# % of physical RAM at which the measured RSS of the server processes turns
# WARN / CRIT. MySQLTuner uses 85% for its calculated footprint.
DEFAULT_WARN = '85'
DEFAULT_CRIT = '95'

# MySQL/MariaDB allocates each buffer from the 32-bit address space (~4 GiB
# practical limit; mysqltuner uses 2 GiB as the conservative threshold). On a
# 32-bit binary, anything above that risks instability.
ADDR_LIMIT_32BIT = 2 * 1024 * 1024 * 1024


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=lib.args.epilog(__file__),
        formatter_class=lib.args.HelpFormatter,
    )

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--always-ok',
        help=lib.args.help('--always-ok'),
        dest='ALWAYS_OK',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '-c',
        '--critical',
        help='CRIT threshold for the percentage of physical RAM used by the '
        'MySQL/MariaDB server processes (RSS). '
        'Supports Nagios ranges. '
        'Default: %(default)s',
        dest='CRITICAL',
        default=DEFAULT_CRIT,
    )

    parser.add_argument(
        '--defaults-file',
        help='MySQL/MariaDB cnf file to read user, host and password from. '
        'Example: `--defaults-file=/var/spool/icinga2/.my.cnf`. '
        'Default: %(default)s',
        dest='DEFAULTS_FILE',
        default=DEFAULT_DEFAULTS_FILE,
    )

    parser.add_argument(
        '--defaults-group',
        help=lib.args.help('--defaults-group') + ' Default: %(default)s',
        dest='DEFAULTS_GROUP',
        default=DEFAULT_DEFAULTS_GROUP,
    )

    parser.add_argument(
        '--lengthy',
        help='Append the breakdown of the calculated worst case to the output, '
        'every buffer with its share, largest first.',
        dest='LENGTHY',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--no-perfdata',
        help=lib.args.help('--no-perfdata'),
        dest='NO_PERFDATA',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--timeout',
        help=lib.args.help('--timeout') + ' Default: %(default)s (seconds)',
        dest='TIMEOUT',
        type=int,
        default=DEFAULT_TIMEOUT,
    )

    parser.add_argument(
        '-w',
        '--warning',
        help='WARN threshold for the percentage of physical RAM used by the '
        'MySQL/MariaDB server processes (RSS). '
        'Supports Nagios ranges. '
        'Default: %(default)s',
        dest='WARNING',
        default=DEFAULT_WARN,
    )

    args, _ = parser.parse_known_args()
    return args


def get_vars(conn):
    # Pull only the variables we actually need rather than implementing a
    # full `get_all_vars()`. SHOW VARIABLES without GLOBAL is connection-local
    # but we only read session-shared knobs here.
    sql = """
        show global variables
        where variable_name like 'aria_pagecache_buffer_size'
            or variable_name like 'binlog_cache_size'
            or variable_name like 'innodb_additional_mem_pool_size'
            or variable_name like 'innodb_buffer_pool_size'
            or variable_name like 'innodb_log_buffer_size'
            or variable_name like 'internal_tmp_mem_storage_engine'
            or variable_name like 'join_buffer_size'
            or variable_name like 'join_buffer_space_limit'
            or variable_name like 'key_buffer_size'
            or variable_name like 'log_bin'
            or variable_name like 'max_allowed_packet'
            or variable_name like 'max_connections'
            or variable_name like 'max_heap_table_size'
            or variable_name like 'optimizer_switch'
            or variable_name like 'performance_schema'
            or variable_name like 'query_cache_size'
            or variable_name like 'read_buffer_size'
            or variable_name like 'read_rnd_buffer_size'
            or variable_name like 'sort_buffer_size'
            or variable_name like 'temptable_max_ram'
            or variable_name like 'thread_stack'
            or variable_name like 'tmp_table_size'
            or variable_name like 'version'
            ;
          """
    return lib.base.coe(lib.db_mysql.select(conn, sql))


def get_status(conn):
    sql = """
        show global status
        where variable_name like 'Max_used_connections'
            ;
          """
    return lib.base.coe(lib.db_mysql.select(conn, sql))


def get_pf_memory(conn, myvar):
    """Return Performance Schema memory usage in bytes, or 0 when PFS is
    OFF / unavailable. PFS reports its own footprint as the
    `performance_schema.memory` row of `SHOW ENGINE PERFORMANCE_SCHEMA
    STATUS`, always the last row and the sum of all `*.memory` rows. The
    name has to match exactly: rows such as
    `memory_summary_by_thread_by_event_name.row_size` come first and hold a
    row size, not memory. Verified against the MariaDB 13.0 and MySQL 26.7
    sources (`storage/perfschema/pfs_engine_table.cc` and
    `storage/perfschema/ha_perfschema.cc`). MySQL requires the
    `PROCESS` privilege for `SHOW ENGINE`; without it the query fails
    with a 1227 access-denied error. The monitoring user usually only
    has `SELECT`, so we treat that as a soft skip and report PFS
    memory as 0 rather than UNKNOWN-ing the whole plugin.
    """
    if myvar.get('performance_schema', 'OFF') != 'ON':
        return 0
    sql = 'show engine performance_schema status;'
    success, rows = lib.db_mysql.select(conn, sql)
    if not success:
        return 0
    for item in rows or []:
        if (
            item['Type'] == 'performance_schema'
            and item['Name'] == 'performance_schema.memory'
        ):
            return int(item['Status'])
    return 0


def get_process_memory():
    """Return `(found, db_rss, other_rss)`: whether a MySQL/MariaDB server
    process runs on this host, the summed RSS of all `mysqld` / `mariadbd`
    processes, and the summed RSS of all other processes, in bytes.
    """
    db_names = {'mariadbd', 'mysqld'}
    found = False
    db_rss = 0
    other_rss = 0
    # With `attrs`, psutil skips processes that vanish meanwhile and sets
    # `memory_info` to None where access is denied.
    for proc in psutil.process_iter(attrs=['name', 'memory_info']):
        mem = proc.info.get('memory_info')
        if mem is None:
            continue
        if (proc.info.get('name') or '') in db_names:
            found = True
            db_rss += mem.rss
        else:
            other_rss += mem.rss
    return found, db_rss, other_rss


def build_contributions(myvar, mycalc):
    """Return a list of `(factor, total, label)` tuples describing every
    knob's contribution to `max_peak_memory`, largest first. `factor` is
    `'<size> * <connections> ='` for a per-connection buffer and empty for a
    server-wide one. Buffers of size 0 are left out.
    """
    bh = lib.human.bytes2human
    max_conn = int(myvar['max_connections'])

    def per_thread(label, size, total=None):
        return (
            f'{bh(size)} * {max_conn} =',
            size * max_conn if total is None else total,
            label,
        )

    tmp_label = (
        'max_tmp_table_size * max_connections'
        ' (min of tmp_table_size and max_heap_table_size)'
    )
    if mycalc['temptable_max_ram'] is not None:
        tmp_label += (
            f', capped at temptable_max_ram ({bh(mycalc["temptable_max_ram"])})'
        )
    join_buffer_size = int(myvar['join_buffer_size'])
    if mycalc['join_buffer'] < join_buffer_size:
        join_label = (
            f'join_buffer_space_limit * max_connections'
            f' (caps join_buffer_size = {bh(join_buffer_size)})'
        )
    else:
        join_label = 'join_buffer_size * max_connections'

    contributions = [
        per_thread(tmp_label, mycalc['max_tmp_table_size'], mycalc['total_tmp_tables']),
        per_thread(join_label, mycalc['join_buffer']),
        ('', mycalc['pf_memory'], 'Performance Schema'),
    ]
    for varname in (
        'read_buffer_size',
        'read_rnd_buffer_size',
        'sort_buffer_size',
        'thread_stack',
    ):
        contributions.append(
            per_thread(f'{varname} * max_connections', int(myvar[varname]))
        )
    for varname in (
        'aria_pagecache_buffer_size',
        'innodb_additional_mem_pool_size',
        'innodb_buffer_pool_size',
        'innodb_log_buffer_size',
        'key_buffer_size',
        'query_cache_size',
    ):
        contributions.append(('', int(myvar.get(varname, 0)), varname))
    # The binlog caches only exist while the binary log is on.
    if mycalc['binlog_cache_size']:
        contributions.append(
            per_thread(
                'binlog_cache_size * max_connections', mycalc['binlog_cache_size']
            )
        )
    contributions = [c for c in contributions if c[1] > 0]
    contributions.sort(key=lambda item: -item[1])
    return contributions


def render_breakdown(myvar, mycalc):
    """Render the --lengthy breakdown of the calculated worst case as a
    right-aligned sum: the factors, the amount, and what it is, largest
    first, closed by the total.
    """
    bh = lib.human.bytes2human
    contributions = build_contributions(myvar, mycalc)
    total_label = 'Total (max_peak_memory)'
    factor_width = max(len(factor) for factor, _, _ in contributions)
    value_width = max(
        len(bh(value))
        for value in [mycalc['max_peak_memory']]
        + [total for _, total, _ in contributions]
    )
    lines = ['Calculated worst case (largest first):', '']
    for factor, total, label in contributions:
        lines.append(f'  {factor:>{factor_width}} {bh(total):>{value_width}}  {label}')
    lines.append('  ' + '=' * (factor_width + value_width + 3 + len(total_label)))
    lines.append(
        f'  {"":>{factor_width}} {bh(mycalc["max_peak_memory"]):>{value_width}}'
        f'  {total_label}'
    )
    return '\n'.join(lines)


def main():
    """The main function. This is where the magic happens."""

    # The calculated worst case follows mysqltuner.pl:calculations(),
    # verified in sync with MySQLTuner 2.9.2. Deliberate deviations: the
    # binlog cache only counts with `log_bin=ON`, the join buffers on MariaDB
    # follow `join_buffer_space_limit` (see there), and nothing of it alerts.
    # MySQLTuner prints it once on request; as a check running every few
    # minutes it alerted on a sum no server ever allocates (measured on
    # MariaDB 11.4: 2.8 GiB calculated for 7 connections, 205 MiB RSS).
    # Alerts follow the measured RSS of the server processes instead.

    # parse the command line
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(STATE_UNKNOWN)

    # fetch data
    found, db_rss, other_process_memory = get_process_memory()
    if not found:
        lib.base.cu(
            'No `mysqld` or `mariadbd` process found on this host. The check'
            ' measures the memory of the database server, so it has to run on'
            ' the database host.'
        )

    mysql_connection = {
        'defaults_file': args.DEFAULTS_FILE,
        'defaults_group': args.DEFAULTS_GROUP,
        'timeout': args.TIMEOUT,
    }
    conn = lib.base.coe(lib.db_mysql.connect(mysql_connection))
    lib.base.coe(lib.db_mysql.check_privileges(conn))
    myvar = lib.db_mysql.lod2dict(get_vars(conn))
    mystat = lib.db_mysql.lod2dict(get_status(conn))
    pf_memory = get_pf_memory(conn, myvar)
    lib.db_mysql.close(conn)

    # init some vars
    state = STATE_OK
    sections = []
    facts = []
    recommendations = []
    is_mariadb = 'mariadb' in myvar.get('version', '').lower()
    product = 'MariaDB' if is_mariadb else 'MySQL'

    # analyze data
    mycalc = {}

    # None of the buffers below is allocated in advance, they are upper
    # bounds a connection grows into while a query needs them: a MEMORY/HEAP
    # temp table takes its blocks row by row (`hp_get_new_block()` in
    # `storage/heap/hp_block.c`, MariaDB 13.0), MySQL's TempTable engine,
    # hash join buffer and sort buffer grow block by block
    # (`storage/temptable`, `sql/iterators/hash_join_buffer.cc`,
    # `Filesort_buffer::allocate_block()`, MySQL 26.7).

    # The effective size of an internal in-memory temp table is the *minimum*
    # of these two settings (mysql docs:
    # https://dev.mysql.com/doc/refman/8.0/en/server-system-variables.html#sysvar_tmp_table_size).
    # Every connection can hold such a temp table (and a query several), so it
    # counts per connection, like in MySQLTuner. MariaDB limits each in-memory
    # temp table to min(tmp_memory_table_size, max_heap_table_size)
    # (`sql/sql_select.cc`, MariaDB 13.0).
    mycalc['max_tmp_table_size'] = min(
        int(myvar['tmp_table_size']),
        int(myvar['max_heap_table_size']),
    )
    # MySQL's TempTable engine additionally caps all in-memory temp tables of
    # the server at `temptable_max_ram` (`sql/sys_vars.cc`, MySQL 26.7).
    # MariaDB has no TempTable engine.
    mycalc['temptable_max_ram'] = None
    if (
        not is_mariadb
        and myvar.get('internal_tmp_mem_storage_engine', 'TempTable') == 'TempTable'
        and str(myvar.get('temptable_max_ram', '')).isdigit()
    ):
        mycalc['temptable_max_ram'] = int(myvar['temptable_max_ram'])

    # With `optimize_join_buffer_size=on`, MariaDB sizes each join buffer for
    # the estimated rows and shrinks all join buffers of a query together to
    # `join_buffer_space_limit` (`JOIN_CACHE::alloc_buffer()` in
    # `sql/sql_join_cache.cc`, MariaDB 13.0). The switch is on by default
    # since MariaDB 11.0 (MDEV-30812); before, and on MySQL, every join
    # buffer may reach `join_buffer_size`.
    mycalc['join_buffer'] = int(myvar['join_buffer_size'])
    if (
        is_mariadb
        and 'optimize_join_buffer_size=on' in myvar.get('optimizer_switch', '')
        and str(myvar.get('join_buffer_space_limit', '')).isdigit()
    ):
        mycalc['join_buffer'] = min(
            mycalc['join_buffer'], int(myvar['join_buffer_space_limit'])
        )

    # A session creates its binlog caches on its first write to the binary
    # log (`THD::binlog_setup_trx_data()` in `sql/log.cc`, MariaDB 13.0);
    # without a binary log there are none.
    mycalc['binlog_cache_size'] = 0
    if myvar.get('log_bin', 'OFF') == 'ON':
        mycalc['binlog_cache_size'] = int(myvar.get('binlog_cache_size', 0))

    mycalc['server_buffers'] = int(myvar['key_buffer_size'])
    mycalc['server_buffers'] += int(myvar.get('innodb_buffer_pool_size', 0))
    mycalc['server_buffers'] += int(myvar.get('innodb_additional_mem_pool_size', 0))
    mycalc['server_buffers'] += int(myvar.get('innodb_log_buffer_size', 0))
    mycalc['server_buffers'] += int(myvar.get('query_cache_size', 0))
    mycalc['server_buffers'] += int(myvar.get('aria_pagecache_buffer_size', 0))

    # `max_allowed_packet` is deliberately missing: a connection's network
    # buffer starts at `net_buffer_length` and only grows to the largest
    # packet it actually receives (`net_realloc()` in `sql/net_serv.cc`,
    # MariaDB 13.0; `sql-common/net_serv.cc`, MySQL 26.7).
    # `max_allowed_packet` is just the size at which a packet is rejected.
    # MySQLTuner dropped it for the same reason.
    mycalc['per_thread_buffers_without_tmp'] = int(myvar['read_buffer_size'])
    mycalc['per_thread_buffers_without_tmp'] += int(myvar['read_rnd_buffer_size'])
    mycalc['per_thread_buffers_without_tmp'] += int(myvar['sort_buffer_size'])
    mycalc['per_thread_buffers_without_tmp'] += int(myvar['thread_stack'])
    mycalc['per_thread_buffers_without_tmp'] += mycalc['join_buffer']
    mycalc['per_thread_buffers_without_tmp'] += mycalc['binlog_cache_size']
    mycalc['per_thread_buffers'] = (
        mycalc['per_thread_buffers_without_tmp'] + mycalc['max_tmp_table_size']
    )

    def tmp_tables(connections):
        total = mycalc['max_tmp_table_size'] * connections
        if mycalc['temptable_max_ram'] is not None:
            total = min(total, mycalc['temptable_max_ram'])
        return total

    mycalc['max_used_connections'] = int(mystat['Max_used_connections'])
    mycalc['max_total_per_thread_buffers'] = mycalc[
        'per_thread_buffers_without_tmp'
    ] * mycalc['max_used_connections'] + tmp_tables(mycalc['max_used_connections'])
    mycalc['total_tmp_tables'] = tmp_tables(int(myvar['max_connections']))
    mycalc['total_per_thread_buffers'] = (
        mycalc['per_thread_buffers_without_tmp'] * int(myvar['max_connections'])
        + mycalc['total_tmp_tables']
    )
    mycalc['pf_memory'] = pf_memory

    # The Galera GCache is deliberately missing: its ring buffer is a file
    # mapped with MAP_SHARED (`gu::MMap` in `galerautils/src/gu_mmap.cpp`,
    # Galera 26.4.27), i.e. page cache the kernel can write back and reclaim,
    # not heap memory. MySQLTuner leaves it out as well.
    mycalc['max_used_memory'] = (
        mycalc['server_buffers']
        + mycalc['max_total_per_thread_buffers']
        + mycalc['pf_memory']
    )
    mycalc['max_peak_memory'] = (
        mycalc['server_buffers']
        + mycalc['total_per_thread_buffers']
        + mycalc['pf_memory']
    )

    mycalc['physical_memory'] = os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES')
    mycalc['pct_max_used_memory'] = round(
        mycalc['max_used_memory'] / mycalc['physical_memory'] * 100, 1
    )
    mycalc['pct_max_physical_memory'] = round(
        mycalc['max_peak_memory'] / mycalc['physical_memory'] * 100, 1
    )
    mycalc['rss'] = db_rss
    mycalc['pct_rss'] = round(db_rss / mycalc['physical_memory'] * 100, 1)
    mycalc['other_process_memory'] = other_process_memory

    # build the message
    bh = lib.human.bytes2human

    # measured memory
    rss_state = lib.base.get_state(
        mycalc['pct_rss'],
        args.WARNING,
        args.CRITICAL,
        _operator='range',
    )
    if rss_state != STATE_OK:
        recommendations.append(
            f'Reduce the largest server-wide buffers (usually'
            f' `innodb_buffer_pool_size`, currently'
            f' {bh(int(myvar.get("innodb_buffer_pool_size", 0)))}), or add RAM'
        )
    state = lib.base.get_worst(state, rss_state)
    facts.append(
        f'{product} uses {bh(mycalc["rss"])}'
        f' ({mycalc["pct_rss"]}% of {bh(mycalc["physical_memory"])} RAM)'
        f'{lib.base.state2str(rss_state, prefix=" ")}.'
        f' Other processes: {bh(mycalc["other_process_memory"])}.'
    )

    # calculated worst case, reported only
    facts.append(
        f'Calculated worst case: {bh(mycalc["max_peak_memory"])}'
        f' ({mycalc["pct_max_physical_memory"]}% of RAM) with all'
        f' {myvar["max_connections"]} connections filling all buffers at once,'
        f' {bh(mycalc["max_used_memory"])} with the'
        f' {mycalc["max_used_connections"]} connections seen so far.'
    )
    if not lib.base.IS_64BIT and mycalc['max_used_memory'] > ADDR_LIMIT_32BIT:
        state = lib.base.get_worst(state, STATE_WARN)
        facts.append(f'More than {bh(ADDR_LIMIT_32BIT)} on a 32-bit binary [WARNING].')
        recommendations.append(
            f'Reduce MySQL buffer sizes: > {bh(ADDR_LIMIT_32BIT)} of allocations'
            f' on a 32-bit binary can cause instability'
        )

    # performance schema info note
    if myvar.get('performance_schema', 'OFF') != 'ON':
        facts.append('Performance Schema is OFF (pfs memory not counted).')

    sections.append('\n'.join(facts))
    if args.LENGTHY:
        sections.append(render_breakdown(myvar, mycalc))
    if recommendations:
        sections.append(
            'Recommendations:\n' + '\n'.join(f'* {r}' for r in recommendations)
        )
    msg = '\n\n'.join(sections)

    # perfdata
    perfdata = ''
    perfdata += lib.base.get_perfdata(
        'mysql_aria_pagecache_buffer_size',
        myvar.get('aria_pagecache_buffer_size', 0),
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_innodb_buffer_pool_size',
        myvar['innodb_buffer_pool_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_innodb_log_buffer_size',
        myvar['innodb_log_buffer_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_join_buffer_size',
        myvar['join_buffer_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_key_buffer_size',
        myvar['key_buffer_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_max_allowed_packet',
        myvar['max_allowed_packet'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_max_connections',
        myvar['max_connections'],
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_max_heap_table_size',
        myvar['max_heap_table_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_pf_memory',
        mycalc['pf_memory'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_query_cache_size',
        myvar.get('query_cache_size', 0),
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_read_buffer_size',
        myvar['read_buffer_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_read_rnd_buffer_size',
        myvar['read_rnd_buffer_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_sort_buffer_size',
        myvar['sort_buffer_size'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_thread_stack',
        myvar['thread_stack'],
        uom='B',
        _min=0,
    )
    perfdata += lib.base.get_perfdata(
        'mysql_tmp_table_size',
        myvar['tmp_table_size'],
        uom='B',
        _min=0,
    )

    perfdata += lib.base.get_perfdata(
        'mysql_max_used_connections',
