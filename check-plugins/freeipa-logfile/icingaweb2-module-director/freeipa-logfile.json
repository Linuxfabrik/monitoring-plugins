    "Datafield": {
        "1": {
            "varname": "freeipa_logfile_always_ok",
            "caption": "Freeipa Logfile: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "93271370-bfd7-4ab3-8ccc-3f09f74f2e69"
        },
        "2": {
            "varname": "freeipa_logfile_critical",
            "caption": "Freeipa Logfile: Critical",
            "description": "Least severe ipa-healthcheck result that returns CRITICAL. Each result includes everything more severe than itself, so `ERROR` covers `CRITICAL` as well. Case-sensitive. `none` lets no result return CRITICAL. Example: `--critical=CRITICAL`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "freeipa_logfile_critical_list"
            },
            "uuid": "47eeca5f-d6aa-400f-a8ff-ba549da3f59c"
        },
        "3": {
            "varname": "freeipa_logfile_ignore",
            "caption": "Freeipa Logfile: Ignore",
            "description": "Any ipa-healthcheck result matching this Python regex will be ignored. The regex is matched against the line the check prints for the result, `<source>.<check>[.<key>]: <message>`, without the result value. Case-sensitive. Can be specified multiple times. Example: `--ignore=IPADNSSystemRecordsCheck`",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "2f7cd2f5-64bf-4d1c-adb8-b67a48068128"
        },
        "4": {
            "varname": "freeipa_logfile_max_age",
            "caption": "Freeipa Logfile: Max Age",
            "description": "Maximum age of the ipa-healthcheck result in hours. An older result means that the daily run no longer happens.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "15d93b18-7191-4350-9d90-5619d02846c6"
        },
        "5": {
            "varname": "freeipa_logfile_no_perfdata",
            "caption": "Freeipa Logfile: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "616421d1-59c8-42d4-a879-6d6cb0179bef"
        },
        "6": {
            "varname": "freeipa_logfile_warning",
            "caption": "Freeipa Logfile: Warning",
            "description": "Least severe ipa-healthcheck result that returns WARNING. Each result includes everything more severe than itself, and a result that `--critical` already covers returns CRITICAL instead. Case-sensitive. `none` lets no result return WARNING. Example: `--warning=ERROR`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "freeipa_logfile_warning_list"
            },
            "uuid": "e8479496-b5de-43ac-8323-658db0a604a0"
        }
    }
