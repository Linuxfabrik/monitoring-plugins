    "ServiceTemplate": {
        "tpl-service-freeipa-logfile": {
            "action_url": null,
            "apply_for": null,
            "assign_filter": null,
            "check_command": "cmd-check-freeipa-logfile",
            "check_interval": "3600",
            "check_period": null,
            "check_timeout": null,
            "command_endpoint": null,
            "disabled": false,
            "display_name": null,
            "enable_active_checks": null,
            "enable_event_handler": null,
            "enable_flapping": null,
            "enable_notifications": true,
            "enable_passive_checks": null,
            "enable_perfdata": true,
            "event_command": null,
            "fields": [],
            "flapping_threshold_high": null,
            "flapping_threshold_low": null,
            "groups": [],
            "host": null,
            "icon_image": "freeipa-logfile.svg",
            "icon_image_alt": null,
            "imports": [
                "tpl-service-generic"
            ],
            "max_check_attempts": 5,
            "notes": "Evaluates the result file of ipa-healthcheck, which checks a FreeIPA server for certificate, replication, topology, DNS, service and file permission problems once a day, for example through ipa-healthcheck.timer. The check itself does not run ipa-healthcheck, so it is fast and needs no more than read access to the result file. Alerts when ipa-healthcheck reports a problem, and when the result file is damaged or older than the maximum age, because then the daily run has stopped. After the nightly log rotation, the result of the rotated file stands until the next run. ipa-healthcheck runs once a day and the services of the server are better watched in real time, so by default only WARNING is raised.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/freeipa-logfile/",
            "object_name": "tpl-service-freeipa-logfile",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "freeipa_logfile_always_ok": false,
                "freeipa_logfile_critical": "none",
                "freeipa_logfile_ignore": [],
                "freeipa_logfile_max_age": 26,
                "freeipa_logfile_no_perfdata": false,
                "freeipa_logfile_warning": "WARNING"
            },
            "volatile": null,
            "zone": null,
            "uuid": "075759a4-d1f5-4e13-80eb-9fab15fca3ec"
        }
    },
