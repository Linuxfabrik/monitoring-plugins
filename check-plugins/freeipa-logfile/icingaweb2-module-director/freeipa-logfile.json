                    "value": "$freeipa_logfile_max_age$"
                },
                "--no-perfdata": {
                    "set_if": "$freeipa_logfile_no_perfdata$"
                },
                "--warning": {
                    "value": "$freeipa_logfile_warning$"
                }
            },
            "command": "/usr/lib64/nagios/plugins/freeipa-logfile",
