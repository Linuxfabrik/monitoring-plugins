"""Unit tests for the freeipa-logfile check plugin.

The trees under `config/` stand in for the host and are handed to the check with
the hidden `--config-root`. Every result file in them was written by a real
`ipa-healthcheck --output-file` on a FreeIPA server in the freeipa-container images
(ipa-healthcheck 0.12 on Rocky 8, 0.19 on Rocky 9):

    rocky8-dns-warnings   0.12, 283 results, 11 WARNING: no integrated DNS, so the
                          SRV and URI records ipa-healthcheck expects are missing
    rocky8-check-timeout  0.12 with `timeout=2`: IPACertRevocation ran out of time
    rocky9-dns-warnings   0.19, 277 results, 12 WARNING, the same cause
    rocky9-errors         0.19 with ipa-custodia stopped and /etc/ipa/ca.crt at 0600
    rocky9-dirsrv-down    0.19 with dirsrv stopped: a check raised (CRITICAL with a
                          traceback), and the checks that need dirsrv did not run
    rocky9-rotated-*      rocky9-errors after `logrotate --force`: the empty file it
                          creates, and the dated predecessor
    rocky9-human-output   `--output-type human` instead of JSON
    rocky9-truncated      the first 4 KiB of rocky9-dns-warnings

Synthetic, because no ipa-healthcheck writes it today:

    rocky9-unknown-result rocky9-dns-warnings with the first result set to 40, a
                          value upstream has no name for and writes as it is

The age of a result file is measured against the real clock, so the fixed trees
switch the age check off with `--max-age=0`, and the age cases use trees that are
written below with `when` relative to now.
"""

import atexit
import datetime
import gzip
import json
import os
import shutil
import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import sys
import tempfile
import time
import unittest

sys.path.insert(0, '..')

import lib.lftest
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN = os.path.join(HERE, '..', 'freeipa-logfile')
REPORT_DIR = os.path.join('var', 'log', 'ipa', 'healthcheck')


def config_root(name):
    return os.path.join(HERE, 'config', name)


def generated_root(name):
    """Create a tree below unit-test/, the only place the check accepts a
    `--config-root` from, and remove it when the tests are done. The process ID
    keeps parallel runs (tox -p) from removing each other's trees."""
    root = os.path.join(HERE, 'config', f'generated-{os.getpid()}-{name}')
    shutil.rmtree(root, ignore_errors=True)
    os.makedirs(os.path.join(root, REPORT_DIR))
    atexit.register(shutil.rmtree, root, True)
    return root


def write_report(name, hours_ago, filename='healthcheck.log'):
    """Write rocky9-dns-warnings with every `when` moved to `hours_ago` hours ago."""
    when = datetime.datetime.fromtimestamp(
        time.time() - hours_ago * 3600, tz=datetime.timezone.utc
    ).strftime('%Y%m%d%H%M%SZ')
    path = os.path.join(
        config_root('rocky9-dns-warnings'), REPORT_DIR, 'healthcheck.log'
    )
    with open(path, encoding='utf-8') as f:
        results = json.load(f)
    for entry in results:
        entry['when'] = when
    root = generated_root(name)
    with open(os.path.join(root, REPORT_DIR, filename), 'w', encoding='utf-8') as f:
        json.dump(results, f, indent=2)
    return root


FRESH = write_report('fresh', 1)
STALE = write_report('stale', 30)

# A result file without a single result has no `when`, so its age is the
# modification time of the file. `ipa-healthcheck --failures-only` writes this on a
# server without a problem.
# The plugin counts whole seconds and the display drops them, so a modification
# time of exactly 30h ago may show as "1D 5h". Half an hour more keeps it at 1D 6h.
MTIME_30H = 30.5 * 3600

EMPTY_LIST_STALE = generated_root('empty-list-stale')
_path = os.path.join(EMPTY_LIST_STALE, REPORT_DIR, 'healthcheck.log')
with open(_path, 'w', encoding='utf-8') as _f:
    _f.write('[]')
os.utime(_path, (time.time() - MTIME_30H,) * 2)

EMPTY_STALE = generated_root('empty-stale')
_path = os.path.join(EMPTY_STALE, REPORT_DIR, 'healthcheck.log')
open(_path, 'w', encoding='utf-8').close()
os.utime(_path, (time.time() - MTIME_30H,) * 2)

# Two predecessors: the counted one is renamed upwards on every rotation, so its
# name says nothing about its age. The newer one by modification time is the one
# that counts, here a compressed copy of rocky9-errors.
ROTATED_ORDER = generated_root('rotated-order')
_dir = os.path.join(ROTATED_ORDER, REPORT_DIR)
open(os.path.join(_dir, 'healthcheck.log'), 'w', encoding='utf-8').close()
shutil.copy(
    os.path.join(config_root('rocky9-dns-warnings'), REPORT_DIR, 'healthcheck.log'),
    os.path.join(_dir, 'healthcheck.log.1'),
)
_src = os.path.join(config_root('rocky9-errors'), REPORT_DIR, 'healthcheck.log')
_dst = os.path.join(_dir, 'healthcheck.log.2.gz')
with open(_src, 'rb') as _in, gzip.open(_dst, 'wb') as _out:
    shutil.copyfileobj(_in, _out)
os.utime(os.path.join(_dir, 'healthcheck.log.1'), (time.time() - 7200,) * 2)
os.utime(os.path.join(_dir, 'healthcheck.log.2.gz'), (time.time() - 3600,) * 2)

# A symlink in place of the result file is never followed, and neither is one in
# place of a predecessor.
SECRET = os.path.join(tempfile.mkdtemp(prefix='freeipa-logfile-'), 'secret')
atexit.register(shutil.rmtree, os.path.dirname(SECRET), True)
with open(SECRET, 'w', encoding='utf-8') as _f:
    _f.write('[{"source": "planted", "check": "SecretMarker", "result": "ERROR"}]')
SYMLINKED = generated_root('symlinked')
os.symlink(SECRET, os.path.join(SYMLINKED, REPORT_DIR, 'healthcheck.log'))
SYMLINKED_PREDECESSOR = generated_root('symlinked-predecessor')
open(
    os.path.join(SYMLINKED_PREDECESSOR, REPORT_DIR, 'healthcheck.log'),
    'w',
    encoding='utf-8',
).close()
os.symlink(
    SECRET, os.path.join(SYMLINKED_PREDECESSOR, REPORT_DIR, 'healthcheck.log-20261108')
)

