class TestCheck(unittest.TestCase):
    pass


def _check_case(test, case):
    result = subprocess.run(  # nosec B603 - argv list, no shell
        [PLUGIN, *case['params']],
        capture_output=True,
        text=True,
        check=False,
    )
    combined = result.stdout + result.stderr
    test.assertEqual(
        result.returncode,
        case['assert-retc'],
        f'expected retc {case["assert-retc"]}, got {result.returncode}.'
        f'\nOutput: {combined}',
    )
    for needle in case.get('assert-in', []):
        test.assertIn(needle, combined, f'{needle!r} not in output:\n{combined}')
    for needle in case.get('assert-not-in', []):
        test.assertNotIn(
            needle, combined, f'{needle!r} unexpectedly in output:\n{combined}'
        )


lib.lftest.attach_each(TestCheck, CASES, _check_case, id_func=lambda it: it['id'])


class TestPermissions(unittest.TestCase):
    """A result directory the check may not list is UNKNOWN, not "not installed"."""

    def test_unlistable_directory(self):
        if hasattr(os, 'geteuid') and os.geteuid() == 0:
            self.skipTest('root lists every directory')
        root = generated_root('unlistable')
        directory = os.path.join(root, REPORT_DIR)
        shutil.copy(
            os.path.join(config_root('rocky9-errors'), REPORT_DIR, 'healthcheck.log'),
            directory,
        )
        os.chmod(directory, 0o000)
        self.addCleanup(os.chmod, directory, 0o755)
        result = subprocess.run(  # nosec B603 - argv list, no shell
            [PLUGIN, f'--config-root={root}'],
            capture_output=True,
            text=True,
            check=False,
        )
        self.assertEqual(result.returncode, STATE_UNKNOWN, result.stdout)
        self.assertIn('permission denied', result.stdout)
        self.assertIn('sudo chmod 0755 /var/log/ipa/healthcheck', result.stdout)


if __name__ == '__main__':
    unittest.main()
