            "max_check_attempts": 5,
            "notes": "Checks how full the netfilter connection tracking table is, and how often the kernel had to give up on a connection. Every host running a firewall, NAT or a container engine tracks its connections in a fixed-size table; once that table is full the kernel throws established connections out to make room, and after that it drops packets, which shows up as random connection timeouts nobody can explain from the application side. The check reports the table usage together with the kernel's own error counters as per-second rates measured between two runs, so the values reflect the current situation and not a total accumulated since boot. A host that does not track connections at all is reported as OK, because there is no table that could fill up. Supports extended reporting via --lengthy. Alerts when the table usage leaves the warning or critical range, when the kernel evicts an entry to make room in a full table, and when it drops packets faster than the thresholds allow.",
            "notes_url": "https://linuxfabrik.github.io/monitoring-plugins/check-plugins/conntrack/",
            "object_name": "tpl-service-conntrack",
            "object_type": "template",
            "retry_interval": 15,
            "service_set": null,
            "template_choice": null,
            "use_agent": null,
            "use_var_overrides": null,
            "vars": {
                "criticality": "C",
                "conntrack_always_ok": false,
                "conntrack_critical": "90",
                "conntrack_lengthy": false,
                "conntrack_no_perfdata": false,
                "conntrack_warning": "80",
                "conntrack_warning_drops": "1",
                "conntrack_warning_evictions": "0"
            },
            "volatile": null,
            "zone": null,
            "uuid": "99b3e2e5-38c4-40e3-a4e8-67aae7837f2c"
        }
    },
