        "2": {
            "varname": "conntrack_critical",
            "caption": "Conntrack: Critical",
            "description": "CRIT threshold for the connection tracking table usage in percent. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "09c09209-432b-4d60-8fab-0c5aad7728d0"
        },
        "3": {
            "varname": "conntrack_critical_drops",
            "caption": "Conntrack: Critical Drops",
            "description": "CRIT threshold for the per-second rate of each counter that means a packet was dropped although the table was not full: refused inserts and dropped packets. Every counter is compared on its own. Supports Nagios ranges. Default: no critical threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "1c3bb4b5-6f24-40fc-be49-849171d680bf"
        },
        "4": {
            "varname": "conntrack_critical_evictions",
            "caption": "Conntrack: Critical Evictions",
            "description": "CRIT threshold for the per-second rate of entries the kernel threw out of a full table to make room for a new connection. Supports Nagios ranges. Default: no critical threshold",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "ed3e178d-23b0-45be-bc21-215dc6256559"
        },
        "5": {
            "varname": "conntrack_lengthy",
            "caption": "Conntrack: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "3d0c86ce-21e9-41e7-a269-cceb63ff94ea"
        },
        "6": {
            "varname": "conntrack_no_perfdata",
            "caption": "Conntrack: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6691af9f-ebbc-4a27-ad94-dfd1319fe610"
        },
        "7": {
            "varname": "conntrack_warning",
            "caption": "Conntrack: Warning",
            "description": "WARN threshold for the connection tracking table usage in percent. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "8951868c-6722-441a-aeeb-5a3edbc2a858"
        },
        "8": {
            "varname": "conntrack_warning_drops",
            "caption": "Conntrack: Warning Drops",
            "description": "WARN threshold for the per-second rate of each counter that means a packet was dropped although the table was not full: refused inserts and dropped packets. Every counter is compared on its own. These occur on a healthy host as well, because two packets of the same new TCP connection arriving on different CPUs always cost one of them, so this tolerates a trickle instead of alerting on the first event. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "097abcb5-4c2f-49df-b91c-d85f7b58d51d"
        },
        "9": {
            "varname": "conntrack_warning_evictions",
            "caption": "Conntrack: Warning Evictions",
            "description": "WARN threshold for the per-second rate of entries the kernel threw out of a full table to make room for a new connection. This is the counter that catches a burst the table usage between two runs never sees, and a healthy host does not produce it at all. Supports Nagios ranges.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "7b2eff48-d4c1-4fcd-9525-bc290fd3228b"
        }
    }
