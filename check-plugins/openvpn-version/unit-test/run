"""Unit tests for the openvpn-version check plugin.

The fixtures in `stdout/` are the raw `openvpn --version` outputs
captured from the official Rocky Linux and Fedora container images
(`quay.io/rockylinux/rockylinux:{8,9,10}` plus
`registry.fedoraproject.org/fedora:43`) after a fresh
`dnf install openvpn` (with EPEL enabled where required). The
plugin runs its `r'OpenVPN\\s+(\\d+\\.\\d+\\.\\d+)'` regex against
each one.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-rocky8-openvpn-2-4-12',
        'test': 'stdout/openvpn-version-rocky8,,0',
        'assert-in': ['OpenVPN v2.4.12'],
    },
    {
        'id': 'parses-rocky9-openvpn-2-5-11',
        'test': 'stdout/openvpn-version-rocky9,,0',
        'assert-in': ['OpenVPN v2.5.11'],
    },
    {
        'id': 'parses-fedora43-openvpn-2-6-19',
        'test': 'stdout/openvpn-version-fedora43,,0',
        'assert-in': ['OpenVPN v2.6.19'],
    },
    {
        'id': 'parses-rocky10-openvpn-2-7-1',
        'test': 'stdout/openvpn-version-rocky10,,0',
        'assert-in': ['OpenVPN v2.7.1'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['OpenVPN not found', '--path'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../openvpn-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
