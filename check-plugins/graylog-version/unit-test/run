"""Unit tests for the graylog-version check plugin.

The fixtures in `stdout/` are the raw `yum list installed
graylog*` and `dpkg --list` outputs captured after a fresh install
of the corresponding Graylog repository deb/rpm package on a Rocky
Linux 9 (`quay.io/rockylinux/rockylinux:9`) and Debian 12
(`docker.io/library/debian:12`) container. We cover both the
RedHat and Debian package-listing shapes the plugin parses with
`r'graylog-server.*\\s+(\\d+\\.\\d+\\.\\d+)'`.

The testcases assert the parsed version and nothing else. The end-of-life half is
not tested here: `lib.version.check_eol()` is the same code in every `*-version`
plugin, and a verdict it derives from live endoflife.date data and today's date
cannot be pinned without breaking as soon as upstream re-dates a cycle or a date
passes. It is covered twice without the network instead, and that is where a case
belongs: against synthetic cycles in the lib repo (`tests/version/unit-test/run`),
and against every answer shape the API returns in
`check-plugins/mysql-version/unit-test/run`, whose fixtures sit next to it in
`endoflifedate/`.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    {
        'id': 'parses-debian-graylog-5-2',
        'test': 'stdout/dpkg-list-graylog-5.2,,0',
        'assert-in': ['Graylog v5.2.12'],
    },
    {
        'id': 'parses-debian-graylog-6-3-approaching',
        'test': 'stdout/dpkg-list-graylog-6.3,,0',
        'assert-in': ['Graylog v6.3.11'],
    },
    {
        'id': 'parses-rocky9-graylog-6-3-approaching',
        'test': 'stdout/yum-list-installed-graylog-6.3,,0',
        'assert-in': ['Graylog v6.3.11'],
    },
    {
        'id': 'parses-debian-graylog-7-0',
        'test': 'stdout/dpkg-list-graylog-7.0,,0',
        'assert-in': ['Graylog v7.0.6'],
    },
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['Graylog not found'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../graylog-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
