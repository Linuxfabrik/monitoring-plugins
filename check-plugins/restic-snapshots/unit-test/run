import os
import shutil
import subprocess  # nosec B404 - the test runs commands from argv lists, never through a shell
import sys
import tempfile

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

BASE_PARAMS = '--warn=1 --repo=test --password-file=test'


TESTS = [
    {
        # `restic snapshots --json` prints `[]` for a repository without snapshots
        'id': 'warn-empty-repository',
        'test': 'stdout/no-snapshots,,',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['The repository has no snapshot at all.'],
    },
    {
        # ... and the same `[]` for filters that drop every snapshot
        'id': 'warn-filters-match-no-snapshot',
        'test': 'stdout/no-snapshots,,',
        'params': BASE_PARAMS + ' --host=web01 --tag=daily',
        'assert-retc': STATE_WARN,
        'assert-in': ['No snapshot matches --host=web01 --tag=daily.'],
    },
    {
        'id': 'ok-empty-repository-always-ok',
        'test': 'stdout/no-snapshots,,',
        'params': BASE_PARAMS + ' --always-ok',
        'assert-retc': STATE_OK,
        'assert-in': ['The repository has no snapshot at all.'],
    },
    {
        'id': 'warn-snapshots-v1',
        'test': 'stdout/snapshots-v1,,',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['There are warnings.\n\nLatest snapshot '],
    },
    {
        'id': 'warn-snapshots-v2',
        'test': 'stdout/snapshots-v2,,',
        'params': BASE_PARAMS,
        'assert-retc': STATE_WARN,
        'assert-in': ['There are warnings.\n\nLatest snapshot '],
    },
]


class TestCheck(unittest.TestCase):
    check = '../restic-snapshots'


lib.lftest.attach_tests(TestCheck, TESTS)


class TestRepositorySafety(unittest.TestCase):
    """This check runs as root via sudo, so the caller must not be able to make
    restic run a program of their choosing or read a file only root should.
    """

    check = '../restic-snapshots'

    def run_check(self, *params):
        result = subprocess.run(  # nosec B603 - argv list, no shell
            [sys.executable, self.check, '--password-file=/etc/hostname', *params],
            capture_output=True,
            text=True,
            timeout=30,
        )
        return result.returncode, result.stdout

    def test_rclone_repository_is_refused(self):
        retc, stdout = self.run_check('--repo=rclone:remote:backups')
        self.assertEqual(retc, STATE_UNKNOWN)
        self.assertIn('rclone', stdout)

    def test_local_repository_anybody_can_change_is_refused(self):
        # restic writes its locks into a local repository; in a directory of the
        # caller's, a planted `locks/` symlink would redirect them
        work = tempfile.mkdtemp(prefix='lftest-restic-repo-')
        try:
            os.chmod(work, 0o777)  # nosec B103 - world-writable on purpose
            retc, stdout = self.run_check(f'--repo={work}')
            self.assertEqual(retc, STATE_UNKNOWN)
            self.assertIn('nobody but root', stdout)
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def test_repository_file_anybody_can_change_is_refused(self):
        work = tempfile.mkdtemp(prefix='lftest-restic-repo-')
        try:
            os.chmod(work, 0o777)  # nosec B103 - world-writable on purpose
            repofile = os.path.join(work, 'repo')
            with open(repofile, 'w') as handle:
                handle.write('rclone:remote:backups\n')
            retc, stdout = self.run_check(f'--repository-file={repofile}')
            self.assertEqual(retc, STATE_UNKNOWN)
            self.assertNotIn('Created', stdout)
        finally:
            shutil.rmtree(work, ignore_errors=True)


if __name__ == '__main__':
    unittest.main()
