    "Datafield": {
        "1": {
            "varname": "huawei_pacific_replicationpair_always_ok",
            "caption": "Huawei Pacific Replicationpair: Always OK?",
            "description": "Always returns OK.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "9b7677f5-9b92-4e3b-9d85-492059ae3189"
        },
        "2": {
            "varname": "huawei_pacific_replicationpair_brief",
            "caption": "Huawei Pacific Replicationpair: Brief?",
            "description": "Hide table rows for pairs that are mirroring and show only those that are not. Perfdata and alerting are unaffected: every pair still emits perfdata and still drives the overall check state.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "512e4e06-4d12-49ea-b6fe-c9fd0646b4d0"
        },
        "3": {
            "varname": "huawei_pacific_replicationpair_cache_expire",
            "caption": "Huawei Pacific Replicationpair: Cache Expire",
            "description": "The amount of time after which the credential/data cache expires, in minutes.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "24e4c070-a210-4020-9529-3021a436933f"
        },
        "4": {
            "varname": "huawei_pacific_replicationpair_critical",
            "caption": "Huawei Pacific Replicationpair: Critical",
            "description": "CRIT threshold for how long a pair has been without a complete copy at the far end, as a Nagios range in seconds. That is the time since the pair last finished transferring, or, while a transfer is running that has not finished, the time since it started. A pair can report a healthy status and still have stopped moving data, which is what this catches. Set it above the pair's own synchronization interval; there is no useful default, because that interval is configured per pair on the appliance. Off by default. Example: `--critical=172800` for two days",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "4cdd2bc4-0506-4691-aaa8-dc86a32d4af9"
        },
        "5": {
            "varname": "huawei_pacific_replicationpair_ignore",
            "caption": "Huawei Pacific Replicationpair: Ignore",
            "description": "Skip replication pairs. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against the pair identifier and the local and remote resource names, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "e2ba4695-ff75-49fd-be9c-b44f7efa6149"
        },
        "6": {
            "varname": "huawei_pacific_replicationpair_insecure",
            "caption": "Huawei Pacific Replicationpair: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "7464a17b-a6ec-4c78-b032-225d5fb4655c"
        },
        "7": {
            "varname": "huawei_pacific_replicationpair_lengthy",
            "caption": "Huawei Pacific Replicationpair: Lengthy?",
            "description": "Extended reporting.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "074fe842-3020-4f8c-a6c2-b35a1ad19682"
        },
        "8": {
            "varname": "huawei_pacific_replicationpair_match",
            "caption": "Huawei Pacific Replicationpair: Match",
            "description": "Limit to replication pairs. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. If both `--match` and `--ignore` are given, an item must match `--match` AND not match `--ignore` to be reported (include first, exclude second). Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against the pair identifier and the local and remote resource names, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "349d1e73-8b2e-4367-b41e-34c4c0d7bf4e"
        },
        "9": {
            "varname": "huawei_pacific_replicationpair_no_insecure",
            "caption": "Huawei Pacific Replicationpair: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "afb5135e-4ccf-41f8-82c3-7b9b38cf05c6"
        },
        "10": {
            "varname": "huawei_pacific_replicationpair_no_match_severity",
            "caption": "Huawei Pacific Replicationpair: No Match Severity",
            "description": "State to report when no item matches the filters and nothing is checked.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeDatalist",
            "format": null,
            "settings": {
                "behavior": "strict",
                "data_type": "string",
                "datalist": "huawei_pacific_replicationpair_no_match_severity_list"
            },
            "uuid": "ba43945f-34af-4463-9b48-8f753b2f2f3f"
        },
        "11": {
            "varname": "huawei_pacific_replicationpair_no_perfdata",
            "caption": "Huawei Pacific Replicationpair: No Perfdata?",
            "description": "Suppress the performance data section from the output. The status message and the exit code are unaffected, so alerting keeps working while trending data is dropped.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "033d9cec-9124-4738-b6b2-ad6b5eb9c9c1"
        },
        "12": {
            "varname": "huawei_pacific_replicationpair_no_proxy",
            "caption": "Huawei Pacific Replicationpair: No Proxy?",
            "description": "Do not use a proxy, not even one the environment names. Overrides `--proxy`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "6bd0d0b6-0571-47e9-9aef-d736264ac685"
        },
        "13": {
            "varname": "huawei_pacific_replicationpair_password",
            "caption": "Huawei Pacific Replicationpair: Password",
            "description": "Huawei OceanStor Pacific API password.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "2e069780-25a5-49fb-af02-9ee7a3668dd8"
        },
        "14": {
            "varname": "huawei_pacific_replicationpair_password_file",
            "caption": "Huawei Pacific Replicationpair: Password File",
            "description": "Path to a file holding the password, read from its first line. Keeps the password out of the process list, where a command-line argument is visible to every user on the host. Takes precedence over `--password`. Keep the file readable only by the monitoring user. Example: `--password-file=/etc/icinga2/secrets/storage`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "hidden"
            },
            "uuid": "8dc8416b-9f43-4dea-af10-ed50d5353333"
        },
        "15": {
            "varname": "huawei_pacific_replicationpair_proxy",
            "caption": "Huawei Pacific Replicationpair: Proxy",
            "description": "Proxy to reach the target through. The scheme defaults to `http` when omitted. Overrides the proxy the environment names (`http_proxy`, `https_proxy`, `all_proxy`) together with the exceptions it lists in `no_proxy`, and is itself overridden by `--no-proxy`. Without either parameter the environment applies. Credentials belong into the environment variable rather than here, because a command-line argument is visible to every user on the host. Example: `--proxy=http://proxy.example.com:3128`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c326da88-b228-4202-b260-a577549c2d80"
        },
        "16": {
            "varname": "huawei_pacific_replicationpair_scope",
            "caption": "Huawei Pacific Replicationpair: Scope",
            "description": "Huawei OceanStor Pacific API scope.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "0fea6575-af73-46b7-bacb-db4828a75f9f"
        },
        "17": {
            "varname": "huawei_pacific_replicationpair_timeout",
            "caption": "Huawei Pacific Replicationpair: Timeout",
            "description": "Network timeout in seconds.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "9da546b4-9832-418a-8f3c-41a014b708a7"
        },
        "18": {
            "varname": "huawei_pacific_replicationpair_url",
            "caption": "Huawei Pacific Replicationpair: URL",
            "description": "Huawei OceanStor Pacific API URL.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "100976b6-e7a3-4466-97c4-9f5cb1ac1c46"
        },
        "19": {
            "varname": "huawei_pacific_replicationpair_username",
            "caption": "Huawei Pacific Replicationpair: Username",
            "description": "Huawei OceanStor Pacific API username.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "f81dfae9-1ef6-402b-b2ef-090a8e14a948"
        },
        "20": {
            "varname": "huawei_pacific_replicationpair_warning",
            "caption": "Huawei Pacific Replicationpair: Warning",
            "description": "WARN threshold for how long a pair has been without a complete copy at the far end, as a Nagios range in seconds. Off by default, see --critical. Example: `--warning=86400` for one day",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "c91423d8-ad66-4644-a6c6-628b17cf351f"
        },
        "21": {
            "varname": "huawei_pacific_replicationpair_verbose",
            "caption": "Huawei Pacific Replicationpair: Verbose?",
            "description": "Makes this plugin verbose during the operation. Useful for debugging and seeing what is going on under the hood. Appends what every API request returned, so the appliance's own answers can be read while working out how it reports something. Session tokens are redacted. The output is as long as those answers are, so this is a debugging aid rather than something to leave switched on.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "480c145c-45bb-4de0-934e-f1a7246aad08"
        }
    }
