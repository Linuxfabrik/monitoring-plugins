"""Unit tests for the mysql-version check plugin.

The plugin probes for either MySQL Community Server or MariaDB by
running `mysqld`, `mariadbd`, `mariadb` or `mysql` with `--version`
and parses the result. Three regexes cover three output formats:

  - `mysqld  Ver X.Y.Z[-MariaDB] for ...`         (mysqld and mariadbd)
  - `mysql  Ver 14.14 Distrib X.Y.Z, for ...`     (legacy mysql client)
  - `mariadb from X.Y.Z-MariaDB, client ...`      (MariaDB 11.4+ client)

Fixtures in `stdout/` cover every MariaDB cycle that endoflife.date
currently lists (5.5 through 12.2) plus the MySQL 8.0 / 8.4 line, with
captures from multiple sources whenever possible:

- `<vendor>-<version>-c{8,9,10}s`   : Red Hat / CentOS Stream sclorg
                                       (`quay.io/sclorg/mariadb-105-c8s`,
                                       `mysql-80-c9s`, etc.)
- `<vendor>-<version>-rocky{8,9,10}`: Rocky Linux + the official MariaDB
                                       yum repo at https://yum.mariadb.org
                                       (or `archive.mariadb.org` for
                                       retired cycles)
- `<vendor>-<version>-centos7`      : CentOS 7 + the archive yum repo
                                       (only used for very old MariaDB
                                       like 5.5 that no longer ships on
                                       Rocky)
- `<vendor>-<version>-debian`       : `docker.io/library/mariadb:<tag>`
                                       (kept side-by-side with the Red
                                       Hat captures so the parser also
                                       sees the upstream Debian package
                                       suffixes like `-1~trusty` and
                                       `-ubu2404`)
- `<vendor>-<version>-debian-client`: same as debian, but captured via
                                       the new `mariadb --version`
                                       client banner that MariaDB 11.4
                                       introduced (the regex case
                                       starting with `from X.Y.Z`)

The testcases assert the parsed version and nothing else. An end-of-life
verdict is derived from live endoflife.date data and from today's date, so
pinning one here breaks as soon as upstream re-dates a cycle or a date passes.
`lib.version.check_eol()` is covered against synthetic cycles in the lib repo
instead, where the expectation cannot age.
"""

import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_UNKNOWN

TESTS = [
    # ---- MariaDB 5.5 ----------------------------------------------
    {
        'id': 'parses-mariadb-5-5-centos7',
        'test': 'stdout/mariadb-5.5-centos7,,0',
        'assert-in': ['MariaDB v5.5.68'],
    },
    {
        'id': 'parses-mariadb-5-5-debian',
        'test': 'stdout/mariadb-5.5-debian,,0',
        'assert-in': ['MariaDB v5.5.64'],
    },
    # ---- MariaDB 10.4 ---------------------------------------------
    {
        'id': 'parses-mariadb-10-4-rocky8',
        'test': 'stdout/mariadb-10.4-rocky8,,0',
        'assert-in': ['MariaDB v10.4.34'],
    },
    {
        'id': 'parses-mariadb-10-4-debian',
        'test': 'stdout/mariadb-10.4-debian,,0',
        'assert-in': ['MariaDB v10.4.34'],
    },
    # ---- MariaDB 10.5 ---------------------------------------------
    {
        'id': 'parses-mariadb-10-5-c8s',
        'test': 'stdout/mariadb-10.5-c8s,,0',
        'assert-in': ['MariaDB v10.5.9'],
    },
    {
        'id': 'parses-mariadb-10-5-c9s',
        'test': 'stdout/mariadb-10.5-c9s,,0',
        'assert-in': ['MariaDB v10.5.29'],
    },
    # ---- MariaDB 10.6 (near EOL) ----------------------------------
    {
        'id': 'parses-mariadb-10-6-rocky9',
        'test': 'stdout/mariadb-10.6-rocky9,,0',
        'assert-in': ['MariaDB v10.6.25'],
    },
    {
        'id': 'parses-mariadb-10-6-debian',
        'test': 'stdout/mariadb-10.6-debian,,0',
        'assert-in': ['MariaDB v10.6.25'],
    },
    # ---- MariaDB 10.11 (LTS) --------------------------------------
    {
        'id': 'parses-mariadb-10-11-c10s',
        'test': 'stdout/mariadb-10.11-c10s,,0',
        'assert-in': ['MariaDB v10.11.15'],
    },
    # ---- MariaDB 11.4 (LTS) ---------------------------------------
    {
        'id': 'parses-mariadb-11-4-rocky9',
        'test': 'stdout/mariadb-11.4-rocky9,,0',
        'assert-in': ['MariaDB v11.4.10'],
    },
    {
        # Exercises the third parser regex (`from X.Y.Z, client...`)
        # introduced by MariaDB 11.4.
        'id': 'parses-mariadb-11-4-debian-client-banner',
        'test': 'stdout/mariadb-11.4-debian-client,,0',
        'assert-in': ['MariaDB v11.4.10'],
    },
    # ---- MariaDB 11.8 ---------------------------------------------
    {
        'id': 'parses-mariadb-11-8-rocky9',
        'test': 'stdout/mariadb-11.8-rocky9,,0',
        'assert-in': ['MariaDB v11.8.6'],
    },
    {
        'id': 'parses-mariadb-11-8-debian-client-banner',
        'test': 'stdout/mariadb-11.8-debian-client,,0',
        'assert-in': ['MariaDB v11.8.6'],
    },
    # ---- MariaDB 12.0 ---------------------------------------------
    {
        'id': 'parses-mariadb-12-0-rocky9',
        'test': 'stdout/mariadb-12.0-rocky9,,0',
        'assert-in': ['MariaDB v12.0.2'],
    },
    {
        'id': 'parses-mariadb-12-0-debian-client',
        'test': 'stdout/mariadb-12.0-debian-client,,0',
        'assert-in': ['MariaDB v12.0.2'],
    },
    # ---- MariaDB 12.1 ---------------------------------------------
    {
        'id': 'parses-mariadb-12-1-rocky9',
        'test': 'stdout/mariadb-12.1-rocky9,,0',
        'assert-in': ['MariaDB v12.1.2'],
    },
    {
        'id': 'parses-mariadb-12-1-debian-client',
        'test': 'stdout/mariadb-12.1-debian-client,,0',
        'assert-in': ['MariaDB v12.1.2'],
    },
    # ---- MariaDB 12.2 ---------------------------------------------
    {
        'id': 'parses-mariadb-12-2-rocky9',
        'test': 'stdout/mariadb-12.2-rocky9,,0',
        'assert-in': ['MariaDB v12.2.2'],
    },
    {
        'id': 'parses-mariadb-12-2-rocky10',
        'test': 'stdout/mariadb-12.2-rocky10,,0',
        'assert-in': ['MariaDB v12.2.2'],
    },
    {
        'id': 'parses-mariadb-12-2-debian-client',
        'test': 'stdout/mariadb-12.2-debian-client,,0',
        'assert-in': ['MariaDB v12.2.2'],
    },
    # ---- MySQL 8.0 ------------------------------------------------
    {
        'id': 'parses-mysql-8-0-c8s',
        'test': 'stdout/mysql-8.0-c8s,,0',
        'assert-in': ['MySQL v8.0.26'],
    },
    {
        'id': 'parses-mysql-8-0-c9s',
        'test': 'stdout/mysql-8.0-c9s,,0',
        'assert-in': ['MySQL v8.0.45'],
    },
    # ---- MySQL 8.4 (LTS) ------------------------------------------
    {
        'id': 'parses-mysql-8-4-c10s',
        'test': 'stdout/mysql-8.4-c10s,,0',
        'assert-in': ['MySQL v8.4.8'],
    },
    # ---- Edge case ------------------------------------------------
    {
        'id': 'unknown-garbage-output',
        'test': 'stdout/garbage-output,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-in': ['MariaDB/MySQL not found'],
    },
]


class TestCheck(unittest.TestCase):
    check = '../mysql-version'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
