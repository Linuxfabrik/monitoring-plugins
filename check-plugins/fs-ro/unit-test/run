import sys

sys.path.insert(0, '..')

import unittest

import lib.lftest
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

_HEALTHY_FIXTURES = [
    'all-mounts-healthy-v1',
    'all-mounts-healthy-v2',
    'all-mounts-healthy-v3',
    'all-mounts-healthy-v4',
    'all-mounts-healthy-v5',
    'all-mounts-healthy-v6',
    'all-mounts-healthy-v7',
    'all-mounts-healthy-v8',
    'all-mounts-healthy-v9',
]


TESTS = [
    {
        'id': f'ok-{slug}',
        'test': f'stdout/{slug},,0',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\.',
    }
    for slug in _HEALTHY_FIXTURES
] + [
    {
        'id': 'ok-all-mounts-healthy-twenty-two-mounts',
        'test': 'stdout/all-mounts-healthy-twenty-two-mounts,,0',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\. 22 mount points checked\.',
    },
    {
        'id': 'warn-one-readonly-mount-v1',
        'test': 'stdout/one-readonly-mount-v1,,0',
        'assert-retc': STATE_WARN,
        'assert-regex': r'1 read-only mount point found',
    },
    {
        'id': 'warn-one-readonly-mount-v2',
        'test': 'stdout/one-readonly-mount-v2,,0',
        'assert-retc': STATE_WARN,
        'assert-regex': r'1 read-only mount point found',
    },
    {
        'id': 'warn-three-readonly-mounts',
        'test': 'stdout/three-readonly-mounts,,0',
        'assert-retc': STATE_WARN,
        'assert-regex': r'3 read-only mount points found',
    },
    {
        # Real /proc/mounts of openSUSE Leap 15.5 with one `docker run` container:
        # SUSE's Docker mounts a read-only secrets tmpfs into it.
        'id': 'ok-suse-docker-secrets-mount-is-ignored',
        'test': 'stdout/leap155-docker-container,,0',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\.',
    },
    {
        # --ignore replaces the defaults, so the container mount is reported again
        'id': 'warn-suse-docker-secrets-mount-without-default-ignores',
        'test': 'stdout/leap155-docker-container,,0',
        'params': '--ignore=/sys/fs',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 read-only mount point found', '/mounts/secrets'],
    },
    {
        # --ignore replaces the defaults, so /sys/fs/cgroup is reported again
        'id': 'warn-ignore-replaces-default-list',
        'test': 'stdout/one-readonly-mount-v1,,0',
        'params': '--ignore=/mnt/iso',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 read-only mount point found', '/sys/fs/cgroup'],
    },
    {
        # --extend-ignore keeps the defaults, so /sys/fs/cgroup stays ignored (#1566)
        'id': 'ok-extend-ignore-keeps-default-list',
        'test': 'stdout/one-readonly-mount-v1,,0',
        'params': '--extend-ignore=/mnt/iso',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\.',
    },
    {
        # A mounted ISO is reported, iso9660 is deliberately not a default fstype
        'id': 'warn-iso9660-not-ignored-by-default',
        'test': 'stdout/one-readonly-mount-v2,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 read-only mount point found', '(type iso9660)'],
    },
    {
        # --extend-ignore-fstype keeps the defaults, so ramfs and squashfs stay ignored
        'id': 'ok-extend-ignore-fstype-iso9660',
        'test': 'stdout/three-readonly-mounts,,0',
        'params': '--extend-ignore-fstype=iso9660 --extend-ignore=/mnt/external-disk',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\.',
    },
    {
        # Real /proc/mounts of a Lustre OST server, where the lustre targets are
        # mounted read-only (#1568)
        'id': 'warn-lustre-ost-server',
        'test': 'stdout/lustre-ost-server,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 read-only mount point found', '/users1/ost0 (type lustre)'],
    },
    {
        'id': 'ok-lustre-ost-server-extend-ignore-fstype',
        'test': 'stdout/lustre-ost-server,,0',
        'params': '--extend-ignore-fstype=lustre',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\.',
    },
    {
        # --ignore-fstype replaces the defaults; the fixture has no ramfs or
        # squashfs, so lustre alone decides
        'id': 'ok-lustre-ost-server-ignore-fstype',
        'test': 'stdout/lustre-ost-server,,0',
        'params': '--ignore-fstype=lustre',
        'assert-retc': STATE_OK,
        'assert-regex': r'Everything is ok\.',
    },
    {
        # Real /proc/mounts of Fedora 44 with a btrfs subvolume `/rwdata` mounted
        # read-only: the "rw" inside `subvol=/rwdata` must not count as `rw`
        'id': 'warn-btrfs-readonly-subvol-named-rwdata',
        'test': 'stdout/fedora44-btrfs-readonly-subvol-named-rwdata,,0',
        'assert-retc': STATE_WARN,
        'assert-in': ['1 read-only mount point found', '/srv/archive (type btrfs)'],
    },
    {
        'id': 'unknown-malformed-proc-mounts',
        'test': 'stdout/malformed-proc-mounts,,0',
        'assert-retc': STATE_UNKNOWN,
        'assert-regex': r'Unexpected format of /proc/mounts\.',
    },
]


class TestCheck(unittest.TestCase):
    check = '../fs-ro'


lib.lftest.attach_tests(TestCheck, TESTS)


if __name__ == '__main__':
    unittest.main()
