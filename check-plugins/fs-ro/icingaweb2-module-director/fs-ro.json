        },
        "4": {
            "varname": "fs_ro_ignore",
            "caption": "FS RO: Ignore",
            "description": "Mount point prefix to ignore. All mount points starting with this value will be skipped. Replaces the default list, use `--extend-ignore` to append to it. Can be specified multiple times. Example: `--ignore=/sys/fs` ignores `/sys/fs/cgroup` and similar. Default: /dev/loop, /proc, /run/credentials, /snap, /sys/fs, /var/lib/docker/containers.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "84d8c591-5fc0-48f4-a49a-dc1dcb5eac64"
        },
        "5": {
            "varname": "fs_ro_ignore_fstype",
            "caption": "FS RO: Ignore Fstype",
            "description": "Filesystem type to ignore, as shown in the third column of `/proc/mounts`. Replaces the default list, use `--extend-ignore-fstype` to append to it. Case-sensitive. Can be specified multiple times. Example: `--ignore-fstype=squashfs --ignore-fstype=lustre`. Default: ramfs, squashfs.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
