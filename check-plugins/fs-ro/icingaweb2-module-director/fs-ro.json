            "caption": "FS RO: Extend Ignore Fstype",
            "description": "Filesystem type to ignore, appended to the default or the `--ignore-fstype` list. Case-sensitive. Can be specified multiple times. Example: `--extend-ignore-fstype=iso9660`.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
