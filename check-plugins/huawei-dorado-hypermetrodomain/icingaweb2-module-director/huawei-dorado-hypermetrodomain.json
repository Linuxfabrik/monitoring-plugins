        "4": {
            "varname": "huawei_dorado_hypermetrodomain_ignore",
            "caption": "Huawei Dorado Hyper Metro Domain: Ignore",
            "description": "Skip HyperMetro domains. Any item matching this Python regex will be ignored. Can be specified multiple times. Example: `(?i)linuxfabrik` for a case-insensitive match. The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `NAME`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "bb3ec7a5-8a3f-4cef-888b-6953e60ea0da"
        },
        "5": {
            "varname": "huawei_dorado_hypermetrodomain_insecure",
            "caption": "Huawei Dorado Hyper Metro Domain: Insecure?",
            "description": "This option explicitly allows insecure SSL connections.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "b849807f-d6fb-4467-99dd-907d18060f55"
        },
        "6": {
            "varname": "huawei_dorado_hypermetrodomain_no_insecure",
            "caption": "Huawei Dorado Hyper Metro Domain: No Insecure?",
            "description": "Verify the TLS certificate against the system trust store, overriding the insecure default of this check. Use it once the endpoint presents a publicly trusted certificate, or once its CA has been added to the system trust store.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeBoolean",
            "format": null,
            "settings": {},
            "uuid": "39a951c2-2026-4694-9fa1-8c2482ce7f09"
        },
        "7": {
            "varname": "huawei_dorado_hypermetrodomain_match",
            "caption": "Huawei Dorado Hyper Metro Domain: Match",
            "description": "Filter by HyperMetro domains. Filter by this Python regular expression. Case-sensitive by default; use `(?i)` for case-insensitive matching. Can be specified multiple times. Examples: `(?i)example` to match \"example\" regardless of case. `^(?!.*example).*$` to match any string except \"example\" (negative lookahead). The regex is anchored at the start of the string (Python `re.match`) and is matched against `UUID`, `NAME`, so prefix with `.*` to match anywhere.",
            "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeArray",
            "format": null,
            "settings": {
                "visibility": "visible"
            },
            "uuid": "b20eeb0f-05a7-4866-bbc6-2e5913ce5d6b"
        },
        "8": {
            "varname": "huawei_dorado_hypermetrodomain_no_match_severity",
