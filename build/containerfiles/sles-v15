# Deliberately the oldest SLE 15 service pack: the package links against the
# glibc of the build image, and SP6 and later ship a newer one. Built on SP5,
# the package installs and runs on SP5 to SP7; built on SP7, it requires
# GLIBC_2.33/2.34 and no longer installs on SP5. Verified with
# linuxfabrik-monitoring-plugins 8.0.0 on bci-base 15.5, 15.6 and 15.7,
# 2026-09-23. Keep in line with BUILD.md.
FROM registry.suse.com/suse/sle15:15.5

# Install Python 3
RUN zypper --non-interactive install --no-recommends gcc python311 python311-pip python311-devel && \
    zypper --non-interactive clean --all

RUN zypper --non-interactive install --no-recommends rpm-build && \
    zypper --non-interactive clean --all
